/-- Case split on the second perpendicular for source triple ⟨0, 1, 2⟩. -/
theorem sub_aux_012 {b : Triple} (hb : b ∈ perpIdx)
    (hne : (⟨0, 1, 2⟩ : Triple) ≠ b)
    (hcross : cross (perpOfQ (⟨0, 1, 2⟩ : Triple)).n (perpOfQ b).n ≠ 0) :
    interPt (perpOfQ (⟨0, 1, 2⟩ : Triple)) (perpOfQ b) ∈ ansPts := by
  rw [perpIdx_eq] at hb
  fin_cases hb
  · exact absurd hne (by decide +kernel)
  · have h1 : dot (perpOfQ ⟨0, 1, 2⟩).n (![3, 5] : Fin 2 → ℚ) = (perpOfQ ⟨0, 1, 2⟩).c := by
      rw [perpOfQ_eq_012]
      decide +kernel
    have h2 : dot (perpOfQ ⟨0, 1, 3⟩).n (![3, 5] : Fin 2 → ℚ) = (perpOfQ ⟨0, 1, 3⟩).c := by
      rw [perpOfQ_eq_013]
      decide +kernel
    have heq : (![3, 5] : Fin 2 → ℚ) = interPt (perpOfQ ⟨0, 1, 2⟩) (perpOfQ ⟨0, 1, 3⟩) :=
      mem_unique hcross h1 h2 (interPt_mem₁ hcross) (interPt_mem₂ hcross)
    rw [← heq]
    have hmem : (![3, 5] : Fin 2 → ℚ) ∈ ansPtsList := by
      rw [ansPtsList_eq]
      exact (List.mem_append_right ansPtsChunk1 (List.mem_append_right ansPtsChunk2 (List.mem_append_left ansPtsChunk4 (by decide +kernel : (![3, 5] : Fin 2 → ℚ) ∈ ansPtsChunk3))))
    exact List.mem_toFinset.mpr hmem
  · have h1 : dot (perpOfQ ⟨0, 1, 2⟩).n (![3, 5] : Fin 2 → ℚ) = (perpOfQ ⟨0, 1, 2⟩).c := by
      rw [perpOfQ_eq_012]
      decide +kernel
    have h2 : dot (perpOfQ ⟨0, 1, 4⟩).n (![3, 5] : Fin 2 → ℚ) = (perpOfQ ⟨0, 1, 4⟩).c := by
      rw [perpOfQ_eq_014]
      decide +kernel
    have heq : (![3, 5] : Fin 2 → ℚ) = interPt (perpOfQ ⟨0, 1, 2⟩) (perpOfQ ⟨0, 1, 4⟩) :=
      mem_unique hcross h1 h2 (interPt_mem₁ hcross) (interPt_mem₂ hcross)
    rw [← heq]
    have hmem : (![3, 5] : Fin 2 → ℚ) ∈ ansPtsList := by
      rw [ansPtsList_eq]
      exact (List.mem_append_right ansPtsChunk1 (List.mem_append_right ansPtsChunk2 (List.mem_append_left ansPtsChunk4 (by decide +kernel : (![3, 5] : Fin 2 → ℚ) ∈ ansPtsChunk3))))
