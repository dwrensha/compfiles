/-- Every computed intersection point is one of the 315 enumerated points:
case split on the first perpendicular; each case is handled by its `sub_aux` lemma. -/
theorem computedPts_subset_ansPts : computedPts ⊆ ansPts := by
  intro v hv
  rw [computedPts, Finset.mem_image] at hv
  obtain ⟨⟨a, b⟩, hab, rfl⟩ := hv
  rw [Finset.mem_filter, Finset.mem_product] at hab
  obtain ⟨⟨ha, hb⟩, hne, hcross⟩ := hab
  rw [perpIdx_eq] at ha
  fin_cases ha
