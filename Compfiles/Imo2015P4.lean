problem imo2015_p4
    (A B C D E O K L X : E2)
    (hOAB : dist O A = dist O B) (hOBC : dist O B = dist O C)
    (hOF : dist O F = dist O A) (hOG : dist O G = dist O A)
    (hAD : dist A D = dist A F) (hAE : dist A E = dist A F)
    (hAFG : dist A F = dist A G)
    (hBDE : Sbtw ℝ B D E) (hDEC : Sbtw ℝ D E C) (hBC : B ≠ C)
    (hKAB : Collinear ℝ {A, B, K}) (hKBDF : Cospherical {B, D, F, K}) (hKB : K ≠ B)
    (hLAC : Collinear ℝ {A, C, L}) (hLCGE : Cospherical {C, G, E, L}) (hLC : L ≠ C)
    (hBDF : ¬Collinear ℝ {B, D, F}) (hCGE : ¬Collinear ℝ {C, G, E})
    (hBDG : ¬Collinear ℝ {B, D, G})
    (hKFG : ¬Collinear ℝ {F, G, K}) (hLFG : ¬Collinear ℝ {F, G, L})
    (hXFK : Collinear ℝ {F, K, X}) (hXGL : Collinear ℝ {G, L, X})
    (hABC : ¬Collinear ℝ {A, B, C}) :
    Collinear ℝ {A, O, X} := by
  -- squared-distance forms of the circle memberships
  have qAFG := sq_eq_of_dist_eq hAFG
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at qAFG
  have hA0 : A 0 = 0 := by linear_combination (1 / 4 : ℝ) * qAFG
  have qOF := sq_eq_of_dist_eq hOF
  have qOG := sq_eq_of_dist_eq hOG
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at qOF qOG
  have hO0 : O 0 = 0 := by linear_combination (1 / 4 : ℝ) * qOF - (1 / 4 : ℝ) * qOG
  -- the three circle equations in polynomial form
  have hA : A 1 ^ 2 - 2 * O 1 * A 1 - 1 = 0 := by
    rw [hA0, hO0] at qOF
    linear_combination -qOF
  have hD : D 0 ^ 2 + D 1 ^ 2 - 2 * A 1 * D 1 - 1 = 0 := by
    have qAD := sq_eq_of_dist_eq hAD
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at qAD
    rw [hA0] at qAD
    linear_combination qAD
  have hB : B 0 ^ 2 + B 1 ^ 2 - 2 * O 1 * B 1 - 1 = 0 := by
    have qOB := sq_eq_of_dist_eq (hOAB.symm.trans hOF.symm)
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at qOB
    rw [hO0] at qOB
    linear_combination qOB
  have hC : C 0 ^ 2 + C 1 ^ 2 - 2 * O 1 * C 1 - 1 = 0 := by
    have qOC := sq_eq_of_dist_eq (hOBC.symm.trans (hOAB.symm.trans hOF.symm))
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at qOC
    rw [hO0] at qOC
    linear_combination qOC
  have hE0 : E 0 ^ 2 + E 1 ^ 2 - 2 * A 1 * E 1 - 1 = 0 := by
    have qAE := sq_eq_of_dist_eq hAE
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at qAE
    rw [hA0] at qAE
    linear_combination qAE
  -- distinctness facts
  have hBD : B ≠ D := (hBDE.ne_left).symm
  have hDE : D ≠ E := hBDE.ne_right
  have hAB : A ≠ B := ne₁₂_of_not_collinear hABC
  have hAC : A ≠ C := ne₁₃_of_not_collinear hABC
  have hK1 : K 1 ≠ 0 := coord_one_ne_zero_of_not_collinear hKFG
  have hL1 : L 1 ≠ 0 := coord_one_ne_zero_of_not_collinear hLFG
  have hAO : A 1 - O 1 ≠ 0 := by
    intro h
    have e : A 1 = O 1 := by linarith
    rw [← e] at hA
    nlinarith [sq_nonneg (A 1)]
  -- collinearity of B, D, E, C
  have hcolBDE : Collinear ℝ {B, D, E} := hBDE.wbtw.collinear
  have hcolDEC : Collinear ℝ {D, E, C} := hDEC.wbtw.collinear
  have hCin : C ∈ line[ℝ, B, D] := by
    have h1 : C ∈ line[ℝ, D, E] :=
      hcolDEC.mem_affineSpan_of_mem_of_ne (by simp) (by simp) (by simp) hDE
    have h2 : line[ℝ, D, E] = line[ℝ, B, D] := by
      rw [hcolBDE.affineSpan_eq_of_ne (show D ∈ ({B, D, E} : Set E2) by simp)
          (show E ∈ ({B, D, E} : Set E2) by simp) hDE,
        hcolBDE.affineSpan_eq_of_ne (show B ∈ ({B, D, E} : Set E2) by simp)
          (show D ∈ ({B, D, E} : Set E2) by simp) hBD]
    rw [h2] at h1
    exact h1
  -- parametrizations on the four lines
  obtain ⟨tE, htE0, htE1⟩ := exists_param_of_mem_line (P := B) (Q := D) (R := E)
    (hcolBDE.mem_affineSpan_of_mem_of_ne (by simp) (by simp) (by simp) hBD)
  obtain ⟨tC, htC0, htC1⟩ := exists_param_of_mem_line (P := B) (Q := D) (R := C) hCin
  obtain ⟨tK, htK0, htK1⟩ := exists_param_of_mem_line (P := A) (Q := B) (R := K)
    (hKAB.mem_affineSpan_of_mem_of_ne (by simp) (by simp) (by simp) hAB)
  obtain ⟨tL, htL0, htL1⟩ := exists_param_of_mem_line (P := A) (Q := C) (R := L)
    (hLAC.mem_affineSpan_of_mem_of_ne (by simp) (by simp) (by simp) hAC)
  -- reparametrize: E = D + s(B-D), C = D + u(B-D), K = B + r(A-B), L = C + q(A-C)
  have hE0' : E 0 = D 0 + (1 - tE) * (B 0 - D 0) := by linear_combination htE0
  have hE1' : E 1 = D 1 + (1 - tE) * (B 1 - D 1) := by linear_combination htE1
  have hs_ne : (1 - tE) ≠ 0 := by
    intro h0
    apply hDE.symm
    apply coord_ext <;> [rw [hE0', h0] ; rw [hE1', h0]] <;> simp
  have hC0' : C 0 = D 0 + (1 - tC) * (B 0 - D 0) := by linear_combination htC0
  have hC1' : C 1 = D 1 + (1 - tC) * (B 1 - D 1) := by linear_combination htC1
  have hu_ne : (1 - tC) ≠ 1 := by
    intro h0
    apply hBC.symm
    have h0' : tC = 0 := by linarith
    apply coord_ext <;> [rw [hC0', h0] ; rw [hC1', h0]] <;> simp
  have hK0' : K 0 = B 0 + (1 - tK) * (A 0 - B 0) := by linear_combination htK0
  have hK1' : K 1 = B 1 + (1 - tK) * (A 1 - B 1) := by linear_combination htK1
  rw [hA0] at hK0'
  have hr_ne : (1 - tK) ≠ 0 := by
    intro h0
    apply hKB.symm
    apply coord_ext <;> [rw [hK0', h0] ; rw [hK1', h0]] <;> simp
  have hL0' : L 0 = C 0 + (1 - tL) * (A 0 - C 0) := by linear_combination htL0
  have hL1' : L 1 = C 1 + (1 - tL) * (A 1 - C 1) := by linear_combination htL1
  rw [hA0] at hL0'
  have hq_ne : (1 - tL) ≠ 0 := by
    intro h0
    apply hLC.symm
    apply coord_ext <;> [rw [hL0', h0] ; rw [hL1', h0]] <;> simp
  -- the second-intersection equation for E on Gamma
  have hEs : ((B 0 - D 0) ^ 2 + (B 1 - D 1) ^ 2) * (1 - tE) +
      (2 * (D 0 * (B 0 - D 0) + D 1 * (B 1 - D 1)) - 2 * A 1 * (B 1 - D 1)) = 0 := by
    rw [hE0', hE1'] at hE0
    have hfact : (D 0 + (1 - tE) * (B 0 - D 0)) ^ 2 + (D 1 + (1 - tE) * (B 1 - D 1)) ^ 2 -
        2 * A 1 * (D 1 + (1 - tE) * (B 1 - D 1)) - 1
        = (D 0 ^ 2 + D 1 ^ 2 - 2 * A 1 * D 1 - 1) + (1 - tE) * (((B 0 - D 0) ^ 2 + (B 1 - D 1) ^ 2) * (1 - tE) +
          (2 * (D 0 * (B 0 - D 0) + D 1 * (B 1 - D 1)) - 2 * A 1 * (B 1 - D 1))) := by
      ring
    rw [hfact, hD, zero_add] at hE0
    rcases mul_eq_zero.mp hE0 with h | h
    · exact absurd h hs_ne
    · exact h
  -- the second-intersection equation for C on Omega
  have hCu : ((B 0 - D 0) ^ 2 + (B 1 - D 1) ^ 2) * (1 - tC) -
      (D 0 ^ 2 + D 1 ^ 2 - 2 * O 1 * D 1 - 1) = 0 := by
    rw [hC0', hC1'] at hC
    have hfact : (D 0 + (1 - tC) * (B 0 - D 0)) ^ 2 + (D 1 + (1 - tC) * (B 1 - D 1)) ^ 2 -
        2 * O 1 * (D 1 + (1 - tC) * (B 1 - D 1)) - 1
        = (1 - tC) * (B 0 ^ 2 + B 1 ^ 2 - 2 * O 1 * B 1 - 1) +
          ((1 - tC) - 1) * (((B 0 - D 0) ^ 2 + (B 1 - D 1) ^ 2) * (1 - tC) -
          (D 0 ^ 2 + D 1 ^ 2 - 2 * O 1 * D 1 - 1)) := by
      ring
    rw [hfact, hB, mul_zero, zero_add] at hC
    rcases mul_eq_zero.mp hC with h | h
    · exact absurd h (sub_ne_zero.mpr hu_ne)
    · exact h
  -- the concyclicity equation for K
  have hKr : (((0 - B 0) ^ 2 + (A 1 - B 1) ^ 2) * ((B 0 + 1) * D 1 - B 1 * (D 0 + 1))) * (1 - tK) +
      ((0 - B 0) * B 1 * (D 0 ^ 2 + D 1 ^ 2 - 1) +
       (A 1 - B 1) * (B 0 ^ 2 + B 1 ^ 2 - 1) * (D 0 + 1) +
       2 * (B 0 * (0 - B 0) + B 1 * (A 1 - B 1)) * (B 0 + 1) * D 1 -
       2 * (B 0 * (0 - B 0) + B 1 * (A 1 - B 1)) * B 1 * (D 0 + 1) -
       (A 1 - B 1) * (B 0 + 1) * (D 0 ^ 2 + D 1 ^ 2 - 1) -
       (0 - B 0) * (B 0 ^ 2 + B 1 ^ 2 - 1) * D 1) = 0 := by
    have hKBDF' : Cospherical {K, B, D, F} := by
      rw [Set.insert_comm K B, Set.insert_comm K D, Set.pair_comm K F]
      exact hKBDF
    have h := cycPolyF_eq_zero_of_cospherical hKBDF'
    simp only [cycPolyF, Matrix.det_fin_three, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.head_cons, Matrix.tail_cons, Matrix.of_apply, Matrix.cons_val_two] at h
    rw [hK0', hK1'] at h
    have h2 : (1 - tK) * ((((0 - B 0) ^ 2 + (A 1 - B 1) ^ 2) * ((B 0 + 1) * D 1 - B 1 * (D 0 + 1))) * (1 - tK) +
        ((0 - B 0) * B 1 * (D 0 ^ 2 + D 1 ^ 2 - 1) +
         (A 1 - B 1) * (B 0 ^ 2 + B 1 ^ 2 - 1) * (D 0 + 1) +
         2 * (B 0 * (0 - B 0) + B 1 * (A 1 - B 1)) * (B 0 + 1) * D 1 -
         2 * (B 0 * (0 - B 0) + B 1 * (A 1 - B 1)) * B 1 * (D 0 + 1) -
         (A 1 - B 1) * (B 0 + 1) * (D 0 ^ 2 + D 1 ^ 2 - 1) -
         (0 - B 0) * (B 0 ^ 2 + B 1 ^ 2 - 1) * D 1)) = 0 := by
      linear_combination h
    rcases mul_eq_zero.mp h2 with h' | h'
    · exact absurd h' hr_ne
    · exact h'
  -- the concyclicity equation for L
  have hLq : (((0 - C 0) ^ 2 + (A 1 - C 1) ^ 2) * ((C 0 - 1) * E 1 - C 1 * (E 0 - 1))) * (1 - tL) +
      ((0 - C 0) * C 1 * (E 0 ^ 2 + E 1 ^ 2 - 1) +
       (A 1 - C 1) * (C 0 ^ 2 + C 1 ^ 2 - 1) * (E 0 - 1) +
       2 * (C 0 * (0 - C 0) + C 1 * (A 1 - C 1)) * (C 0 - 1) * E 1 -
       2 * (C 0 * (0 - C 0) + C 1 * (A 1 - C 1)) * C 1 * (E 0 - 1) -
       (A 1 - C 1) * (C 0 - 1) * (E 0 ^ 2 + E 1 ^ 2 - 1) -
       (0 - C 0) * (C 0 ^ 2 + C 1 ^ 2 - 1) * E 1) = 0 := by
    have hLCGE' : Cospherical {L, C, E, G} := by
      rw [Set.insert_comm L C, Set.insert_comm L E, Set.pair_comm L G, Set.insert_comm E G]
      exact hLCGE
    have h := cycPolyG_eq_zero_of_cospherical hLCGE'
    simp only [cycPolyG, Matrix.det_fin_three, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.head_cons, Matrix.tail_cons, Matrix.of_apply, Matrix.cons_val_two] at h
    rw [hL0', hL1'] at h
    have h2 : (1 - tL) * ((((0 - C 0) ^ 2 + (A 1 - C 1) ^ 2) * ((C 0 - 1) * E 1 - C 1 * (E 0 - 1))) * (1 - tL) +
        ((0 - C 0) * C 1 * (E 0 ^ 2 + E 1 ^ 2 - 1) +
         (A 1 - C 1) * (C 0 ^ 2 + C 1 ^ 2 - 1) * (E 0 - 1) +
         2 * (C 0 * (0 - C 0) + C 1 * (A 1 - C 1)) * (C 0 - 1) * E 1 -
         2 * (C 0 * (0 - C 0) + C 1 * (A 1 - C 1)) * C 1 * (E 0 - 1) -
         (A 1 - C 1) * (C 0 - 1) * (E 0 ^ 2 + E 1 ^ 2 - 1) -
         (0 - C 0) * (C 0 ^ 2 + C 1 ^ 2 - 1) * E 1)) = 0 := by
      linear_combination h
    rcases mul_eq_zero.mp h2 with h' | h'
    · exact absurd h' hq_ne
    · exact h'
  -- X lies on both lines
  have hX1 : K 1 * (X 0 + 1) - (K 0 + 1) * X 1 = 0 := by
    have hc := cross_of_collinear hXFK
