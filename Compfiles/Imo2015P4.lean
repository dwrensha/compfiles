/-- Small regrouping identity used by `hKeyQ1_aux`: the cofactor combination
is rearranged to expose the two quadratic certificates. Proved with variables
standing for the large subterms, so the `ring` call stays tiny. -/
lemma hKeyRegroup_aux (p q r a b c d e : ℝ) :
    (Sub.sub (Mul.mul p (Add.add (Mul.mul q b) (Mul.mul r c))) (Mul.mul e (Sub.sub (Mul.mul q a) (Mul.mul r d)))) = (Add.add (Mul.mul q (Sub.sub (Mul.mul p b) (Mul.mul e a))) (Mul.mul r (Add.add (Mul.mul p c) (Mul.mul e d)))) := by
  simp only [rr_mul, rr_add, rr_sub]
  ring

/-- Small factoring identity used by `hKeyQ2_aux`: extracting the common
quadratic factor. Proved with variables standing for the large subterms, so
the `ring` call stays tiny. -/
lemma hKeyFactor_aux (q r w u v : ℝ) :
    (Add.add (Mul.mul q (Mul.mul w u)) (Mul.mul r (Mul.mul w v))) = (Mul.mul w (Add.add (Mul.mul q u) (Mul.mul r v))) := by
  simp only [rr_mul, rr_add, rr_sub]
  ring

/-- Small reassociation identity used by `hKeyQ3_aux`. Proved with
variables standing for the large subterms, so the `ring` call stays tiny. -/
lemma hKeyAssoc_aux (a b c d : ℝ) :
    (Mul.mul a (Mul.mul b (Mul.mul c d))) = (Mul.mul (Mul.mul (Mul.mul a b) c) d) := by
  simp only [rr_mul, rr_add, rr_sub]
  ring

