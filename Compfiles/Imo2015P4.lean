problem_file { tags := [.Geometry] }

/-!
# International Mathematical Olympiad 2015, Problem 4

Triangle ABC has circumcircle Ω and circumcenter O. A circle Γ with center A
intersects the segment BC at points D and E, such that B, D, E, and C are
all different and lie on line BC in this order. Let F and G be the points of
intersection of Γ and Ω, such that A, F, B, C, and G lie on Ω in this order.
Let K = (BDF) ∩ AB ≠ B and L = (CGE) ∩ AC ≠ C and assume these points do not
lie on line FG. Define X = FK ∩ GL. Prove that X lies on the line AO.

## Notes on the formalization

We work in Cartesian coordinates in the Euclidean plane, in a coordinate system
with F = (-1, 0) and G = (1, 0). Any configuration satisfying the hypotheses can
be brought to this form by a similarity of the plane (which preserves all the
hypotheses and the conclusion); we do not formalize this reduction and prove the
normalized version of the problem instead. Since AF = AG and OF = OG, both A and
O then lie on the y-axis, and the conclusion "X lies on line AO" becomes
"the first coordinate of X is zero".

The order conditions (B, D, E, C in this order on the line; A, F, B, C, G in
this order on the circle) are mostly not needed for the proof: the conclusion
is an algebraic identity that holds on the whole configuration variety, so we
omit them. (We do keep the consequence that G is not on line BC, in the form
of the hypothesis hBDG.) The proof is then a (large) exact coordinate
computation: everything is rational in the coordinates, so no choice of sign
or branch is ever needed. In particular, K and L are determined rationally:
the condition "B, D, F, K concyclic, K ≠ B" picks out K uniquely, and the
final conclusion reduces to a polynomial identity in the coordinates, which is
verified by exhibiting a factorization of the resulting polynomial together
with a small ideal-membership certificate for the last factor (found by
computer algebra).
-/

namespace Imo2015P4

open scoped EuclideanGeometry

open EuclideanGeometry

/-- The Euclidean plane. -/
local notation "E2" => EuclideanSpace ℝ (Fin 2)

/-- The first intersection point of the two circles, normalized to (-1, 0). -/
local notation "F" => (!₂[(-1 : ℝ), (0 : ℝ)] : E2)

/-- The second intersection point of the two circles, normalized to (1, 0). -/
local notation "G" => (!₂[(1 : ℝ), (0 : ℝ)] : E2)

snip begin

/-- Rewriting rules between the class-projection operations (`Mul.mul`,
`Add.add`, `Sub.sub`) and the `*`/`+`/`-` notations on ℝ.  The giant
polynomial statements in this file are written in the class-projection form:
elaborating such huge terms through the heterogeneous `binop%` elaborator
creates a quadratic number of pending typeclass problems ("synthesize
pending MVars"), while the plain class-projection form elaborates linearly.
The `rr_*` lemmas convert goals back to notation form at the kernel level
before `ring`-family tactics. -/
private lemma rr_mul (a b : ℝ) : Mul.mul a b = a * b := rfl
private lemma rr_add (a b : ℝ) : Add.add a b = a + b := rfl
private lemma rr_sub (a b : ℝ) : Sub.sub a b = a - b := rfl
private lemma rr_add_mul (a b c : ℝ) :
    Mul.mul (Add.add a b) c = Add.add (Mul.mul a c) (Mul.mul b c) := add_mul a b c
private lemma rr_mul_zero (a : ℝ) : Mul.mul a 0 = 0 := mul_zero a

-- the `simp only [rr_mul, rr_add, rr_sub]` preludes below do not always use
-- all three lemmas at every site
set_option linter.unusedSimpArgs false

/-- Two points of the plane with equal coordinates are equal. -/
lemma coord_ext {P Q : E2} (h0 : P 0 = Q 0) (h1 : P 1 = Q 1) : P = Q := by
  have h : ∀ i, P i = Q i := by
    rw [Fin.forall_fin_two]
    exact ⟨h0, h1⟩
  exact PiLp.ext h

/-- Squared-distance form of an equality of distances. -/
lemma sq_eq_of_dist_eq {P Q R S : E2} (h : dist P Q = dist R S) :
    (P 0 - Q 0) ^ 2 + (P 1 - Q 1) ^ 2 = (R 0 - S 0) ^ 2 + (R 1 - S 1) ^ 2 := by
  have h2 : dist P Q ^ 2 = dist R S ^ 2 := by rw [h]
  rw [EuclideanSpace.dist_eq, EuclideanSpace.dist_eq] at h2
  rw [Real.sq_sqrt (by positivity), Real.sq_sqrt (by positivity)] at h2
  rw [Fin.sum_univ_two, Fin.sum_univ_two] at h2
  simp only [Real.dist_eq, sq_abs] at h2
  exact h2

/-- Squared-distance form of a distance value. -/
lemma sq_of_dist_eq {P Q : E2} {r : ℝ} (h : dist P Q = r) :
    (P 0 - Q 0) ^ 2 + (P 1 - Q 1) ^ 2 = r ^ 2 := by
  have h2 : dist P Q ^ 2 = r ^ 2 := by rw [h]
  rw [EuclideanSpace.dist_eq] at h2
  rw [Real.sq_sqrt (by positivity)] at h2
  rw [Fin.sum_univ_two] at h2
  simp only [Real.dist_eq, sq_abs] at h2
  exact h2

/-- The 2D cross product equation expressing that `R` lies on line `PQ`. -/
lemma cross_of_collinear {P Q R : E2} (h : Collinear ℝ {P, Q, R}) :
    (Q 0 - P 0) * (R 1 - P 1) = (Q 1 - P 1) * (R 0 - P 0) := by
  rw [collinear_iff_of_mem (show P ∈ ({P, Q, R} : Set E2) by simp)] at h
  obtain ⟨v, hv⟩ := h
  obtain ⟨r₂, h₂⟩ := hv Q (by simp)
  obtain ⟨r₃, h₃⟩ := hv R (by simp)
  have h₂0 : Q 0 = r₂ * v 0 + P 0 := by
    have := congrArg (fun p : E2 => p 0) h₂
    simpa using this
  have h₂1 : Q 1 = r₂ * v 1 + P 1 := by
    have := congrArg (fun p : E2 => p 1) h₂
    simpa using this
  have h₃0 : R 0 = r₃ * v 0 + P 0 := by
    have := congrArg (fun p : E2 => p 0) h₃
    simpa using this
  have h₃1 : R 1 = r₃ * v 1 + P 1 := by
    have := congrArg (fun p : E2 => p 1) h₃
    simpa using this
  rw [h₂0, h₂1, h₃0, h₃1]
  ring

/-- The converse: vanishing cross product implies collinearity. -/
lemma collinear_of_cross_eq_zero {P Q R : E2}
    (h : (Q 0 - P 0) * (R 1 - P 1) - (Q 1 - P 1) * (R 0 - P 0) = 0) :
    Collinear ℝ {P, Q, R} := by
  by_cases hPQ : Q = P
  · subst hPQ
    have he : ({Q, Q, R} : Set E2) = {Q, R} := by ext x; simp
    rw [he]
    exact collinear_pair ℝ Q R
  rw [collinear_iff_of_mem (show P ∈ ({P, Q, R} : Set E2) by simp)]
  refine ⟨Q -ᵥ P, fun S hS => ?_⟩
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hS
  rcases hS with hSe | hSe | hSe
  · exact ⟨0, by rw [hSe]; simp⟩
  · exact ⟨1, by rw [hSe]; simp⟩
  · rw [hSe]
    by_cases h0 : Q 0 - P 0 ≠ 0
    · refine ⟨(R 0 - P 0) / (Q 0 - P 0), coord_ext ?_ ?_⟩
      · rw [show (((R 0 - P 0) / (Q 0 - P 0)) • (Q -ᵥ P) +ᵥ P) 0
            = (R 0 - P 0) / (Q 0 - P 0) * (Q 0 - P 0) + P 0 by simp [smul_eq_mul]]
        field_simp [h0]
        ring
      · rw [show (((R 0 - P 0) / (Q 0 - P 0)) • (Q -ᵥ P) +ᵥ P) 1
            = (R 0 - P 0) / (Q 0 - P 0) * (Q 1 - P 1) + P 1 by simp [smul_eq_mul]]
        have h' : (Q 0 - P 0) * (R 1 - P 1) = (Q 1 - P 1) * (R 0 - P 0) := by
          linear_combination h
        field_simp [h0]
        linear_combination h'
    · push Not at h0
      have h1 : Q 1 - P 1 ≠ 0 := by
        intro h1
        apply hPQ
        exact coord_ext (by linarith) (by linarith)
      rw [h0, zero_mul] at h
      have hR0 : R 0 = P 0 := by
        have e : (Q 1 - P 1) * (R 0 - P 0) = 0 := by linarith
        have := mul_eq_zero.mp e
        rcases this with h' | h'
        · exact absurd h' h1
        · linarith
      refine ⟨(R 1 - P 1) / (Q 1 - P 1), coord_ext ?_ ?_⟩
      · rw [show (((R 1 - P 1) / (Q 1 - P 1)) • (Q -ᵥ P) +ᵥ P) 0
            = (R 1 - P 1) / (Q 1 - P 1) * (Q 0 - P 0) + P 0 by simp [smul_eq_mul]]
        rw [h0, mul_zero, zero_add]
        exact hR0
      · rw [show (((R 1 - P 1) / (Q 1 - P 1)) • (Q -ᵥ P) +ᵥ P) 1
            = (R 1 - P 1) / (Q 1 - P 1) * (Q 1 - P 1) + P 1 by simp [smul_eq_mul]]
        field_simp [h1]
        ring

/-- Nonvanishing of the cross product for non-collinear points. -/
lemma cross_ne_zero_of_not_collinear {P Q R : E2} (h : ¬Collinear ℝ {P, Q, R}) :
    (Q 0 - P 0) * (R 1 - P 1) - (Q 1 - P 1) * (R 0 - P 0) ≠ 0 := by
  intro hc
  exact h (collinear_of_cross_eq_zero hc)

/-- Parametric form of a point on the line through two points:
`R = P + s • (Q - P)` on coordinates. -/
lemma exists_param_of_mem_line {P Q R : E2} (h : R ∈ line[ℝ, P, Q]) :
    ∃ s : ℝ, R 0 = P 0 + s * (Q 0 - P 0) ∧ R 1 = P 1 + s * (Q 1 - P 1) := by
  rw [mem_affineSpan_pair_iff_exists_lineMap_eq] at h
  obtain ⟨t, ht⟩ := h
  have e0 : (t • (Q -ᵥ P) +ᵥ P : E2) 0 = t * (Q 0 - P 0) + P 0 := by simp [smul_eq_mul]
  have e1 : (t • (Q -ᵥ P) +ᵥ P : E2) 1 = t * (Q 1 - P 1) + P 1 := by simp [smul_eq_mul]
  refine ⟨t, ?_, ?_⟩
  · rw [← ht, AffineMap.lineMap_apply, e0]
    ring
  · rw [← ht, AffineMap.lineMap_apply, e1]
    ring

/-- A sum of two squares vanishes only when both vanish (used for nondegeneracy). -/
lemma sq_sum_ne_zero_of_ne {P Q : E2} (h : P ≠ Q) :
    (P 0 - Q 0) ^ 2 + (P 1 - Q 1) ^ 2 ≠ 0 := by
  intro hz
  apply h
  have h0 : (P 0 - Q 0) ^ 2 = 0 := by
    nlinarith [sq_nonneg (P 0 - Q 0), sq_nonneg (P 1 - Q 1)]
  have h1 : (P 1 - Q 1) ^ 2 = 0 := by
    nlinarith [sq_nonneg (P 0 - Q 0), sq_nonneg (P 1 - Q 1)]
  have e0 := sq_eq_zero_iff.mp h0
  have e1 := sq_eq_zero_iff.mp h1
  exact coord_ext (by linarith) (by linarith)

/-- Three points on the y-axis are collinear. -/
lemma collinear_of_coord_zero {P Q R : E2} (hP : P 0 = 0) (hQ : Q 0 = 0) (hR : R 0 = 0) :
    Collinear ℝ {P, Q, R} := by
  rw [collinear_iff_of_mem (show P ∈ ({P, Q, R} : Set E2) by simp)]
  refine ⟨!₂[(0 : ℝ), (1 : ℝ)], fun S hS => ?_⟩
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hS
  rcases hS with hSe | hSe | hSe
  · exact ⟨0, by rw [hSe]; simp⟩
  · refine ⟨Q 1 - P 1, ?_⟩
    rw [hSe]
    apply coord_ext
    · rw [show ((Q 1 - P 1) • (!₂[(0 : ℝ), (1 : ℝ)] : E2) +ᵥ P) 0
          = (Q 1 - P 1) * 0 + P 0 by simp [smul_eq_mul]]
      rw [hQ, hP, mul_zero, zero_add]
    · rw [show ((Q 1 - P 1) • (!₂[(0 : ℝ), (1 : ℝ)] : E2) +ᵥ P) 1
          = (Q 1 - P 1) * 1 + P 1 by simp [smul_eq_mul]]
      ring
  · refine ⟨R 1 - P 1, ?_⟩
    rw [hSe]
    apply coord_ext
    · rw [show ((R 1 - P 1) • (!₂[(0 : ℝ), (1 : ℝ)] : E2) +ᵥ P) 0
          = (R 1 - P 1) * 0 + P 0 by simp [smul_eq_mul]]
      rw [hR, hP, mul_zero, zero_add]
    · rw [show ((R 1 - P 1) • (!₂[(0 : ℝ), (1 : ℝ)] : E2) +ᵥ P) 1
          = (R 1 - P 1) * 1 + P 1 by simp [smul_eq_mul]]
      ring

/-- Three points on the x-axis are collinear. -/
lemma collinear_of_coord_one_zero {P Q R : E2} (hP : P 1 = 0) (hQ : Q 1 = 0)
    (hR : R 1 = 0) : Collinear ℝ {P, Q, R} := by
  rw [collinear_iff_of_mem (show P ∈ ({P, Q, R} : Set E2) by simp)]
  refine ⟨!₂[(1 : ℝ), (0 : ℝ)], fun S hS => ?_⟩
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hS
  rcases hS with hSe | hSe | hSe
  · exact ⟨0, by rw [hSe]; simp⟩
  · refine ⟨Q 0 - P 0, ?_⟩
    rw [hSe]
    apply coord_ext
    · rw [show ((Q 0 - P 0) • (!₂[(1 : ℝ), (0 : ℝ)] : E2) +ᵥ P) 0
          = (Q 0 - P 0) * 1 + P 0 by simp [smul_eq_mul]]
      ring
    · rw [show ((Q 0 - P 0) • (!₂[(1 : ℝ), (0 : ℝ)] : E2) +ᵥ P) 1
          = (Q 0 - P 0) * 0 + P 1 by simp [smul_eq_mul]]
      rw [hQ, hP, mul_zero, zero_add]
  · refine ⟨R 0 - P 0, ?_⟩
    rw [hSe]
    apply coord_ext
    · rw [show ((R 0 - P 0) • (!₂[(1 : ℝ), (0 : ℝ)] : E2) +ᵥ P) 0
          = (R 0 - P 0) * 1 + P 0 by simp [smul_eq_mul]]
      ring
    · rw [show ((R 0 - P 0) • (!₂[(1 : ℝ), (0 : ℝ)] : E2) +ᵥ P) 1
          = (R 0 - P 0) * 0 + P 1 by simp [smul_eq_mul]]
      rw [hR, hP, mul_zero, zero_add]

/-- If `P` is not on line `FG`, its second coordinate is nonzero. -/
lemma coord_one_ne_zero_of_not_collinear {P : E2} (h : ¬Collinear ℝ {F, G, P}) :
    P 1 ≠ 0 := by
  intro hP1
  apply h
  apply collinear_of_coord_one_zero
  · simp
  · simp
  · exact hP1

/-- The concyclicity determinant of three points together with F = (-1, 0):
it vanishes iff the four points are concyclic or collinear. -/
abbrev cycPolyF (P Q R : E2) : ℝ :=
  Matrix.det !![P 0 + 1, P 1, P 0 ^ 2 + P 1 ^ 2 - 1;
               Q 0 + 1, Q 1, Q 0 ^ 2 + Q 1 ^ 2 - 1;
               R 0 + 1, R 1, R 0 ^ 2 + R 1 ^ 2 - 1]

/-- The concyclicity determinant of three points together with G = (1, 0). -/
abbrev cycPolyG (P Q R : E2) : ℝ :=
  Matrix.det !![P 0 - 1, P 1, P 0 ^ 2 + P 1 ^ 2 - 1;
               Q 0 - 1, Q 1, Q 0 ^ 2 + Q 1 ^ 2 - 1;
               R 0 - 1, R 1, R 0 ^ 2 + R 1 ^ 2 - 1]

/-- Four cospherical points, one of them being F = (-1, 0), satisfy the
concyclicity determinant equation. -/
lemma cycPolyF_eq_zero_of_cospherical {P Q R : E2} (h : Cospherical {P, Q, R, F}) :
    cycPolyF P Q R = 0 := by
  rw [cospherical_def] at h
  obtain ⟨c, rad, h⟩ := h
  have hP := sq_of_dist_eq (h P (by simp))
  have hQ := sq_of_dist_eq (h Q (by simp))
  have hR := sq_of_dist_eq (h R (by simp))
  have hF := sq_of_dist_eq (h F (by simp))
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at hF
  show Matrix.det _ = 0
  rw [Matrix.det_fin_three]
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.tail_cons,
    Matrix.of_apply, Matrix.cons_val_two]
  linear_combination
    ((Q 0 + 1) * R 1 - Q 1 * (R 0 + 1)) * hP +
    (P 1 * (R 0 + 1) - (P 0 + 1) * R 1) * hQ +
    ((P 0 + 1) * Q 1 - P 1 * (Q 0 + 1)) * hR -
    (((Q 0 + 1) * R 1 - Q 1 * (R 0 + 1)) + (P 1 * (R 0 + 1) - (P 0 + 1) * R 1) +
     ((P 0 + 1) * Q 1 - P 1 * (Q 0 + 1))) * hF

/-- Four cospherical points, one of them being G = (1, 0), satisfy the
concyclicity determinant equation. -/
lemma cycPolyG_eq_zero_of_cospherical {P Q R : E2} (h : Cospherical {P, Q, R, G}) :
    cycPolyG P Q R = 0 := by
  rw [cospherical_def] at h
  obtain ⟨c, rad, h⟩ := h
  have hP := sq_of_dist_eq (h P (by simp))
  have hQ := sq_of_dist_eq (h Q (by simp))
  have hR := sq_of_dist_eq (h R (by simp))
  have hG := sq_of_dist_eq (h G (by simp))
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at hG
  show Matrix.det _ = 0
  rw [Matrix.det_fin_three]
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.tail_cons,
    Matrix.of_apply, Matrix.cons_val_two]
  linear_combination
    ((Q 0 - 1) * R 1 - Q 1 * (R 0 - 1)) * hP +
    (P 1 * (R 0 - 1) - (P 0 - 1) * R 1) * hQ +
    ((P 0 - 1) * Q 1 - P 1 * (Q 0 - 1)) * hR -
    (((Q 0 - 1) * R 1 - Q 1 * (R 0 - 1)) + (P 1 * (R 0 - 1) - (P 0 - 1) * R 1) +
     ((P 0 - 1) * Q 1 - P 1 * (Q 0 - 1))) * hG

snip end

set_option maxHeartbeats 40000000 in
set_option maxRecDepth 32000 in
