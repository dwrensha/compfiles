        unfold area2
        rw [show v 2 - v 1 = (v 2 - v 0) + (v 0 - v 1) from by ext <;> simp <;> ring,
          det2_add_right, show v 0 - v 1 = -(v 1 - v 0) from by ext <;> simp <;> ring,
          det2_neg_right, det2_self, neg_zero, add_zero]
      rw [h2]
      exact hv 0 1 2 (Or.inl ⟨hlt01, hlt12⟩)
    have hd2 : 0 < det2 (edge v 1) (-(v 2 - v 0)) := by
      rw [det2_neg_right]
      have h1 : det2 (edge v 1) (v 2 - v 0) = - det2 (v 2 - v 0) (edge v 1) := by
        show (edge v 1).1 * (v 2 - v 0).2 - (edge v 1).2 * (v 2 - v 0).1 =
          -((v 2 - v 0).1 * (edge v 1).2 - (v 2 - v 0).2 * (edge v 1).1)
        ring
      rw [h1]
      have h2 : 0 < det2 (v 2 - v 0) (edge v 1) := (det2_pos_iff_turnAng _ _ hw_nz
        (edge_ne_zero_of_convex v hv (by omega) 1)).mpr hA2
      linarith [h2]
    have hd3 : 0 < det2 (-(v 2 - v 0)) (edge v 0) := by
      rw [det2_neg_left]
      have h1 : det2 (v 2 - v 0) (edge v 0) = - det2 (edge v 0) (v 2 - v 0) := by
        show (v 2 - v 0).1 * (edge v 0).2 - (v 2 - v 0).2 * (edge v 0).1 =
          -((edge v 0).1 * (v 2 - v 0).2 - (edge v 0).2 * (v 2 - v 0).1)
        ring
      rw [h1]
      have h2 : 0 < det2 (edge v 0) (v 2 - v 0) := (det2_pos_iff_turnAng _ _
        (edge_ne_zero_of_convex v hv (by omega) 0) hw_nz).mpr hA0
      linarith [h2]
    have htri := turn_sum_triangle (edge v 0) (edge v 1) (-(v 2 - v 0)) hd1 hd2 hd3
    have hrev1 : turnAng (edge v 1) (v 2 - v 0) = 2 * Real.pi - turnAng (v 2 - v 0) (edge v 1) := by
      have h1 := turnAng_add_reverse (edge v 1) (v 2 - v 0)
      rcases h1 with h | ⟨h, h2⟩
      · linarith [h]
      · exfalso
        exact absurd h2 (ne_of_gt hA2.1)
    have hrev2 : turnAng (v 2 - v 0) (edge v 0) = 2 * Real.pi - turnAng (edge v 0) (v 2 - v 0) := by
      have h1 := turnAng_add_reverse (v 2 - v 0) (edge v 0)
      rcases h1 with h | ⟨h, h2⟩
      · linarith [h]
      · exfalso
        exact absurd h2 (ne_of_gt hA0.1)
    have hn1 : turnAng (edge v 1) (-(v 2 - v 0)) = Real.pi - turnAng (v 2 - v 0) (edge v 1) := by
      have h1 := turnAng_neg_right (edge v 1) (v 2 - v 0) hw_nz
      have h2 := turnAng_lt_two_pi (edge v 1) (-(v 2 - v 0))
      rcases h1 with h | h
      · exfalso
        linarith [h, hrev1, hA2.2, h2]
      · linarith [h, hrev1]
    have hn2 : turnAng (-(v 2 - v 0)) (edge v 0) = Real.pi - turnAng (edge v 0) (v 2 - v 0) := by
      have h1 := turnAng_neg_left (v 2 - v 0) (edge v 0) hw_nz
      have h2 := turnAng_lt_two_pi (-(v 2 - v 0)) (edge v 0)
      rcases h1 with h | h
      · linarith [h, hrev2]
      · exfalso
        linarith [h, hrev2, hA0.2, h2]
    linarith [htri, hn1, hn2]
  -- assemble
  rw [hT', hT, hmid, he'0, he'1, he'n1, he2v, hR1, hR2, hR3]
  ring
/-- The `ℕ`-indexed edge vector (cyclically). -/
noncomputable def edgeN {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ) (l : ℕ) : ℝ × ℝ :=
  edge v ⟨l % n, Nat.mod_lt l (NeZero.pos n)⟩

/-- The `ℕ`-indexed turning angle (cyclically). -/
noncomputable def turnN {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ) (l : ℕ) : ℝ :=
  turnAng (edgeN v l) (edgeN v (l + 1))

/-- The lift of edge directions for a convex polygon. -/
noncomputable def liftTheta {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ) (k : ℕ) : ℝ :=
  dirAng (edge v 0) + ∑ l ∈ Finset.range k, turnN v l

theorem edgeN_period {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ) (l : ℕ) :
    edgeN v (l + n) = edgeN v l := by
  unfold edgeN
  have h1 : (⟨(l + n) % n, Nat.mod_lt _ (NeZero.pos n)⟩ : Fin n) =
      ⟨l % n, Nat.mod_lt l (NeZero.pos n)⟩ := by
    apply Fin.ext
    simp [Nat.add_mod_right]
  rw [h1]

theorem turnN_period {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ) (l : ℕ) :
    turnN v (l + n) = turnN v l := by
  unfold turnN
  rw [show l + n + 1 = l + 1 + n from by ring, edgeN_period v l, edgeN_period v (l + 1)]

theorem edgeN_zero {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ) : edgeN v 0 = edge v 0 := by
  unfold edgeN
  have h1 : (⟨0 % n, Nat.mod_lt _ (NeZero.pos n)⟩ : Fin n) = 0 := by
    apply Fin.ext
    simp
  rw [h1]

theorem edgeN_of_lt {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ) {l : ℕ} (hl : l < n) :
    edgeN v l = edge v ⟨l, hl⟩ := by
  unfold edgeN
  have h1 : (⟨l % n, Nat.mod_lt _ (NeZero.pos n)⟩ : Fin n) = ⟨l, hl⟩ := by
    apply Fin.ext
    simp [Nat.mod_eq_of_lt hl]
  rw [h1]

theorem edgeN_succ_val {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ) (i : Fin n) :
    edgeN v (i.val + 1) = edge v (i + 1) := by
  have hnn : 0 < n := NeZero.pos n
  have h1 : (⟨(i.val + 1) % n, Nat.mod_lt _ hnn⟩ : Fin n) = i + 1 := by
    apply Fin.ext
    have h2 : (i + 1 : Fin n).val = (i.val + 1 % n) % n := by
      rw [Fin.val_add]
      rfl
    rw [h2, Nat.add_mod_mod]
  unfold edgeN
  rw [h1]

theorem turnN_pos {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ) (hv : IsConvexPolygon v)
    (hn3 : 3 ≤ n) (l : ℕ) :
    0 < turnN v l ∧ turnN v l < Real.pi := by
  have h1 : turnN v l = turnAng (edge v ⟨l % n, Nat.mod_lt l (NeZero.pos n)⟩)
      (edge v (⟨l % n, Nat.mod_lt l (NeZero.pos n)⟩ + 1)) := by
    unfold turnN edgeN
    have h2 : (⟨(l + 1) % n, Nat.mod_lt _ (NeZero.pos n)⟩ : Fin n) =
        (⟨l % n, Nat.mod_lt l (NeZero.pos n)⟩ : Fin n) + 1 := by
      apply Fin.ext
      have h3 : ((⟨l % n, Nat.mod_lt l (NeZero.pos n)⟩ : Fin n) + 1).val =
          (l % n + 1 % n) % n := by
        rw [Fin.val_add]
        rfl
      rw [h3]
      show (l + 1) % n = (l % n + 1 % n) % n
      rw [Nat.add_mod]
    rw [h2]
  rw [h1]
  exact turnAng_edge_pos_of_convex v hv hn3 _

/-- The total turning angle of a strictly convex polygon is `2π`, by ear
induction. -/
theorem turn_sum_eq_two_pi : ∀ {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ),
    IsConvexPolygon v → 3 ≤ n →
    ∑ j : Fin n, turnAng (edge v j) (edge v (j + 1)) = 2 * Real.pi := by
  have key : ∀ (n : ℕ) (h : 3 ≤ n) [NeZero n] (v : Fin n → ℝ × ℝ),
      IsConvexPolygon v → ∑ j : Fin n, turnAng (edge v j) (edge v (j + 1)) = 2 * Real.pi := by
    intro n hn
    induction n, hn using Nat.le_induction with
    | base =>
      intro _ v hv
      -- the triangle case
      have hd0 : 0 < det2 (edge v 0) (edge v 1) :=
        (det2_pos_iff_turnAng _ _ (edge_ne_zero_of_convex v hv (by omega) 0)
          (edge_ne_zero_of_convex v hv (by omega) 1)).mpr
          (turnAng_edge_pos_of_convex v hv (by omega) 0)
      have hd1 : 0 < det2 (edge v 1) (edge v 2) :=
        (det2_pos_iff_turnAng _ _ (edge_ne_zero_of_convex v hv (by omega) 1)
          (edge_ne_zero_of_convex v hv (by omega) 2)).mpr
          (turnAng_edge_pos_of_convex v hv (by omega) 1)
      have hd2 : 0 < det2 (edge v 2) (edge v 0) := by
        have h1 : (2 : Fin 3) + 1 = (0 : Fin 3) := by
          apply Fin.ext
          have h2 : ((2 : Fin 3) + 1).val = (2 + 1 % 3) % 3 := by
            rw [Fin.val_add]
            rfl
          rw [h2]
          have h3 : 1 % 3 = 1 := by norm_num
          rw [h3]
          decide
        have h4 : det2 (edge v 2) (edge v 0) = det2 (edge v 2) (edge v ((2 : Fin 3) + 1)) := by
          rw [h1]
        rw [h4]
        exact (det2_pos_iff_turnAng _ _ (edge_ne_zero_of_convex v hv (by omega) 2)
          (edge_ne_zero_of_convex v hv (by omega) ((2 : Fin 3) + 1))).mpr
          (turnAng_edge_pos_of_convex v hv (by omega) 2)
      have hsum : ∑ j : Fin 3, turnAng (edge v j) (edge v (j + 1)) =
          turnAng (edge v 0) (edge v 1) + turnAng (edge v 1) (edge v 2) +
            turnAng (edge v 2) (edge v 0) := by
        have h1 : (2 : Fin 3) + 1 = (0 : Fin 3) := by
          apply Fin.ext
          have h2 : ((2 : Fin 3) + 1).val = (2 + 1 % 3) % 3 := by
            rw [Fin.val_add]
            rfl
          rw [h2]
          have h3 : 1 % 3 = 1 := by norm_num
          rw [h3]
          decide
        have h01 : (0 : Fin 3) + 1 = (1 : Fin 3) := by decide
        have h12 : (1 : Fin 3) + 1 = (2 : Fin 3) := by decide
        have h2 : (univ : Finset (Fin 3)) = {0, 1, 2} := by
          ext j
          simp only [Finset.mem_univ, Finset.mem_insert, Finset.mem_singleton]
          constructor
          · intro _
            have h3 := j.isLt
            have h4 : j.val = 0 ∨ j.val = 1 ∨ j.val = 2 := by omega
            rcases h4 with h4 | h4 | h4
            · exact Or.inl (Fin.ext h4)
            · exact Or.inr (Or.inl (Fin.ext h4))
            · exact Or.inr (Or.inr (Fin.ext h4))
          · intro _
            trivial
        rw [h2, Finset.sum_insert (by simp), Finset.sum_insert (by simp), Finset.sum_singleton,
          h1, h01, h12, add_assoc]
      rw [hsum]
      exact turn_sum_triangle (edge v 0) (edge v 1) (edge v 2) hd0 hd1 hd2
    | succ n hn ih =>
      intro _ v hv
      haveI : NeZero n := ⟨by omega⟩
      have hcv : IsConvexPolygon (v ∘ Fin.succAbove (⟨1, by omega⟩ : Fin (n + 1))) :=
        IsConvexPolygon_clip1 v hv hn
      have hih := ih _ hcv
      have hclip := turn_sum_clip v hv hn
      rw [hih] at hclip
      exact hclip.symm
  intro n _ v hv hn3
  exact key n hn3 v hv

theorem turnN_sum {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ) (hv : IsConvexPolygon v)
    (hn3 : 3 ≤ n) : ∑ l ∈ Finset.range n, turnN v l = 2 * Real.pi := by
  have h1 : ∑ i : Fin n, turnAng (edge v i) (edge v (i + 1)) = 2 * Real.pi :=
    turn_sum_eq_two_pi v hv hn3
  rw [← h1]
  rw [← Fin.sum_univ_eq_sum_range (turnN v) n]
  apply Finset.sum_congr rfl
  intro i _
  unfold turnN
  rw [edgeN_of_lt v i.isLt, edgeN_succ_val v]

theorem turnN_sum_shift {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ) :
    ∀ k : ℕ, ∑ l ∈ Finset.range n, turnN v (k + l) = ∑ l ∈ Finset.range n, turnN v l := by
  intro k
  induction k with
  | zero => simp
  | succ k ih =>
    have h1 : ∑ l ∈ Finset.range n, turnN v (k + 1 + l) =
        ∑ l ∈ Finset.range n, turnN v (k + l + 1) := by
      apply Finset.sum_congr rfl
      intro l _
      ring_nf
    rw [h1]
    have h2 : ∑ l ∈ Finset.range n, turnN v (k + l + 1) =
        ∑ l ∈ Finset.range n, turnN v (k + l) + turnN v (k + n) - turnN v k := by
      have h3 : ∑ l ∈ Finset.range (n + 1), turnN v (k + l) =
          turnN v k + ∑ l ∈ Finset.range n, turnN v (k + l + 1) := by
        rw [Finset.sum_range_succ', add_zero, add_comm (turnN v k)]
        congr 1
      have h4 : ∑ l ∈ Finset.range (n + 1), turnN v (k + l) =
          ∑ l ∈ Finset.range n, turnN v (k + l) + turnN v (k + n) :=
        Finset.sum_range_succ _ n
      rw [h4] at h3
      linarith [h3]
    rw [h2, turnN_period v k, ih]
    simp

/-- The lift of a convex polygon's edge directions. -/
theorem edgeLift_of_convex {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ)
    (hv : IsConvexPolygon v) (hn3 : 3 ≤ n) : Nonempty (EdgeLift (edge v)) := by
  have hnn : 0 < n := NeZero.pos n
  have hT := turnN_sum v hv hn3
  have hperiod : ∀ k : ℕ, liftTheta v (k + n) = liftTheta v k + 2 * Real.pi := by
    intro k
    unfold liftTheta
    have h2 : ∑ l ∈ Finset.range (k + n), turnN v l =
        ∑ l ∈ Finset.range k, turnN v l + 2 * Real.pi := by
      rw [← Finset.sum_range_add_sum_Ico (turnN v) (Nat.le_add_right k n),
        Finset.sum_Ico_eq_sum_range (turnN v) k (k + n), Nat.add_sub_cancel_left,
        turnN_sum_shift v k, hT]
    linarith [h2]
  have hstep : ∀ k : ℕ, liftTheta v (k + 1) - liftTheta v k = turnN v k := by
    intro k
    unfold liftTheta
    rw [Finset.sum_range_succ]
    ring
  have hcons : ∀ l : ℕ, ∃ m : ℤ, liftTheta v l = dirAng (edgeN v l) + 2 * Real.pi * (m : ℝ) := by
    intro l
    induction l with
    | zero =>
      refine ⟨0, by
        unfold liftTheta
        rw [edgeN_zero]
        simp⟩
    | succ l ih =>
      obtain ⟨m, hm⟩ := ih
      obtain ⟨k, hk⟩ := turnAng_mod_eq (edgeN v l) (edgeN v (l + 1))
      have hstep1 : liftTheta v (l + 1) = liftTheta v l + turnN v l := by
        unfold liftTheta
        rw [Finset.sum_range_succ]
        ring
      refine ⟨m + k, by
        rw [hstep1, hm]
        unfold turnN
        push_cast
        linarith [hk]⟩
  refine ⟨{ Θ := liftTheta v
            period := hperiod
            step_nonneg := ?_
            step_le := ?_
            cons := ?_ }⟩
  · intro k
    rw [hstep]
    exact (turnN_pos v hv hn3 k).1.le
  · intro k
    rw [hstep]
    exact (turnN_pos v hv hn3 k).2.le
  · intro i _
    obtain ⟨m, hm⟩ := hcons i.val
    have h1 : edgeN v i.val = edge v i := by
      have h2 := edgeN_of_lt v i.isLt
      rw [h2]
    refine ⟨m, by
      rw [h1] at hm
      exact hm⟩

/-- The defect is nonnegative for every closed edge sequence admitting a
lift: strong induction on the measure `MES`, dispatching to the three
reduction operations of the official solution. -/
theorem FES_nonneg_of_closed_lift : ∀ (M : ℕ) {n : ℕ} [NeZero n] (e : Fin n → ℝ × ℝ),
    MES e = M → ESClosed e → Nonempty (EdgeLift e) → 0 ≤ FES e := by
  intro M
  induction M using Nat.strong_induction_on with
  | _ M ih =>
    intro n _ e hm hclosed hlift
    rcases n with _ | m
    · exact absurd (NeZero.pos 0) (Nat.lt_irrefl 0)
    obtain ⟨L⟩ := hlift
    have hcard_le : esEll e ≤ m + 1 := by
      have h3 : esEll e = ((univ.filter fun i : Fin (m + 1) => e i ≠ 0).image
          fun i => lineKey (e i)).card := rfl
      rw [h3]
      apply le_trans Finset.card_image_le
      have h2 := Finset.card_filter_le univ (fun i : Fin (m + 1) => e i ≠ 0)
      rw [Finset.card_univ, Fintype.card_fin] at h2
      exact h2
    by_cases hell : esEll e ≤ 1
    · -- base case: at most one direction line, so all determinants vanish
      have hdet0 : ∀ i j : Fin (m + 1), det2 (e i) (e j) = 0 := by
        intro i j
        by_cases hi : e i = 0
        · rw [hi, det2_zero_left]
        · by_cases hj : e j = 0
          · rw [hj, det2_zero_right]
          · have h1 : lineKey (e i) = lineKey (e j) := by
              have hcard := Finset.card_le_one.mp hell
              exact hcard _ (Finset.mem_image.mpr
                ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi⟩, rfl⟩) _
                (Finset.mem_image.mpr ⟨j, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hj⟩, rfl⟩)
            exact (lineKey_eq_iff _ _ hi hj).mp h1
      have hG : GES e = 0 := by
        apply Finset.sum_eq_zero
        intro i _
        apply Finset.sum_eq_zero
        intro j _
        by_cases h : i.val < j.val <;> simp [h, hdet0 i j]
      have hS : SES e = 0 := by
        apply Finset.sum_eq_zero
        intro i _
        apply Finset.sum_eq_zero
        intro j _
        by_cases h : i.val < j.val <;> simp [h, hdet0 i j]
      show 0 ≤ GES e - 2 * SES e
      rw [hG, hS]
      norm_num
    · push_neg at hell
      replace hell : 2 ≤ esEll e := hell
      by_cases hz : ∃ z : Fin (m + 1), e z = 0
      · -- operation of type B0: delete the zero edge
        obtain ⟨z, hz⟩ := hz
        haveI : NeZero m := ⟨by omega⟩
        obtain ⟨e', hcl', hli', hF', hNu', hEl'⟩ := FES_eq_of_remove_zero e L hclosed hell z hz
        have hlt : MES e' < M := by
          rw [← hm]
          have hA : MES e' = esEll e' * (m + 1) + esNu e' := rfl
          have hB : MES e = esEll e * (m + 2) + esNu e := rfl
          have hC : esEll e * (m + 2) = esEll e * (m + 1) + esEll e := by ring
          rw [hA, hB, hEl', hNu', hC]
          omega
        have hres := ih (MES e') hlt e' rfl hcl' hli'
        rw [← hF']
        exact hres
      · have hzz : ∀ i : Fin (m + 1), e i ≠ 0 := by
          intro i hcon
          exact hz ⟨i, hcon⟩
        by_cases hpar : ∃ i j : Fin (m + 1), i.val < j.val ∧ det2 (e i) (e j) = 0
        · obtain ⟨i, j, hilt, hdet⟩ := hpar
          have hij : i ≠ j := by
            intro hcon
            rw [hcon] at hilt
            exact lt_irrefl _ hilt
          by_cases hdot : 0 < dott (e i) (e j)
          · -- operation B1: merge a same-direction pair
            obtain ⟨e', hcl', hli', hF', hNu', hEl'⟩ :=
              FES_eq_of_merge_same e L hclosed hij hilt (hzz i) (hzz j) hdet hdot
            have hlt : MES e' < M := by
              rw [← hm]
              have hA : MES e' = esEll e' * (m + 2) + esNu e' := rfl
              have hB : MES e = esEll e * (m + 2) + esNu e := rfl
              have hC : esEll e' * (m + 2) ≤ esEll e * (m + 2) := Nat.mul_le_mul_right _ hEl'
              rw [hA, hB]
              omega
            have hres := ih (MES e') hlt e' rfl hcl' hli'
            rw [← hF']
            exact hres
          · -- operation A: remove the shorter of an antiparallel pair
            have hdot2 : dott (e i) (e j) < 0 := by
              rcases lt_trichotomy (dott (e i) (e j)) 0 with h | h | h
              · exact h
              · exfalso
                have hkey : ((e i).1 ^ 2 + (e i).2 ^ 2) * ((e j).1 ^ 2 + (e j).2 ^ 2) =
                    det2 (e i) (e j) ^ 2 + dott (e i) (e j) ^ 2 := by
                  simp [det2, dott]
                  ring
                rw [hdet, h] at hkey
                simp at hkey
                rcases hkey with hkey | hkey
                · have h1 := (add_eq_zero_iff_of_nonneg (sq_nonneg (e i).1)
                    (sq_nonneg (e i).2)).mp hkey
                  exact hzz i (Prod.ext (sq_eq_zero_iff.mp h1.1) (sq_eq_zero_iff.mp h1.2))
                · have h1 := (add_eq_zero_iff_of_nonneg (sq_nonneg (e j).1)
                    (sq_nonneg (e j).2)).mp hkey
                  exact hzz j (Prod.ext (sq_eq_zero_iff.mp h1.1) (sq_eq_zero_iff.mp h1.2))
              · exact absurd h hdot
            by_cases hlen : nrm (e i) ≤ nrm (e j)
            · obtain ⟨e', hcl', hli', hF', hNu', hEl'⟩ :=
                FES_eq_of_opA_remove_earlier e L hclosed hij hilt (hzz i) (hzz j) hdet hdot2 hlen
              have hlt : MES e' < M := by
                rw [← hm]
                have hA : MES e' = esEll e' * (m + 2) + esNu e' := rfl
                have hB : MES e = esEll e * (m + 2) + esNu e := rfl
                have hC : esEll e' * (m + 2) ≤ esEll e * (m + 2) := Nat.mul_le_mul_right _ hEl'
                rw [hA, hB]
                omega
              have hres := ih (MES e') hlt e' rfl hcl' hli'
              rw [← hF']
              exact hres
            · push_neg at hlen
              obtain ⟨e', hcl', hli', hF', hNu', hEl'⟩ :=
                FES_eq_of_opA_remove_later e L hclosed hij hilt (hzz i) (hzz j) hdet hdot2
                  (le_of_lt hlen)
              have hlt : MES e' < M := by
                rw [← hm]
                have hA : MES e' = esEll e' * (m + 2) + esNu e' := rfl
                have hB : MES e = esEll e * (m + 2) + esNu e := rfl
                have hC : esEll e' * (m + 2) ≤ esEll e * (m + 2) := Nat.mul_le_mul_right _ hEl'
                rw [hA, hB]
                omega
              have hres := ih (MES e') hlt e' rfl hcl' hli'
              rw [← hF']
              exact hres
        · -- operation B: no parallel pairs, split a well-chosen edge
          have hdist : ∀ i j : Fin (m + 1), e i ≠ 0 → e j ≠ 0 → det2 (e i) (e j) = 0 →
              i = j := by
            intro i j _ _ hdet
            by_contra hne
            rcases lt_trichotomy i.val j.val with h | h | h
            · exact hpar ⟨i, j, h, hdet⟩
            · exact hne (Fin.ext h)
            · exact hpar ⟨j, i, h, by
                have h1 : det2 (e j) (e i) = - det2 (e i) (e j) := by
                  show (e j).1 * (e i).2 - (e j).2 * (e i).1 =
                    -((e i).1 * (e j).2 - (e i).2 * (e j).1)
                  ring
                rw [h1, hdet, neg_zero]⟩
          have hn3 : 3 ≤ m + 1 := by
            by_contra hcon
            push_neg at hcon
            have h12 : m + 1 = 1 ∨ m + 1 = 2 := by omega
            rcases h12 with hm1 | hm1
            · have hm0 : m = 0 := by omega
              subst hm0
              have h0 : (∑ i : Fin (0 + 1), e i) = 0 := hclosed
              have h0' : (∑ i : Fin 1, e i) = 0 := h0
              rw [Fin.sum_univ_one] at h0'
              have h0'' : e (0 : Fin (0 + 1)) = 0 := h0'
              exact hzz 0 h0'' 
            · have hm1' : m = 1 := by omega
              subst hm1'
              have h0 : (∑ i : Fin (1 + 1), e i) = 0 := hclosed
              have h0' : (∑ i : Fin 2, e i) = 0 := h0
              rw [Fin.sum_univ_two] at h0'
              have h0'' : e (0 : Fin (1 + 1)) + e (1 : Fin (1 + 1)) = 0 := h0'
              have h1 : e (1 : Fin (1 + 1)) = - e (0 : Fin (1 + 1)) := by
                rw [add_comm] at h0''
                exact eq_neg_of_add_eq_zero_left h0''
              have h2 : det2 (e (0 : Fin (1 + 1))) (e (1 : Fin (1 + 1))) = 0 := by
                rw [h1, det2_neg_right, det2_self, neg_zero]
              exact hpar ⟨0, 1, by simp, h2⟩
          obtain ⟨e', hcl', hli', hF', hEl', hNu'⟩ := FES_lt_of_opB_split e L hclosed hdist hzz hn3
          have hlt : MES e' < M := by
            rw [← hm]
            have hA : MES e' = esEll e' * (m + 3) + esNu e' := rfl
            have hA2 : esEll e' * (m + 3) = esEll e' * (m + 2) + esEll e' := by ring
            have hB : MES e = esEll e * (m + 2) + esNu e := rfl
            have hC : esEll e' * (m + 2) + (m + 2) = esEll e * (m + 2) := by
              rw [← Nat.add_one_mul, hEl']
            rw [hA, hB, hA2]
            omega
          have hres := ih (MES e') hlt e' rfl hcl' hli'
          linarith [hres, hF']

/-- The defect is nonnegative for every closed edge sequence admitting a
lift. -/
theorem FES_nonneg_of_closed_lift' {n : ℕ} [NeZero n] (e : Fin n → ℝ × ℝ)
    (hclosed : ESClosed e) (hlift : Nonempty (EdgeLift e)) : 0 ≤ FES e :=
  FES_nonneg_of_closed_lift (MES e) e rfl hclosed hlift

/-- Key lemma 2 (`[Q] ≥ 4 [P]`, the zonotope/difference-body inequality):
`2 * polyArea2 v ≤ zonoArea v`, i.e.
`∑_{i<j} |det2 (e i) (e j)| ≥ 2 ∑_{i<j} det2 (e i) (e j)`.

Proof route (official Solution 2): induction on the number of side directions.
If two sides are parallel, one cuts off a parallelogram `R`; both `zonoArea` and
`4 · polyArea2 / 2` drop by `4 [R]` and `4 [R]/... `, leaving the difference
invariant.  Otherwise one splits a suitable side into two sides along the two
neighbouring directions in the angularly sorted list of edge vectors, which decreases
`zonoArea - 2 * polyArea2` and the number of side directions.  The base case is a
degenerate polygon collapsed to a segment, where both sides vanish. -/
theorem two_mul_polyArea2_le_zonoArea {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ)
    (hv : IsConvexPolygon v) :
    2 * polyArea2 v ≤ zonoArea v := by
  by_cases hn3 : 3 ≤ n
  · have hclosed : ESClosed (edge v) := sum_edge_eq_zero v
    have hlift := edgeLift_of_convex v hv hn3
    have hF := FES_nonneg_of_closed_lift' (edge v) hclosed hlift
    have hS : SES (edge v) = polyArea2 v := by
      rw [polyArea2_eq_sum, SES, Finset.sum_comm]
    have hG : GES (edge v) = zonoArea v := rfl
    have h1 : 0 ≤ GES (edge v) - 2 * SES (edge v) := hF
    rw [hG, hS] at h1
    linarith [h1]
  · have hn2 : n ≤ 2 := by omega
    by_cases hn1 : n = 1
    · subst hn1
      have hp : polyArea2 v = 0 := by
        unfold polyArea2
        rw [Fin.sum_univ_one]
        have h1 : (0 : Fin 1) + 1 = (0 : Fin 1) := by decide
        rw [h1, det2_self]
      have hz : zonoArea v = 0 := by
        unfold zonoArea
        apply Finset.sum_eq_zero
        intro i _
        apply Finset.sum_eq_zero
        intro j _
        rw [if_neg (by
          have h2 := i.isLt
          have h3 := j.isLt
          omega)]
      rw [hp, hz]
      norm_num
    · have hn2' : n = 2 := by
        have h0 := NeZero.pos n
        omega
      subst hn2'
      have hp : polyArea2 v = 0 := by
        unfold polyArea2
        have h0 : (0 : Fin 2) + 1 = (1 : Fin 2) := by decide
        have h1 : det2 (v 1) (v ((1 : Fin 2) + 1)) = - det2 (v 0) (v 1) := by
          have h2 : (1 : Fin 2) + 1 = (0 : Fin 2) := by
            apply Fin.ext
            have h3 : ((1 : Fin 2) + 1).val = (1 + 1 % 2) % 2 := by
              rw [Fin.val_add]
              rfl
            rw [h3]
            norm_num [Fin.val_zero]
          rw [h2]
          show (v 1).1 * (v 0).2 - (v 1).2 * (v 0).1 =
            -((v 0).1 * (v 1).2 - (v 0).2 * (v 1).1)
          ring
        rw [Fin.sum_univ_two, h0, h1]
        simp
      have hz : zonoArea v = 0 := by
        unfold zonoArea
        rw [Fin.sum_univ_two]
        simp only [Fin.sum_univ_two]
        have he : det2 (edge v 0) (edge v 1) = 0 := by
          have h2 : edge v 1 = - edge v 0 := by
            have h3 : (1 : Fin 2) + 1 = (0 : Fin 2) := by
              apply Fin.ext
              have h4 : ((1 : Fin 2) + 1).val = (1 + 1 % 2) % 2 := by
                rw [Fin.val_add]
                rfl
              rw [h4]
              norm_num [Fin.val_zero]
            unfold edge
            rw [h3]
            ext <;> simp
          rw [h2, det2_neg_right, det2_self, neg_zero]
        rw [he]
        simp
      rw [hp, hz]
      norm_num

snip end

problem imo2006_p6 {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ) (hv : IsConvexPolygon v) :
    polyArea2 v ≤ ∑ i : Fin n, sideLabel v i := by
  have h1 := sum_sup_area2_eq_zonoArea v hv
  have h2 := two_mul_polyArea2_le_zonoArea v hv
  unfold sideLabel zonoArea at *
  rw [← Finset.sum_div, h1] at *
  linarith [h2]

end Imo2006P6


/-!
## Status of the formalization (progress notes)

The main theorem `imo2006_p6` is reduced, via the official Solution 2 (IMO 2006
shortlist, problem G10), to two key lemmas about the edge vectors
`e i = edge v i = v (i+1) - v i`:

* `sum_sup_area2_eq_zonoArea` (K1, `[Q] = 2 ∑ Sᵢ`): **PROVED.**
  `∑ i, (max_j area2 (v i) (v (i+1)) (v j)) = zonoArea v`
  where `zonoArea v = ∑_{i<j} |det2 (e i) (e j)|` is the area of the zonotope
  generated by the edges (= the area of the centrally symmetric "associate"
  polygon `Q`, i.e. of the difference body `P − P`).
* `two_mul_polyArea2_le_zonoArea` (K2, `[Q] ≥ 4 [P]`): **PROVED.**
  `2 * polyArea2 v ≤ zonoArea v`.

The main theorem follows immediately from the two:
`∑ i, sideLabel v i = ½ ∑ i, (max_j area2 …) = ½ zonoArea v ≥ ½ (2 * polyArea2 v)
 = polyArea2 v`.

### What is proved (all in `namespace Imo2006P6`, in `snip begin … snip end`)

* `det2`/`area2` algebra: linearity, antisymmetry, the denominator-free 2D
  Cramer rule `det2_smul_eq`, distributivity over finset sums
  (`det2_sum_left`, `det2_sum_right`).
* Shoelace machinery: `sum_succ_eq_sum` (sums are invariant under a cyclic
  shift of `Fin n`), `sum_edge_eq_zero` (the edge vectors sum to zero),
  `vertex_sub_zero_eq_sum` (`v i − v 0` is the sum of the first `i` edge
  vectors), `polyArea2_eq_sum` (`polyArea2 v = ∑_{j<i} det2 (e j) (e i)`).
* Strictly convex quadrilaterals: `four_ears` (the four ear positivities),
  `exists_crossing` (the diagonals cross strictly — Cramer solution with both
  parameters in `(0,1)`), `not_alternating` (a superlevel set of a linear
  functional on the vertices of a strictly convex polygon contains no
  cyclically-alternating quadruple `(≥ s, ≤ s, > s, ≤ s)`; proof: evaluate the
  functional at the diagonal crossing point, which must lie both above and at
  most at the threshold).
* Unimodality: `no_dip` — the increments of the twice-area sequence over base
  `0` cannot drop and then rise.  Proof: from a drop at `a` and a rise at
  `b > a` one builds a rightmost valley `c'` and a peak `m` (or, in the flat
  case, the point `a` itself at the valley level), and applies
  `not_alternating` to the cyclic quadruple `(m, c', c'+1, 0)` resp.
  `(a, c', c'+1, 0)`.
* Row identity for side `0`: `row_max_eq_zero`
  (`max_j area2 (v 0) (v 1) (v j) = ½ ∑_a |det2 (e 0) (e a)|`), proved by
  (i) the free bound `sup ≤ ∑ positives` (a prefix sum can only shrink when
  nonpositive terms are dropped) and (ii) the peak `p` = first index with
  increment `≤ 0`, whose prefix `[1, p)` contains exactly the positive
  increments (via `no_dip`), so its partial sum equals the sum of positives
  `= ½ ∑ |row|` since every row sums to `det2 (e i) (∑ e) = 0`.
* Rotation invariance: `IsConvexPolygon_succ`, `IsConvexPolygon_add`
  (convexity is preserved under `j ↦ j + 1` and hence under `j ↦ j + i`),
  the shift equivalence `finShiftEquiv`, `sum_add_eq`, `sup'_add_eq`,
  and the general row identity `row_max_eq` for every side `i`.
* `sum_sup_area2_eq_zonoArea`: rows summed, lower triangle mirrored to the
  upper one by `|det2 p q| = |det2 q p|`, giving `2 * zonoArea v`.

### How `two_mul_polyArea2_le_zonoArea` is proved

This is the hard geometric core (the difference-body inequality `[P − P] ≥ 4 [P]`,
equivalently the 2-dimensional Brunn–Minkowski / Rogers–Shephard inequality;
mixed volumes are not available in mathlib).

Proof route (official Solution 2, algebraic form): set
`FES e := GES e − 2 * SES e` (for `e = edge v` this is
`zonoArea v − 2 * polyArea2 v`) and run strong induction on the measure
`MES e = esEll e * n + esNu e` (the number of distinct side direction lines,
resp. of nonzero sides) in `FES_nonneg_of_closed_lift`, dispatching to four
reduction operations, each preserving closure `ESClosed` (`∑ i, e i = 0`) and
the existence of a direction lift (`EdgeLift` — the combinatorial shadow of
"the edge directions wind once around the circle": a `Θ : ℕ → ℝ` with
`Θ (k + n) = Θ k + 2π`, step sizes in `[0, π]`, and
`Θ i ≡ dirAng (e i) (mod 2π)` on nonzero edges):

* Operation B0 (a zero side exists, `FES_eq_of_remove_zero`): delete it.
* Operation B1 (two parallel sides in the same direction,
  `FES_eq_of_merge_same`): merge them.
* Operation A (two antiparallel sides, `FES_eq_of_opA_remove_earlier` /
  `FES_eq_of_opA_remove_later`): remove the shorter side `e i` and replace
  the longer `e j` by `e j + e i` (the cut parallelogram `R`).  Both
  `zonoArea` and `2 * polyArea2` drop by the same amount, leaving `F`
  invariant.
* Operation B (`ℓ ≥ 3`, no parallel sides, `FES_lt_of_opB_split`): choose a
  side whose two neighbouring directions `b_{j−1}, b_{j+1}` in the angularly
  sorted `±e` list satisfy `det2 b_{j−1} b_{j+1} > 0` (the pigeonhole
  `opB_pigeonhole`: the `2ℓ` directions cannot all have consecutive-triple
  rotation `≥ 180°` when `ℓ ≥ 3`).  Split it into `f₁ + f₂` with
  `f₁ ∥ b_{j−1}`, `f₂ ∥ b_{j+1}` (Cramer coefficients are positive).  `F`
  strictly decreases (by `det(f₁,f₂) > 0`) and `ℓ` decreases by one.
* Base case `ℓ ≤ 1`: at most one direction line among the sides, so all
  determinants vanish and `F = 0`.

The input lift for a strictly convex polygon is built in Phase 2
(`edgeLift_of_convex`): `turnAng_edge_pos_of_convex` (every turning angle
lies in `(0, π)`), `turn_sum_eq_two_pi` (the turning angles sum to `2π`, by
ear clipping — `IsConvexPolygon_clip1` removes vertex `1`, `turn_sum_clip`
relates the two turn sums, induction on `n` with the triangle
`turn_sum_triangle` as base), and `liftTheta` (partial sums of the turning
angles), with `turnN_period` / `turnN_sum_shift` for the periodicity.

### Note on the convexity hypothesis

`IsConvexPolygon` demands strictly positive orientation of every cyclically
ordered vertex triple, excluding 180° angles and collinear/backtracking
vertices.  The inequality for weakly convex (degenerate) polygons follows from
the strict case by continuity (all quantities are continuous in the vertices).
-/

