/-!
# International Mathematical Olympiad 2006, Problem 6

Assign to each side $b$ of a convex polygon $\mathcal{P}$ the maximum area of a triangle
that has $b$ as a side and is contained in $\mathcal{P}$.
Show that the sum of the areas assigned to the sides of $\mathcal{P}$
is at least twice the area of $\mathcal{P}$.

## Formalization notes

We work with a polygon given as a list of vertices `v : Fin n → ℝ × ℝ` in
counterclockwise order, with the convex-position hypothesis that every cyclically
ordered triple of vertices spans a triangle of nonnegative (twice) signed area
(`IsConvexPolygon`).

* The area of the polygon is `polyArea2 v / 2`, where `polyArea2` is the shoelace sum.
* The maximum area of a triangle with side `v i (v (i+1))` contained in the polygon is
  attained at a vertex of the polygon (the area is affine in the moving vertex, and the
  polygon is the convex hull of its vertices).  We therefore define the label of side
  `i` as `sideLabel v i := (max_j area2 (v i) (v (i+1)) (v j)) / 2`.

The proof follows *Solution 2* of the official IMO 2006 shortlist (problem G10):
if `e i = v (i+1) - v i` are the edge vectors, then with
`Z := ∑_{i<j} |det (e i) (e j)|` (the area of the zonotope generated by the edges,
i.e. of the centrally symmetric "associate" polygon `Q`) one shows

1. `∑ i, 2 * sideLabel v i = Z` — each row maximum equals half the row absolute sum,
   because the signs of `det (e i) (e j)` for fixed `i` come in one cyclic positive
   block (unimodality of the distances from an edge line);
2. `2 * polyArea2 v ≤ Z` — the inequality `[Q] ≥ 4 [P]` of the official solution.
-/

open Finset

namespace Imo2006P6

/-- The determinant of two plane vectors, i.e. twice the signed area of the triangle
they span at the origin. -/
def det2 (p q : ℝ × ℝ) : ℝ := p.1 * q.2 - p.2 * q.1

/-- Twice the signed area of the triangle `p q r`; positive iff the triple `p q r` is
oriented counterclockwise. -/
def area2 (p q r : ℝ × ℝ) : ℝ := det2 (q - p) (r - p)

/-- `v : Fin n → ℝ × ℝ` is the list of vertices of a (strictly) convex polygon in
counterclockwise order: every cyclically ordered triple of vertices spans a triangle
of positive (twice) signed area.  (This excludes degenerate configurations such as
180° angles or collinear/backtracking vertices; the inequality for those follows
from the strict case by continuity.) -/
def IsConvexPolygon {n : ℕ} (v : Fin n → ℝ × ℝ) : Prop :=
  ∀ i j k : Fin n,
    (i.val < j.val ∧ j.val < k.val) ∨ (j.val < k.val ∧ k.val < i.val) ∨
      (k.val < i.val ∧ i.val < j.val) →
    0 < area2 (v i) (v j) (v k)

/-- Twice the signed area of the polygon with vertices `v` (shoelace formula). -/
def polyArea2 {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ) : ℝ :=
  ∑ i : Fin n, det2 (v i) (v (i + 1))

/-- The edge vector of the `i`-th side. -/
def edge {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ) (i : Fin n) : ℝ × ℝ :=
  v (i + 1) - v i

/-- The area assigned to the `i`-th side of the polygon: the maximum, over the
vertices `v j`, of the area of the triangle with base `v i (v (i+1))` and apex `v j`.
The maximum over the whole polygon of the area is attained at a vertex since the area
is affine in the apex. -/
noncomputable def sideLabel {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ) (i : Fin n) : ℝ :=
  (univ.sup' univ_nonempty fun j : Fin n => area2 (v i) (v (i + 1)) (v j)) / 2

/-- The area of the zonotope generated by the edge vectors (twice the sum of the
parallelogram areas over pairs of edges); this is the area of the centrally symmetric
"associate" polygon `Q` from the official Solution 2. -/
def zonoArea {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ) : ℝ :=
  ∑ i : Fin n, ∑ j : Fin n, if i.val < j.val then |det2 (edge v i) (edge v j)| else 0

snip begin

/-!
### Basic algebra of `det2` and `area2`
-/

@[simp] theorem det2_self (p : ℝ × ℝ) : det2 p p = 0 := by
  simp [det2, mul_comm]

theorem det2_neg (p q : ℝ × ℝ) : det2 p q = -det2 q p := by
  simp [det2]; ring

theorem det2_add_left (p q r : ℝ × ℝ) : det2 (p + q) r = det2 p r + det2 q r := by
  simp [det2, Prod.fst_add, Prod.snd_add]; ring

theorem det2_add_right (p q r : ℝ × ℝ) : det2 p (q + r) = det2 p q + det2 p r := by
  simp [det2, Prod.fst_add, Prod.snd_add]; ring

theorem det2_sub_left (p q r : ℝ × ℝ) : det2 (p - q) r = det2 p r - det2 q r := by
  simp [det2, Prod.fst_sub, Prod.snd_sub]; ring

theorem det2_sub_right (p q r : ℝ × ℝ) : det2 p (q - r) = det2 p q - det2 p r := by
  simp [det2, Prod.fst_sub, Prod.snd_sub]; ring

theorem det2_smul_left (t : ℝ) (p q : ℝ × ℝ) : det2 (t • p) q = t * det2 p q := by
  simp [det2, Prod.smul_fst, Prod.smul_snd]; ring

theorem det2_smul_right (t : ℝ) (p q : ℝ × ℝ) : det2 p (t • q) = t * det2 p q := by
  simp [det2, Prod.smul_fst, Prod.smul_snd]; ring

theorem area2_zero_left (p q : ℝ × ℝ) : area2 0 p q = det2 p q := by
  simp [area2, det2]

/-- `area2` is invariant under simultaneous translation. -/
theorem area2_add_left (p q r a : ℝ × ℝ) :
    area2 (a + p) (a + q) (a + r) = area2 p q r := by
  simp [area2]

/-- `area2 p q r` as an affine combination of determinants. -/
theorem area2_eq (p q r : ℝ × ℝ) :
    area2 p q r = det2 q r - det2 p r + det2 p q := by
  simp [area2, det2, Prod.fst_sub, Prod.snd_sub]; ring

theorem area2_swap_right (p q r : ℝ × ℝ) : area2 p q r = -area2 p r q := by
  simp [area2, det2, Prod.fst_sub, Prod.snd_sub]; ring

/-- Summing a function over a cyclic shift of `Fin n` does not change the sum. -/
theorem sum_succ_eq_sum {n : ℕ} [NeZero n] (f : Fin n → ℝ × ℝ) :
    (∑ i : Fin n, f (i + 1)) = ∑ i : Fin n, f i := by
  have h : ∀ i : Fin n, f (i + 1) = f (finRotate n i) := fun i => by
    rw [finRotate_apply]
  rw [Finset.sum_congr rfl (fun i _ => h i), Equiv.sum_comp (finRotate n) f]

/-- The edge vectors sum to zero. -/
theorem sum_edge_eq_zero {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ) :
    (∑ i : Fin n, edge v i) = 0 := by
  unfold edge
  rw [Finset.sum_sub_distrib, sum_succ_eq_sum v, sub_self]

/-- `det2` distributes over a sum in the second argument. -/
theorem det2_sum_right {ι : Type*} [DecidableEq ι] (p : ℝ × ℝ) (s : Finset ι) (f : ι → ℝ × ℝ) :
    det2 p (∑ i ∈ s, f i) = ∑ i ∈ s, det2 p (f i) := by
  induction s using Finset.induction with
  | empty => simp [det2]
  | @insert a s ha ih =>
      rw [Finset.sum_insert ha, det2_add_right, ih, Finset.sum_insert ha]

/-- `det2` distributes over a sum in the first argument. -/
theorem det2_sum_left {ι : Type*} [DecidableEq ι] (q : ℝ × ℝ) (s : Finset ι) (f : ι → ℝ × ℝ) :
    det2 (∑ i ∈ s, f i) q = ∑ i ∈ s, det2 (f i) q := by
  induction s using Finset.induction with
  | empty => simp [det2]
  | @insert a s ha ih =>
      rw [Finset.sum_insert ha, det2_add_left, ih, Finset.sum_insert ha]

/-- 2D Cramer rule, denominator-free form. -/
theorem det2_smul_eq (p q r : ℝ × ℝ) :
    det2 q r • p = det2 p r • q + det2 q p • r := by
  apply Prod.ext <;>
    simp [Prod.smul_fst, Prod.smul_snd, Prod.fst_add, Prod.snd_add, det2] <;> ring

/-- The four indices are in cyclic order. -/
def Cyclic4 {n : ℕ} (a b c d : Fin n) : Prop :=
  (a.val < b.val ∧ b.val < c.val ∧ c.val < d.val) ∨
    (b.val < c.val ∧ c.val < d.val ∧ d.val < a.val) ∨
    (c.val < d.val ∧ d.val < a.val ∧ a.val < b.val) ∨
    (d.val < a.val ∧ a.val < b.val ∧ b.val < c.val)

/-- From a cyclically ordered quadruple of indices of a strictly convex polygon we get
the four "ear" area positivities. -/
theorem four_ears {n : ℕ} (v : Fin n → ℝ × ℝ) (hv : IsConvexPolygon v)
    {a b c d : Fin n} (h : Cyclic4 a b c d) :
    0 < det2 (v b - v a) (v c - v a) ∧ 0 < det2 (v c - v b) (v d - v b) ∧
      0 < det2 (v d - v c) (v a - v c) ∧ 0 < det2 (v a - v d) (v b - v d) := by
  rcases h with ⟨hab, hbc, hcd⟩ | ⟨hbc, hcd, hda⟩ | ⟨hcd, hda, hab⟩ | ⟨hda, hab, hbc⟩
  · exact ⟨hv a b c (.inl ⟨hab, hbc⟩), hv b c d (.inl ⟨hbc, hcd⟩),
      hv c d a (.inr (.inr ⟨hab.trans hbc, hcd⟩)),
      hv d a b (.inr (.inl ⟨hab, hbc.trans hcd⟩))⟩
  · exact ⟨hv a b c (.inr (.inl ⟨hbc, hcd.trans hda⟩)), hv b c d (.inl ⟨hbc, hcd⟩),
      hv c d a (.inl ⟨hcd, hda⟩),
      hv d a b (.inr (.inr ⟨hbc.trans hcd, hda⟩))⟩
  · exact ⟨hv a b c (.inr (.inr ⟨hcd.trans hda, hab⟩)),
      hv b c d (.inr (.inl ⟨hcd, hda.trans hab⟩)), hv c d a (.inl ⟨hcd, hda⟩),
      hv d a b (.inl ⟨hda, hab⟩)⟩
  · exact ⟨hv a b c (.inl ⟨hab, hbc⟩),
      hv b c d (.inr (.inr ⟨hda.trans hab, hbc⟩)),
      hv c d a (.inr (.inl ⟨hda, hab.trans hbc⟩)), hv d a b (.inl ⟨hda, hab⟩)⟩

theorem det2_neg_right (p q : ℝ × ℝ) : det2 p (-q) = -det2 p q := by
  change p.1 * (-q.2) - p.2 * (-q.1) = -(p.1 * q.2 - p.2 * q.1)
  ring

theorem det2_neg_left (p q : ℝ × ℝ) : det2 (-p) q = -det2 p q := by
  change (-p.1) * q.2 - (-p.2) * q.1 = -(p.1 * q.2 - p.2 * q.1)
  ring

/-- The diagonals of a strictly convex quadrilateral cross strictly:
there is a point lying in the relative interior of both diagonals. -/
theorem exists_crossing {n : ℕ} (v : Fin n → ℝ × ℝ) (hv : IsConvexPolygon v)
    {a b c d : Fin n} (h : Cyclic4 a b c d) :
    ∃ O : ℝ × ℝ, ∃ t u : ℝ, 0 < t ∧ t < 1 ∧ 0 < u ∧ u < 1 ∧
      O = v a + t • (v c - v a) ∧ O = v b + u • (v d - v b) := by
  obtain ⟨habc, hbcd, hcda, hdab⟩ := four_ears v hv h
  have hden : 0 < det2 (v c - v a) (v d - v b) := by
    have he : det2 (v c - v a) (v d - v b) =
        det2 (v b - v a) (v c - v a) + det2 (v d - v c) (v a - v c) := by
      simp [det2, Prod.fst_sub, Prod.snd_sub]; ring
    linarith [he, habc, hcda]
  set den := det2 (v c - v a) (v d - v b) with hden_def
  have htn : det2 (v b - v a) (v d - v b) = det2 (v a - v d) (v b - v d) := by
    simp [det2, Prod.fst_sub, Prod.snd_sub]; ring
  have hun : det2 (v c - v a) (v a - v b) = det2 (v b - v a) (v c - v a) := by
    simp [det2, Prod.fst_sub, Prod.snd_sub]; ring
  have hdt : det2 (v c - v a) (v d - v b) - det2 (v b - v a) (v d - v b) =
      det2 (v c - v b) (v d - v b) := by
    simp [det2, Prod.fst_sub, Prod.snd_sub]; ring
  have hdu : det2 (v c - v a) (v d - v b) - det2 (v c - v a) (v a - v b) =
      det2 (v d - v c) (v a - v c) := by
    simp [det2, Prod.fst_sub, Prod.snd_sub]; ring
  set t := det2 (v b - v a) (v d - v b) / den with ht_def
  set u := det2 (v c - v a) (v a - v b) / den with hu_def
  have ht0 : 0 < t := by rw [ht_def, htn]; exact div_pos hdab hden
  have ht1 : t < 1 := by
    have e : 0 < den - det2 (v a - v d) (v b - v d) := by
      rw [← htn, hden_def, hdt]; exact hbcd
    rw [ht_def, htn, div_lt_one hden]; linarith [e]
  have hu0 : 0 < u := by rw [hu_def, hun]; exact div_pos habc hden
  have hu1 : u < 1 := by
    have e : 0 < den - det2 (v b - v a) (v c - v a) := by
      rw [← hun, hden_def, hdu]; exact hcda
    rw [hu_def, hun, div_lt_one hden]; linarith [e]
  have hun2 : det2 (v c - v a) (v b - v a) = -det2 (v c - v a) (v a - v b) := by
    rw [show (v b - v a) = -(v a - v b) from by abel, det2_neg_right]
  have key : t • (v c - v a) - u • (v d - v b) = v b - v a := by
    have hne : den ≠ 0 := ne_of_gt hden
    have e := det2_smul_eq (v b - v a) (v c - v a) (v d - v b)
    rw [hun2, ← hden_def] at e
    have e2 : den • (v b - v a) = den • (t • (v c - v a) - u • (v d - v b)) := by
      rw [smul_sub den (t • (v c - v a)) (u • (v d - v b)),
        smul_smul den t (v c - v a), smul_smul den u (v d - v b),
        ht_def, hu_def, mul_div_cancel₀ _ hne, mul_div_cancel₀ _ hne,
        sub_eq_add_neg (det2 (v b - v a) (v d - v b) • (v c - v a))
          (det2 (v c - v a) (v a - v b) • (v d - v b)),
        ← neg_smul]
      exact e
    have h2 := congrArg (den⁻¹ • ·) e2
    symm
    simpa [smul_smul, inv_mul_cancel₀ hne] using h2
  refine ⟨v a + t • (v c - v a), t, u, ht0, ht1, hu0, hu1, rfl, ?_⟩
  have hv' : v b = v a + (v b - v a) := by abel
  nth_rewrite 1 [hv']
  rw [← key]
  abel

/-- A superlevel set of a linear functional on the vertices of a strictly convex
polygon contains no "alternating" cyclically ordered quadruple: if `a b c d` are
cyclically ordered, one cannot have the values `≥ s, ≤ s, > s, ≤ s`. -/
theorem not_alternating {n : ℕ} (v : Fin n → ℝ × ℝ) (hv : IsConvexPolygon v)
    (u : ℝ × ℝ) (s : ℝ) {a b c d : Fin n} (h : Cyclic4 a b c d)
    (hfa : s ≤ det2 u (v a)) (hfc : s < det2 u (v c))
    (hfb : det2 u (v b) ≤ s) (hfd : det2 u (v d) ≤ s) : False := by
  obtain ⟨O, t, w, ht0, ht1, hw0, hw1, hO1, hO2⟩ := exists_crossing v hv h
  have hcomb : ∀ (x y : ℝ × ℝ) (r : ℝ), x + r • (y - x) = (1 - r) • x + r • y := by
    intro x y r
    ext <;> simp [Prod.smul_fst, Prod.smul_snd] <;> ring
  have hO1v : det2 u O = (1 - t) * det2 u (v a) + t * det2 u (v c) := by
    rw [hO1, hcomb, det2_add_right, det2_smul_right, det2_smul_right]
  have hO2v : det2 u O = (1 - w) * det2 u (v b) + w * det2 u (v d) := by
    rw [hO2, hcomb, det2_add_right, det2_smul_right, det2_smul_right]
  have hgt : s < det2 u O := by
    have e : (1 - t) * s + t * s < (1 - t) * det2 u (v a) + t * det2 u (v c) := by
      apply add_lt_add_of_le_of_lt
      · exact mul_le_mul_of_nonneg_left hfa (by linarith [ht1])
      · exact mul_lt_mul_of_pos_left hfc ht0
    have e2 : (1 - t) * s + t * s = s := by ring
    linarith [e, e2, hO1v]
  have hle : det2 u O ≤ s := by
    have e : (1 - w) * det2 u (v b) + w * det2 u (v d) ≤ (1 - w) * s + w * s := by
      apply add_le_add
      · exact mul_le_mul_of_nonneg_left hfb (by linarith [hw1])
      · exact mul_le_mul_of_nonneg_left hfd hw0.le
    have e2 : (1 - w) * s + w * s = s := by ring
    linarith [e, e2, hO2v]
  linarith [hgt, hle]

/-- The increments of the twice-area sequence over base `0` cannot drop and then rise:
unimodality of the vertex distances from the line of side `0`. -/
theorem no_dip {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ) (hv : IsConvexPolygon v)
    {a b : Fin n} (ha : 1 ≤ a.val) (hab : a.val < b.val)
    (hda : det2 (edge v 0) (edge v a) ≤ 0) (hdb : 0 < det2 (edge v 0) (edge v b)) :
    False := by
  set T : Fin n → ℝ := fun x => det2 (edge v 0) (v x - v 0) with hT
  have step : ∀ x : Fin n, T (x + 1) - T x = det2 (edge v 0) (edge v x) := by
    intro x
    have e : (v (x + 1) - v 0) - (v x - v 0) = edge v x := by unfold edge; abel
    rw [hT, ← det2_sub_right, e]
  have hT0 : T 0 = 0 := by simp [hT, det2]
  have hTpos : ∀ x : Fin n, x.val ≠ 0 → x.val ≠ 1 → 0 < T x := by
    intro x hx0 hx1
    have hx : 1 < x.val := by omega
    have h0 : (0 : Fin n) + 1 = 1 := by rw [zero_add]
    have e : edge v 0 = v 1 - v 0 := by unfold edge; rw [h0]
    have h := hv 0 1 x (Or.inl ⟨by
      show (0 : ℕ) < 1 % n
      rw [Nat.mod_eq_of_lt (by omega : 1 < n)]
      exact Nat.one_pos, by
      show 1 % n < x.val
      rw [Nat.mod_eq_of_lt (by omega : 1 < n)]
      exact hx⟩)
    have h2 : T x = det2 (v 1 - v 0) (v x - v 0) := by simp only [hT, e]
    rw [h2]
    exact h
  have hb1 : T b < T (b + 1) := by linarith [step b, hdb]
  have ha1 : T (a + 1) ≤ T a := by linarith [step a, hda]
  have hbval : b.val + 1 < n := by
    by_contra hlt
    push Not at hlt
    have hbv : b.val = n - 1 := by have := b.isLt; omega
    have h1v : (1 : Fin n).val = 1 := by
      show (1 : ℕ) % n = 1
      rw [Nat.mod_eq_of_lt (by omega : 1 < n)]
    have hb10 : (b + 1).val = 0 := by
      rw [Fin.add_def, h1v, hbv, show (n - 1 + 1 : ℕ) = n from by omega]
      simp
    have hb1e : b + 1 = 0 := Fin.ext hb10
    rw [hb1e, hT0] at hb1
    have hb2 : 0 < T b := hTpos b (by omega) (by omega)
    linarith [hb1, hb2]
  have hav1 : (a + 1).val = a.val + 1 := Fin.val_add_one_of_lt' (by omega)
  have hbv1 : (b + 1).val = b.val + 1 := Fin.val_add_one_of_lt' hbval
  have hab1 : a + 1 ≤ b + 1 := by
    show (a + 1).val ≤ (b + 1).val
    rw [hav1, hbv1]; omega
  have hne1 : (Finset.Icc (a + 1) (b + 1)).Nonempty :=
    ⟨a + 1, Finset.mem_Icc.mpr ⟨le_refl _, hab1⟩⟩
  obtain ⟨c, hc_mem, hc_min⟩ := Finset.exists_min_image (Finset.Icc (a + 1) (b + 1)) T hne1
  set S := (Finset.Icc (a + 1) (b + 1)).filter fun x =>
    ∀ y ∈ Finset.Icc (a + 1) (b + 1), T x ≤ T y
  have hS : S.Nonempty := ⟨c, Finset.mem_filter.mpr ⟨hc_mem, hc_min⟩⟩
  set c' := S.max' hS with hc'_def
  have hc'mem : c' ∈ S := S.max'_mem hS
  have hc'max : ∀ y ∈ S, y ≤ c' := fun y hy => S.le_max' y hy
  rw [Finset.mem_filter] at hc'mem
  obtain ⟨hc'icc, hc'min⟩ := hc'mem
  obtain ⟨hc'ge, hc'le⟩ := Finset.mem_Icc.mp hc'icc
  have hc'val : a.val + 1 ≤ c'.val := by
    change (a + 1).val ≤ c'.val at hc'ge
    rwa [hav1] at hc'ge
  have hc'val2 : c'.val ≤ b.val + 1 := by
    change (c').val ≤ (b + 1).val at hc'le
    rwa [hbv1] at hc'le
  have hc'lt : c' < b + 1 := by
    by_contra hlt
    push Not at hlt
    have heq : c' = b + 1 := le_antisymm hc'le hlt
    have hbmem : b ∈ Finset.Icc (a + 1) (b + 1) := by
      refine Finset.mem_Icc.mpr ⟨?_, ?_⟩
      · show (a + 1).val ≤ b.val
        rw [hav1]; omega
      · show b.val ≤ (b + 1).val
        rw [hbv1]; omega
    have h1 := hc'min b hbmem
    rw [heq] at h1
    linarith [h1, hb1]
  have hc'v1 : (c' + 1).val = c'.val + 1 := Fin.val_add_one_of_lt' (by omega)
  have hstep : T c' < T (c' + 1) := by
    have hmem : c' + 1 ∈ Finset.Icc (a + 1) (b + 1) := by
      refine Finset.mem_Icc.mpr ⟨?_, ?_⟩
      · show (a + 1).val ≤ (c' + 1).val
        rw [hav1, hc'v1]; omega
      · show (c' + 1).val ≤ (b + 1).val
        rw [hc'v1, hbv1]; omega
    have hlt : c' < c' + 1 := by
      show c'.val < (c' + 1).val
      rw [hc'v1]; omega
    by_contra hle
    push Not at hle
    have hmemS : c' + 1 ∈ S :=
      Finset.mem_filter.mpr ⟨hmem, fun y hy => le_trans hle (hc'min y hy)⟩
    have h2 := hc'max (c' + 1) hmemS
    exact absurd h2 (not_le_of_gt hlt)
  have hs0 : 0 < T c' := hTpos c' (by omega) (by omega)
  obtain ⟨m, hm_mem, hm_max⟩ := Finset.exists_max_image (Finset.Icc 1 c') T
    ⟨1, Finset.mem_Icc.mpr ⟨le_refl _, by
      show (1 : Fin n).val ≤ c'.val
      show 1 % n ≤ c'.val
      rw [Nat.mod_eq_of_lt (by omega : 1 < n)]
      omega⟩⟩
  obtain ⟨hmge1, hmlec'⟩ := Finset.mem_Icc.mp hm_mem
  have hmge1v : 1 ≤ m.val := by
    change (1 : ℕ) % n ≤ m.val at hmge1
    rwa [Nat.mod_eq_of_lt (by omega : 1 < n)] at hmge1
  have hmge : T c' ≤ T m := hm_max c' (Finset.mem_Icc.mpr ⟨by
    show (1 : Fin n).val ≤ c'.val
    show 1 % n ≤ c'.val
    rw [Nat.mod_eq_of_lt (by omega : 1 < n)]
    omega, le_refl _⟩)
  have hconv : ∀ x : Fin n, T x = det2 (edge v 0) (v x) - det2 (edge v 0) (v 0) := by
    intro x
    show det2 (edge v 0) (v x - v 0) = det2 (edge v 0) (v x) - det2 (edge v 0) (v 0)
    rw [det2_sub_right]
  set s := T c' with hs
  -- the alternating quadruple has `0` as fourth point
  by_cases hmgt : s < T m
  · -- quadruple (m, c', c'+1, 0)
    have hmc' : m < c' := by
      rcases lt_or_eq_of_le hmlec' with h | h
      · exact h
      · exact absurd h (by intro he; rw [he] at hmgt; exact absurd hmgt (lt_irrefl _))
    have hcy : Cyclic4 m c' (c' + 1) 0 := by
      refine Or.inr (Or.inr (Or.inr ⟨?_, ?_, ?_⟩))
      · show (0 : ℕ) < m.val
        omega
      · exact hmc'
      · rw [hc'v1]; omega
    have h1 : det2 (edge v 0) (v c') ≤ det2 (edge v 0) (v m) := by
      rw [hconv m, hconv c'] at *; linarith [hmgt]
    have h2 : det2 (edge v 0) (v c') < det2 (edge v 0) (v (c' + 1)) := by
      rw [hconv (c' + 1), hconv c'] at *; linarith [hstep]
    have h3 : det2 (edge v 0) (v c') ≤ det2 (edge v 0) (v c') := le_refl _
    have h4 : det2 (edge v 0) (v 0) ≤ det2 (edge v 0) (v c') := by
      rw [hconv c'] at *; linarith [hT0, hs0]
    exact not_alternating v hv (edge v 0) (det2 (edge v 0) (v c')) hcy h1 h2 h3 h4
  · -- flat case: T m = s, quadruple (a, c', c'+1, 0)
    push Not at hmgt
    have hmeq : T m = s := le_antisymm hmgt hmge
    have ha_le : T a ≤ T m := by
      apply hm_max a
      refine Finset.mem_Icc.mpr ⟨?_, ?_⟩
      · show 1 % n ≤ a.val
        rw [Nat.mod_eq_of_lt (by omega : 1 < n)]
        omega
      · show a.val ≤ c'.val
        omega
    have hage : s ≤ T (a + 1) := hc'min (a + 1) (Finset.mem_Icc.mpr ⟨le_refl _, hab1⟩)
    have haeq : T a = s := by linarith [ha_le, hmeq, hage, ha1]
    have hac' : a < c' := by
      show a.val < c'.val
      omega
    have hcy : Cyclic4 a c' (c' + 1) 0 := by
      refine Or.inr (Or.inr (Or.inr ⟨?_, ?_, ?_⟩))
      · show (0 : ℕ) < a.val
        omega
      · exact hac'
      · rw [hc'v1]; omega
    have h1 : det2 (edge v 0) (v c') ≤ det2 (edge v 0) (v a) := by
      rw [hconv a, hconv c'] at *; linarith [haeq]
    have h2 : det2 (edge v 0) (v c') < det2 (edge v 0) (v (c' + 1)) := by
      rw [hconv (c' + 1), hconv c'] at *; linarith [hstep]
    have h3 : det2 (edge v 0) (v c') ≤ det2 (edge v 0) (v c') := le_refl _
    have h4 : det2 (edge v 0) (v 0) ≤ det2 (edge v 0) (v c') := by
      rw [hconv c'] at *; linarith [hT0, hs0]
    exact not_alternating v hv (edge v 0) (det2 (edge v 0) (v c')) hcy h1 h2 h3 h4

/-- A vertex minus the initial vertex is the sum of the edge vectors along the way. -/
theorem vertex_sub_zero_eq_sum {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ) (i : Fin n) :
    v i - v 0 = ∑ j : Fin n, (if j.val < i.val then edge v j else 0) := by
  have key : ∀ k (hk : k < n), v ⟨k, hk⟩ - v 0 =
      ∑ j : Fin n, (if j.val < k then edge v j else 0) := by
    intro k
    induction k with
    | zero =>
        intro hk
        simp
    | succ k ih =>
        intro hk
        have hk' : k < n := Nat.lt_of_succ_lt hk
        have hone : (⟨k, hk'⟩ : Fin n) + 1 = ⟨k + 1, hk⟩ := by
          ext
          show ((⟨k, hk'⟩ : Fin n) + 1).val = k + 1
          rw [Fin.val_add_one_of_lt' hk]
        have hB : (Finset.univ.filter fun j : Fin n => j.val < k + 1) =
            insert ⟨k, hk'⟩ (Finset.univ.filter fun j : Fin n => j.val < k) := by
          ext j
          simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_insert]
          constructor
          · intro h
            rcases Nat.lt_succ_iff_lt_or_eq.mp h with h | h
            · exact Or.inr h
            · exact Or.inl (Fin.ext h)
          · intro h
            rcases h with h | h
            · rw [h]; exact Nat.lt_succ_self k
            · exact Nat.lt_succ_of_lt h
        have hsum : (∑ j : Fin n, (if j.val < k + 1 then edge v j else 0)) =
            (∑ j : Fin n, (if j.val < k then edge v j else 0)) + edge v ⟨k, hk'⟩ := by
          rw [Finset.sum_ite, Finset.sum_ite, Finset.sum_const_zero,
            Finset.sum_const_zero, add_zero, add_zero, hB,
            Finset.sum_insert (by simp), add_comm]
        calc v ⟨k + 1, hk⟩ - v 0
            = (v ⟨k, hk'⟩ + edge v ⟨k, hk'⟩) - v 0 := by
              rw [← hone]
              unfold edge
              abel
          _ = (v ⟨k, hk'⟩ - v 0) + edge v ⟨k, hk'⟩ := by abel
          _ = (∑ j : Fin n, (if j.val < k then edge v j else 0)) + edge v ⟨k, hk'⟩ := by
              rw [ih hk']
          _ = ∑ j : Fin n, (if j.val < k + 1 then edge v j else 0) := hsum.symm
  exact key i.val i.isLt

/-- Twice the polygon area in terms of the edge vectors:
`polyArea2 v = ∑ i, ∑_{j < i} det2 (e j) (e i)`. -/
theorem polyArea2_eq_sum {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ) :
    polyArea2 v = ∑ i : Fin n, ∑ j : Fin n,
      (if j.val < i.val then det2 (edge v j) (edge v i) else 0) := by
  have h1 : ∀ i : Fin n, det2 (v i) (v (i + 1)) = det2 (v i) (edge v i) := by
    intro i
    unfold edge
    rw [det2_sub_right, det2_self, sub_zero]
  show (∑ i : Fin n, det2 (v i) (v (i + 1))) = _
  rw [Finset.sum_congr rfl (fun i _ => h1 i)]
  have h2 : ∀ i : Fin n, det2 (v i) (edge v i) =
      det2 (v i - v 0) (edge v i) + det2 (v 0) (edge v i) := by
    intro i
    conv_lhs => rw [← sub_add_cancel (v i) (v 0)]
    rw [det2_add_left]
  rw [Finset.sum_congr rfl (fun i _ => h2 i), Finset.sum_add_distrib]
  have h3 : det2 (v 0) (∑ i : Fin n, edge v i) = 0 := by
    rw [sum_edge_eq_zero]
    simp [det2]
  rw [det2_sum_right] at h3
  rw [h3, add_zero]
  apply Finset.sum_congr rfl
  intro i _
  rw [vertex_sub_zero_eq_sum v i, det2_sum_left]
  apply Finset.sum_congr rfl
  intro j _
  by_cases hj : j.val < i.val <;> simp [hj, det2]

/-- The maximum triangle area over side `0` equals half the absolute row sum
(this is the unimodality of the vertex distances from the line of side `0`). -/
theorem row_max_eq_zero {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ) (hv : IsConvexPolygon v) :
    (univ.sup' univ_nonempty fun j : Fin n => area2 (v 0) (v 1) (v j)) =
      (∑ a : Fin n, |det2 (edge v 0) (edge v a)|) / 2 := by
  by_cases hn : 3 ≤ n
  swap
  · -- n ∈ {1, 2}: everything vanishes
    have hpos : 0 < n := Nat.pos_of_ne_zero (NeZero.ne n)
    have hn' : n = 1 ∨ n = 2 := by omega
    rcases hn' with rfl | rfl
    · have h1 : ∀ j : Fin 1, area2 (v 0) (v 1) (v j) = 0 := by
        intro j
        have hj : j = 0 := Subsingleton.elim j 0
        have h10 : (1 : Fin 1) = 0 := Subsingleton.elim 1 0
        rw [hj, h10]
        simp [area2, det2]
      have hsup : (univ.sup' univ_nonempty fun j : Fin 1 => area2 (v 0) (v 1) (v j)) = 0 := by
        apply le_antisymm
        · exact Finset.sup'_le univ_nonempty (fun j : Fin 1 => area2 (v 0) (v 1) (v j))
            (fun j _ => le_of_eq (h1 j))
        · have hle := Finset.le_sup' (fun j : Fin 1 => area2 (v 0) (v 1) (v j))
            (Finset.mem_univ (0 : Fin 1))
          rw [h1 0] at hle
          exact hle
      have hsum1 : (∑ a : Fin 1, |det2 (edge v 0) (edge v a)|) = 0 := by
        rw [Fin.sum_univ_one]
        simp
      rw [hsup, hsum1]
      simp
    · have h1 : ∀ j : Fin 2, area2 (v 0) (v 1) (v j) = 0 := by
        rw [Fin.forall_fin_two]
        constructor <;> (simp only [area2, det2, Prod.fst_sub, Prod.snd_sub]; ring)
      have hsup : (univ.sup' univ_nonempty fun j : Fin 2 => area2 (v 0) (v 1) (v j)) = 0 := by
        apply le_antisymm
        · exact Finset.sup'_le univ_nonempty (fun j : Fin 2 => area2 (v 0) (v 1) (v j))
            (fun j _ => le_of_eq (h1 j))
        · have hle := Finset.le_sup' (fun j : Fin 2 => area2 (v 0) (v 1) (v j))
            (Finset.mem_univ (0 : Fin 2))
          rw [h1 0] at hle
          exact hle
      have hsum2 : (∑ a : Fin 2, |det2 (edge v 0) (edge v a)|) = 0 := by
        rw [Fin.sum_univ_two]
        have h01 : (0 : Fin 2) + 1 = 1 := by decide
        have h11 : (1 : Fin 2) + 1 = 0 := by decide
        have e0 : edge v 0 = v 1 - v 0 := by unfold edge; rw [h01]
        have e1 : edge v 1 = v 0 - v 1 := by unfold edge; rw [h11]
        rw [e0, e1]
        have hneg : v 0 - v 1 = -(v 1 - v 0) := by abel
        rw [hneg, det2_neg_right]
        simp
      rw [hsup, hsum2]
      simp
  · -- n ≥ 3
    set d : Fin n → ℝ := fun a => det2 (edge v 0) (edge v a) with hd
    have h0 : (0 : Fin n) + 1 = 1 := by rw [zero_add]
    have e0 : edge v 0 = v 1 - v 0 := by unfold edge; rw [h0]
    have h1v : (1 : Fin n).val = 1 := by
      show (1 : ℕ) % n = 1
      rw [Nat.mod_eq_of_lt (by omega : 1 < n)]
    have hsum : (∑ a : Fin n, d a) = 0 := by
      have e : (∑ a : Fin n, d a) = det2 (edge v 0) (∑ a : Fin n, edge v a) := by
        simp only [hd]
        exact (det2_sum_right (edge v 0) univ (edge v)).symm
      rw [e, sum_edge_eq_zero]
      simp [det2]
    have hd0 : d 0 = 0 := by simp [hd]
    have hd1 : 0 < d 1 := by
      have h := hv 0 1 2 (Or.inl ⟨by
        show (0 : ℕ) < 1 % n
        rw [Nat.mod_eq_of_lt (by omega : 1 < n)]
        exact Nat.one_pos, by
        show 1 % n < 2 % n
        rw [Nat.mod_eq_of_lt (by omega : 1 < n), Nat.mod_eq_of_lt (by omega : 2 < n)]
        exact Nat.one_lt_two⟩)
      have h11 : (1 : Fin n) + 1 = 2 := by
        ext
        simp [Fin.add_def]
      have e1 : edge v 1 = v 2 - v 1 := by unfold edge; rw [h11]
      have h2 : det2 (v 1 - v 0) (v 2 - v 1) = det2 (v 1 - v 0) (v 2 - v 0) := by
        have e : (v 2 - v 1) = (v 2 - v 0) - (v 1 - v 0) := by abel
        rw [e, det2_sub_right, det2_self, sub_zero]
      simp only [hd, e0, e1, h2]
      exact h
    set P : Finset (Fin n) := univ.filter (fun a => 0 < d a) with hP
    have hhalf : (∑ a ∈ P, d a) = (∑ a : Fin n, |d a|) / 2 := by
      have e1 : ∑ a ∈ P, |d a| = ∑ a ∈ P, d a := by
        apply Finset.sum_congr rfl
        intro x hx
        rw [hP, Finset.mem_filter] at hx
        exact abs_of_pos hx.2
      have e2 : ∑ a ∈ univ.filter (fun a => ¬0 < d a), |d a| =
          -∑ a ∈ univ.filter (fun a => ¬0 < d a), d a := by
        rw [← Finset.sum_neg_distrib]
        apply Finset.sum_congr rfl
        intro x hx
        rw [Finset.mem_filter] at hx
        exact abs_of_nonpos (le_of_not_gt hx.2)
      have e3 : ∑ a : Fin n, |d a| =
          ∑ a ∈ P, |d a| + ∑ a ∈ univ.filter (fun a => ¬0 < d a), |d a| := by
        rw [← Finset.sum_filter_add_sum_filter_not univ (fun a => 0 < d a)]
      have h2 : (∑ a ∈ P, d a) + ∑ a ∈ univ.filter (fun a => ¬0 < d a), d a = 0 := by
        rw [hP, Finset.sum_filter_add_sum_filter_not univ (fun a => 0 < d a)]
        exact hsum
      rw [e3, e1, e2]
      linarith [h2]
    have hTj : ∀ j : Fin n, area2 (v 0) (v 1) (v j) = det2 (edge v 0) (v j - v 0) := by
      intro j; simp only [e0, area2]
    have hTsum : ∀ j : Fin n, det2 (edge v 0) (v j - v 0) =
        ∑ i : Fin n, (if i.val < j.val then d i else 0) := by
      intro j
      rw [vertex_sub_zero_eq_sum v j, det2_sum_right]
      apply Finset.sum_congr rfl
      intro i _
      by_cases hi : i.val < j.val <;> simp [hi, hd, det2]
    rw [← hhalf]
    apply le_antisymm
    · apply Finset.sup'_le
      intro j _
      rw [hTj j, hTsum j]
      have h1 : ∑ i : Fin n, (if i.val < j.val then d i else 0) =
          ∑ i ∈ univ.filter (fun i => i.val < j.val), d i := by
        rw [Finset.sum_filter]
      rw [h1, ← Finset.sum_filter_add_sum_filter_not (univ.filter fun i => i.val < j.val)
        (fun i => 0 < d i)]
      have hnonpos : ∑ x ∈ (univ.filter fun i => i.val < j.val).filter (fun i => ¬0 < d i),
          d x ≤ 0 := by
        apply Finset.sum_nonpos
        intro x hx
        rw [Finset.mem_filter] at hx
        exact le_of_not_gt hx.2
      have hposle : ∑ x ∈ (univ.filter fun i => i.val < j.val).filter (fun i => 0 < d i),
          d x ≤ ∑ a ∈ P, d a := by
        apply Finset.sum_le_sum_of_subset_of_nonneg
        · intro x hx
          rw [Finset.mem_filter] at hx
          rw [hP, Finset.mem_filter]
          exact ⟨Finset.mem_univ x, hx.2⟩
        · intro x hx _
          rw [hP, Finset.mem_filter] at hx
          exact le_of_lt hx.2
      linarith [hnonpos, hposle]
    · -- the peak realizes the sum of positives
      set S : Finset (Fin n) := univ.filter (fun x => 1 ≤ x.val ∧ d x ≤ 0) with hS
      have hSne : S.Nonempty := by
        by_contra hem
        have hpos1 : 0 < ∑ x ∈ univ.filter (fun x => 1 ≤ x.val), d x := by
          apply Finset.sum_pos
          · intro x hx
            rw [Finset.mem_filter] at hx
            by_contra h2
            push Not at h2
            exact hem ⟨x, Finset.mem_filter.mpr ⟨hx.1, ⟨hx.2, h2⟩⟩⟩
          · exact ⟨1, Finset.mem_filter.mpr ⟨Finset.mem_univ 1, by
              show (1 : ℕ) ≤ 1 % n
              rw [Nat.mod_eq_of_lt (by omega : 1 < n)]⟩⟩
        have hzero : ∑ x ∈ univ.filter (fun x => 1 ≤ x.val), d x = 0 := by
          have hsplit : (∑ x ∈ univ.filter (fun x => 1 ≤ x.val), d x) +
              ∑ x ∈ univ.filter (fun x => ¬1 ≤ x.val), d x = 0 := by
            rw [Finset.sum_filter_add_sum_filter_not]
            exact hsum
          have hone : ∑ x ∈ univ.filter (fun x => ¬1 ≤ x.val), d x = 0 := by
            apply Finset.sum_eq_zero
            intro x hx
            rw [Finset.mem_filter] at hx
            push Not at hx
            have hx0 : x = 0 := by
              rw [Fin.ext_iff]
              show x.val = 0
              omega
            rw [hx0]
            exact hd0
          linarith [hsplit, hone]
        linarith [hpos1, hzero]
      set p := S.min' hSne with hp
      have hpmem : p ∈ S := S.min'_mem hSne
      rw [hS, Finset.mem_filter] at hpmem
      obtain ⟨hpu, hp1, hpd⟩ := hpmem
      have hT : det2 (edge v 0) (v p - v 0) = ∑ a ∈ P, d a := by
        rw [hTsum p]
        have h1 : ∑ i : Fin n, (if i.val < p.val then d i else 0) =
            ∑ i ∈ univ.filter (fun i => i.val < p.val), d i := by
          rw [Finset.sum_filter]
        rw [h1, ← Finset.sum_filter_add_sum_filter_not (univ.filter fun i => i.val < p.val)
          (fun i => 0 < d i)]
        have hpos : (univ.filter fun i => i.val < p.val).filter (fun i => 0 < d i) = P := by
          ext x
          simp only [Finset.mem_filter, hP, Finset.mem_univ, true_and]
          constructor
          · intro h; exact h.2
          · intro h
            refine ⟨?_, h⟩
            by_contra h2
            push Not at h2
            rcases eq_or_lt_of_le h2 with h2 | h2
            · have hxp : x = p := Fin.ext h2.symm
              rw [hxp] at h
              exact absurd h (not_lt_of_ge hpd)
            · exact no_dip v hv hp1 h2 hpd h
        have hnonpos : ∑ x ∈ (univ.filter fun i => i.val < p.val).filter (fun i => ¬0 < d i),
            d x = 0 := by
          apply Finset.sum_eq_zero
          intro x hx
          rw [Finset.mem_filter] at hx
          obtain ⟨hx1, hx2⟩ := hx
          obtain ⟨_, hxlt⟩ := Finset.mem_filter.mp hx1
          have hx0 : x = 0 := by
            by_contra hne
            have hx1' : 1 ≤ x.val := by
              by_contra h1x
              push Not at h1x
              have : x.val = 0 := by omega
              exact hne (Fin.ext this)
            have hxS : x ∈ S := by
              rw [hS, Finset.mem_filter]
              exact ⟨Finset.mem_univ x, ⟨hx1', le_of_not_gt hx2⟩⟩
            have hxp : p.val ≤ x.val := Finset.min'_le S x hxS
            omega
          rw [hx0]
          exact hd0
        rw [hpos, hnonpos, add_zero]
      calc ∑ a ∈ P, d a = det2 (edge v 0) (v p - v 0) := hT.symm
        _ = area2 (v 0) (v 1) (v p) := (hTj p).symm
        _ ≤ univ.sup' univ_nonempty (fun j : Fin n => area2 (v 0) (v 1) (v j)) :=
            Finset.le_sup' (fun j : Fin n => area2 (v 0) (v 1) (v j)) (Finset.mem_univ p)

/-- Convexity is invariant under rotating the vertex list by one step: the
cyclic-order condition on the indices is preserved by `· + 1`. -/
theorem IsConvexPolygon_succ {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ)
    (hv : IsConvexPolygon v) : IsConvexPolygon (fun j => v (j + 1)) := by
  intro i j k h
  by_cases hn : 3 ≤ n
  · have h1v : (1 : Fin n).val = 1 := by
      show (1 : ℕ) % n = 1
      rw [Nat.mod_eq_of_lt (by omega : 1 < n)]
    have hilt := i.isLt
    have hjlt := j.isLt
    have hklt := k.isLt
    have hlast : ∀ x : Fin n, x.val = n - 1 → (x + 1).val = 0 := by
      intro x hx
      rw [Fin.add_def, h1v, hx, show (n - 1 + 1 : ℕ) = n from by omega]
      simp
    have hstep : ∀ x : Fin n, x.val ≠ n - 1 → (x + 1).val = x.val + 1 := by
      intro x hx
      have hxlt := x.isLt
      exact Fin.val_add_one_of_lt' (by omega)
    rcases h with ⟨hij, hjk⟩ | ⟨hjk, hki⟩ | ⟨hki, hij⟩
    · by_cases hk : k.val = n - 1
      · exact hv (i + 1) (j + 1) (k + 1) (Or.inr (Or.inr ⟨by
          rw [hlast k hk, hstep i (by omega)]; omega,
          by rw [hstep i (by omega), hstep j (by omega)]; omega⟩))
      · exact hv (i + 1) (j + 1) (k + 1) (Or.inl ⟨by
          rw [hstep i (by omega), hstep j (by omega)]; omega,
          by rw [hstep j (by omega), hstep k hk]; omega⟩)
    · by_cases hi : i.val = n - 1
      · exact hv (i + 1) (j + 1) (k + 1) (Or.inl ⟨by
          rw [hlast i hi, hstep j (by omega)]; omega,
          by rw [hstep j (by omega), hstep k (by omega)]; omega⟩)
      · exact hv (i + 1) (j + 1) (k + 1) (Or.inr (Or.inl ⟨by
          rw [hstep j (by omega), hstep k (by omega)]; omega,
          by rw [hstep k (by omega), hstep i hi]; omega⟩))
    · by_cases hj : j.val = n - 1
      · exact hv (i + 1) (j + 1) (k + 1) (Or.inr (Or.inl ⟨by
          rw [hlast j hj, hstep k (by omega)]; omega,
          by rw [hstep k (by omega), hstep i (by omega)]; omega⟩))
      · exact hv (i + 1) (j + 1) (k + 1) (Or.inr (Or.inr ⟨by
          rw [hstep k (by omega), hstep i (by omega)]; omega,
          by rw [hstep i (by omega), hstep j hj]; omega⟩))
  · exfalso
    have hilt := i.isLt
    have hjlt := j.isLt
    have hklt := k.isLt
    omega

/-- Convexity is invariant under rotating the vertex list by any number of steps. -/
theorem IsConvexPolygon_add {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ)
    (hv : IsConvexPolygon v) (i : Fin n) : IsConvexPolygon (fun j => v (j + i)) := by
  suffices h : ∀ k (hk : k < n), IsConvexPolygon (fun j => v (j + ⟨k, hk⟩)) by
    exact h i.val i.isLt
  intro k
  induction k with
  | zero =>
      intro hk
      have he : (fun j : Fin n => v (j + ⟨0, hk⟩)) = v := by
        funext j
        congr 1
        rw [show (⟨0, hk⟩ : Fin n) = 0 from Fin.ext rfl]
        exact add_zero j
      rw [he]
      exact hv
  | succ k ih =>
      intro hk
      have hk' : k < n := Nat.lt_of_succ_lt hk
      have hstep := IsConvexPolygon_succ (fun j' => v (j' + ⟨k, hk'⟩)) (ih hk')
      have hkk : (⟨k, hk'⟩ : Fin n) + 1 = ⟨k + 1, hk⟩ := by
        ext
        show ((⟨k, hk'⟩ : Fin n) + 1).val = k + 1
        rw [Fin.val_add_one_of_lt' hk]
      have he : (fun j : Fin n => v (j + ⟨k + 1, hk⟩)) =
          (fun j => (fun j' => v (j' + ⟨k, hk'⟩)) (j + 1)) := by
        funext j
        show v (j + ⟨k + 1, hk⟩) = v ((j + 1) + ⟨k, hk'⟩)
        congr 1
        rw [← hkk, ← add_assoc, add_right_comm]
      rw [he]
      exact hstep

/-- The permutation of `Fin n` shifting every index by `i`. -/
def finShiftEquiv {n : ℕ} [NeZero n] (i : Fin n) : Fin n ≃ Fin n where
  toFun j := j + i
  invFun j := j - i
  left_inv j := add_sub_cancel_right j i
  right_inv j := sub_add_cancel j i

/-- Summing a function over a shift of `Fin n` does not change the sum. -/
theorem sum_add_eq {n : ℕ} [NeZero n] (f : Fin n → ℝ) (i : Fin n) :
    (∑ j : Fin n, f (j + i)) = ∑ j : Fin n, f j := by
  have h : ∀ j : Fin n, f (j + i) = f (finShiftEquiv i j) := fun j => rfl
  rw [Finset.sum_congr rfl (fun j _ => h j), Equiv.sum_comp (finShiftEquiv i) f]

/-- Taking the maximum of a function over a shift of `Fin n` does not change the
maximum. -/
theorem sup'_add_eq {n : ℕ} [NeZero n] (f : Fin n → ℝ) (i : Fin n) :
    (univ.sup' univ_nonempty fun j => f (j + i)) = univ.sup' univ_nonempty f := by
  apply le_antisymm
  · apply Finset.sup'_le univ_nonempty
    intro j _
    exact Finset.le_sup' f (Finset.mem_univ (j + i))
  · apply Finset.sup'_le univ_nonempty
    intro j _
    have h : f j = (fun j' => f (j' + i)) (j - i) := by
      show f j = f (j - i + i)
      rw [sub_add_cancel]
    rw [h]
    exact Finset.le_sup' (fun j' => f (j' + i)) (Finset.mem_univ (j - i))

/-- The maximum triangle area over side `i` equals half the absolute row sum:
`row_max_eq_zero` rotated to side `i`. -/
theorem row_max_eq {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ) (hv : IsConvexPolygon v)
    (i : Fin n) :
    (univ.sup' univ_nonempty fun j : Fin n => area2 (v i) (v (i + 1)) (v j)) =
      (∑ a : Fin n, |det2 (edge v i) (edge v a)|) / 2 := by
  have hconv : IsConvexPolygon (fun j => v (j + i)) := IsConvexPolygon_add v hv i
  have hedge : ∀ a : Fin n, edge (fun j => v (j + i)) a = edge v (a + i) := by
    intro a
    show v ((a + 1) + i) - v (a + i) = v ((a + i) + 1) - v (a + i)
    rw [show (a + 1) + i = (a + i) + 1 from add_right_comm a 1 i]
  have hr := row_max_eq_zero (fun j => v (j + i)) hconv
  simp only [zero_add] at hr
  rw [show (1 : Fin n) + i = i + 1 from add_comm 1 i] at hr
  simp only [hedge, zero_add] at hr
  rw [← sup'_add_eq (fun j => area2 (v i) (v (i + 1)) (v j)) i,
    ← sum_add_eq (fun a => |det2 (edge v i) (edge v a)|) i]
  exact hr

/-!
### The two key lemmas

The proof of the main theorem reduces to the following two statements about the
edge vectors, corresponding to the two steps `[Q] = 2 ∑ Sᵢ` and `[Q] ≥ 4 [P]`
of the official Solution 2.
-/

/-- Key lemma 1 (row maxima equal row absolute sums, summed):
`∑ i, (max_j area2 (v i) (v (i+1)) (v j)) = ∑_{i<j} |det2 (e i) (e j)|`.

Proof route: for fixed `i`, `area2 (v i) (v (i+1)) (v k) = ∑_{a=i}^{k-1} det2 (e i) (e a)`
(telescoping).  The distances of the vertices from the line of side `i` are unimodal
(a superlevel set of a linear functional on the vertices of a convex polygon is a
cyclic interval, and it cannot contain `i` or `i+1`), so the signs of
`det2 (e i) (e a)` for fixed `i` form one cyclic block of nonnegatives followed by one
cyclic block of nonpositives.  Hence the maximum partial sum equals the sum of the
nonnegative terms, which (as every row `a ↦ det2 (e i) (e a)` sums to
`det2 (e i) (∑ e a) = 0`) equals `½ ∑_a |det2 (e i) (e a)|`.  Summing over `i` gives
the claim. -/
theorem sum_sup_area2_eq_zonoArea {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ)
    (hv : IsConvexPolygon v) :
    (∑ i : Fin n, (univ.sup' univ_nonempty fun j : Fin n =>
        area2 (v i) (v (i + 1)) (v j))) =
      zonoArea v := by
  have hdouble : (∑ i : Fin n, ∑ a : Fin n, |det2 (edge v i) (edge v a)|) =
      2 * zonoArea v := by
    have hpt : ∀ i a : Fin n, |det2 (edge v i) (edge v a)| =
        (if i.val < a.val then |det2 (edge v i) (edge v a)| else 0) +
          (if a.val < i.val then |det2 (edge v i) (edge v a)| else 0) := by
      intro i a
      rcases lt_trichotomy i.val a.val with h | h | h
      · rw [if_pos h, if_neg (by omega : ¬a.val < i.val)]
        simp
      · have hai : i = a := Fin.ext h
        rw [if_neg (by omega : ¬i.val < a.val), if_neg (by omega : ¬a.val < i.val), hai]
        simp
      · rw [if_neg (by omega : ¬i.val < a.val), if_pos h]
        simp
    have hsplit : ∀ i : Fin n, (∑ a : Fin n, |det2 (edge v i) (edge v a)|) =
        (∑ a : Fin n, if i.val < a.val then |det2 (edge v i) (edge v a)| else 0) +
          (∑ a : Fin n, if a.val < i.val then |det2 (edge v i) (edge v a)| else 0) := by
      intro i
      rw [Finset.sum_congr rfl (fun a _ => hpt i a)]
      exact Finset.sum_add_distrib
    have hsplit_sum : (∑ i : Fin n, ∑ a : Fin n, |det2 (edge v i) (edge v a)|) =
        (∑ i : Fin n, ∑ a : Fin n,
          if i.val < a.val then |det2 (edge v i) (edge v a)| else 0) +
          (∑ i : Fin n, ∑ a : Fin n,
            if a.val < i.val then |det2 (edge v i) (edge v a)| else 0) := by
      rw [Finset.sum_congr rfl (fun i _ => hsplit i)]
      exact Finset.sum_add_distrib
    have hB : (∑ i : Fin n, ∑ a : Fin n,
        if a.val < i.val then |det2 (edge v i) (edge v a)| else 0) = zonoArea v := by
      have hswap : (∑ i : Fin n, ∑ a : Fin n,
          if a.val < i.val then |det2 (edge v i) (edge v a)| else 0) =
          ∑ a : Fin n, ∑ i : Fin n,
            if a.val < i.val then |det2 (edge v i) (edge v a)| else 0 :=
        Finset.sum_comm
      rw [hswap]
      unfold zonoArea
      apply Finset.sum_congr rfl
      intro i _
      apply Finset.sum_congr rfl
      intro a _
      by_cases h : i.val < a.val
      · rw [if_pos h, if_pos h, det2_neg, abs_neg]
      · rw [if_neg h, if_neg h]
    have hA : (∑ i : Fin n, ∑ a : Fin n,
        if i.val < a.val then |det2 (edge v i) (edge v a)| else 0) = zonoArea v := rfl
    rw [hsplit_sum, hA, hB]
    ring
  have hsumdiv : (∑ i : Fin n, (∑ a : Fin n, |det2 (edge v i) (edge v a)|) / 2) =
      (∑ i : Fin n, ∑ a : Fin n, |det2 (edge v i) (edge v a)|) / 2 :=
    (Finset.sum_div univ (fun i => ∑ a : Fin n, |det2 (edge v i) (edge v a)|) 2).symm
  rw [Finset.sum_congr rfl (fun i _ => row_max_eq v hv i), hsumdiv, hdouble]
  exact mul_div_cancel_left₀ _ two_ne_zero

/-!
### Edge sequences: norms, dot products, direction angles

The second key lemma is proved purely in terms of the edge-vector sequence
`e : Fin n → ℝ × ℝ`.  We need the Euclidean norm, the dot product and the
direction angle (`Complex.arg`) of a plane vector, related to `det2` by
`det2 v w = |v| |w| sin (arg w − arg v)`.
-/

/-- The Euclidean norm of a plane vector. -/
noncomputable def nrm (v : ℝ × ℝ) : ℝ := Real.sqrt (v.1 ^ 2 + v.2 ^ 2)

/-- The dot product of two plane vectors. -/
def dott (v w : ℝ × ℝ) : ℝ := v.1 * w.1 + v.2 * w.2

/-- The plane vector as a complex number. -/
noncomputable def toC (v : ℝ × ℝ) : ℂ := v.1 + v.2 * Complex.I

/-- The direction angle of a vector, in `(-π, π]` (junk value `0` at `0`). -/
noncomputable def dirAng (v : ℝ × ℝ) : ℝ := Complex.arg (toC v)

@[simp] theorem toC_re (v : ℝ × ℝ) : (toC v).re = v.1 := by
  simp [toC]

@[simp] theorem toC_im (v : ℝ × ℝ) : (toC v).im = v.2 := by
  simp [toC]

theorem toC_eq_zero_iff (v : ℝ × ℝ) : toC v = 0 ↔ v = 0 := by
  constructor
  · intro h
    have h1 := congrArg Complex.re h
    have h2 := congrArg Complex.im h
    simp at h1 h2
    exact Prod.ext h1 h2
  · intro h
    simp [h, toC]

theorem nrm_toC (v : ℝ × ℝ) : ‖toC v‖ = nrm v := by
  have h : ‖toC v‖ ^ 2 = v.1 ^ 2 + v.2 ^ 2 := by
    rw [← Complex.normSq_eq_norm_sq, Complex.normSq_apply]
    simp [toC]
    ring
  rw [nrm, ← h]
  exact (Real.sqrt_sq (norm_nonneg _)).symm

theorem nrm_eq_zero_iff (v : ℝ × ℝ) : nrm v = 0 ↔ v = 0 := by
  unfold nrm
  rw [Real.sqrt_eq_zero (by positivity)]
  constructor
  · intro h
    have h1 : v.1 ^ 2 = 0 := by
      have := sq_nonneg v.2
      linarith [sq_nonneg v.1]
    have h2 : v.2 ^ 2 = 0 := by
      have := sq_nonneg v.1
      linarith [sq_nonneg v.2]
    exact Prod.ext (sq_eq_zero_iff.mp h1) (sq_eq_zero_iff.mp h2)
  · intro h
    simp [h]

theorem nrm_pos_of_ne_zero (v : ℝ × ℝ) (hv : v ≠ 0) : 0 < nrm v := by
  unfold nrm
  apply Real.sqrt_pos_of_pos
  have h1 : 0 ≤ v.1 ^ 2 := sq_nonneg v.1
  have h2 : 0 ≤ v.2 ^ 2 := sq_nonneg v.2
  have : v.1 ≠ 0 ∨ v.2 ≠ 0 := by
    by_contra h
    push Not at h
    exact hv (Prod.ext h.1 h.2)
  rcases this with h | h
  · exact lt_of_lt_of_le (sq_pos_of_ne_zero h) (le_add_of_nonneg_right h2)
  · exact lt_of_lt_of_le (sq_pos_of_ne_zero h) (le_add_of_nonneg_left h1)

@[simp] theorem nrm_zero : nrm (0 : ℝ × ℝ) = 0 := by
  simp [nrm]

theorem nrm_nonneg (v : ℝ × ℝ) : 0 ≤ nrm v := Real.sqrt_nonneg _

theorem det2_zero_left (q : ℝ × ℝ) : det2 (0 : ℝ × ℝ) q = 0 := by
  simp [det2]

theorem det2_zero_right (p : ℝ × ℝ) : det2 p (0 : ℝ × ℝ) = 0 := by
  simp [det2]

/-- The fundamental relation: `det2 v w = |v| |w| sin (arg w − arg v)`. -/
theorem det2_eq_sin (v w : ℝ × ℝ) :
    det2 v w = nrm v * nrm w * Real.sin (dirAng w - dirAng v) := by
  by_cases hv : v = 0
  · simp [hv, det2]
  by_cases hw : w = 0
  · simp [hw, det2]
  have hcv : toC v ≠ 0 := (toC_eq_zero_iff v).not.mpr hv
  have hcw : toC w ≠ 0 := (toC_eq_zero_iff w).not.mpr hw
  have hnv : nrm v ≠ 0 := by
    rw [← nrm_toC]
    exact norm_ne_zero_iff.mpr hcv
  have hnw : nrm w ≠ 0 := by
    rw [← nrm_toC]
    exact norm_ne_zero_iff.mpr hcw
  rw [show dirAng v = Complex.arg (toC v) from rfl,
    show dirAng w = Complex.arg (toC w) from rfl, Real.sin_sub,
    Complex.sin_arg, Complex.sin_arg, Complex.cos_arg hcw, Complex.cos_arg hcv,
    toC_re, toC_im, toC_re, toC_im, ← nrm_toC, ← nrm_toC]
  rw [det2]
  field_simp
  try ring

/-- The dual relation: `dott v w = |v| |w| cos (arg w − arg v)`. -/
theorem dott_eq_cos (v w : ℝ × ℝ) :
    dott v w = nrm v * nrm w * Real.cos (dirAng w - dirAng v) := by
  by_cases hv : v = 0
  · simp [hv, dott]
  by_cases hw : w = 0
  · simp [hw, dott]
  have hcv : toC v ≠ 0 := (toC_eq_zero_iff v).not.mpr hv
  have hcw : toC w ≠ 0 := (toC_eq_zero_iff w).not.mpr hw
  have hnv : nrm v ≠ 0 := by
    rw [← nrm_toC]
    exact norm_ne_zero_iff.mpr hcv
  have hnw : nrm w ≠ 0 := by
    rw [← nrm_toC]
    exact norm_ne_zero_iff.mpr hcw
  rw [show dirAng v = Complex.arg (toC v) from rfl,
    show dirAng w = Complex.arg (toC w) from rfl, Real.cos_sub,
    Complex.sin_arg, Complex.sin_arg, Complex.cos_arg hcw, Complex.cos_arg hcv,
    toC_re, toC_im, toC_re, toC_im, ← nrm_toC, ← nrm_toC]
  rw [dott]
  field_simp
  try ring

theorem nrm_smul (t : ℝ) (v : ℝ × ℝ) : nrm (t • v) = |t| * nrm v := by
  unfold nrm
  simp [Prod.smul_fst, Prod.smul_snd, mul_pow]
  rw [show t ^ 2 * v.1 ^ 2 + t ^ 2 * v.2 ^ 2 = t ^ 2 * (v.1 ^ 2 + v.2 ^ 2) from by ring,
    Real.sqrt_mul (sq_nonneg t), Real.sqrt_sq_eq_abs]

theorem toC_smul (t : ℝ) (v : ℝ × ℝ) : toC (t • v) = (t : ℂ) * toC v := by
  simp [toC, Prod.smul_fst, Prod.smul_snd]
  ring

theorem dirAng_smul_of_pos (t : ℝ) (v : ℝ × ℝ) (ht : 0 < t) :
    dirAng (t • v) = dirAng v := by
  rw [show dirAng (t • v) = Complex.arg (toC (t • v)) from rfl,
    show dirAng v = Complex.arg (toC v) from rfl, toC_smul,
    Complex.arg_real_mul _ ht]

theorem nrm_neg (v : ℝ × ℝ) : nrm (-v) = nrm v := by
  simp [nrm]

/-- `sin (arg (−v) − x) = − sin (arg v − x)` for nonzero `v`. -/
theorem sin_dirAng_neg (v : ℝ × ℝ) (hv : v ≠ 0) (x : ℝ) :
    Real.sin (dirAng (-v) - x) = -Real.sin (dirAng v - x) := by
  have hcv : toC v ≠ 0 := (toC_eq_zero_iff v).not.mpr hv
  have h2 : toC (-v) = -toC v := by
    simp only [toC, Prod.fst_neg, Prod.snd_neg]
    push_cast
    ring
  have hcnv : -toC v ≠ 0 := neg_ne_zero.mpr hcv
  rw [show dirAng (-v) = Complex.arg (toC (-v)) from rfl,
    show dirAng v = Complex.arg (toC v) from rfl, h2, Real.sin_sub, Real.sin_sub,
    Complex.sin_arg, Complex.sin_arg, Complex.cos_arg hcnv, Complex.cos_arg hcv,
    Complex.neg_re, Complex.neg_im, norm_neg, toC_re, toC_im]
  ring

/-- `cos (arg (−v) − x) = − cos (arg v − x)` for nonzero `v`. -/
theorem cos_dirAng_neg (v : ℝ × ℝ) (hv : v ≠ 0) (x : ℝ) :
    Real.cos (dirAng (-v) - x) = -Real.cos (dirAng v - x) := by
  have hcv : toC v ≠ 0 := (toC_eq_zero_iff v).not.mpr hv
  have h2 : toC (-v) = -toC v := by
    simp only [toC, Prod.fst_neg, Prod.snd_neg]
    push_cast
    ring
  have hcnv : -toC v ≠ 0 := neg_ne_zero.mpr hcv
  rw [show dirAng (-v) = Complex.arg (toC (-v)) from rfl,
    show dirAng v = Complex.arg (toC v) from rfl, h2, Real.cos_sub, Real.cos_sub,
    Complex.sin_arg, Complex.sin_arg, Complex.cos_arg hcnv, Complex.cos_arg hcv,
    Complex.neg_re, Complex.neg_im, norm_neg, toC_re, toC_im]
  ring

theorem dirAng_mem_Ioc (v : ℝ × ℝ) : dirAng v ∈ Set.Ioc (-Real.pi) Real.pi :=
  Complex.arg_mem_Ioc _

/-- A representative of the direction *line* of a vector: the direction angle
modulo `π`, in `[0, π)`. -/
noncomputable def lineKey (v : ℝ × ℝ) : ℝ :=
  if dirAng v = Real.pi then 0
  else if 0 ≤ dirAng v then dirAng v
  else dirAng v + Real.pi

theorem lineKey_mem (v : ℝ × ℝ) : 0 ≤ lineKey v ∧ lineKey v < Real.pi := by
  have harg : dirAng v ∈ Set.Ioc (-Real.pi) Real.pi := dirAng_mem_Ioc v
  obtain ⟨h1, h2⟩ := harg
  unfold lineKey
  split_ifs with h3 h4
  · exact ⟨le_refl _, Real.pi_pos⟩
  · exact ⟨h4, lt_of_le_of_ne h2 h3⟩
  · exact ⟨by linarith, by linarith⟩

theorem lineKey_sub (v : ℝ × ℝ) :
    ∃ k : ℤ, lineKey v = dirAng v + k * Real.pi := by
  unfold lineKey
  split_ifs with h1 h2
  · exact ⟨-1, by rw [h1]; ring⟩
  · exact ⟨0, by simp⟩
  · exact ⟨1, by simp⟩

theorem sin_lineKey_sub_dirAng (v : ℝ × ℝ) :
    Real.sin (lineKey v - dirAng v) = 0 := by
  obtain ⟨k, hk⟩ := lineKey_sub v
  rw [hk]
  have : dirAng v + k * Real.pi - dirAng v = k * Real.pi := by ring
  rw [this, Real.sin_int_mul_pi]

/-- `lineKey` identifies exactly the vectors differing by an integer multiple
of `π` in direction angle, i.e. vectors on the same line through the origin. -/
theorem lineKey_eq_iff_int_pi (v w : ℝ × ℝ) :
    lineKey v = lineKey w ↔ ∃ k : ℤ, dirAng w = dirAng v + k * Real.pi := by
  obtain ⟨kv, hkv⟩ := lineKey_sub v
  obtain ⟨kw, hkw⟩ := lineKey_sub w
  constructor
  · intro h
    rw [hkv, hkw] at h
    exact ⟨kv - kw, by push_cast; linarith [h]⟩
  · intro ⟨k, hk⟩
    rw [hkv, hkw]
    obtain ⟨hv1, hv2⟩ := dirAng_mem_Ioc v
    obtain ⟨hw1, hw2⟩ := dirAng_mem_Ioc w
    have hm1 := lineKey_mem v
    have hm2 := lineKey_mem w
    rw [hkv] at hm1
    rw [hkw] at hm2
    have hd : dirAng v + kv * Real.pi - (dirAng w + kw * Real.pi) =
        (kv - kw - k) * Real.pi := by
      rw [hk]
      ring
    have h1 : -Real.pi < (kv - kw - k) * Real.pi := by
      linarith [hd, hm1.1, hm1.2, hm2.1, hm2.2]
    have h2 : (kv - kw - k) * Real.pi < Real.pi := by
      linarith [hd, hm1.1, hm1.2, hm2.1, hm2.2]
    have h3 : (-1 : ℝ) < (kv - kw - k : ℝ) := by
      by_contra hc
      push Not at hc
      have hle := mul_le_mul_of_nonneg_right hc (le_of_lt Real.pi_pos)
      ring_nf at hle
      linarith
    have h4 : (kv - kw - k : ℝ) < 1 := by
      by_contra hc
      push Not at hc
      have hle := mul_le_mul_of_nonneg_right hc (le_of_lt Real.pi_pos)
      ring_nf at hle
      linarith
    have h3' : (-1 : ℤ) < kv - kw - k := by exact_mod_cast h3
    have h4' : kv - kw - k < 1 := by exact_mod_cast h4
    have h5 : kv - kw - k = 0 := by omega
    have h5' : (↑kv - ↑kw - ↑k : ℝ) = 0 := by
      have h5'' : ((kv - kw - k : ℤ) : ℝ) = 0 := by exact_mod_cast h5
      push_cast at h5''
      exact h5''
    rw [h5'] at hd
    simp at hd
    linarith [hd]

theorem lineKey_eq_iff (v w : ℝ × ℝ) (hv : v ≠ 0) (hw : w ≠ 0) :
    lineKey v = lineKey w ↔ det2 v w = 0 := by
  rw [lineKey_eq_iff_int_pi]
  constructor
  · intro ⟨k, hk⟩
    rw [det2_eq_sin, hk]
    have : dirAng v + k * Real.pi - dirAng v = k * Real.pi := by ring
    rw [this, Real.sin_int_mul_pi]
    simp
  · intro h
    rw [det2_eq_sin] at h
    have hnv : nrm v ≠ 0 := (nrm_eq_zero_iff v).not.mpr hv
    have hnw : nrm w ≠ 0 := (nrm_eq_zero_iff w).not.mpr hw
    have hsin : Real.sin (dirAng w - dirAng v) = 0 := by
      have h1 : nrm v * nrm w * Real.sin (dirAng w - dirAng v) = 0 := h
      rcases mul_eq_zero.mp h1 with h2 | h2
      · rcases mul_eq_zero.mp h2 with h3 | h3
        · exact absurd h3 hnv
        · exact absurd h3 hnw
      · exact h2
    rw [Real.sin_eq_zero_iff] at hsin
    obtain ⟨k, hk⟩ := hsin
    exact ⟨k, by linarith [hk]⟩

theorem sin_neg_of_mem_Ioo (x : ℝ) (h1 : Real.pi < x) (h2 : x < 2 * Real.pi) :
    Real.sin x < 0 := by
  have : Real.sin x = -Real.sin (x - Real.pi) := by
    conv_lhs => rw [show x = x - Real.pi + Real.pi from by ring]
    rw [Real.sin_add_pi]
  rw [this]
  have h : 0 < Real.sin (x - Real.pi) := Real.sin_pos_of_pos_of_lt_pi (by linarith) (by linarith)
  linarith

theorem sin_nonpos_of_mem_Icc (x : ℝ) (h1 : Real.pi ≤ x) (h2 : x ≤ 2 * Real.pi) :
    Real.sin x ≤ 0 := by
  have : Real.sin x = -Real.sin (x - Real.pi) := by
    conv_lhs => rw [show x = x - Real.pi + Real.pi from by ring]
    rw [Real.sin_add_pi]
  rw [this]
  have h : 0 ≤ Real.sin (x - Real.pi) :=
    Real.sin_nonneg_of_nonneg_of_le_pi (by linarith) (by linarith)
  linarith

theorem sin_nonpos_of_neg_mem (x : ℝ) (h1 : -Real.pi ≤ x) (h2 : x ≤ 0) :
    Real.sin x ≤ 0 := by
  have : 0 ≤ Real.sin (-x) := Real.sin_nonneg_of_nonneg_of_le_pi (by linarith) (by linarith)
  have h2 : Real.sin x = -Real.sin (-x) := by rw [← Real.sin_neg]; simp
  linarith

theorem sin_nonneg_of_two_pi_sub_mem (x : ℝ) (h1 : 2 * Real.pi ≤ x)
    (h2 : x ≤ 3 * Real.pi) : 0 ≤ Real.sin x := by
  have : Real.sin x = Real.sin (x - 2 * Real.pi) := by
    rw [Real.sin_sub_two_pi]
  rw [this]
  exact Real.sin_nonneg_of_nonneg_of_le_pi (by linarith) (by linarith)

theorem sin_pos_of_two_pi_add_mem (x : ℝ) (h1 : 2 * Real.pi < x)
    (h2 : x < 3 * Real.pi) : 0 < Real.sin x := by
  have : Real.sin x = Real.sin (x - 2 * Real.pi) := by
    rw [Real.sin_sub_two_pi]
  rw [this]
  exact Real.sin_pos_of_pos_of_lt_pi (by linarith) (by linarith)

/-!
### Edge sequences and the defect functional `F`
-/

/-- A closed edge sequence: the edge vectors sum to zero. -/
def ESClosed {n : ℕ} (e : Fin n → ℝ × ℝ) : Prop := (∑ i, e i) = 0

/-- The zonotope area functional on edge sequences: `∑_{i<j} |det2 (e i) (e j)|`. -/
def GES {n : ℕ} (e : Fin n → ℝ × ℝ) : ℝ :=
  ∑ i : Fin n, ∑ j : Fin n, if i.val < j.val then |det2 (e i) (e j)| else 0

/-- The shoelace functional on edge sequences: `∑_{i<j} det2 (e i) (e j)|`. -/
def SES {n : ℕ} (e : Fin n → ℝ × ℝ) : ℝ :=
  ∑ i : Fin n, ∑ j : Fin n, if i.val < j.val then det2 (e i) (e j) else 0

/-- The defect `F = G − 2S`: this is `[Q] − 4[P]` of the official solution. -/
def FES {n : ℕ} (e : Fin n → ℝ × ℝ) : ℝ := GES e - 2 * SES e

/-- The number of nonzero edges. -/
noncomputable def esNu {n : ℕ} (e : Fin n → ℝ × ℝ) : ℕ :=
  (Finset.univ.filter fun i => e i ≠ 0).card

/-- The number of direction lines of the edge sequence. -/
noncomputable def esEll {n : ℕ} (e : Fin n → ℝ × ℝ) : ℕ :=
  ((Finset.univ.filter fun i => e i ≠ 0).image fun i => lineKey (e i)).card

/-- The induction measure. -/
noncomputable def MES {n : ℕ} (e : Fin n → ℝ × ℝ) : ℕ := esEll e * (n + 1) + esNu e

/-- A lift of the edge directions to a monotone real sequence with total
turning `2π` and steps of at most `π`.  This is the angle-free replacement of
the "angularly sorted" condition: it is invariant under all three reduction
operations of the official proof. -/
structure EdgeLift {n : ℕ} (e : Fin n → ℝ × ℝ) where
  Θ : ℕ → ℝ
  period : ∀ k, Θ (k + n) = Θ k + 2 * Real.pi
  step_nonneg : ∀ k, 0 ≤ Θ (k + 1) - Θ k
  step_le : ∀ k, Θ (k + 1) - Θ k ≤ Real.pi
  cons : ∀ i : Fin n, e i ≠ 0 → ∃ m : ℤ, Θ i.val = dirAng (e i) + 2 * Real.pi * m

namespace EdgeLift

variable {n : ℕ} {e : Fin n → ℝ × ℝ}

theorem monotone (L : EdgeLift e) : Monotone L.Θ :=
  monotone_nat_of_le_succ fun k => by
    have h := L.step_nonneg k
    linarith

/-- Determinant of two edges in terms of the lift. -/
theorem det2_eq (L : EdgeLift e) (i j : Fin n) :
    det2 (e i) (e j) =
      nrm (e i) * nrm (e j) * Real.sin (L.Θ j.val - L.Θ i.val) := by
  by_cases hi : e i = 0
  · simp [hi, det2_zero_left]
  by_cases hj : e j = 0
  · simp [hj, det2_zero_right]
  obtain ⟨mi, hi'⟩ := L.cons i hi
  obtain ⟨mj, hj'⟩ := L.cons j hj
  rw [det2_eq_sin, hi', hj']
  rw [show dirAng (e j) + 2 * Real.pi * ↑mj - (dirAng (e i) + 2 * Real.pi * ↑mi) =
      dirAng (e j) - dirAng (e i) + ↑(mj - mi) * (2 * Real.pi) from by
    push_cast; ring, Real.sin_add_int_mul_two_pi]

/-- Consecutive edges turn weakly left. -/
theorem consec (L : EdgeLift e) [NeZero n] (i : Fin n) : 0 ≤ det2 (e i) (e (i + 1)) := by
  rw [L.det2_eq]
  apply mul_nonneg (mul_nonneg (nrm_nonneg _) (nrm_nonneg _))
  by_cases hlast : i.val + 1 < n
  · rw [Fin.val_add_one_of_lt' hlast]
    exact Real.sin_nonneg_of_nonneg_of_le_pi
      (by have h := L.step_nonneg i.val; linarith)
      (by have h := L.step_le i.val; linarith)
  · have hi : i.val = n - 1 := by have := i.isLt; omega
    have hv : (i + 1).val = 0 := by
      have hmod : (n - 1 + 1 % n) % n = 0 := by
        have hn1 : 1 ≤ n := by have := i.isLt; omega
        by_cases hn2 : n = 1
        · rw [hn2]
        · rw [Nat.mod_eq_of_lt (by omega : 1 < n), show n - 1 + 1 = n from by omega,
            Nat.mod_self]
      show (i.val + (1 : Fin n).val) % n = 0
      rw [hi]
      exact hmod
    rw [hv]
    have hstep1 := L.step_nonneg (n - 1)
    have hstep2 := L.step_le (n - 1)
    have hnn : n - 1 + 1 = n := by have := i.isLt; omega
    rw [hnn] at hstep1 hstep2
    have hper := L.period 0
    simp at hper
    rw [show L.Θ 0 - L.Θ i.val = L.Θ n - L.Θ (n - 1) - 2 * Real.pi from by
      rw [hi, hper]; ring, Real.sin_sub_two_pi]
    exact Real.sin_nonneg_of_nonneg_of_le_pi hstep1 hstep2

end EdgeLift

/-! ### Turning angles and the closed-half-circle lemma -/

/-- The unit vector at angle `α`. -/
noncomputable def uVec (α : ℝ) : ℝ × ℝ := (Real.cos α, Real.sin α)

theorem nrm_uVec (α : ℝ) : nrm (uVec α) = 1 := by
  have h : (uVec α).1 ^ 2 + (uVec α).2 ^ 2 = 1 := by
    simp [uVec, Real.cos_sq_add_sin_sq]
  unfold nrm
  rw [h]
  simp

theorem uVec_ne_zero (α : ℝ) : uVec α ≠ 0 := by
  intro h
  have h1 := nrm_uVec α
  rw [h, nrm_zero] at h1
  simp at h1

/-- `det2 (uVec α) w = |w| sin (arg w − α)`. -/
theorem det2_uVec (α : ℝ) (w : ℝ × ℝ) (hw : w ≠ 0) :
    det2 (uVec α) w = nrm w * Real.sin (dirAng w - α) := by
  have hw2 : toC w ≠ 0 := (toC_eq_zero_iff w).not.mpr hw
  rw [Real.sin_sub, show dirAng w = Complex.arg (toC w) from rfl, Complex.sin_arg,
    Complex.cos_arg hw2, toC_re, toC_im, nrm_toC]
  show (uVec α).1 * w.2 - (uVec α).2 * w.1 = _
  simp only [uVec]
  field_simp [ne_of_gt (nrm_pos_of_ne_zero w hw)]
  try ring

/-- The direction angle of the unit vector at angle `α`, up to a `2π` shift. -/
theorem dirAng_uVec (α : ℝ) : ∃ k : ℤ, dirAng (uVec α) = α + 2 * Real.pi * (k : ℝ) := by
  have hne : uVec α ≠ 0 := uVec_ne_zero α
  have h1 : nrm (uVec α) = 1 := nrm_uVec α
  have hcos : Real.cos (dirAng (uVec α)) = Real.cos α := by
    have h2 : Real.cos (dirAng (uVec α)) = (toC (uVec α)).re / ‖toC (uVec α)‖ := by
      rw [dirAng, Complex.cos_arg ((toC_eq_zero_iff (uVec α)).not.mpr hne)]
    rw [nrm_toC, h1] at h2
    rw [h2]
    simp [uVec]
  have hsin : Real.sin (dirAng (uVec α)) = Real.sin α := by
    have h2 : Real.sin (dirAng (uVec α)) = (toC (uVec α)).im / ‖toC (uVec α)‖ := by
      rw [dirAng, Complex.sin_arg]
    rw [nrm_toC, h1] at h2
    rw [h2]
    simp [uVec]
  obtain ⟨k, hk | hk⟩ := Real.cos_eq_cos_iff.mp hcos
  · refine ⟨-k, by
      push_cast
      linarith [hk]⟩
  · have hdir : dirAng (uVec α) = 2 * (k : ℝ) * Real.pi - α := by linarith [hk]
    have h3 : Real.sin (2 * (k : ℝ) * Real.pi - α) = Real.sin α := by
      rw [← hdir]
      exact hsin
    have h4 : Real.sin (2 * (k : ℝ) * Real.pi - α) = -Real.sin α := by
      have h5 : 2 * (k : ℝ) * Real.pi - α = -α + (k : ℝ) * (2 * Real.pi) := by ring
      rw [h5, Real.sin_add_int_mul_two_pi, Real.sin_neg]
    have h6 : Real.sin α = 0 := by linarith [h3, h4]
    obtain ⟨m, hm⟩ := Real.sin_eq_zero_iff.mp h6
    refine ⟨k - m, by
      push_cast
      rw [← hm] at hdir
      linarith [hdir, hm]⟩

/-- `det2 (uVec α) (uVec β) = sin (β − α)`, the determinant of two unit vectors. -/
theorem det2_uVec_uVec (α β : ℝ) : det2 (uVec α) (uVec β) = Real.sin (β - α) := by
  show (uVec α).1 * (uVec β).2 - (uVec α).2 * (uVec β).1 = Real.sin (β - α)
  simp only [uVec]
  rw [Real.sin_sub]
  ring

/-- The turning angle from `v` to `w`, in `[0, 2π)`. -/
noncomputable def turnAng (v w : ℝ × ℝ) : ℝ :=
  if dirAng v ≤ dirAng w then dirAng w - dirAng v else dirAng w - dirAng v + 2 * Real.pi

theorem turnAng_nonneg (v w : ℝ × ℝ) : 0 ≤ turnAng v w := by
  obtain ⟨hv1, hv2⟩ := dirAng_mem_Ioc v
  obtain ⟨hw1, hw2⟩ := dirAng_mem_Ioc w
  unfold turnAng
  split_ifs with h
  · linarith
  · push Not at h
    linarith

theorem turnAng_lt_two_pi (v w : ℝ × ℝ) : turnAng v w < 2 * Real.pi := by
  obtain ⟨hv1, hv2⟩ := dirAng_mem_Ioc v
  obtain ⟨hw1, hw2⟩ := dirAng_mem_Ioc w
  unfold turnAng
  split_ifs with h
  · linarith
  · push Not at h
    linarith

theorem sin_turnAng (v w : ℝ × ℝ) :
    Real.sin (turnAng v w) = Real.sin (dirAng w - dirAng v) := by
  unfold turnAng
  split_ifs with h
  · rfl
  · exact Real.sin_add_two_pi _

theorem cos_turnAng (v w : ℝ × ℝ) :
    Real.cos (turnAng v w) = Real.cos (dirAng w - dirAng v) := by
  unfold turnAng
  split_ifs with h
  · rfl
  · exact Real.cos_add_two_pi _

theorem det2_pos_iff_turnAng (v w : ℝ × ℝ) (hv : v ≠ 0) (hw : w ≠ 0) :
    0 < det2 v w ↔ 0 < turnAng v w ∧ turnAng v w < Real.pi := by
  rw [det2_eq_sin, ← sin_turnAng]
  have h1 : 0 < nrm v * nrm w := mul_pos (nrm_pos_of_ne_zero v hv) (nrm_pos_of_ne_zero w hw)
  rw [mul_pos_iff_of_pos_left h1]
  constructor
  · intro h
    have hnn := turnAng_nonneg v w
    have hlt := turnAng_lt_two_pi v w
    constructor
    · rcases eq_or_lt_of_le hnn with h0 | h0
      · rw [← h0] at h
        simp at h
      · exact h0
    · by_contra hc
      push Not at hc
      have hle : Real.sin (turnAng v w) ≤ 0 := sin_nonpos_of_mem_Icc _ hc (le_of_lt hlt)
      linarith
  · intro h
    exact Real.sin_pos_of_pos_of_lt_pi h.1 h.2

/-- If all nonzero edges lie weakly on one side of a line, there is at most one
direction line. -/
theorem esEll_le_one_of_det2_sign {n : ℕ} (e : Fin n → ℝ × ℝ) (hclosed : ESClosed e)
    (u : ℝ × ℝ) (hu : u ≠ 0) (hsgn : ∀ i, e i ≠ 0 → 0 ≤ det2 u (e i)) :
    esEll e ≤ 1 := by
  have h1 : (∑ i, e i) = 0 := hclosed
  have hsum : (∑ i : Fin n, det2 u (e i)) = 0 := by
    rw [← det2_sum_right u univ e, h1]
    simp [det2]
  have hall : ∀ i ∈ univ, det2 u (e i) = 0 :=
    (Finset.sum_eq_zero_iff_of_nonneg (fun i _ => by
      by_cases hi : e i = 0
      · simp [hi, det2]
      · exact hsgn i hi)).mp hsum
  have himg : (univ.filter fun i => e i ≠ 0).image (fun i => lineKey (e i)) ⊆
      {lineKey u} := by
    intro y hy
    rw [Finset.mem_image] at hy
    obtain ⟨i, hi, rfl⟩ := hy
    rw [Finset.mem_filter] at hi
    have hdet : det2 u (e i) = 0 := hall i (Finset.mem_univ i)
    rw [Finset.mem_singleton]
    exact ((lineKey_eq_iff u (e i) hu hi.2).mpr hdet).symm
  unfold esEll
  exact le_trans (Finset.card_le_card himg) (by simp)

/-- The lift has no jumps of `π` or more between consecutive nonzero edges:
the immediate-next lift is less than `π` away. -/
theorem gap_lt_pi {n : ℕ} {e : Fin n → ℝ × ℝ} (L : EdgeLift e) (hclosed : ESClosed e)
    (h2 : 2 ≤ esEll e) (i j : Fin n) (_hei : e i ≠ 0) (_hej : e j ≠ 0)
    (himm : ∀ k : Fin n, e k ≠ 0 → ¬ (L.Θ i.val < L.Θ k.val ∧ L.Θ k.val < L.Θ j.val))
    (_hlt : L.Θ i.val < L.Θ j.val) : L.Θ j.val - L.Θ i.val < Real.pi := by
  by_contra hc
  push Not at hc
  have hn : L.Θ n = L.Θ 0 + 2 * Real.pi := by
    have h := L.period 0
    simp at h
    exact h
  have hile : L.Θ i.val ≤ L.Θ 0 + Real.pi := by
    have h3 : L.Θ j.val ≤ L.Θ n := L.monotone (show j.val ≤ n by omega)
    linarith [hc, h3, hn]
  have hsgn : ∀ k : Fin n, e k ≠ 0 → det2 (uVec (L.Θ i.val)) (e k) ≤ 0 := by
    intro k hk
    rw [det2_uVec _ _ hk]
    apply mul_nonpos_of_nonneg_of_nonpos (nrm_nonneg _)
    obtain ⟨mk, hmk⟩ := L.cons k hk
    have hsin : Real.sin (L.Θ k.val - L.Θ i.val) ≤ 0 := by
      by_cases hcase : L.Θ k.val ≤ L.Θ i.val
      · apply sin_nonpos_of_neg_mem
        · have h4 : L.Θ 0 ≤ L.Θ k.val := L.monotone (Nat.zero_le _)
          linarith [hile, h4]
        · linarith [hcase]
      · push Not at hcase
        have hge : L.Θ j.val ≤ L.Θ k.val := by
          by_contra hlt2
          push Not at hlt2
          exact himm k hk ⟨hcase, hlt2⟩
        apply sin_nonpos_of_mem_Icc
        · linarith [hc, hge]
        · have h4 : L.Θ k.val ≤ L.Θ n := L.monotone (show k.val ≤ n by omega)
          have h5 : L.Θ 0 ≤ L.Θ i.val := L.monotone (Nat.zero_le _)
          linarith [h4, h5, hn]
    have hsin2 : Real.sin (dirAng (e k) - L.Θ i.val) = Real.sin (L.Θ k.val - L.Θ i.val) := by
      rw [hmk]
      rw [show dirAng (e k) + 2 * Real.pi * ↑mk - L.Θ i.val =
          dirAng (e k) - L.Θ i.val + ↑mk * (2 * Real.pi) from by ring,
        Real.sin_add_int_mul_two_pi]
    rw [hsin2]
    exact hsin
  have hle := esEll_le_one_of_det2_sign e hclosed (-uVec (L.Θ i.val))
    (neg_ne_zero.mpr (uVec_ne_zero _)) (fun k hk => by
      rw [det2_neg_left]
      exact neg_nonneg.mpr (hsgn k hk))
  linarith [hle, h2]

/-- The wrap-around gap: the last nonzero edge back to the first nonzero edge
(through the `2π` boundary) is less than `π` away, when there are at least two
direction lines. -/
theorem gap_wrap_lt_pi {n : ℕ} {e : Fin n → ℝ × ℝ} (L : EdgeLift e) (hclosed : ESClosed e)
    (h2 : 2 ≤ esEll e) (i j : Fin n) (hei : e i ≠ 0) (hej : e j ≠ 0)
    (hlast : ∀ k : Fin n, i.val < k.val → e k = 0)
    (hfirst : ∀ k : Fin n, k.val < j.val → e k = 0) :
    L.Θ j.val + 2 * Real.pi - L.Θ i.val < Real.pi := by
  by_contra hc
  push Not at hc
  have hge : L.Θ i.val - L.Θ j.val ≤ Real.pi := by linarith [hc]
  have hsgn : ∀ k : Fin n, e k ≠ 0 → 0 ≤ det2 (uVec (L.Θ j.val)) (e k) := by
    intro k hk
    rw [det2_uVec _ _ hk]
    apply mul_nonneg (nrm_nonneg _)
    have hjk : j.val ≤ k.val := by
      by_contra hlt2
      push Not at hlt2
      exact hk (hfirst k (by omega))
    have hki : k.val ≤ i.val := by
      by_contra hlt2
      push Not at hlt2
      exact hk (hlast k (by omega))
    have h1 : L.Θ j.val ≤ L.Θ k.val := L.monotone hjk
    have h2' : L.Θ k.val ≤ L.Θ i.val := L.monotone hki
    have hsin : 0 ≤ Real.sin (L.Θ k.val - L.Θ j.val) :=
      Real.sin_nonneg_of_nonneg_of_le_pi (by linarith [h1]) (by linarith [h2', hge])
    obtain ⟨mk, hmk⟩ := L.cons k hk
    have hsin2 : Real.sin (dirAng (e k) - L.Θ j.val) = Real.sin (L.Θ k.val - L.Θ j.val) := by
      rw [hmk]
      rw [show dirAng (e k) + 2 * Real.pi * ↑mk - L.Θ j.val =
          dirAng (e k) - L.Θ j.val + ↑mk * (2 * Real.pi) from by ring,
        Real.sin_add_int_mul_two_pi]
    rw [hsin2]
    exact hsin
  have hle := esEll_le_one_of_det2_sign e hclosed (uVec (L.Θ j.val)) (uVec_ne_zero _) hsgn
  linarith [hle, h2]

/-- Iterated period law of a lift. -/
theorem EdgeLift.period_iter {n : ℕ} {e : Fin n → ℝ × ℝ} (L : EdgeLift e) :
    ∀ q : ℕ, ∀ x : ℕ, L.Θ (x + q * n) = L.Θ x + 2 * Real.pi * (q : ℝ) := by
  intro q
  induction' q with q ih
  · intro x
    simp
  · intro x
    have h1 : x + (q + 1) * n = (x + q * n) + n := by ring
    rw [h1, L.period, ih x]
    push_cast
    ring

/-- The flat-backward repair of a lift: at zero edges the angle stays at the
previous nonzero edge's value.  The repaired lift agrees with the original one
at every nonzero edge, and is constant across zero runs (`Θ (p+1) = Θ p`
whenever position `p+1` is a zero edge). -/
theorem edgeLift_flatPrev {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    (hclosed : ESClosed e) (h2 : 2 ≤ esEll e) :
    ∃ L' : EdgeLift e, (∀ t : Fin n, e t ≠ 0 → L'.Θ t.val = L.Θ t.val) ∧
      (∀ p : ℕ, e ⟨(p + 1) % n, Nat.mod_lt _ (NeZero.pos n)⟩ = 0 →
        L'.Θ (p + 1) = L'.Θ p) := by
  classical
  have hn1 : 0 < n := NeZero.pos n
  set S : Finset (Fin n) := univ.filter (fun t => e t ≠ 0) with hSdef
  have hSne : S.Nonempty := by
    have h2' : 2 ≤ ((univ.filter fun t => e t ≠ 0).image fun t => lineKey (e t)).card := h2
    have hcard : 0 < ((univ.filter fun t => e t ≠ 0).image fun t => lineKey (e t)).card := by
      omega
    rw [Finset.card_pos] at hcard
    obtain ⟨y, hy⟩ := hcard
    rw [Finset.mem_image] at hy
    obtain ⟨t, ht, _⟩ := hy
    exact ⟨t, ht⟩
  have hn2 : 2 ≤ n := by
    have h1 : 2 ≤ ((univ.filter fun t => e t ≠ 0).image fun t => lineKey (e t)).card := h2
    have h2' : ((univ.filter fun t => e t ≠ 0).image fun t => lineKey (e t)).card ≤
        (univ.filter fun t => e t ≠ 0).card := Finset.card_image_le
    have h3 : (univ.filter fun t => e t ≠ 0).card ≤ n := by
      have h4 : (univ.filter fun t => e t ≠ 0).card ≤ (univ : Finset (Fin n)).card :=
        Finset.card_le_card (Finset.filter_subset _ univ)
      have h5 : (univ : Finset (Fin n)).card = n := Finset.card_fin n
      rw [h5] at h4
      exact h4
    omega
  set lst : Fin n := S.max' hSne with hlst
  set fst : Fin n := S.min' hSne with hfst
  have hlst_e : e lst ≠ 0 := (Finset.mem_filter.mp (Finset.max'_mem S hSne)).2
  have hfst_e : e fst ≠ 0 := (Finset.mem_filter.mp (Finset.min'_mem S hSne)).2
  have hlast : ∀ k : Fin n, lst.val < k.val → e k = 0 := by
    intro k hk
    by_contra hke
    have hkS : k ∈ S := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hke⟩
    have hle := Finset.le_max' S k hkS
    simp only [Fin.le_def] at hle
    omega
  have hfirst : ∀ k : Fin n, k.val < fst.val → e k = 0 := by
    intro k hk
    by_contra hke
    have hkS : k ∈ S := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hke⟩
    have hle := Finset.min'_le S k hkS
    simp only [Fin.le_def] at hle
    omega
  set cand : ℕ → Finset (Fin n) := fun p => S.filter (fun t => t.val ≤ p % n) with hcand
  set gv : ℕ → ℕ := fun p =>
    if h : (cand p).Nonempty then (p - p % n) + ((cand p).max' h).val
    else (p - p % n) + lst.val with hgv
  set off : ℕ → ℝ := fun p => if (cand p).Nonempty then 0 else 2 * Real.pi with hoff
  set Θb : ℕ → ℝ := fun p => L.Θ (gv p) - off p with hΘb
  have hΘb2 : ∀ p, Θb p = L.Θ (gv p) - off p := fun p => rfl
  have hbase : ∀ p : ℕ, p - p % n = n * (p / n) := by
    intro p
    have h := Nat.div_add_mod p n
    omega
  have hgv_pos : ∀ (p : ℕ) (h : (cand p).Nonempty),
      gv p = (p - p % n) + ((cand p).max' h).val := by
    intro p h
    rw [hgv]
    exact dif_pos h
  have hgv_neg : ∀ (p : ℕ) (h : ¬(cand p).Nonempty), gv p = (p - p % n) + lst.val := by
    intro p h
    rw [hgv]
    exact dif_neg h
  have hoff_pos : ∀ (p : ℕ) (h : (cand p).Nonempty), off p = 0 := by
    intro p h
    rw [hoff]
    exact dif_pos h
  have hoff_neg : ∀ (p : ℕ) (h : ¬(cand p).Nonempty), off p = 2 * Real.pi := by
    intro p h
    rw [hoff]
    exact dif_neg h
  have hcand_period : ∀ p : ℕ, cand (p + n) = cand p := by
    intro p
    simp only [hcand, Nat.add_mod_right]
  have hmod2 : ∀ p : ℕ, (p + 1) % n = p % n + 1 ∨ ((p + 1) % n = 0 ∧ p % n = n - 1) := by
    intro p
    have h2 : p = n * (p / n) + p % n := (Nat.div_add_mod p n).symm
    have h3 : p % n < n := Nat.mod_lt p hn1
    by_cases h4 : p % n + 1 < n
    · left
      conv_lhs => rw [h2]
      rw [Nat.add_assoc, Nat.mul_add_mod_self_left, Nat.mod_eq_of_lt h4]
    · refine Or.inr ⟨?_, by omega⟩
      conv_lhs => rw [h2]
      have h5 : p % n + 1 = n := by omega
      rw [Nat.add_assoc, h5, Nat.mul_add_mod_self_left, Nat.mod_self]
  have hFlat : ∀ p : ℕ, e ⟨(p + 1) % n, Nat.mod_lt _ hn1⟩ = 0 → Θb (p + 1) = Θb p := by
    intro p hz
    rcases hmod2 p with hmod | ⟨hmod, hpn⟩
    · -- no wrap: the candidate sets agree
      have hcc : cand (p + 1) = cand p := by
        ext t
        simp only [hcand, Finset.mem_filter, hmod]
        constructor
        · intro ⟨htS, ht⟩
          refine ⟨htS, ?_⟩
          by_contra htle
          push Not at htle
          have htval : t.val = p % n + 1 := by omega
          have ht' : t = ⟨(p + 1) % n, Nat.mod_lt _ hn1⟩ := by
            apply Fin.ext
            rw [htval]
            exact hmod.symm
          rw [ht'] at htS
          exact absurd hz (Finset.mem_filter.mp htS).2
        · intro ⟨htS, ht⟩
          exact ⟨htS, by omega⟩
      simp only [hΘb, hgv, hoff, hcc, hmod]
      have hb2 : p + 1 - (p % n + 1) = p - p % n := by
        have := Nat.mod_le p n
        omega
      rw [hb2]
    · -- wrap: `cand (p+1) = ∅`, `cand p = S`
      have hcc1 : ¬(cand (p + 1)).Nonempty := by
        rw [Finset.not_nonempty_iff_eq_empty, Finset.filter_eq_empty_iff]
        intro t ht hle
        have htS := (Finset.mem_filter.mp ht).2
        have htval : t.val = (p + 1) % n := by
          simp only [hmod] at hle
          have := t.isLt
          omega
        have ht' : t = ⟨(p + 1) % n, Nat.mod_lt _ hn1⟩ := Fin.ext htval
        rw [ht'] at htS
        exact absurd hz htS
      have hcp : cand p = S := by
        simp only [hcand, Finset.filter_eq_self, hpn]
        intro t _
        have := t.isLt
        omega
      have hcc2 : (cand p).Nonempty := by
        rw [hcp]
        exact hSne
      have hmv : ((cand p).max' hcc2).val = lst.val := by
        have h1 : (cand p).max' hcc2 = lst := by
          apply le_antisymm
          · apply Finset.max'_le
            intro y hy
            exact Finset.le_max' _ _ (Finset.mem_filter.mp hy).1
          · have hlst_in : lst ∈ cand p := by
              rw [hcp]
              exact Finset.max'_mem S hSne
            exact Finset.le_max' _ _ hlst_in
        rw [h1]
      rw [hΘb2, hΘb2, hgv_neg _ hcc1, hoff_neg _ hcc1, hgv_pos _ hcc2, hoff_pos _ hcc2, hmv]
      have hb1 : p + 1 - (p + 1) % n = (p - p % n) + n := by
        rw [hmod]
        have := Nat.mod_le p n
        omega
      rw [hb1, show (p - p % n) + n + lst.val = ((p - p % n) + lst.val) + n from by ring,
        L.period]
      ring
  have hperiod := L.period_iter
  refine ⟨{ Θ := Θb
            period := ?_
            step_nonneg := ?_
            step_le := ?_
            cons := ?_ }, ?_, ?_⟩
  · -- period
    intro p
    have hb : p + n - (p + n) % n = (p - p % n) + n := by
      rw [Nat.add_mod_right]
      have := Nat.mod_le p n
      omega
    by_cases hcp : (cand p).Nonempty
    · have h1 : (cand (p + n)).Nonempty := by rwa [hcand_period p]
      have hm : ((cand (p + n)).max' h1).val = ((cand p).max' hcp).val := by
        have h2 : (cand (p + n)).max' h1 = (cand p).max' hcp := by
          apply le_antisymm
          · apply Finset.max'_le
            intro y hy
            have hy2 : y ∈ cand p := by
              rw [← hcand_period p]
              exact hy
            exact Finset.le_max' _ _ hy2
          · apply Finset.max'_le
            intro y hy
            have hy2 : y ∈ cand (p + n) := by
              rw [hcand_period p]
              exact hy
            exact Finset.le_max' _ _ hy2
        rw [h2]
      rw [hΘb2, hΘb2, hgv_pos _ h1, hoff_pos _ h1, hgv_pos _ hcp, hoff_pos _ hcp, hm, hb,
        show (p - p % n) + n + ((cand p).max' hcp).val =
          ((p - p % n) + ((cand p).max' hcp).val) + n from by ring, L.period]
      ring
    · have h1 : ¬(cand (p + n)).Nonempty := by rwa [hcand_period p]
      rw [hΘb2, hΘb2, hgv_neg _ h1, hoff_neg _ h1, hgv_neg _ hcp, hoff_neg _ hcp, hb,
        show (p - p % n) + n + lst.val = ((p - p % n) + lst.val) + n from by ring, L.period]
      ring
  · -- step_nonneg
    intro p
    by_cases hz : e ⟨(p + 1) % n, Nat.mod_lt _ hn1⟩ = 0
    · rw [hFlat p hz, sub_self]
    · have hmem1 : (⟨(p + 1) % n, Nat.mod_lt _ hn1⟩ : Fin n) ∈
          S.filter (fun t => t.val ≤ (p + 1) % n) := by
        apply Finset.mem_filter.mpr
        exact ⟨Finset.mem_filter.mpr ⟨Finset.mem_univ _, hz⟩, le_rfl⟩
      have hc1 : (cand (p + 1)).Nonempty := ⟨⟨(p + 1) % n, Nat.mod_lt _ hn1⟩, hmem1⟩
      have hsgv : gv (p + 1) = p + 1 := by
        have hmax : (cand (p + 1)).max' hc1 = ⟨(p + 1) % n, Nat.mod_lt _ hn1⟩ := by
          apply le_antisymm
          · apply Finset.max'_le
            intro y hy
            have hy2 := (Finset.mem_filter.mp hy).2
            simp only [Fin.le_def]
            exact hy2
          · exact Finset.le_max' _ _ hmem1
        rw [hgv_pos _ hc1, hmax]
        show (p + 1) - (p + 1) % n + (p + 1) % n = p + 1
        exact Nat.sub_add_cancel (Nat.mod_le (p + 1) n)
      have hsoff : off (p + 1) = 0 := hoff_pos _ hc1
      by_cases hcp : (cand p).Nonempty
      · rw [hΘb2, hΘb2, hsgv, hsoff, hgv_pos _ hcp, hoff_pos _ hcp]
        have hm : ((cand p).max' hcp).val ≤ p % n := (Finset.mem_filter.mp
          (Finset.max'_mem _ hcp)).2
        have hle1 : L.Θ ((p - p % n) + ((cand p).max' hcp).val) ≤ L.Θ p := by
          apply L.monotone
          have := Nat.mod_le p n
          omega
        have hle2 : L.Θ p ≤ L.Θ (p + 1) := L.monotone (Nat.le_succ p)
        linarith [hle1, hle2]
      · rw [hΘb2, hΘb2, hsgv, hsoff, hgv_neg _ hcp, hoff_neg _ hcp]
        have hlarge : p % n < lst.val := by
          by_contra hlt
          push Not at hlt
          exact hcp ⟨lst, Finset.mem_filter.mpr ⟨Finset.max'_mem S hSne, hlt⟩⟩
        have hle1 : L.Θ (p + 1) + 2 * Real.pi ≥ L.Θ ((p - p % n) + lst.val) := by
          have hub : L.Θ ((p - p % n) + lst.val) ≤ L.Θ ((p - p % n) + n) := by
            apply L.monotone
            have := lst.isLt
            omega
          have hper : L.Θ ((p - p % n) + n) = L.Θ (p - p % n) + 2 * Real.pi := L.period _
          have hlb : L.Θ (p - p % n) ≤ L.Θ (p + 1) := by
            apply L.monotone
            have := Nat.mod_le p n
            omega
          linarith [hub, hper, hlb]
        linarith [hle1]
  · -- step_le
    intro p
    by_cases hz : e ⟨(p + 1) % n, Nat.mod_lt _ hn1⟩ = 0
    · rw [hFlat p hz, sub_self]
      exact Real.pi_nonneg
    · have hmem1 : (⟨(p + 1) % n, Nat.mod_lt _ hn1⟩ : Fin n) ∈
          S.filter (fun t => t.val ≤ (p + 1) % n) := by
        apply Finset.mem_filter.mpr
        exact ⟨Finset.mem_filter.mpr ⟨Finset.mem_univ _, hz⟩, le_rfl⟩
      have hc1 : (cand (p + 1)).Nonempty := ⟨⟨(p + 1) % n, Nat.mod_lt _ hn1⟩, hmem1⟩
      have hsgv : gv (p + 1) = p + 1 := by
        have hmax : (cand (p + 1)).max' hc1 = ⟨(p + 1) % n, Nat.mod_lt _ hn1⟩ := by
          apply le_antisymm
          · apply Finset.max'_le
            intro y hy
            have hy2 := (Finset.mem_filter.mp hy).2
            simp only [Fin.le_def]
            exact hy2
          · exact Finset.le_max' _ _ hmem1
        rw [hgv_pos _ hc1, hmax]
        show (p + 1) - (p + 1) % n + (p + 1) % n = p + 1
        exact Nat.sub_add_cancel (Nat.mod_le (p + 1) n)
      have hsoff : off (p + 1) = 0 := hoff_pos _ hc1
      by_cases hcp : (cand p).Nonempty
      · rw [hΘb2, hΘb2, hsgv, hsoff, hgv_pos _ hcp, hoff_pos _ hcp]
        set m := ((cand p).max' hcp).val with hmdef
        have hmle : m ≤ p % n := (Finset.mem_filter.mp (Finset.max'_mem _ hcp)).2
        have hm_e : e ⟨m, ((cand p).max' hcp).isLt⟩ ≠ 0 :=
          (Finset.mem_filter.mp (Finset.mem_filter.mp (Finset.max'_mem _ hcp)).1).2
        by_cases hwrap : (p + 1) % n = 0
        · -- wrap step: the total is at most the wrap gap
          have hpn : p % n = n - 1 := by
            rcases hmod2 p with h1 | ⟨h1, h2⟩
            · omega
            · exact h2
          have hcpS : cand p = S := by
            simp only [hcand, Finset.filter_eq_self, hpn]
            intro t _
            have := t.isLt
            omega
          have hmv : m = lst.val := by
            have h1 : (cand p).max' hcp = lst := by
              apply le_antisymm
              · apply Finset.max'_le
                intro y hy
                exact Finset.le_max' _ _ (Finset.mem_filter.mp hy).1
              · have hlst_in : lst ∈ cand p := by
                  rw [hcpS]
                  exact Finset.max'_mem S hSne
                exact Finset.le_max' _ _ hlst_in
            rw [hmdef, h1]
          have hb1 : p + 1 = (p - p % n) + n := by
            have := Nat.mod_le p n
            omega
          have hp1 : L.Θ (p + 1) = L.Θ 0 + 2 * Real.pi * ((p / n : ℕ) + 1 : ℝ) := by
            rw [hb1, hbase p, show n * (p / n) + n = 0 + ((p / n) + 1) * n from by ring,
              hperiod]
            simp
          have hpm : L.Θ ((p - p % n) + m) = L.Θ m + 2 * Real.pi * ((p / n : ℕ) : ℝ) := by
            rw [hbase p, show n * (p / n) + m = m + (p / n) * n from by ring, hperiod]
          have hgap := gap_wrap_lt_pi L hclosed h2 lst fst hlst_e hfst_e hlast hfirst
          have h0 : L.Θ 0 ≤ L.Θ fst.val := L.monotone (Nat.zero_le _)
          rw [hp1, hpm, hmv]
          have h2pi : (2 : ℝ) * Real.pi * ((p / n : ℕ) + 1 : ℝ) =
              2 * Real.pi * ((p / n : ℕ) : ℝ) + 2 * Real.pi := by
            push_cast
            ring
          rw [h2pi]
          linarith [hgap, h0]
        · -- immediate-next step: at most the immediate gap
          have hpn : (p + 1) % n = p % n + 1 := by
            rcases hmod2 p with h1 | ⟨h1, h2⟩
            · exact h1
            · omega
          have hb1 : p + 1 = (p - p % n) + (p % n + 1) := by
            have := Nat.mod_le p n
            omega
          have himm : ∀ k : Fin n, e k ≠ 0 →
              ¬ (L.Θ m < L.Θ k.val ∧ L.Θ k.val < L.Θ ((p + 1) % n)) := by
            intro k hk ⟨hk1, hk2⟩
            have hk3 : k.val ≤ p % n := by
              by_contra hlt
              push Not at hlt
              have h1 : L.Θ ((p + 1) % n) ≤ L.Θ k.val := by
                apply L.monotone
                rw [hpn]
                omega
              linarith [h1, hk2]
            have hk4 : k.val ≤ m := by
              have hkS : k ∈ cand p := Finset.mem_filter.mpr ⟨
                Finset.mem_filter.mpr ⟨Finset.mem_univ _, hk⟩, hk3⟩
              exact Finset.le_max' _ k hkS
            have h1 : L.Θ k.val ≤ L.Θ m := L.monotone (by omega)
            linarith [h1, hk1]
          have hpm : L.Θ ((p - p % n) + m) = L.Θ m + 2 * Real.pi * ((p / n : ℕ) : ℝ) := by
            rw [hbase p, show n * (p / n) + m = m + (p / n) * n from by ring, hperiod]
          have hp1 : L.Θ (p + 1) = L.Θ ((p + 1) % n) + 2 * Real.pi * ((p / n : ℕ) : ℝ) := by
            rw [hpn, hb1, hbase p, show n * (p / n) + (p % n + 1) =
              (p % n + 1) + (p / n) * n from by ring, hperiod]
          by_cases hlt : L.Θ m < L.Θ ((p + 1) % n)
          · have hgap := gap_lt_pi L hclosed h2 ⟨m, by
              have h3 : ((cand p).max' hcp).val < n := ((cand p).max' hcp).isLt
              exact h3⟩ ⟨(p + 1) % n, Nat.mod_lt _ hn1⟩ hm_e hz himm hlt
            rw [hp1, hpm]
            have hval : ((⟨(p + 1) % n, Nat.mod_lt _ hn1⟩ : Fin n)).val = (p + 1) % n := rfl
            rw [hval] at hgap
            linarith [hgap]
          · push Not at hlt
            rw [hp1, hpm]
            have hval : ((⟨(p + 1) % n, Nat.mod_lt _ hn1⟩ : Fin n)).val = (p + 1) % n := rfl
            have h0 := Real.pi_pos
            linarith [hlt, h0]
      · rw [hΘb2, hΘb2, hsgv, hsoff, hgv_neg _ hcp, hoff_neg _ hcp]
        have hlarge : p % n < fst.val := by
          by_contra hlt
          push Not at hlt
          exact hcp ⟨fst, Finset.mem_filter.mpr ⟨Finset.min'_mem S hSne, hlt⟩⟩
        have hpn : (p + 1) % n = p % n + 1 := by
          rcases hmod2 p with h1 | ⟨h1, h2⟩
          · exact h1
          · omega
        have hfst_eq : (p + 1) % n = fst.val := by
          have h1 : p % n + 1 ≤ fst.val := by omega
          have h2 : ⟨(p + 1) % n, Nat.mod_lt _ hn1⟩ ∈
              univ.filter (fun t => e t ≠ 0) :=
            Finset.mem_filter.mpr ⟨Finset.mem_univ _, hz⟩
          have h3 : fst.val ≤ (p + 1) % n := Finset.min'_le S _ h2
          omega
        have hb1 : p + 1 = (p - p % n) + fst.val := by
          have := Nat.mod_le p n
          omega
        have hp1 : L.Θ (p + 1) = L.Θ fst.val + 2 * Real.pi * ((p / n : ℕ) : ℝ) := by
          rw [hb1, hbase p, show n * (p / n) + fst.val = fst.val + (p / n) * n from by ring,
            hperiod]
        have hpm : L.Θ ((p - p % n) + lst.val) =
            L.Θ lst.val + 2 * Real.pi * ((p / n : ℕ) : ℝ) := by
          rw [hbase p, show n * (p / n) + lst.val = lst.val + (p / n) * n from by ring,
            hperiod]
        have hgap := gap_wrap_lt_pi L hclosed h2 lst fst hlst_e hfst_e hlast hfirst
        rw [hp1, hpm]
        linarith [hgap]
  · -- cons
    intro t ht
    have htS : t ∈ cand t := by
      have h1 : t ∈ S.filter (fun u => u.val ≤ t.val % n) := by
        apply Finset.mem_filter.mpr
        refine ⟨Finset.mem_filter.mpr ⟨Finset.mem_univ _, ht⟩, ?_⟩
        show t.val ≤ t.val % n
        rw [Nat.mod_eq_of_lt t.isLt]
      exact h1
    have hct : (cand t).Nonempty := ⟨t, htS⟩
    have hmax : (cand t).max' hct = t := by
      apply le_antisymm
      · apply Finset.max'_le
        intro y hy
        have hy2 := (Finset.mem_filter.mp hy).2
        simp only [Fin.le_def]
        have ht2 : t.val % n = t.val := Nat.mod_eq_of_lt t.isLt
        rw [ht2] at hy2
        exact hy2
      · exact Finset.le_max' _ _ htS
    rw [hΘb2, hgv_pos _ hct, hoff_pos _ hct, hmax]
    have hb : t.val - t.val % n = 0 := by
      rw [Nat.mod_eq_of_lt t.isLt]
      omega
    rw [hb, zero_add, sub_zero]
    exact L.cons t ht
  · -- agreement at nonzero edges
    intro t ht
    have htS : t ∈ cand t := by
      have h1 : t ∈ S.filter (fun u => u.val ≤ t.val % n) := by
        apply Finset.mem_filter.mpr
        refine ⟨Finset.mem_filter.mpr ⟨Finset.mem_univ _, ht⟩, ?_⟩
        show t.val ≤ t.val % n
        rw [Nat.mod_eq_of_lt t.isLt]
      exact h1
    have hct : (cand t).Nonempty := ⟨t, htS⟩
    have hmax : (cand t).max' hct = t := by
      apply le_antisymm
      · apply Finset.max'_le
        intro y hy
        have hy2 := (Finset.mem_filter.mp hy).2
        simp only [Fin.le_def]
        have ht2 : t.val % n = t.val := Nat.mod_eq_of_lt t.isLt
        rw [ht2] at hy2
        exact hy2
      · exact Finset.le_max' _ _ htS
    show L.Θ (gv t.val) - off t.val = L.Θ t.val
    rw [hgv_pos _ hct, hoff_pos _ hct, hmax]
    have hb : t.val - t.val % n = 0 := by
      rw [Nat.mod_eq_of_lt t.isLt]
      omega
    rw [hb, zero_add, sub_zero]
  · -- flat at zero edges
    intro p hz
    exact hFlat p hz

/-!
### Sum-manipulation lemmas for `GES` and `SES`

`GES` is first written as half of the full determinant-matrix sum, which is
invariant under arbitrary index reindexing; `SES` is handled with
position-aware update formulas.
-/

/-- The full determinant-matrix sum; equals twice `GES`. -/
def fullAbs {n : ℕ} (e : Fin n → ℝ × ℝ) : ℝ :=
  ∑ i : Fin n, ∑ j : Fin n, |det2 (e i) (e j)|

theorem fullAbs_eq_two_GES {n : ℕ} (e : Fin n → ℝ × ℝ) :
    fullAbs e = 2 * GES e := by
  have hpt : ∀ i j : Fin n, |det2 (e i) (e j)| =
      (if i.val < j.val then |det2 (e i) (e j)| else 0) +
        (if j.val < i.val then |det2 (e i) (e j)| else 0) := by
    intro i j
    rcases lt_trichotomy i.val j.val with h | h | h
    · rw [if_pos h, if_neg (by omega : ¬ j.val < i.val)]
      simp
    · have hai : i = j := Fin.ext h
      rw [if_neg (by omega : ¬ i.val < j.val), if_neg (by omega : ¬ j.val < i.val), hai]
      simp
    · rw [if_neg (by omega : ¬ i.val < j.val), if_pos h]
      simp
  have hsplit : (∑ i : Fin n, ∑ j : Fin n, |det2 (e i) (e j)|) =
      (∑ i : Fin n, ∑ j : Fin n, if i.val < j.val then |det2 (e i) (e j)| else 0) +
        (∑ i : Fin n, ∑ j : Fin n, if j.val < i.val then |det2 (e i) (e j)| else 0) := by
    rw [Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => hpt i j))]
    simp only [Finset.sum_add_distrib]
  have hB : (∑ i : Fin n, ∑ j : Fin n,
      if j.val < i.val then |det2 (e i) (e j)| else 0) =
        ∑ i : Fin n, ∑ j : Fin n, if i.val < j.val then |det2 (e i) (e j)| else 0 := by
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro j _
    apply Finset.sum_congr rfl
    intro i _
    by_cases h : j.val < i.val
    · rw [if_pos h, if_pos h, det2_neg, abs_neg]
    · rw [if_neg h, if_neg h]
  rw [fullAbs, GES, hsplit, hB]
  ring

theorem GES_eq_half_full {n : ℕ} (e : Fin n → ℝ × ℝ) :
    GES e = fullAbs e / 2 := by
  rw [fullAbs_eq_two_GES]
  field_simp

/-- Updating one edge changes `fullAbs` by twice the change of its row. -/
theorem fullAbs_update_sub {n : ℕ} (e : Fin n → ℝ × ℝ) (j : Fin n) (x : ℝ × ℝ) :
    fullAbs (Function.update e j x) - fullAbs e =
      2 * ∑ k ∈ univ.erase j, (|det2 x (e k)| - |det2 (e j) (e k)|) := by
  set upd := Function.update e j x with hupd
  have hrow : ∀ i : Fin n, i ≠ j →
      (∑ k : Fin n, |det2 (upd i) (upd k)|) =
        |det2 x (e i)| + ∑ k ∈ univ.erase j, |det2 (e i) (e k)| := by
    intro i hi
    have h1 : upd i = e i := by
      rw [hupd]
      exact Function.update_of_ne hi _ e
    rw [h1, ← Finset.add_sum_erase univ (fun k => |det2 (e i) (upd k)|) (Finset.mem_univ j)]
    have h2 : |det2 (e i) (upd j)| = |det2 x (e i)| := by
      rw [hupd, Function.update_self, det2_neg, abs_neg]
    rw [h2]
    congr 1
    apply Finset.sum_congr rfl
    intro k hk
    have hk' : k ≠ j := Finset.ne_of_mem_erase hk
    rw [hupd, Function.update_of_ne hk' _ e]
  have hrowj : (∑ k : Fin n, |det2 (upd j) (upd k)|) =
      ∑ k ∈ univ.erase j, |det2 x (e k)| := by
    rw [← Finset.add_sum_erase univ (fun k => |det2 (upd j) (upd k)|) (Finset.mem_univ j)]
    have h2 : |det2 (upd j) (upd j)| = 0 := by
      rw [hupd, Function.update_self, det2_self]
      simp
    rw [h2, zero_add]
    apply Finset.sum_congr rfl
    intro k hk
    have hk' : k ≠ j := Finset.ne_of_mem_erase hk
    rw [hupd, Function.update_self, Function.update_of_ne hk' _ e]
  have hsplit : fullAbs upd =
      (∑ i ∈ univ.erase j, ∑ k : Fin n, |det2 (upd i) (upd k)|) +
        ∑ k : Fin n, |det2 (upd j) (upd k)| := by
    unfold fullAbs
    rw [← Finset.add_sum_erase univ (fun i => ∑ k, |det2 (upd i) (upd k)|)
      (Finset.mem_univ j), add_comm]
  have hold : fullAbs e =
      (∑ i ∈ univ.erase j, ∑ k ∈ univ.erase j, |det2 (e i) (e k)|) +
        2 * ∑ k ∈ univ.erase j, |det2 (e j) (e k)| := by
    unfold fullAbs
    rw [← Finset.add_sum_erase univ (fun i => ∑ k, |det2 (e i) (e k)|)
      (Finset.mem_univ j), add_comm]
    have hrowe : (∑ k : Fin n, |det2 (e j) (e k)|) =
        ∑ k ∈ univ.erase j, |det2 (e j) (e k)| := by
      rw [← Finset.add_sum_erase univ (fun k => |det2 (e j) (e k)|) (Finset.mem_univ j)]
      simp
    rw [hrowe]
    have hcol : (∑ i ∈ univ.erase j, ∑ k : Fin n, |det2 (e i) (e k)|) =
        (∑ i ∈ univ.erase j, ∑ k ∈ univ.erase j, |det2 (e i) (e k)|) +
          ∑ i ∈ univ.erase j, |det2 (e j) (e i)| := by
      rw [← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro i hi
      rw [← Finset.add_sum_erase univ (fun k => |det2 (e i) (e k)|) (Finset.mem_univ j)]
      have habs : |det2 (e i) (e j)| = |det2 (e j) (e i)| := by rw [det2_neg, abs_neg]
      rw [habs, add_comm]
    rw [hcol]
    ring
  rw [hsplit, hrowj, hold]
  rw [Finset.sum_congr rfl (fun i hi => hrow i (Finset.ne_of_mem_erase hi))]
  rw [Finset.sum_add_distrib, Finset.sum_sub_distrib]
  ring

/-- Updating one edge changes `GES` by the change of its row. -/
theorem GES_update_sub {n : ℕ} (e : Fin n → ℝ × ℝ) (j : Fin n) (x : ℝ × ℝ) :
    GES (Function.update e j x) - GES e =
      ∑ k ∈ univ.erase j, (|det2 x (e k)| - |det2 (e j) (e k)|) := by
  rw [GES_eq_half_full, GES_eq_half_full]
  rw [show fullAbs (Function.update e j x) / 2 - fullAbs e / 2 =
      (fullAbs (Function.update e j x) - fullAbs e) / 2 from by ring]
  rw [fullAbs_update_sub, mul_div_cancel_left₀ _ two_ne_zero]

/-- Updating one edge changes `SES` by two explicit position-aware sums. -/
theorem SES_update_sub {n : ℕ} (e : Fin n → ℝ × ℝ) (j : Fin n) (x : ℝ × ℝ) :
    SES (Function.update e j x) - SES e =
      (∑ k ∈ univ.filter fun k => k.val < j.val, det2 (e k) (x - e j)) +
        (∑ k ∈ univ.filter fun k => j.val < k.val, det2 (x - e j) (e k)) := by
  have hterm : ∀ i k : Fin n,
      (if i.val < k.val then det2 (Function.update e j x i) (Function.update e j x k)
        else 0) -
      (if i.val < k.val then det2 (e i) (e k) else 0) =
      (if k = j ∧ i.val < j.val then det2 (e i) (x - e j) else 0) +
      (if i = j ∧ j.val < k.val then det2 (x - e j) (e k) else 0) := by
    intro i k
    by_cases hik : i.val < k.val
    · rw [if_pos hik, if_pos hik]
      by_cases hk : k = j
      · subst hk
        rw [Function.update_self, Function.update_of_ne (by
          intro hcontra
          rw [hcontra] at hik
          exact lt_irrefl _ hik)]
        rw [if_pos ⟨rfl, hik⟩, if_neg (by rintro ⟨rfl, h2⟩; exact lt_irrefl _ h2)]
        simp [det2_sub_right]
      · rw [Function.update_of_ne hk]
        by_cases hi : i = j
        · subst hi
          rw [Function.update_self]
          rw [if_neg (by rintro ⟨rfl, h2⟩; exact lt_irrefl _ h2), if_pos ⟨rfl, hik⟩]
          simp [det2_sub_left]
        · rw [Function.update_of_ne hi, if_neg (by rintro ⟨h1, -⟩; exact hk h1),
            if_neg (by rintro ⟨h1, -⟩; exact hi h1)]
          simp
    · rw [if_neg hik, if_neg hik,
        if_neg (by rintro ⟨h1, h2⟩; exact hik (h1.symm ▸ h2)),
        if_neg (by rintro ⟨h1, h2⟩; exact hik (h1 ▸ h2))]
      simp
  have hmain : SES (Function.update e j x) - SES e =
      (∑ i : Fin n, ∑ k : Fin n,
        if k = j ∧ i.val < j.val then det2 (e i) (x - e j) else 0) +
        (∑ i : Fin n, ∑ k : Fin n,
          if i = j ∧ j.val < k.val then det2 (x - e j) (e k) else 0) := by
    unfold SES
    rw [← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro i _
    rw [← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro k _
    exact hterm i k
  rw [hmain]
  have hpiece1 : (∑ i : Fin n, ∑ k : Fin n,
      if k = j ∧ i.val < j.val then det2 (e i) (x - e j) else 0) =
        ∑ k ∈ univ.filter (fun k => k.val < j.val), det2 (e k) (x - e j) := by
    rw [Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro i _
    rw [show (∑ k : Fin n, if k = j ∧ i.val < j.val then det2 (e i) (x - e j) else 0) =
      ∑ k : Fin n, if k = j then (if i.val < j.val then det2 (e i) (x - e j) else 0)
        else 0 from by
      apply Finset.sum_congr rfl
      intro k _
      by_cases hk : k = j
      · subst hk
        try simp
      · rw [if_neg (by rintro ⟨h1, -⟩; exact hk h1), if_neg hk]]
    rw [Finset.sum_ite_eq' univ j (fun k => if i.val < j.val then det2 (e i) (x - e j)
      else 0)]
    simp
  have hpiece2 : (∑ i : Fin n, ∑ k : Fin n,
      if i = j ∧ j.val < k.val then det2 (x - e j) (e k) else 0) =
        ∑ k ∈ univ.filter (fun k => j.val < k.val), det2 (x - e j) (e k) := by
    rw [Finset.sum_comm, Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro k _
    rw [show (∑ i : Fin n, if i = j ∧ j.val < k.val then det2 (x - e j) (e k) else 0) =
      ∑ i : Fin n, if i = j then (if j.val < k.val then det2 (x - e j) (e k) else 0)
        else 0 from by
      apply Finset.sum_congr rfl
      intro i _
      by_cases hi : i = j
      · subst hi
        try simp
      · rw [if_neg (by rintro ⟨h1, -⟩; exact hi h1), if_neg hi]]
    rw [Finset.sum_ite_eq' univ j (fun i => if j.val < k.val then det2 (x - e j) (e k)
      else 0)]
    simp
  rw [hpiece1, hpiece2]

/-- Summing over `univ.erase p` in `Fin (n+1)` reindexed through `succAbove`. -/
theorem Fin.sum_succAbove {n : ℕ} (p : Fin (n + 1)) (f : Fin (n + 1) → ℝ) :
    (∑ k : Fin n, f (p.succAbove k)) = ∑ j ∈ univ.erase p, f j := by
  apply Finset.sum_bij (fun k _ => p.succAbove k)
  · intro k _
    exact Finset.mem_erase.mpr ⟨Fin.succAbove_ne p k, Finset.mem_univ _⟩
  · intro k1 _ k2 _ h
    exact Fin.succAbove_right_injective h
  · intro j hj
    have hj' : j ≠ p := Finset.ne_of_mem_erase hj
    obtain ⟨z, hz⟩ := Fin.exists_succAbove_eq hj'
    exact ⟨z, Finset.mem_univ _, hz⟩
  · intro k _
    rfl

/-- Inserting an edge adds its absolute row to `fullAbs`. -/
theorem fullAbs_insertNth_sub {n : ℕ} (e : Fin n → ℝ × ℝ) (p : Fin (n + 1))
    (x : ℝ × ℝ) :
    fullAbs (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e) - fullAbs e =
      2 * ∑ k : Fin n, |det2 x (e k)| := by
  have hsplit : fullAbs (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e) =
      (∑ i ∈ univ.erase p, ∑ k : Fin (n + 1),
        |det2 (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e i) (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e k)|) +
        ∑ k : Fin (n + 1), |det2 (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e p) (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e k)| := by
    unfold fullAbs
    rw [← Finset.add_sum_erase univ (fun i => ∑ k,
      |det2 (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e i) (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e k)|) (Finset.mem_univ p),
      add_comm]
  have hrowp : (∑ k : Fin (n + 1),
      |det2 (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e p) (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e k)|) =
        ∑ k : Fin n, |det2 x (e k)| := by
    rw [Fin.insertNth_apply_same]
    rw [← Finset.add_sum_erase univ (fun k => |det2 x (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e k)|)
      (Finset.mem_univ p)]
    have h0 : |det2 x (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e p)| = 0 := by
      rw [Fin.insertNth_apply_same]
      simp
    rw [h0, zero_add, ← Fin.sum_succAbove p (fun k => |det2 x (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e k)|)]
    apply Finset.sum_congr rfl
    intro k _
    rw [Fin.insertNth_apply_succAbove]
  have hrows : (∑ i ∈ univ.erase p, ∑ k : Fin (n + 1),
      |det2 (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e i) (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e k)|) =
        ∑ i : Fin n, (∑ k : Fin n, |det2 (e i) (e k)| + |det2 (e i) x|) := by
    rw [← Fin.sum_succAbove p (fun i => ∑ k : Fin (n + 1),
      |det2 (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e i) (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e k)|)]
    apply Finset.sum_congr rfl
    intro i _
    rw [Fin.insertNth_apply_succAbove]
    rw [← Finset.add_sum_erase univ (fun k => |det2 (e i) (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e k)|)
      (Finset.mem_univ p)]
    rw [Fin.insertNth_apply_same, add_comm]
    congr 1
    rw [← Fin.sum_succAbove p (fun k => |det2 (e i) (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e k)|)]
    apply Finset.sum_congr rfl
    intro k _
    rw [Fin.insertNth_apply_succAbove]
  rw [hsplit, hrowp, hrows, Finset.sum_add_distrib]
  have habs : ∀ i : Fin n, |det2 (e i) x| = |det2 x (e i)| := by
    intro i
    rw [det2_neg, abs_neg]
  rw [Finset.sum_congr rfl (fun i _ => habs i), fullAbs]
  ring

/-- Inserting an edge adds its absolute row to `GES`. -/
theorem GES_insertNth_sub {n : ℕ} (e : Fin n → ℝ × ℝ) (p : Fin (n + 1))
    (x : ℝ × ℝ) :
    GES (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e) - GES e = ∑ k : Fin n, |det2 x (e k)| := by
  rw [GES_eq_half_full, GES_eq_half_full]
  rw [show fullAbs (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e) / 2 - fullAbs e / 2 =
      (fullAbs (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e) - fullAbs e) / 2 from by ring]
  rw [fullAbs_insertNth_sub, mul_div_cancel_left₀ _ two_ne_zero]

/-- The value of `succAbove` on values. -/
theorem Fin.succAbove_val {n : ℕ} (p : Fin (n + 1)) (q : Fin n) :
    (p.succAbove q).val = if q.val < p.val then q.val else q.val + 1 := by
  by_cases hq : q.val < p.val
  · have h : q.castSucc < p := hq
    rw [Fin.succAbove_of_castSucc_lt p q h, if_pos hq, Fin.val_castSucc]
  · have h : p ≤ q.castSucc := by
      rw [Fin.le_def, Fin.val_castSucc]
      exact le_of_not_gt hq
    rw [Fin.succAbove_of_le_castSucc p q h, if_neg hq, Fin.val_succ]

/-- `succAbove` is strictly monotone. -/
theorem Fin.succAbove_lt_succAbove {n : ℕ} (p : Fin (n + 1)) (a k : Fin n) :
    (p.succAbove a).val < (p.succAbove k).val ↔ a.val < k.val := by
  rw [Fin.succAbove_val p a, Fin.succAbove_val p k]
  by_cases ha : a.val < p.val <;> by_cases hk : k.val < p.val <;>
    simp [ha, hk] <;> omega

/-- Inserting an edge changes `SES` by its position-aware row. -/
theorem SES_insertNth_sub {n : ℕ} (e : Fin n → ℝ × ℝ) (p : Fin (n + 1))
    (x : ℝ × ℝ) :
    SES (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e) - SES e =
      ∑ k : Fin n, if k.val < p.val then det2 (e k) x else det2 x (e k) := by
  have hrowp : (∑ k : Fin (n + 1),
      if p.val < k.val then det2 (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e p) (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e k)
        else 0) =
      ∑ k : Fin n, if p.val ≤ k.val then det2 x (e k) else 0 := by
    rw [Fin.insertNth_apply_same]
    rw [← Finset.add_sum_erase univ
      (fun k => if p.val < k.val then det2 x (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e k) else 0)
      (Finset.mem_univ p)]
    have h0 : (if p.val < p.val then det2 x (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e p) else 0) = 0 := by
      rw [if_neg (lt_irrefl _)]
    rw [h0, zero_add, ← Fin.sum_succAbove p
      (fun k => if p.val < k.val then det2 x (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e k) else 0)]
    apply Finset.sum_congr rfl
    intro k _
    rw [Fin.insertNth_apply_succAbove]
    by_cases hk : k.val < p.val
    · have h1 : (p.succAbove k).val = k.val := by
        rw [Fin.succAbove_val p k, if_pos hk]
      rw [if_neg (by rw [h1]; exact not_lt_of_ge (le_of_lt hk) : ¬ p.val < (p.succAbove k).val),
        if_neg (not_le_of_gt hk)]
    · have h1 : (p.succAbove k).val = k.val + 1 := by
        rw [Fin.succAbove_val p k, if_neg hk]
      rw [if_pos (by rw [h1]; omega : p.val < (p.succAbove k).val),
        if_pos (le_of_not_gt hk)]
  have hrows : (∑ i ∈ univ.erase p, ∑ k : Fin (n + 1),
      if i.val < k.val then det2 (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e i) (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e k)
        else 0) =
      ∑ a : Fin n, ((∑ k : Fin n, if a.val < k.val then det2 (e a) (e k) else 0) +
        if a.val < p.val then det2 (e a) x else 0) := by
    rw [← Fin.sum_succAbove p (fun i => ∑ k : Fin (n + 1),
      if i.val < k.val then det2 (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e i) (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e k)
        else 0)]
    apply Finset.sum_congr rfl
    intro a _
    rw [Fin.insertNth_apply_succAbove]
    rw [← Finset.add_sum_erase univ
      (fun k => if (p.succAbove a).val < k.val then det2 (e a) (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e k)
        else 0) (Finset.mem_univ p)]
    rw [Fin.insertNth_apply_same, add_comm]
    congr 1
    · rw [← Fin.sum_succAbove p
        (fun k => if (p.succAbove a).val < k.val then det2 (e a) (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e k)
          else 0)]
      apply Finset.sum_congr rfl
      intro k _
      rw [Fin.insertNth_apply_succAbove]
      by_cases hlt : a.val < k.val
      · rw [if_pos ((Fin.succAbove_lt_succAbove p a k).mpr hlt), if_pos hlt]
      · rw [if_neg (by
          intro h
          exact hlt ((Fin.succAbove_lt_succAbove p a k).mp h)), if_neg hlt]
    · by_cases ha : a.val < p.val
      · have h1 : (p.succAbove a).val = a.val := by
          rw [Fin.succAbove_val p a, if_pos ha]
        rw [if_pos (by rw [h1]; exact ha : (p.succAbove a).val < p.val), if_pos ha]
      · have h1 : (p.succAbove a).val = a.val + 1 := by
          rw [Fin.succAbove_val p a, if_neg ha]
        rw [if_neg (by rw [h1]; omega : ¬ (p.succAbove a).val < p.val), if_neg ha]
  have hsplit : SES (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e) =
      (∑ i ∈ univ.erase p, ∑ k : Fin (n + 1),
        if i.val < k.val then det2 (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e i) (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e k)
          else 0) +
        ∑ k : Fin (n + 1),
          if p.val < k.val then det2 (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e p) (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e k)
            else 0 := by
    unfold SES
    rw [← Finset.add_sum_erase univ (fun i => ∑ k,
      if i.val < k.val then det2 (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e i) (Fin.insertNth (α := fun _ => ℝ × ℝ) p x e k)
        else 0) (Finset.mem_univ p), add_comm]
  rw [hsplit, hrowp, hrows]
  rw [Finset.sum_add_distrib]
  have hcomb : ∀ k : Fin n, (if k.val < p.val then det2 (e k) x else det2 x (e k)) =
      (if k.val < p.val then det2 (e k) x else 0) +
        (if p.val ≤ k.val then det2 x (e k) else 0) := by
    intro k
    by_cases hk : k.val < p.val
    · rw [if_pos hk, if_pos hk, if_neg (not_le_of_gt hk)]
      simp
    · rw [if_neg hk, if_neg hk, if_pos (le_of_not_gt hk)]
      simp
  rw [Finset.sum_congr rfl (fun k _ => hcomb k), Finset.sum_add_distrib]
  unfold SES
  ring

/-! ### Sums over value-intervals -/

/-- Sums over value-intervals of `Fin n`. -/
def sumIco {n : ℕ} (a b : ℕ) (f : Fin n → ℝ) : ℝ :=
  ∑ k ∈ univ.filter (fun k => a ≤ k.val ∧ k.val < b), f k

theorem sumIco_consecutive {n : ℕ} (a i b : ℕ) (f : Fin n → ℝ) (hai : a ≤ i)
    (hib : i ≤ b) : sumIco a b f = sumIco a i f + sumIco i b f := by
  unfold sumIco
  rw [← Finset.sum_union (by
    rw [Finset.disjoint_filter]
    intro k _ h1 h2
    omega)]
  congr 1
  ext k
  simp only [Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · intro ⟨h1, h2⟩
    by_cases h3 : k.val < i
    · exact Or.inl ⟨h1, h3⟩
    · exact Or.inr ⟨by omega, h2⟩
  · intro h
    rcases h with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact ⟨h1, by omega⟩
    · exact ⟨by omega, h2⟩

theorem sumIco_self {n : ℕ} (a : ℕ) (f : Fin n → ℝ) : sumIco a a f = 0 := by
  unfold sumIco
  rw [Finset.filter_eq_empty_iff.2 (by
    intro k _
    omega)]
  simp

theorem sumIco_singleton {n : ℕ} (i : ℕ) (hi : i < n) (f : Fin n → ℝ) :
    sumIco i (i + 1) f = f ⟨i, hi⟩ := by
  unfold sumIco
  have hset : univ.filter (fun k : Fin n => i ≤ k.val ∧ k.val < i + 1) = {⟨i, hi⟩} := by
    ext k
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_singleton]
    constructor
    · intro ⟨h1, h2⟩
      exact Fin.ext (show k.val = i by omega)
    · intro h
      rw [h]
      show i ≤ i ∧ i < i + 1
      omega
  rw [hset, Finset.sum_singleton]

theorem sumIco_zero_eq {n : ℕ} (b : ℕ) (f : Fin n → ℝ) :
    sumIco 0 b f = ∑ k ∈ univ.filter (fun k => k.val < b), f k := by
  unfold sumIco
  rw [show (univ.filter fun k : Fin n => (0 : ℕ) ≤ k.val ∧ k.val < b) =
      univ.filter (fun k : Fin n => k.val < b) from
    Finset.filter_congr (fun k _ => by omega)]

theorem sumIco_univ {n : ℕ} (f : Fin n → ℝ) :
    sumIco 0 n f = ∑ k : Fin n, f k := by
  unfold sumIco
  rw [Finset.filter_eq_self.2 (fun k _ => by omega)]

theorem sumIco_succ_eq_univ {n : ℕ} (j : ℕ) (f : Fin n → ℝ) :
    sumIco (j + 1) n f = ∑ k ∈ univ.filter (fun k => j < k.val), f k := by
  unfold sumIco
  rw [show (univ.filter fun k : Fin n => j + 1 ≤ k.val ∧ k.val < n) =
      univ.filter (fun k : Fin n => j < k.val) from
    Finset.filter_congr (fun k _ => by omega)]

theorem sumIco_neg {n : ℕ} (a b : ℕ) (f : Fin n → ℝ) :
    sumIco a b (fun k => -f k) = -sumIco a b f := by
  unfold sumIco
  rw [Finset.sum_neg_distrib]

theorem sumIco_succ_left {n : ℕ} (a b : ℕ) (f : Fin n → ℝ) :
    sumIco (a + 1) b f = ∑ k ∈ univ.filter (fun k => a < k.val ∧ k.val < b), f k := by
  unfold sumIco
  rw [show (univ.filter fun k : Fin n => a + 1 ≤ k.val ∧ k.val < b) =
      univ.filter fun k : Fin n => a < k.val ∧ k.val < b from by
    ext k
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    constructor <;> intro h <;> exact h]

theorem sum_update_sub {n : ℕ} (f : Fin n → ℝ × ℝ) (k : Fin n) (b : ℝ × ℝ) :
    (∑ x : Fin n, Function.update f k b x) = (∑ x : Fin n, f x) - f k + b := by
  rw [Finset.sum_update_of_mem (Finset.mem_univ _) f b,
    Finset.sdiff_singleton_eq_erase, ← Finset.add_sum_erase univ f (Finset.mem_univ k)]
  abel

/-- Summing a vector-valued function over `succAbove` gives the sum over the
complement of the pivot. -/
theorem Fin.sum_succAbove_prod {n : ℕ} (p : Fin (n + 1)) (f : Fin (n + 1) → ℝ × ℝ) :
    (∑ k : Fin n, f (p.succAbove k)) = ∑ j ∈ univ.erase p, f j := by
  apply Finset.sum_bij (fun k _ => p.succAbove k)
  · intro k _
    exact Finset.mem_erase.mpr ⟨Fin.succAbove_ne p k, Finset.mem_univ _⟩
  · intro k1 _ k2 _ h
    exact Fin.succAbove_right_injective h
  · intro j hj
    have hj' : j ≠ p := Finset.ne_of_mem_erase hj
    obtain ⟨z, hz⟩ := Fin.exists_succAbove_eq hj'
    exact ⟨z, Finset.mem_univ _, hz⟩
  · intro k _
    rfl

/-- Removing a zero edge: the edge-sum invariant, the defect `F`, the edge
counts, and the existence of a lift are all preserved. -/
theorem FES_eq_of_remove_zero {n : ℕ} [NeZero n] (e : Fin (n + 1) → ℝ × ℝ)
    (L : EdgeLift e) (hclosed : ESClosed e) (h2 : 2 ≤ esEll e)
    (z : Fin (n + 1)) (hz : e z = 0) :
    ∃ e' : Fin n → ℝ × ℝ, ESClosed e' ∧ Nonempty (EdgeLift e') ∧
      FES e' = FES e ∧ esNu e' = esNu e ∧ esEll e' = esEll e := by
  classical
  have hn1 : 0 < n := NeZero.pos n
  obtain ⟨Lr, hagree, hflat⟩ := edgeLift_flatPrev L hclosed h2
  refine ⟨fun i => e (z.succAbove i), ?_, ?_, ?_, ?_, ?_⟩
  · -- `ESClosed`
    show (∑ i : Fin n, e (z.succAbove i)) = 0
    rw [Fin.sum_succAbove_prod]
    have h1 : e z + ∑ j ∈ univ.erase z, e j = 0 := by
      rw [Finset.add_sum_erase _ _ (Finset.mem_univ z)]
      exact hclosed
    rw [hz, zero_add] at h1
    exact h1
  · -- `EdgeLift`
    set σ : ℕ → ℕ := fun k => (z.succAbove ⟨k % n, Nat.mod_lt k hn1⟩).val +
      (k / n) * (n + 1) with hσ
    have hdiv2 : ∀ k : ℕ, (k + 1) % n = k % n + 1 ∨
        ((k + 1) % n = 0 ∧ (k + 1) / n = k / n + 1 ∧ k % n = n - 1) := by
      intro k
      have h2 : k = n * (k / n) + k % n := (Nat.div_add_mod k n).symm
      have h3 : k % n < n := Nat.mod_lt k hn1
      by_cases h4 : k % n + 1 < n
      · left
        conv_lhs => rw [h2]
        rw [Nat.add_assoc, Nat.mul_add_mod_self_left, Nat.mod_eq_of_lt h4]
      · have h5 : k % n + 1 = n := by omega
        refine Or.inr ⟨?_, ?_, by omega⟩
        · conv_lhs => rw [h2]
          rw [Nat.add_assoc, h5, Nat.mul_add_mod_self_left, Nat.mod_self]
        · conv_lhs => rw [h2]
          rw [Nat.add_assoc, h5, show n * (k / n) + n = (k / n + 1) * n from by ring,
            Nat.mul_div_cancel _ hn1]
    have hsucc_div : ∀ k : ℕ, (k + 1) % n = k % n + 1 → (k + 1) / n = k / n := by
      intro k hk
      have h4 : k % n + 1 < n := by
        rw [← hk]
        exact Nat.mod_lt _ hn1
      have h3 : k + 1 = n * (k / n) + (k % n + 1) := by
        have := Nat.div_add_mod k n
        omega
      rw [h3, show n * (k / n) + (k % n + 1) = (k % n + 1) + n * (k / n) from by ring,
        Nat.add_mul_div_left _ _ hn1, Nat.div_eq_of_lt h4, zero_add]
    have hσ_period : ∀ k, σ (k + n) = σ k + (n + 1) := by
      intro k
      have h1 : (⟨(k + n) % n, Nat.mod_lt _ hn1⟩ : Fin n) = ⟨k % n, Nat.mod_lt k hn1⟩ := by
        apply Fin.ext
        simp [Nat.add_mod_right]
      simp only [hσ, h1, Nat.add_div_right _ hn1]
      ring
    have hσ_mono : ∀ k, σ k < σ (k + 1) := by
      intro k
      rcases hdiv2 k with h1 | ⟨h1, h1', h1''⟩
      · have h2 := hsucc_div k h1
        have h5 : (z.succAbove ⟨k % n, Nat.mod_lt k hn1⟩).val <
            (z.succAbove ⟨(k + 1) % n, Nat.mod_lt _ hn1⟩).val := by
          rw [Fin.succAbove_lt_succAbove]
          simp [h1]
        simp only [hσ, h2]
        omega
      · simp only [hσ, h1, h1']
        have h6 : (z.succAbove ⟨k % n, Nat.mod_lt k hn1⟩).val ≤ n := by
          have := (z.succAbove ⟨k % n, Nat.mod_lt k hn1⟩).isLt
          omega
        rw [show (k / n + 1) * (n + 1) = (k / n) * (n + 1) + (n + 1) from by ring]
        omega
    have hσ_skip : ∀ k, σ (k + 1) = σ k + 1 ∨
        (σ (k + 1) = σ k + 2 ∧
          e ⟨(σ k + 1) % (n + 1), Nat.mod_lt _ (Nat.succ_pos n)⟩ = 0) := by
      intro k
      rcases hdiv2 k with h1 | ⟨h1, h1', h1''⟩
      · have h2 := hsucc_div k h1
        have h3 : (z.succAbove ⟨k % n, Nat.mod_lt k hn1⟩).val =
            if k % n < z.val then k % n else k % n + 1 := Fin.succAbove_val z _
        have h4 : (z.succAbove ⟨(k + 1) % n, Nat.mod_lt _ hn1⟩).val =
            if (k + 1) % n < z.val then (k + 1) % n else (k + 1) % n + 1 :=
          Fin.succAbove_val z _
        by_cases h5 : (k + 1) % n < z.val
        · have h8 : k % n < z.val := by omega
          left
          simp only [hσ, h2]
          rw [h3, h4, if_pos h5, if_pos h8, h1]
          omega
        · by_cases h6 : (k + 1) % n = z.val
          · have h7 : k % n + 1 = z.val := by omega
            have h8 : k % n < z.val := by omega
            have h9 : ¬ (k + 1) % n < z.val := by omega
            right
            constructor
            · simp only [hσ, h2]
              rw [h3, h4, if_neg h9, if_pos h8, h1]
              omega
            · have h10 : σ k + 1 = z.val + (k / n) * (n + 1) := by
                simp only [hσ, h2]
                rw [h3, if_pos h8]
                omega
              have h12 : (⟨(σ k + 1) % (n + 1), Nat.mod_lt _ (Nat.succ_pos n)⟩ :
                  Fin (n + 1)) = z := by
                apply Fin.ext
                show (σ k + 1) % (n + 1) = z.val
                rw [h10, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt z.isLt]
              rw [h12, hz]
          · have h7 : z.val < (k + 1) % n := by omega
            have h10 : ¬ k % n < z.val := by omega
            left
            simp only [hσ, h2]
            rw [h3, h4, if_neg h5, if_neg h10, h1]
            omega
      · have h3 : (z.succAbove ⟨k % n, Nat.mod_lt k hn1⟩).val =
            if k % n < z.val then k % n else k % n + 1 := Fin.succAbove_val z _
        have h4 : (z.succAbove ⟨(k + 1) % n, Nat.mod_lt _ hn1⟩).val =
            if (k + 1) % n < z.val then (k + 1) % n else (k + 1) % n + 1 :=
          Fin.succAbove_val z _
        by_cases hz0 : z.val = 0
        · right
          have h5 : (z.succAbove ⟨(k + 1) % n, Nat.mod_lt _ hn1⟩).val = 1 := by
            rw [h4, h1, hz0, if_neg (by omega : ¬ (0 : ℕ) < 0)]
          have h6 : (z.succAbove ⟨k % n, Nat.mod_lt k hn1⟩).val = n := by
            rw [h3, h1'', hz0, if_neg (by omega : ¬ n - 1 < (0 : ℕ))]
            have := Nat.mod_lt k hn1
            omega
          constructor
          · simp only [hσ]
            rw [h5, h6, h1']
            rw [show (k / n + 1) * (n + 1) = (k / n) * (n + 1) + (n + 1) from by ring]
            omega
          · have h9 : σ k + 1 = (k / n + 1) * (n + 1) := by
              simp only [hσ]
              rw [h6]
              ring
            have h12 : (⟨(σ k + 1) % (n + 1), Nat.mod_lt _ (Nat.succ_pos n)⟩ :
                Fin (n + 1)) = z := by
              apply Fin.ext
              show (σ k + 1) % (n + 1) = z.val
              rw [h9, Nat.mul_mod_left, hz0]
            rw [h12, hz]
        · by_cases hzn : z.val = n
          · right
            have h5 : (z.succAbove ⟨(k + 1) % n, Nat.mod_lt _ hn1⟩).val = 0 := by
              rw [h4, h1, hzn, if_pos (by omega : (0 : ℕ) < n)]
            have h6 : (z.succAbove ⟨k % n, Nat.mod_lt k hn1⟩).val = n - 1 := by
              rw [h3, h1'', hzn, if_pos (by omega : n - 1 < n)]
            constructor
            · simp only [hσ]
              rw [h5, h6, h1']
              rw [show (k / n + 1) * (n + 1) = (k / n) * (n + 1) + (n + 1) from by ring]
              omega
            · have h9 : σ k + 1 = n + (k / n) * (n + 1) := by
                simp only [hσ]
                rw [h6]
                omega
              have h12 : (⟨(σ k + 1) % (n + 1), Nat.mod_lt _ (Nat.succ_pos n)⟩ :
                  Fin (n + 1)) = z := by
                apply Fin.ext
                show (σ k + 1) % (n + 1) = z.val
                rw [h9, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt (Nat.lt_succ_self n),
                  hzn]
              rw [h12, hz]
          · left
            have h5 : (z.succAbove ⟨(k + 1) % n, Nat.mod_lt _ hn1⟩).val = 0 := by
              rw [h4, h1, if_pos (by omega : (0 : ℕ) < z.val)]
            have h6 : (z.succAbove ⟨k % n, Nat.mod_lt k hn1⟩).val = n := by
              rw [h3, h1'', if_neg (by omega : ¬ n - 1 < z.val)]
              have := Nat.mod_lt k hn1
              omega
            simp only [hσ]
            rw [h5, h6, h1']
            rw [show (k / n + 1) * (n + 1) = (k / n) * (n + 1) + (n + 1) from by ring]
            omega
    refine ⟨{ Θ := fun k => Lr.Θ (σ k)
              period := ?_
              step_nonneg := ?_
              step_le := ?_
              cons := ?_ }⟩
    · intro k
      show Lr.Θ (σ (k + n)) = Lr.Θ (σ k) + 2 * Real.pi
      rw [hσ_period k, Lr.period]
    · intro k
      show 0 ≤ Lr.Θ (σ (k + 1)) - Lr.Θ (σ k)
      have h := hσ_mono k
      have h2 : Lr.Θ (σ k) ≤ Lr.Θ (σ (k + 1)) := Lr.monotone (by omega)
      linarith [h2]
    · intro k
      show Lr.Θ (σ (k + 1)) - Lr.Θ (σ k) ≤ Real.pi
      rcases hσ_skip k with h1 | ⟨h1, h2⟩
      · rw [h1]
        exact Lr.step_le _
      · have h3 : Lr.Θ (σ k + 1) = Lr.Θ (σ k) := hflat (σ k) h2
        rw [h1, show Lr.Θ (σ k + 2) - Lr.Θ (σ k) = Lr.Θ (σ k + 2) - Lr.Θ (σ k + 1) from by
          rw [h3]]
        exact Lr.step_le _
    · intro i hi
      have h1 : σ i.val = (z.succAbove i).val := by
        have h2 : (⟨i.val % n, Nat.mod_lt i.val hn1⟩ : Fin n) = i := by
          apply Fin.ext
          simp [Nat.mod_eq_of_lt i.isLt]
        simp only [hσ, h2, Nat.div_eq_of_lt i.isLt, zero_mul, add_zero]
      show ∃ m : ℤ, Lr.Θ (σ i.val) = dirAng ((fun i => e (z.succAbove i)) i) +
        2 * Real.pi * ↑m
      rw [h1, hagree (z.succAbove i) hi]
      exact L.cons (z.succAbove i) hi
  · -- `FES`
    have heq : e = Fin.insertNth (α := fun _ => ℝ × ℝ) z 0 (fun i => e (z.succAbove i)) := by
      funext j
      by_cases hjz : j = z
      · subst hjz
        rw [Fin.insertNth_apply_same, hz]
      · obtain ⟨k, rfl⟩ := Fin.exists_succAbove_eq hjz
        rw [Fin.insertNth_apply_succAbove]
    have hG := GES_insertNth_sub (fun i => e (z.succAbove i)) z 0
    have hS := SES_insertNth_sub (fun i => e (z.succAbove i)) z 0
    simp [det2_zero_left, det2_zero_right] at hG hS
    have hG2 : GES (Fin.insertNth (α := fun _ => ℝ × ℝ) z 0 (fun i => e (z.succAbove i))) =
        GES (fun i => e (z.succAbove i)) := sub_eq_zero.mp hG
    have hS2 : SES (Fin.insertNth (α := fun _ => ℝ × ℝ) z 0 (fun i => e (z.succAbove i))) =
        SES (fun i => e (z.succAbove i)) := sub_eq_zero.mp hS
    rw [congrArg FES heq]
    unfold FES
    rw [hG2, hS2]
  · -- `esNu`
    unfold esNu
    apply Finset.card_bij (fun i _ => z.succAbove i)
    · intro i hi
      rw [Finset.mem_filter] at hi
      exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi.2⟩
    · intro i1 _ i2 _ h
      exact Fin.succAbove_right_injective h
    · intro j hj
      rw [Finset.mem_filter] at hj
      have hjz : j ≠ z := by
        intro h
        rw [h, hz] at hj
        exact hj.2 rfl
      obtain ⟨k, rfl⟩ := Fin.exists_succAbove_eq hjz
      exact ⟨k, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hj.2⟩, rfl⟩
  · -- `esEll`
    unfold esEll
    congr 1
    ext y
    constructor
    · intro hy
      rw [Finset.mem_image] at hy
      obtain ⟨i, hi, rfl⟩ := hy
      rw [Finset.mem_filter] at hi
      exact Finset.mem_image.mpr ⟨z.succAbove i,
        Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi.2⟩, rfl⟩
    · intro hy
      rw [Finset.mem_image] at hy
      obtain ⟨j, hj, rfl⟩ := hy
      rw [Finset.mem_filter] at hj
      have hjz : j ≠ z := by
        intro h
        rw [h, hz] at hj
        exact hj.2 rfl
      obtain ⟨k, rfl⟩ := Fin.exists_succAbove_eq hjz
      exact Finset.mem_image.mpr ⟨k, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hj.2⟩, rfl⟩

/-!
### Operation B: the angularly-sorted ray set

The directions of the edges and their antipodes, windowed into
`[Θ 0, Θ 0 + 2π)`.  Under the "no two parallel edges" hypothesis this set has
`2n` elements; consecutive elements leave gaps summing to `2π`, which drives
the pigeonhole step of operation B.
-/

/-- The lift-values of distinct-direction edges are distinct. -/
theorem theta_inj_of_hdist {n : ℕ} {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    (hdist : ∀ i j : Fin n, e i ≠ 0 → e j ≠ 0 → det2 (e i) (e j) = 0 → i = j)
    (hzz : ∀ i : Fin n, e i ≠ 0) :
    Function.Injective (fun i : Fin n => L.Θ i.val) := by
  intro i j hij
  have hij' : L.Θ i.val = L.Θ j.val := hij
  apply hdist i j (hzz i) (hzz j)
  obtain ⟨mi, hmi⟩ := L.cons i (hzz i)
  obtain ⟨mj, hmj⟩ := L.cons j (hzz j)
  rw [det2_eq_sin]
  have hsin : Real.sin (dirAng (e j) - dirAng (e i)) = 0 := by
    have h1 : dirAng (e j) - dirAng (e i) = 2 * Real.pi * (mi - mj : ℤ) := by
      have h2 : dirAng (e j) = L.Θ j.val - 2 * Real.pi * mj := by linarith [hmj]
      have h3 : dirAng (e i) = L.Θ i.val - 2 * Real.pi * mi := by linarith [hmi]
      rw [h2, h3, hij']
      push_cast
      ring
    rw [h1, show 2 * Real.pi * (mi - mj : ℤ) = 0 + (mi - mj : ℤ) * (2 * Real.pi) from by
      push_cast
      ring, Real.sin_add_int_mul_two_pi]
    simp
  rw [hsin]
  simp

/-- The ray set for operation B: `Θ`-values and their windowed antipodes. -/
noncomputable def opBRays {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e) :
    Finset ℝ :=
  univ.image (fun i : Fin n => L.Θ i.val) ∪
    univ.image (fun i : Fin n => if L.Θ i.val + Real.pi < L.Θ 0 + 2 * Real.pi then
      L.Θ i.val + Real.pi else L.Θ i.val - Real.pi)

/-- The antipode value is never a `Θ`-value. -/
theorem theta_ne_theta_add_pi {n : ℕ} {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    (hdist : ∀ i j : Fin n, e i ≠ 0 → e j ≠ 0 → det2 (e i) (e j) = 0 → i = j)
    (hzz : ∀ i : Fin n, e i ≠ 0) (i j : Fin n) :
    L.Θ i.val ≠ L.Θ j.val + Real.pi := by
  intro h
  have hij : i = j := by
    apply hdist i j (hzz i) (hzz j)
    obtain ⟨mi, hmi⟩ := L.cons i (hzz i)
    obtain ⟨mj, hmj⟩ := L.cons j (hzz j)
    rw [det2_eq_sin]
    have hsin : Real.sin (dirAng (e j) - dirAng (e i)) = 0 := by
      have h1 : dirAng (e j) - dirAng (e i) = -Real.pi + 2 * Real.pi * (mi - mj : ℤ) := by
        have h2 : dirAng (e j) = L.Θ j.val - 2 * Real.pi * mj := by linarith [hmj]
        have h3 : dirAng (e i) = L.Θ i.val - 2 * Real.pi * mi := by linarith [hmi]
        rw [h2, h3, h]
        push_cast
        ring
      rw [h1, show -Real.pi + 2 * Real.pi * (mi - mj : ℤ) =
          -Real.pi + (mi - mj : ℤ) * (2 * Real.pi) from by push_cast; ring,
        Real.sin_add_int_mul_two_pi]
      simp
    rw [hsin]
    simp
  rw [hij] at h
  have hpi := Real.pi_pos
  linarith [h, hpi]

/-- The antipode map is injective on the indices. -/
theorem w'_injective {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    (hdist : ∀ i j : Fin n, e i ≠ 0 → e j ≠ 0 → det2 (e i) (e j) = 0 → i = j)
    (hzz : ∀ i : Fin n, e i ≠ 0) :
    Function.Injective (fun i : Fin n =>
      if L.Θ i.val + Real.pi < L.Θ 0 + 2 * Real.pi then L.Θ i.val + Real.pi
        else L.Θ i.val - Real.pi) := by
  intro i j hij
  have hij' : (if L.Θ i.val + Real.pi < L.Θ 0 + 2 * Real.pi then L.Θ i.val + Real.pi
      else L.Θ i.val - Real.pi) =
      (if L.Θ j.val + Real.pi < L.Θ 0 + 2 * Real.pi then L.Θ j.val + Real.pi
        else L.Θ j.val - Real.pi) := hij
  by_cases hi : L.Θ i.val + Real.pi < L.Θ 0 + 2 * Real.pi
  · by_cases hj : L.Θ j.val + Real.pi < L.Θ 0 + 2 * Real.pi
    · rw [if_pos hi, if_pos hj] at hij'
      have h0 : L.Θ i.val = L.Θ j.val := by linarith [hij']
      exact theta_inj_of_hdist L hdist hzz h0
    · rw [if_pos hi, if_neg hj] at hij'
      exfalso
      have h1 : L.Θ j.val = L.Θ i.val + 2 * Real.pi := by linarith [hij']
      have h2 : i = j := by
        apply hdist i j (hzz i) (hzz j)
        obtain ⟨mi, hmi⟩ := L.cons i (hzz i)
        obtain ⟨mj, hmj⟩ := L.cons j (hzz j)
        rw [det2_eq_sin]
        have hsin : Real.sin (dirAng (e j) - dirAng (e i)) = 0 := by
          have h3 : dirAng (e j) - dirAng (e i) = 2 * Real.pi * (mi - mj + 1 : ℤ) := by
            have h4 : dirAng (e j) = L.Θ j.val - 2 * Real.pi * mj := by linarith [hmj]
            have h5 : dirAng (e i) = L.Θ i.val - 2 * Real.pi * mi := by linarith [hmi]
            rw [h4, h5, h1]
            push_cast
            ring
          rw [h3, show 2 * Real.pi * (mi - mj + 1 : ℤ) =
              0 + (mi - mj + 1 : ℤ) * (2 * Real.pi) from by push_cast; ring,
            Real.sin_add_int_mul_two_pi]
          simp
        rw [hsin]
        simp
      rw [h2] at h1
      have hpi := Real.pi_pos
      linarith [h1, hpi]
  · by_cases hj : L.Θ j.val + Real.pi < L.Θ 0 + 2 * Real.pi
    · rw [if_neg hi, if_pos hj] at hij'
      exfalso
      have h1 : L.Θ j.val = L.Θ i.val - 2 * Real.pi := by linarith [hij']
      have h2 : j = i := by
        apply hdist j i (hzz j) (hzz i)
        obtain ⟨mi, hmi⟩ := L.cons i (hzz i)
        obtain ⟨mj, hmj⟩ := L.cons j (hzz j)
        rw [det2_eq_sin]
        have hsin : Real.sin (dirAng (e i) - dirAng (e j)) = 0 := by
          have h3 : dirAng (e i) - dirAng (e j) = 2 * Real.pi * (mj - mi + 1 : ℤ) := by
            have h4 : dirAng (e i) = L.Θ i.val - 2 * Real.pi * mi := by linarith [hmi]
            have h5 : dirAng (e j) = L.Θ j.val - 2 * Real.pi * mj := by linarith [hmj]
            rw [h4, h5, h1]
            push_cast
            ring
          rw [h3, show 2 * Real.pi * (mj - mi + 1 : ℤ) =
              0 + (mj - mi + 1 : ℤ) * (2 * Real.pi) from by push_cast; ring,
            Real.sin_add_int_mul_two_pi]
          simp
        rw [hsin]
        simp
      rw [h2] at h1
      have hpi := Real.pi_pos
      linarith [h1, hpi]
    · rw [if_neg hi, if_neg hj] at hij'
      exact theta_inj_of_hdist L hdist hzz (by linarith [hij'])

/-- The card of the ray set is `2n`. -/
theorem card_opBRays {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    (hdist : ∀ i j : Fin n, e i ≠ 0 → e j ≠ 0 → det2 (e i) (e j) = 0 → i = j)
    (hzz : ∀ i : Fin n, e i ≠ 0) : (opBRays L).card = 2 * n := by
  have h1 : (univ.image (fun i : Fin n => L.Θ i.val)).card = n := by
    rw [Finset.card_image_of_injective univ (theta_inj_of_hdist L hdist hzz),
      Finset.card_univ, Fintype.card_fin]
  have h2 : (univ.image (fun i : Fin n => if L.Θ i.val + Real.pi < L.Θ 0 + 2 * Real.pi then
        L.Θ i.val + Real.pi else L.Θ i.val - Real.pi)).card = n := by
    rw [Finset.card_image_of_injective univ (w'_injective L hdist hzz),
      Finset.card_univ, Fintype.card_fin]
  have hdisj : Disjoint (univ.image (fun i : Fin n => L.Θ i.val))
      (univ.image (fun i : Fin n => if L.Θ i.val + Real.pi < L.Θ 0 + 2 * Real.pi then
        L.Θ i.val + Real.pi else L.Θ i.val - Real.pi)) := by
    rw [Finset.disjoint_left]
    intro x hx
    rw [Finset.mem_image] at hx
    obtain ⟨i, _, rfl⟩ := hx
    rw [Finset.mem_image]
    rintro ⟨j, _, hj⟩
    have hj' : (if L.Θ j.val + Real.pi < L.Θ 0 + 2 * Real.pi then L.Θ j.val + Real.pi
        else L.Θ j.val - Real.pi) = L.Θ i.val := hj
    by_cases hjc : L.Θ j.val + Real.pi < L.Θ 0 + 2 * Real.pi
    · rw [if_pos hjc] at hj'
      exact theta_ne_theta_add_pi L hdist hzz i j hj'.symm
    · rw [if_neg hjc] at hj'
      have h1 : L.Θ j.val = L.Θ i.val + Real.pi := by linarith [hj']
      exact theta_ne_theta_add_pi L hdist hzz j i h1
  rw [show (opBRays L) = (univ.image (fun i : Fin n => L.Θ i.val)) ∪
      (univ.image (fun i : Fin n => if L.Θ i.val + Real.pi < L.Θ 0 + 2 * Real.pi then
        L.Θ i.val + Real.pi else L.Θ i.val - Real.pi)) from rfl]
  rw [Finset.card_union_of_disjoint hdisj, h1, h2]
  ring

/-- `Θ 0` belongs to the ray set, which is therefore nonempty. -/
theorem opBRays_nonempty {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e) :
    (opBRays L).Nonempty :=
  ⟨L.Θ 0, Finset.mem_union_left _ (Finset.mem_image.mpr ⟨(0 : Fin n), Finset.mem_univ _, rfl⟩)⟩

/-- Every edge direction is strictly below the window top. -/
theorem theta_lt_top {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    (hdist : ∀ i j : Fin n, e i ≠ 0 → e j ≠ 0 → det2 (e i) (e j) = 0 → i = j)
    (hzz : ∀ i : Fin n, e i ≠ 0) (i : Fin n) :
    L.Θ i.val < L.Θ 0 + 2 * Real.pi := by
  have hn : L.Θ n = L.Θ 0 + 2 * Real.pi := by
    have h := L.period 0
    simp at h
    exact h
  have hle : L.Θ i.val ≤ L.Θ n := L.monotone (show i.val ≤ n by omega)
  by_contra hlt
  push Not at hlt
  have heq : L.Θ i.val = L.Θ n := by linarith [hle, hlt, hn]
  have hpar : det2 (e i) (e 0) = 0 := by
    rw [det2_eq_sin]
    obtain ⟨mi, hmi⟩ := L.cons i (hzz i)
    obtain ⟨m0, hm0⟩ := L.cons 0 (hzz 0)
    simp only [Fin.val_zero] at hm0
    have hsin : Real.sin (dirAng (e 0) - dirAng (e i)) = 0 := by
      have h1 : dirAng (e 0) - dirAng (e i) = 2 * Real.pi * (mi - m0 - 1 : ℤ) := by
        have h2 : dirAng (e 0) = L.Θ 0 - 2 * Real.pi * m0 := by linarith [hm0]
        have h3 : dirAng (e i) = L.Θ i.val - 2 * Real.pi * mi := by linarith [hmi]
        rw [h2, h3, heq, hn]
        push_cast
        ring
      rw [h1, show 2 * Real.pi * (mi - m0 - 1 : ℤ) =
          0 + (mi - m0 - 1 : ℤ) * (2 * Real.pi) from by push_cast; ring,
        Real.sin_add_int_mul_two_pi]
      simp
    rw [hsin]
    simp
  by_cases hi0 : i = 0
  · rw [hi0] at heq
    simp only [Fin.val_zero] at heq
    have hpi := Real.pi_pos
    linarith [heq, hn, hpi]
  · exact absurd (hdist i 0 (hzz i) (hzz 0) hpar) hi0

/-- Window bounds of the ray set. -/
theorem opBRays_mem_bounds {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    (hdist : ∀ i j : Fin n, e i ≠ 0 → e j ≠ 0 → det2 (e i) (e j) = 0 → i = j)
    (hzz : ∀ i : Fin n, e i ≠ 0) :
    ∀ x ∈ opBRays L, L.Θ 0 ≤ x ∧ x < L.Θ 0 + 2 * Real.pi := by
  intro x hx
  unfold opBRays at hx
  rw [Finset.mem_union, Finset.mem_image, Finset.mem_image] at hx
  rcases hx with ⟨i, _, rfl⟩ | ⟨i, _, rfl⟩
  · have h1 : L.Θ 0 ≤ L.Θ i.val := L.monotone (Nat.zero_le _)
    have h2 := theta_lt_top L hdist hzz i
    exact ⟨h1, h2⟩
  · by_cases hi : L.Θ i.val + Real.pi < L.Θ 0 + 2 * Real.pi
    · rw [if_pos hi]
      have h1 : L.Θ 0 ≤ L.Θ i.val := L.monotone (Nat.zero_le _)
      have hpi := Real.pi_pos
      exact ⟨by linarith [h1, hpi], hi⟩
    · rw [if_neg hi]
      have h1 : L.Θ 0 ≤ L.Θ i.val := L.monotone (Nat.zero_le _)
      have h2 := theta_lt_top L hdist hzz i
      have hpi := Real.pi_pos
      exact ⟨by linarith [h1, hpi, hi], by linarith [h2, hpi]⟩

/-- The minimum of the ray set is `Θ 0`. -/
theorem opBRays_min' {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    (hdist : ∀ i j : Fin n, e i ≠ 0 → e j ≠ 0 → det2 (e i) (e j) = 0 → i = j)
    (hzz : ∀ i : Fin n, e i ≠ 0) :
    (opBRays L).min' (opBRays_nonempty L) = L.Θ 0 := by
  apply le_antisymm
  · apply Finset.min'_le
    exact Finset.mem_union_left _ (Finset.mem_image.mpr ⟨(0 : Fin n), Finset.mem_univ _, rfl⟩)
  · apply Finset.le_min'
    intro y hy
    exact (opBRays_mem_bounds L hdist hzz y hy).1

/-- The doubled ray set (for the circular successor). -/
noncomputable def opBRays2 {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e) :
    Finset ℝ :=
  opBRays L ∪ (opBRays L).image fun y => y + 2 * Real.pi

/-- The circular successor of `x` in the doubled ray set. -/
noncomputable def opBNxt {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    (x : ℝ) : ℝ :=
  if h : ((opBRays2 L).filter (x < ·)).Nonempty then ((opBRays2 L).filter (x < ·)).min' h
    else (opBRays L).min' (opBRays_nonempty L) + 2 * Real.pi

/-- The successor exceeds `x`, for `x` in the ray set. -/
theorem opBNxt_gt {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    (hdist : ∀ i j : Fin n, e i ≠ 0 → e j ≠ 0 → det2 (e i) (e j) = 0 → i = j)
    (hzz : ∀ i : Fin n, e i ≠ 0) {x : ℝ} (hx : x ∈ opBRays L) :
    x < opBNxt L x := by
  unfold opBNxt
  split_ifs with h
  · have := Finset.min'_mem _ h
    rw [Finset.mem_filter] at this
    exact this.2
  · rw [opBRays_min' L hdist hzz]
    exact (opBRays_mem_bounds L hdist hzz x hx).2

/-- The successor is a lower bound of all later set elements. -/
theorem opBNxt_le {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    {x : ℝ} (y : ℝ) (hy : y ∈ opBRays2 L) (hxy : x < y) :
    opBNxt L x ≤ y := by
  unfold opBNxt
  split_ifs with h
  · apply Finset.min'_le
    exact Finset.mem_filter.mpr ⟨hy, hxy⟩
  · exact absurd (⟨y, Finset.mem_filter.mpr ⟨hy, hxy⟩⟩ :
      ((opBRays2 L).filter (x < ·)).Nonempty) h

/-- The successor of a non-maximal ray is again a ray. -/
theorem opBNxt_mem {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    (hdist : ∀ i j : Fin n, e i ≠ 0 → e j ≠ 0 → det2 (e i) (e j) = 0 → i = j)
    (hzz : ∀ i : Fin n, e i ≠ 0) {x : ℝ} (hx : x ∈ opBRays L)
    (hnx : x ≠ (opBRays L).max' (opBRays_nonempty L)) :
    opBNxt L x ∈ opBRays L := by
  have hnon : ((opBRays2 L).filter (x < ·)).Nonempty := by
    refine ⟨(opBRays L).max' (opBRays_nonempty L), Finset.mem_filter.mpr ⟨?_, ?_⟩⟩
    · exact Finset.mem_union_left _ (Finset.max'_mem _ _)
    · have hle := Finset.le_max' _ x hx
      by_contra hlt
      push Not at hlt
      have heq : x = (opBRays L).max' (opBRays_nonempty L) := le_antisymm hle hlt
      exact hnx heq
  have h1 : opBNxt L x = ((opBRays2 L).filter (x < ·)).min' hnon := by
    unfold opBNxt
    rw [dif_pos hnon]
  rw [h1]
  have h2 := Finset.min'_mem _ hnon
  rw [Finset.mem_filter] at h2
  obtain ⟨h2, h3⟩ := h2
  unfold opBRays2 at h2
  rw [Finset.mem_union, Finset.mem_image] at h2
  rcases h2 with h2 | ⟨z, hz, hzq⟩
  · exact h2
  · exfalso
    have h4 : ((opBRays2 L).filter (x < ·)).min' hnon = z + 2 * Real.pi := hzq.symm
    have h5 : (opBRays L).max' (opBRays_nonempty L) ∈ (opBRays2 L).filter (x < ·) := by
      exact Finset.mem_filter.mpr ⟨Finset.mem_union_left _ (Finset.max'_mem _ _),
        lt_of_le_of_ne (Finset.le_max' _ x hx) hnx⟩
    have h6 := Finset.min'_le _ _ h5
    rw [h4] at h6
    have h7 := Finset.le_max' _ z hz
    have h8 := (opBRays_mem_bounds L hdist hzz z hz).2
    have h9 := (opBRays_mem_bounds L hdist hzz z hz).1
    have h10 := (opBRays_mem_bounds L hdist hzz _ (Finset.max'_mem _ (opBRays_nonempty L))).2
    have h11 : (opBRays L).min' (opBRays_nonempty L) = L.Θ 0 := opBRays_min' L hdist hzz
    linarith [h6, h7, h8, h9, h10, h11]

/-- The successor of the maximal ray wraps to the minimum plus `2π`. -/
theorem opBNxt_max {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    (hdist : ∀ i j : Fin n, e i ≠ 0 → e j ≠ 0 → det2 (e i) (e j) = 0 → i = j)
    (hzz : ∀ i : Fin n, e i ≠ 0) :
    opBNxt L ((opBRays L).max' (opBRays_nonempty L)) =
      (opBRays L).min' (opBRays_nonempty L) + 2 * Real.pi := by
  set R := opBRays L with hR
  set mx := R.max' (opBRays_nonempty L) with hmx
  have hnon : ((opBRays2 L).filter (mx < ·)).Nonempty := by
    refine ⟨R.min' (opBRays_nonempty L) + 2 * Real.pi, Finset.mem_filter.mpr ⟨?_, ?_⟩⟩
    · exact Finset.mem_union_right _ (Finset.mem_image.mpr
        ⟨R.min' (opBRays_nonempty L), Finset.min'_mem _ _, rfl⟩)
    · have h1 := (opBRays_mem_bounds L hdist hzz mx (Finset.max'_mem _ _)).2
      have h2 : R.min' (opBRays_nonempty L) = L.Θ 0 := opBRays_min' L hdist hzz
      linarith [h1, h2]
  have h1 : opBNxt L mx = ((opBRays2 L).filter (mx < ·)).min' hnon := by
    unfold opBNxt
    rw [dif_pos hnon]
  rw [h1]
  apply le_antisymm
  · apply Finset.min'_le
    exact Finset.mem_filter.mpr ⟨Finset.mem_union_right _ (Finset.mem_image.mpr
      ⟨R.min' (opBRays_nonempty L), Finset.min'_mem _ _, rfl⟩), by
      have h4 := (opBRays_mem_bounds L hdist hzz mx (Finset.max'_mem _ _)).2
      have h5 : R.min' (opBRays_nonempty L) = L.Θ 0 := opBRays_min' L hdist hzz
      linarith [h4, h5]⟩
  · apply Finset.le_min'
    intro y hy
    rw [Finset.mem_filter] at hy
    obtain ⟨hy1, hy2⟩ := hy
    unfold opBRays2 at hy1
    rw [Finset.mem_union, Finset.mem_image] at hy1
    rcases hy1 with hy1 | ⟨z, hz, rfl⟩
    · exfalso
      have h3 := Finset.le_max' _ y hy1
      linarith [h3, hy2]
    · have h3 := Finset.min'_le _ z hz
      linarith [h3]

/-- The successor of `min + 2π` is the successor of `min`, shifted. -/
theorem opBNxt_shift_min {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    (hdist : ∀ i j : Fin n, e i ≠ 0 → e j ≠ 0 → det2 (e i) (e j) = 0 → i = j)
    (hzz : ∀ i : Fin n, e i ≠ 0) (hn3 : 3 ≤ n) :
    opBNxt L ((opBRays L).min' (opBRays_nonempty L) + 2 * Real.pi) =
      opBNxt L ((opBRays L).min' (opBRays_nonempty L)) + 2 * Real.pi := by
  set R := opBRays L with hR
  set mn := R.min' (opBRays_nonempty L) with hmn
  set sn := opBNxt L mn with hsn
  have hcard : R.card = 2 * n := card_opBRays L hdist hzz
  have hmn_ne_mx : mn ≠ R.max' (opBRays_nonempty L) := by
    intro h
    have h2 : ∀ a ∈ R, ∀ b ∈ R, a = b := by
      intro a ha b hb
      have h7 : a = mn := le_antisymm (by
        rw [h]
        exact Finset.le_max' _ a ha) (Finset.min'_le _ a ha)
      have h8 : b = mn := le_antisymm (by
        rw [h]
        exact Finset.le_max' _ b hb) (Finset.min'_le _ b hb)
      rw [h7, h8]
    have h7 : R.card ≤ 1 := Finset.card_le_one.mpr h2
    omega
  have hsn_mem : sn ∈ R := opBNxt_mem L hdist hzz (Finset.min'_mem R (opBRays_nonempty L)) hmn_ne_mx
  have hnon : ((opBRays2 L).filter (mn + 2 * Real.pi < ·)).Nonempty := by
    refine ⟨sn + 2 * Real.pi, Finset.mem_filter.mpr ⟨?_, ?_⟩⟩
    · exact Finset.mem_union_right _ (Finset.mem_image.mpr ⟨sn, hsn_mem, rfl⟩)
    · have h1 := opBNxt_gt L hdist hzz (Finset.min'_mem R (opBRays_nonempty L))
      linarith [h1, Real.pi_pos]
  have h1 : opBNxt L (mn + 2 * Real.pi) = ((opBRays2 L).filter (mn + 2 * Real.pi < ·)).min' hnon := by
    unfold opBNxt
    rw [dif_pos hnon]
  rw [h1]
  apply le_antisymm
  · apply Finset.min'_le
    exact Finset.mem_filter.mpr ⟨Finset.mem_union_right _ (Finset.mem_image.mpr
      ⟨sn, hsn_mem, rfl⟩), by
      have h1 := opBNxt_gt L hdist hzz (Finset.min'_mem R (opBRays_nonempty L))
      linarith [h1, Real.pi_pos]⟩
  · apply Finset.le_min'
    intro y hy
    rw [Finset.mem_filter] at hy
    obtain ⟨hy1, hy2⟩ := hy
    unfold opBRays2 at hy1
    rw [Finset.mem_union, Finset.mem_image] at hy1
    rcases hy1 with hy1 | ⟨z, hz, rfl⟩
    · exfalso
      have h3 := Finset.le_max' _ y hy1
      have h4 := (opBRays_mem_bounds L hdist hzz y hy1).2
      have h5 : R.min' (opBRays_nonempty L) = L.Θ 0 := opBRays_min' L hdist hzz
      linarith [h3, h4, h5, hy2]
    · have h3 : mn < z := by
        have h4 := Finset.min'_le _ z hz
        by_contra hlt
        push Not at hlt
        have heq : z = mn := le_antisymm hlt h4
        rw [heq] at hy2
        exact absurd hy2 (lt_irrefl _)
      have h6 := opBNxt_le L z (Finset.mem_union_left _ hz) h3
      linarith [h6]

/-- The pigeonhole step of operation B: two consecutive ray gaps with total `< π`. -/
theorem opB_pigeonhole {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    (hdist : ∀ i j : Fin n, e i ≠ 0 → e j ≠ 0 → det2 (e i) (e j) = 0 → i = j)
    (hzz : ∀ i : Fin n, e i ≠ 0) (hn3 : 3 ≤ n) :
    ∃ x₀ ∈ opBRays L, opBNxt L (opBNxt L x₀) - x₀ < Real.pi := by
  classical
  set R := opBRays L with hR
  set hne := opBRays_nonempty L
  set mn := R.min' hne with hmn
  set mx := R.max' hne with hmx
  have hcard : R.card = 2 * n := card_opBRays L hdist hzz
  -- facts about the successor
  have hnxt_ne_min : ∀ x ∈ R, opBNxt L x ≠ mn := by
    intro x hx
    have h1 := Finset.min'_le _ x hx
    have h2 := opBNxt_gt L hdist hzz hx
    by_contra h
    rw [h] at h2
    linarith [h1, h2]
  have hnxt_inj : ∀ x y : ℝ, x ∈ R → y ∈ R → opBNxt L x = opBNxt L y → x = y := by
    intro x y hx hy hxy
    rcases le_total x y with h | h
    · by_contra hne2
      push Not at hne2
      have hlt : x < y := lt_of_le_of_ne h hne2
      have h2 := opBNxt_le L y (Finset.mem_union_left _ hy) hlt
      have h3 := opBNxt_gt L hdist hzz hy
      rw [← hxy] at h3
      linarith [h2, h3]
    · by_contra hne2
      push Not at hne2
      have hlt : y < x := lt_of_le_of_ne h hne2.symm
      have h2 := opBNxt_le L x (Finset.mem_union_left _ hx) hlt
      have h3 := opBNxt_gt L hdist hzz hx
      rw [hxy] at h3
      linarith [h2, h3]
  have hnxt_pred : ∀ y ∈ R, y ≠ mn → ∃ p ∈ R, p ≠ mx ∧ opBNxt L p = y := by
    intro y hy hym
    have hnon : (R.filter (· < y)).Nonempty := by
      have h1 := Finset.min'_le _ y hy
      have h2 : mn < y := by
        by_contra hlt
        push Not at hlt
        exact hym (le_antisymm hlt h1)
      exact ⟨mn, Finset.mem_filter.mpr ⟨Finset.min'_mem _ _, h2⟩⟩
    set p := (R.filter (· < y)).max' hnon with hp
    have hplt : p < y := (Finset.mem_filter.mp (Finset.max'_mem _ hnon)).2
    have hpR : p ∈ R := (Finset.mem_filter.mp (Finset.max'_mem _ hnon)).1
    have hpf : ((opBRays2 L).filter (p < ·)).Nonempty :=
      ⟨y, Finset.mem_filter.mpr ⟨Finset.mem_union_left _ hy, hplt⟩⟩
    have hnxtp : opBNxt L p = ((opBRays2 L).filter (p < ·)).min' hpf := by
      unfold opBNxt
      rw [dif_pos hpf]
    have hpy : opBNxt L p = y := by
      rw [hnxtp]
      apply le_antisymm
      · apply Finset.min'_le
        exact Finset.mem_filter.mpr ⟨Finset.mem_union_left _ hy, hplt⟩
      · apply Finset.le_min'
        intro z hz
        rw [Finset.mem_filter] at hz
        obtain ⟨hz1, hz2⟩ := hz
        by_contra hlt
        push Not at hlt
        have hzR : z ∈ R := by
          unfold opBRays2 at hz1
          rw [Finset.mem_union, Finset.mem_image] at hz1
          rcases hz1 with hz1 | ⟨w, hw, rfl⟩
          · exact hz1
          · exfalso
            have h3 := (opBRays_mem_bounds L hdist hzz w hw).2
            have h4 := (opBRays_mem_bounds L hdist hzz y hy).2
            have h5 := Finset.min'_le _ w hw
            have h6 : R.min' (opBRays_nonempty L) = L.Θ 0 := opBRays_min' L hdist hzz
            linarith [h3, h4, h5, h6, hlt]
        have hzp : z ≤ p := Finset.le_max' _ z (Finset.mem_filter.mpr ⟨hzR, hlt⟩)
        linarith [hzp, hz2]
    have hpmx : p ≠ mx := by
      intro h
      have h2 : opBNxt L mx = mn + 2 * Real.pi := opBNxt_max L hdist hzz
      rw [h, h2] at hpy
      have h3 := (opBRays_mem_bounds L hdist hzz y hy).2
      have h4 : R.min' (opBRays_nonempty L) = L.Θ 0 := opBRays_min' L hdist hzz
      linarith [hpy, h3, h4]
    exact ⟨p, hpR, hpmx, hpy⟩
  have hbij (f g : ℝ → ℝ)
      (hf : ∀ x ∈ R.erase mx, f x = g (opBNxt L x)) :
      ∑ x ∈ R.erase mx, f x = ∑ y ∈ R.erase mn, g y := by
    apply Finset.sum_bij (fun x _ => opBNxt L x)
    · intro x hx
      rw [Finset.mem_erase] at hx
      obtain ⟨hx1, hx2⟩ := hx
      have h1 : opBNxt L x ∈ R := opBNxt_mem L hdist hzz hx2 hx1
      exact Finset.mem_erase.mpr ⟨hnxt_ne_min x hx2, h1⟩
    · intro x hx y hy hxy
      exact hnxt_inj x y (Finset.mem_of_mem_erase hx) (Finset.mem_of_mem_erase hy) hxy
    · intro y hy
      rw [Finset.mem_erase] at hy
      obtain ⟨hy1, hy2⟩ := hy
      obtain ⟨p, hp1, hp2, hp3⟩ := hnxt_pred y hy2 hy1
      exact ⟨p, Finset.mem_erase.mpr ⟨hp2, hp1⟩, hp3⟩
    · intro x hx
      exact hf x hx
  -- the two gap sums
  have hsumT : ∑ x ∈ R, (opBNxt L x - x) = 2 * Real.pi := by
    rw [← Finset.add_sum_erase R (fun x => opBNxt L x - x) (Finset.max'_mem R hne),
      Finset.sum_sub_distrib, hbij (fun x => opBNxt L x) (fun y => y) (fun x _ => rfl)]
    have h1 : (∑ x ∈ R.erase mn, x) = (∑ x ∈ R, x) - mn := by
      rw [← Finset.sum_erase_add R _ (Finset.min'_mem R hne)]
      ring
    have h2 : (∑ x ∈ R.erase mx, x) = (∑ x ∈ R, x) - mx := by
      rw [← Finset.sum_erase_add R _ (Finset.max'_mem R hne)]
      ring
    rw [h1, h2]
    have hmax2 : opBNxt L mx = mn + 2 * Real.pi := by
      have h := opBNxt_max L hdist hzz
      rw [← hmx, ← hmn] at h
      exact h
    rw [hmax2]
    ring
  have hsumTn : ∑ x ∈ R, (opBNxt L (opBNxt L x) - opBNxt L x) = 2 * Real.pi := by
    have hmn_ne_mx : mn ≠ mx := by
      intro h
      have h2 : ∀ a ∈ R, ∀ b ∈ R, a = b := by
        intro a ha b hb
        have h7 : a = mn := le_antisymm (by
          rw [h]
          exact Finset.le_max' _ a ha) (Finset.min'_le _ a ha)
        have h8 : b = mn := le_antisymm (by
          rw [h]
          exact Finset.le_max' _ b hb) (Finset.min'_le _ b hb)
        rw [h7, h8]
      have h7 : R.card ≤ 1 := Finset.card_le_one.mpr h2
      omega
    have hbij2 : ∑ y ∈ (R.erase mn).erase mx, opBNxt L y =
        ∑ z ∈ (R.erase mn).erase (opBNxt L mn), z := by
      apply Finset.sum_bij (fun y _ => opBNxt L y)
      · intro y hy
        rw [Finset.mem_erase, Finset.mem_erase] at hy
        obtain ⟨hy1, hy2, hy3⟩ := hy
        have h1 : opBNxt L y ∈ R := opBNxt_mem L hdist hzz hy3 hy1
        have h2 : opBNxt L y ≠ opBNxt L mn := by
          intro h
          exact hy2 (hnxt_inj y mn hy3 (Finset.min'_mem R hne) h)
        exact Finset.mem_erase.mpr ⟨h2, Finset.mem_erase.mpr ⟨hnxt_ne_min y hy3, h1⟩⟩
      · intro y1 hy1 y2 hy2 h
        exact hnxt_inj y1 y2 (Finset.mem_of_mem_erase (Finset.mem_of_mem_erase hy1))
          (Finset.mem_of_mem_erase (Finset.mem_of_mem_erase hy2)) h
      · intro z hz
        rw [Finset.mem_erase, Finset.mem_erase] at hz
        obtain ⟨hz1, hz2, hz3⟩ := hz
        obtain ⟨p, hp1, hp2, hp3⟩ := hnxt_pred z hz3 hz2
        have hp4 : p ≠ mn := by
          intro h
          rw [← hp3, h] at hz1
          exact hz1 rfl
        exact ⟨p, Finset.mem_erase.mpr ⟨hp2, Finset.mem_erase.mpr ⟨hp4, hp1⟩⟩, hp3⟩
      · intro y _
        rfl
    rw [← Finset.add_sum_erase R (fun x => opBNxt L (opBNxt L x) - opBNxt L x)
        (Finset.max'_mem R hne), Finset.sum_sub_distrib,
      hbij (fun x => opBNxt L (opBNxt L x)) (fun y => opBNxt L y) (fun x _ => rfl)]
    have hsh : opBNxt L (opBNxt L mx) - opBNxt L mx =
        (opBNxt L mn + 2 * Real.pi) - (mn + 2 * Real.pi) := by
      have hmax2 : opBNxt L mx = mn + 2 * Real.pi := by
        have h := opBNxt_max L hdist hzz
        rw [← hmx, ← hmn] at h
        exact h
      have hshift2 : opBNxt L (mn + 2 * Real.pi) = opBNxt L mn + 2 * Real.pi := by
        have h := opBNxt_shift_min L hdist hzz hn3
        rw [← hmn] at h
        exact h
      rw [hmax2, hshift2]
    have h3 : (∑ y ∈ R.erase mn, opBNxt L y) =
        (mn + 2 * Real.pi) + ∑ z ∈ (R.erase mn).erase (opBNxt L mn), z := by
      have hsplit : R.erase mn = ((R.erase mn).erase mx) ∪ {mx} := by
        ext z
        simp only [Finset.mem_erase, Finset.mem_union, Finset.mem_singleton]
        constructor
        · intro ⟨h1, h2⟩
          by_cases h3 : z = mx
          · exact Or.inr h3
          · exact Or.inl ⟨h3, h1, h2⟩
        · intro h
          rcases h with ⟨h1, h2⟩ | h1
          · exact h2
          · rw [h1]
            exact ⟨hmn_ne_mx.symm, Finset.max'_mem R hne⟩
      conv_lhs => rw [hsplit]
      rw [Finset.sum_union (by
        rw [Finset.disjoint_left]
        intro z hz
        rw [Finset.mem_erase] at hz
        rw [Finset.mem_singleton]
        exact hz.1), hbij2, Finset.sum_singleton]
      have hmax2 : opBNxt L mx = mn + 2 * Real.pi := by
        have h := opBNxt_max L hdist hzz
        rw [← hmx, ← hmn] at h
        exact h
      rw [hmax2]
      ring
    have h4 : (∑ z ∈ (R.erase mn).erase (opBNxt L mn), z) =
        (∑ y ∈ R, y) - mn - opBNxt L mn := by
      have hmem : opBNxt L mn ∈ R.erase mn :=
        Finset.mem_erase.mpr ⟨hnxt_ne_min mn (Finset.min'_mem R hne),
          opBNxt_mem L hdist hzz (Finset.min'_mem R hne) hmn_ne_mx⟩
      have h5 : opBNxt L mn + ∑ z ∈ (R.erase mn).erase (opBNxt L mn), z =
          ∑ y ∈ R.erase mn, y := Finset.add_sum_erase (R.erase mn) (fun z => z) hmem
      have h6 : (∑ y ∈ R.erase mn, y) + mn = ∑ y ∈ R, y :=
        Finset.sum_erase_add R (fun y => y) (Finset.min'_mem R hne)
      linarith [h5, h6]
    rw [hsh, h3, h4, hbij (fun x => opBNxt L x) (fun y => y) (fun x _ => rfl)]
    have h5 : (∑ y ∈ R.erase mn, y) = (∑ y ∈ R, y) - mn := by
      rw [← Finset.sum_erase_add R _ (Finset.min'_mem R hne)]
      ring
    rw [h5]
    ring
  -- combine and conclude
  have hsumS : ∑ x ∈ R, (opBNxt L (opBNxt L x) - x) = 4 * Real.pi := by
    rw [show (∑ x ∈ R, (opBNxt L (opBNxt L x) - x)) =
        ∑ x ∈ R, ((opBNxt L x - x) + (opBNxt L (opBNxt L x) - opBNxt L x)) from
      Finset.sum_congr rfl (fun x _ => by ring), Finset.sum_add_distrib, hsumT, hsumTn]
    ring
  obtain ⟨x₀, hx₀, hs⟩ : ∃ x₀ ∈ R, (opBNxt L (opBNxt L x₀) - x₀) < Real.pi := by
    apply Finset.exists_lt_of_sum_lt
    rw [hsumS, Finset.sum_const, hcard, nsmul_eq_mul]
    have h1 : (4 : ℝ) < 2 * n := by
      have h2 : (3 : ℝ) ≤ n := by exact_mod_cast hn3
      linarith [h2]
    have h4 : (0 : ℝ) < 2 * n - 4 := by linarith [h1]
    have h5 : (0 : ℝ) < (2 * n - 4) * Real.pi := mul_pos h4 Real.pi_pos
    have h6 : ↑(2 * n) = 2 * (n : ℝ) := by push_cast; ring
    rw [h6]
    nlinarith [h5, Real.pi_pos]
  exact ⟨x₀, hx₀, hs⟩

/-- No ray-set element lies strictly between consecutive successors. -/
theorem opB_window {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    (hdist : ∀ i j : Fin n, e i ≠ 0 → e j ≠ 0 → det2 (e i) (e j) = 0 → i = j)
    (hzz : ∀ i : Fin n, e i ≠ 0) {x₀ : ℝ} (hx₀ : x₀ ∈ opBRays L)
    {x : ℝ} (hx : x ∈ opBRays2 L) :
    x ∉ Set.Ioo x₀ (opBNxt L x₀) ∧ x ∉ Set.Ioo (opBNxt L x₀) (opBNxt L (opBNxt L x₀)) := by
  constructor
  · intro h
    exact absurd h.2 (not_lt.mpr (opBNxt_le L x hx h.1))
  · intro h
    have hb1 : opBNxt L x₀ ∈ opBRays2 L := by
      by_cases hxmax : x₀ = (opBRays L).max' (opBRays_nonempty L)
      · rw [hxmax, opBNxt_max L hdist hzz]
        exact Finset.mem_union_right _ (Finset.mem_image.mpr
          ⟨(opBRays L).min' (opBRays_nonempty L), Finset.min'_mem _ _, rfl⟩)
      · exact Finset.mem_union_left _ (opBNxt_mem L hdist hzz hx₀ hxmax)
    exact absurd h.2 (not_lt.mpr (opBNxt_le L x hx h.1))

/-- The unique ray-set element of `(x₀, nxt² x₀)` is `nxt x₀`. -/
theorem opB_window_eq {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    (hdist : ∀ i j : Fin n, e i ≠ 0 → e j ≠ 0 → det2 (e i) (e j) = 0 → i = j)
    (hzz : ∀ i : Fin n, e i ≠ 0) {x₀ : ℝ} (hx₀ : x₀ ∈ opBRays L)
    {x : ℝ} (hx : x ∈ opBRays2 L) (hmem : x ∈ Set.Ioo x₀ (opBNxt L (opBNxt L x₀))) :
    x = opBNxt L x₀ := by
  obtain ⟨h1, h2⟩ := opB_window L hdist hzz hx₀ hx
  rcases lt_trichotomy x (opBNxt L x₀) with h | h | h
  · exact absurd ⟨hmem.1, h⟩ h1
  · exact h
  · exact absurd ⟨h, hmem.2⟩ h2

/-- Two indices with lift-values differing by a multiple of `π` are equal. -/
theorem eq_of_theta_eq_add_mul_pi {n : ℕ} {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    (hdist : ∀ i j : Fin n, e i ≠ 0 → e j ≠ 0 → det2 (e i) (e j) = 0 → i = j)
    (hzz : ∀ i : Fin n, e i ≠ 0) (i j : Fin n) (m : ℤ)
    (h : L.Θ i.val = L.Θ j.val + (m : ℝ) * Real.pi) : i = j := by
  apply hdist i j (hzz i) (hzz j)
  obtain ⟨mi, hmi⟩ := L.cons i (hzz i)
  obtain ⟨mj, hmj⟩ := L.cons j (hzz j)
  rw [det2_eq_sin]
  have hsin : Real.sin (dirAng (e j) - dirAng (e i)) = 0 := by
    have h1 : dirAng (e j) - dirAng (e i) = -(m : ℝ) * Real.pi + 2 * Real.pi * (mi - mj : ℤ) := by
      have h2 : dirAng (e j) = L.Θ j.val - 2 * Real.pi * mj := by linarith [hmj]
      have h3 : dirAng (e i) = L.Θ i.val - 2 * Real.pi * mi := by linarith [hmi]
      rw [h2, h3, h]
      push_cast
      ring
    rw [h1, show -(m : ℝ) * Real.pi + 2 * Real.pi * (mi - mj : ℤ) =
        -(m : ℝ) * Real.pi + (mi - mj : ℤ) * (2 * Real.pi) from by push_cast; ring,
      Real.sin_add_int_mul_two_pi]
    rw [show -(m : ℝ) * Real.pi = (-m : ℤ) * Real.pi from by push_cast; ring,
      Real.sin_int_mul_pi]
  rw [hsin]
  simp

theorem exists_int_of_sin_pos {y : ℝ} (h : 0 < Real.sin y) :
    ∃ k : ℤ, (k : ℝ) * (2 * Real.pi) < y ∧ y < (k : ℝ) * (2 * Real.pi) + Real.pi := by
  have h2pi : (0 : ℝ) < 2 * Real.pi := by linarith [Real.pi_pos]
  have hle := Int.floor_le (y / (2 * Real.pi))
  have hlt := Int.lt_floor_add_one (y / (2 * Real.pi))
  have hk1 : (⌊y / (2 * Real.pi)⌋ : ℝ) * (2 * Real.pi) ≤ y :=
    (le_div_iff₀ h2pi).mp hle
  have hk2 : y < ((⌊y / (2 * Real.pi)⌋ : ℝ) + 1) * (2 * Real.pi) :=
    (div_lt_iff₀ h2pi).mp hlt
  refine ⟨⌊y / (2 * Real.pi)⌋, ?_, ?_⟩
  · rcases eq_or_lt_of_le hk1 with heq | hlt'
    · exfalso
      have h1 := Real.sin_add_int_mul_two_pi (0 : ℝ) ⌊y / (2 * Real.pi)⌋
      rw [zero_add, Real.sin_zero] at h1
      rw [heq] at h1
      linarith
    · exact hlt'
  · by_contra hc
    have hcy : (⌊y / (2 * Real.pi)⌋ : ℝ) * (2 * Real.pi) + Real.pi ≤ y :=
      le_of_not_gt hc
    have hsin : Real.sin y
        = Real.sin (y - (⌊y / (2 * Real.pi)⌋ : ℝ) * (2 * Real.pi)) := by
      have h1 := Real.sin_add_int_mul_two_pi
        (y - (⌊y / (2 * Real.pi)⌋ : ℝ) * (2 * Real.pi)) ⌊y / (2 * Real.pi)⌋
      rwa [sub_add_cancel] at h1
    have hsin2 : Real.sin (y - (⌊y / (2 * Real.pi)⌋ : ℝ) * (2 * Real.pi))
        = -Real.sin (y - (⌊y / (2 * Real.pi)⌋ : ℝ) * (2 * Real.pi) - Real.pi) := by
      have h2 := Real.sin_add_pi
        (y - (⌊y / (2 * Real.pi)⌋ : ℝ) * (2 * Real.pi) - Real.pi)
      rwa [sub_add_cancel] at h2
    have hnn :
        0 ≤ Real.sin (y - (⌊y / (2 * Real.pi)⌋ : ℝ) * (2 * Real.pi) - Real.pi) := by
      refine Real.sin_nonneg_of_nonneg_of_le_pi ?_ ?_
      · linarith
      · linarith
    linarith

theorem exists_int_of_sin_neg {y : ℝ} (h : Real.sin y < 0) :
    ∃ k : ℤ, (k : ℝ) * (2 * Real.pi) - Real.pi < y ∧ y < (k : ℝ) * (2 * Real.pi) := by
  have h' : 0 < Real.sin (-y) := by
    rw [Real.sin_neg]
    linarith
  obtain ⟨k, hk1, hk2⟩ := exists_int_of_sin_pos h'
  refine ⟨-k, ?_, ?_⟩ <;> push_cast <;> linarith

theorem exists_int_mem_Ioo_of_sin_mul_sin_neg {y δ : ℝ} (hδ : 0 < δ) (hδpi : δ < Real.pi)
    (h : Real.sin y * Real.sin (y - δ) < 0) :
    ∃ m : ℤ, (m : ℝ) * Real.pi < y ∧ y < (m : ℝ) * Real.pi + δ := by
  have h2pi : (0 : ℝ) < 2 * Real.pi := by linarith [Real.pi_pos]
  rcases mul_neg_iff.mp h with ⟨h1, h2⟩ | ⟨h1, h2⟩
  · obtain ⟨k, hk1, hk2⟩ := exists_int_of_sin_pos h1
    obtain ⟨j, hj1, hj2⟩ := exists_int_of_sin_neg h2
    have hjk : j = k := by
      rcases lt_trichotomy j k with hlt | heq | hgt
      · exfalso
        have h1 : j + 1 ≤ k := Int.add_one_le_iff.mpr hlt
        have h2 : (j : ℝ) + 1 ≤ (k : ℝ) := by exact_mod_cast h1
        have hmul := mul_le_mul_of_nonneg_right h2 (le_of_lt h2pi)
        linarith [Real.pi_pos]
      · exact heq
      · exfalso
        have h1 : k + 1 ≤ j := Int.add_one_le_iff.mpr hgt
        have h2 : (k : ℝ) + 1 ≤ (j : ℝ) := by exact_mod_cast h1
        have hmul := mul_le_mul_of_nonneg_right h2 (le_of_lt h2pi)
        linarith
    rw [hjk] at hj2
    refine ⟨2 * k, ?_, ?_⟩ <;> push_cast <;> linarith
  · obtain ⟨k, hk1, hk2⟩ := exists_int_of_sin_neg h1
    obtain ⟨j, hj1, hj2⟩ := exists_int_of_sin_pos h2
    have hjk : j = k - 1 := by
      rcases lt_trichotomy j (k - 1) with hlt | heq | hgt
      · exfalso
        have h1 : j + 1 ≤ k - 1 := Int.add_one_le_iff.mpr hlt
        have h2 : (j : ℝ) + 1 ≤ ((k - 1 : ℤ) : ℝ) := by exact_mod_cast h1
        push_cast at h2
        have hmul := mul_le_mul_of_nonneg_right h2 (le_of_lt h2pi)
        linarith [Real.pi_pos]
      · exact heq
      · exfalso
        have h1 : (k - 1) + 1 ≤ j := Int.add_one_le_iff.mpr hgt
        have h2 : k ≤ j := by rwa [sub_add_cancel] at h1
        have h3 : (k : ℝ) ≤ (j : ℝ) := by exact_mod_cast h2
        have hmul := mul_le_mul_of_nonneg_right h3 (le_of_lt h2pi)
        linarith
    rw [hjk] at hj2
    push_cast at hj2
    refine ⟨2 * k - 1, ?_, ?_⟩ <;> push_cast <;> linarith

/-- Exclusion: no small `π`-shift of another edge's lift value lies in the
good window `(x₀, nxt² x₀)`. -/
theorem opB_excl {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    (hdist : ∀ i j : Fin n, e i ≠ 0 → e j ≠ 0 → det2 (e i) (e j) = 0 → i = j)
    (hzz : ∀ i : Fin n, e i ≠ 0) {x₀ : ℝ} (hx₀ : x₀ ∈ opBRays L)
    (mσ : ℤ) {a : Fin n} (ha' : L.Θ a.val = opBNxt L x₀ - (mσ : ℝ) * Real.pi)
    {t : ℤ} (ht : t = 0 ∨ t = 1 ∨ t = -1 ∨ t = 2 ∨ t = -2)
    (k : Fin n) (hka : k ≠ a) :
    (L.Θ k.val + (t : ℝ) * Real.pi) ∉ Set.Ioo x₀ (opBNxt L (opBNxt L x₀)) := by
  intro hmem
  have h0lt : L.Θ 0 ≤ x₀ := (opBRays_mem_bounds L hdist hzz x₀ hx₀).1
  have hk0 : L.Θ k.val ∈ opBRays L :=
    Finset.mem_union_left _ (Finset.mem_image.mpr ⟨k, Finset.mem_univ k, rfl⟩)
  have hn : L.Θ n = L.Θ 0 + 2 * Real.pi := by
    have h := L.period 0
    simp at h
    exact h
  have hktop : L.Θ k.val ≤ L.Θ 0 + 2 * Real.pi := by
    have h3 : L.Θ k.val ≤ L.Θ n := L.monotone (show k.val ≤ n by omega)
    linarith [h3, hn]
  have tail : (L.Θ k.val + (t : ℝ) * Real.pi) ∈ opBRays2 L → False := by
    intro hy2
    have hyb := opB_window_eq L hdist hzz hx₀ hy2 hmem
    have hcon : L.Θ k.val = L.Θ a.val + ((mσ - t : ℤ) : ℝ) * Real.pi := by
      push_cast
      linarith [hyb, ha']
    exact hka (eq_of_theta_eq_add_mul_pi L hdist hzz k a (mσ - t) hcon)
  rcases ht with rfl | rfl | rfl | rfl | rfl
  · apply tail
    simp only [Int.cast_zero, zero_mul, add_zero]
    exact Finset.mem_union_left _ hk0
  · by_cases hc : L.Θ k.val + Real.pi < L.Θ 0 + 2 * Real.pi
    · apply tail
      simp only [Int.cast_one, one_mul]
      exact Finset.mem_union_left _ (Finset.mem_union_right _
        (Finset.mem_image.mpr ⟨k, Finset.mem_univ k, by
          show (if L.Θ k.val + Real.pi < L.Θ 0 + 2 * Real.pi then L.Θ k.val + Real.pi
            else L.Θ k.val - Real.pi) = L.Θ k.val + Real.pi
          rw [if_pos hc]⟩))
    · apply tail
      have hmem1 : L.Θ k.val - Real.pi ∈ opBRays L :=
        Finset.mem_union_right _
          (Finset.mem_image.mpr ⟨k, Finset.mem_univ k, by
            show (if L.Θ k.val + Real.pi < L.Θ 0 + 2 * Real.pi then L.Θ k.val + Real.pi
              else L.Θ k.val - Real.pi) = L.Θ k.val - Real.pi
            rw [if_neg hc]⟩)
      have h1 : L.Θ k.val + ((1 : ℤ) : ℝ) * Real.pi =
          (L.Θ k.val - Real.pi) + 2 * Real.pi := by
        push_cast
        ring
      rw [h1]
      exact Finset.mem_union_right _
        (Finset.mem_image.mpr ⟨L.Θ k.val - Real.pi, hmem1, rfl⟩)
  · by_cases hc : L.Θ k.val + Real.pi < L.Θ 0 + 2 * Real.pi
    · have h := hmem.1
      push_cast at h
      linarith [h, hc, h0lt]
    · apply tail
      simp only [Int.cast_neg, Int.cast_one, neg_one_mul, ← sub_eq_add_neg]
      exact Finset.mem_union_left _ (Finset.mem_union_right _
        (Finset.mem_image.mpr ⟨k, Finset.mem_univ k, by
          show (if L.Θ k.val + Real.pi < L.Θ 0 + 2 * Real.pi then L.Θ k.val + Real.pi
            else L.Θ k.val - Real.pi) = L.Θ k.val - Real.pi
          rw [if_neg hc]⟩))
  · apply tail
    have h1 : L.Θ k.val + ((2 : ℤ) : ℝ) * Real.pi = L.Θ k.val + 2 * Real.pi := by
      push_cast
      ring
    rw [h1]
    exact Finset.mem_union_right _ (Finset.mem_image.mpr ⟨L.Θ k.val, hk0, rfl⟩)
  · have h := hmem.1
    push_cast at h
    linarith [h, hktop, h0lt]

/-- Shifting a unit-vector direction by a multiple of `π` preserves its line. -/
theorem lineKey_uVec_sub_mul_pi (α : ℝ) (m : ℤ) :
    lineKey (uVec (α - (m : ℝ) * Real.pi)) = lineKey (uVec α) := by
  obtain ⟨k1, hk1⟩ := dirAng_uVec (α - (m : ℝ) * Real.pi)
  obtain ⟨k0, hk0⟩ := dirAng_uVec α
  apply (lineKey_eq_iff_int_pi _ _).mpr
  refine ⟨2 * (k0 - k1) + m, by
    rw [hk0, hk1]
    push_cast
    ring⟩

/-- The line of the unit vector along an edge direction is the edge's line. -/
theorem lineKey_uVec_theta {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    (hzz : ∀ i : Fin n, e i ≠ 0) (t : Fin n) :
    lineKey (uVec (L.Θ t.val)) = lineKey (e t) := by
  obtain ⟨k, hk⟩ := dirAng_uVec (L.Θ t.val)
  obtain ⟨m, hm⟩ := L.cons t (hzz t)
  apply (lineKey_eq_iff_int_pi _ _).mpr
  have h1 : dirAng (e t) = L.Θ t.val - 2 * Real.pi * (m : ℝ) := by linarith [hm]
  refine ⟨-2 * (k + m), by
    rw [h1, hk]
    push_cast
    ring⟩

/-- The middle edge of the good triple: direction, window, exclusions, and
line correspondences. -/
theorem opB_middle {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    (hdist : ∀ i j : Fin n, e i ≠ 0 → e j ≠ 0 → det2 (e i) (e j) = 0 → i = j)
    (hzz : ∀ i : Fin n, e i ≠ 0) (hn3 : 3 ≤ n)
    {x₀ : ℝ} (hx₀ : x₀ ∈ opBRays L) :
    ∃ (a : Fin n) (β₁ β₂ : ℝ) (σ : ℤ), β₁ = x₀ - (σ : ℝ) * Real.pi ∧
      (σ = 0 ∨ σ = 1 ∨ σ = -1 ∨ σ = 2) ∧
      β₁ < L.Θ a.val ∧ L.Θ a.val < β₂ ∧
      β₂ - β₁ = opBNxt L (opBNxt L x₀) - x₀ ∧
      (∀ k : Fin n, k ≠ a → L.Θ k.val ∉ Set.Ioo x₀ (opBNxt L (opBNxt L x₀))) ∧
      (∀ k : Fin n, k ≠ a → (L.Θ k.val + Real.pi) ∉ Set.Ioo x₀ (opBNxt L (opBNxt L x₀))) ∧
      (∀ k : Fin n, k ≠ a → (L.Θ k.val - Real.pi) ∉ Set.Ioo x₀ (opBNxt L (opBNxt L x₀))) ∧
      (∀ k : Fin n, k ≠ a → (L.Θ k.val + 2 * Real.pi) ∉ Set.Ioo x₀ (opBNxt L (opBNxt L x₀))) ∧
      (∀ k : Fin n, k ≠ a → (L.Θ k.val - 2 * Real.pi) ∉ Set.Ioo x₀ (opBNxt L (opBNxt L x₀))) ∧
      (∃ c d : Fin n, lineKey (uVec β₁) = lineKey (e c) ∧ lineKey (uVec β₂) = lineKey (e d)) ∧
      opBNxt L (opBNxt L x₀) ≤ L.Θ 0 + 2 * Real.pi + (σ : ℝ) * Real.pi := by
  classical
  set b₁ := opBNxt L x₀ with hb₁
  set b₂ := opBNxt L b₁ with hb₂
  have hb01 : x₀ < b₁ := opBNxt_gt L hdist hzz hx₀
  have h0lt : L.Θ 0 ≤ x₀ := (opBRays_mem_bounds L hdist hzz x₀ hx₀).1
  have htop : x₀ < L.Θ 0 + 2 * Real.pi := (opBRays_mem_bounds L hdist hzz x₀ hx₀).2
  have hb12 : b₁ < b₂ := by
    by_cases hxmax : x₀ = (opBRays L).max' (opBRays_nonempty L)
    · rw [hb₂, hb₁, hxmax, opBNxt_max L hdist hzz, opBNxt_shift_min L hdist hzz hn3]
      have h1 := opBNxt_gt L hdist hzz (Finset.min'_mem _ (opBRays_nonempty L))
      linarith [h1, Real.pi_pos]
    · exact opBNxt_gt L hdist hzz (opBNxt_mem L hdist hzz hx₀ hxmax)
  have hEx : ∀ (mσ : ℤ) {a : Fin n}, L.Θ a.val = b₁ - (mσ : ℝ) * Real.pi →
      (∀ k : Fin n, k ≠ a → L.Θ k.val ∉ Set.Ioo x₀ b₂) ∧
      (∀ k : Fin n, k ≠ a → (L.Θ k.val + Real.pi) ∉ Set.Ioo x₀ b₂) ∧
      (∀ k : Fin n, k ≠ a → (L.Θ k.val - Real.pi) ∉ Set.Ioo x₀ b₂) ∧
      (∀ k : Fin n, k ≠ a → (L.Θ k.val + 2 * Real.pi) ∉ Set.Ioo x₀ b₂) ∧
      (∀ k : Fin n, k ≠ a → (L.Θ k.val - 2 * Real.pi) ∉ Set.Ioo x₀ b₂) := by
    intro mσ a ha
    have ha' : L.Θ a.val = opBNxt L x₀ - (mσ : ℝ) * Real.pi := ha
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · intro k hka
      have hxc := opB_excl L hdist hzz hx₀ mσ ha' (t := 0) (Or.inl rfl) k hka
      simpa [hb₁, hb₂] using hxc
    · intro k hka
      have hxc := opB_excl L hdist hzz hx₀ mσ ha' (t := 1) (Or.inr (Or.inl rfl)) k hka
      simpa [hb₁, hb₂] using hxc
    · intro k hka
      have hxc := opB_excl L hdist hzz hx₀ mσ ha' (t := -1) (Or.inr (Or.inr (Or.inl rfl))) k hka
      rw [show L.Θ k.val - Real.pi = L.Θ k.val + ((-1 : ℤ) : ℝ) * Real.pi from by
        push_cast; ring, hb₂, hb₁]
      exact hxc
    · intro k hka
      have hxc := opB_excl L hdist hzz hx₀ mσ ha' (t := 2)
        (Or.inr (Or.inr (Or.inr (Or.inl rfl)))) k hka
      simpa [hb₁, hb₂] using hxc
    · intro k hka
      have hxc := opB_excl L hdist hzz hx₀ mσ ha' (t := -2)
        (Or.inr (Or.inr (Or.inr (Or.inr rfl)))) k hka
      rw [show L.Θ k.val - 2 * Real.pi = L.Θ k.val + ((-2 : ℤ) : ℝ) * Real.pi from by
        push_cast; ring, hb₂, hb₁]
      exact hxc
  -- line-correspondence helpers
  have hcorr1 : ∀ γ : ℝ, (∃ c : Fin n, lineKey (uVec γ) = lineKey (e c)) →
      ∀ m : ℤ, ∃ c : Fin n, lineKey (uVec (γ - (m : ℝ) * Real.pi)) = lineKey (e c) := by
    intro γ h m
    obtain ⟨c, hc⟩ := h
    rw [lineKey_uVec_sub_mul_pi γ m]
    exact ⟨c, hc⟩
  have hbase : ∀ y : ℝ, y ∈ opBRays L → ∃ c : Fin n, lineKey (uVec y) = lineKey (e c) := by
    intro y hy
    unfold opBRays at hy
    rw [Finset.mem_union, Finset.mem_image, Finset.mem_image] at hy
    rcases hy with ⟨c, _, rfl⟩ | ⟨c, _, rfl⟩
    · exact ⟨c, lineKey_uVec_theta L hzz c⟩
    · by_cases hw : L.Θ c.val + Real.pi < L.Θ 0 + 2 * Real.pi
      · rw [if_pos hw]
        have h1 : lineKey (uVec (L.Θ c.val + Real.pi)) = lineKey (uVec (L.Θ c.val)) := by
          have h2 := lineKey_uVec_sub_mul_pi (L.Θ c.val + Real.pi) 1
          rw [show L.Θ c.val + Real.pi - ((1 : ℤ) : ℝ) * Real.pi = L.Θ c.val from by
            push_cast; ring] at h2
          exact h2.symm
        rw [h1]
        exact ⟨c, lineKey_uVec_theta L hzz c⟩
      · rw [if_neg hw]
        have h1 : lineKey (uVec (L.Θ c.val - Real.pi)) = lineKey (uVec (L.Θ c.val)) := by
          have h2 := lineKey_uVec_sub_mul_pi (L.Θ c.val) 1
          rw [show L.Θ c.val - ((1 : ℤ) : ℝ) * Real.pi = L.Θ c.val - Real.pi from by
            push_cast; ring] at h2
          exact h2
        rw [h1]
        exact ⟨c, lineKey_uVec_theta L hzz c⟩
  by_cases hxmax : x₀ = (opBRays L).max' (opBRays_nonempty L)
  · -- case C: `b₁ = mn + 2π`
    have hb1eq : b₁ = (opBRays L).min' (opBRays_nonempty L) + 2 * Real.pi := by
      rw [hb₁, hxmax]
      exact opBNxt_max L hdist hzz
    have hmn : (opBRays L).min' (opBRays_nonempty L) = L.Θ 0 := opBRays_min' L hdist hzz
    have hb2eq : b₂ = opBNxt L ((opBRays L).min' (opBRays_nonempty L)) + 2 * Real.pi := by
      rw [hb₂, hb1eq]
      exact opBNxt_shift_min L hdist hzz hn3
    have hmn_ne_mx : (opBRays L).min' (opBRays_nonempty L) ≠
        (opBRays L).max' (opBRays_nonempty L) := by
      have hcard : (opBRays L).card = 2 * n := card_opBRays L hdist hzz
      intro h
      have h2 : ∀ a ∈ opBRays L, ∀ b ∈ opBRays L, a = b := by
        intro a ha b hb
        have h3 := Finset.min'_le _ a ha
        have h4 := Finset.le_max' _ a ha
        have h5 := Finset.min'_le _ b hb
        have h6 := Finset.le_max' _ b hb
        rw [← h] at *
        linarith [h3, h4, h5, h6]
      have h7 : (opBRays L).card ≤ 1 := Finset.card_le_one.mpr h2
      omega
    have hsn_mem : opBNxt L ((opBRays L).min' (opBRays_nonempty L)) ∈ opBRays L :=
      opBNxt_mem L hdist hzz (Finset.min'_mem _ (opBRays_nonempty L)) hmn_ne_mx
    have ha : L.Θ (0 : Fin n).val = b₁ - ((2 : ℤ) : ℝ) * Real.pi := by
      simp only [Fin.val_zero]
      rw [hb1eq, hmn]
      push_cast
      ring
    obtain ⟨hE1, hE2, hE3, hE4, hE5⟩ := hEx 2 ha
    have hβ1 : ∃ c : Fin n, lineKey (uVec (x₀ - 2 * Real.pi)) = lineKey (e c) :=
      hcorr1 x₀ (hbase x₀ hx₀) 2
    have hsn_gt : (opBRays L).min' (opBRays_nonempty L) <
        opBNxt L ((opBRays L).min' (opBRays_nonempty L)) :=
      opBNxt_gt L hdist hzz (Finset.min'_mem _ (opBRays_nonempty L))
    have hβ2 : ∃ d : Fin n, lineKey (uVec (b₂ - 2 * Real.pi)) = lineKey (e d) := by
      have h9 : lineKey (uVec (b₂ - 2 * Real.pi)) =
          lineKey (uVec (opBNxt L ((opBRays L).min' (opBRays_nonempty L)))) := by
        rw [show b₂ - 2 * Real.pi = opBNxt L ((opBRays L).min' (opBRays_nonempty L)) from by
          linarith [hb2eq]]
      rw [h9]
      exact hbase _ hsn_mem
    exact ⟨0, x₀ - 2 * Real.pi, b₂ - 2 * Real.pi, 2, by push_cast; ring,
      Or.inr (Or.inr (Or.inr rfl)),
      by simp only [Fin.val_zero]; rw [← hmn]; linarith [hb1eq, hb01],
      by simp only [Fin.val_zero]; rw [← hmn]; linarith [hb2eq, hsn_gt],
      by ring, hE1, hE2, hE3, hE4, hE5,
      hβ1.elim (fun c hc => ⟨c, hβ2.elim (fun d hd => ⟨d, hc, hd⟩)⟩), by
      have h1 := (opBRays_mem_bounds L hdist hzz _ hsn_mem).2
      push_cast
      linarith [h1, hb2eq]⟩
  · -- cases A/B: `b₁` is a genuine ray
    have hb1R : b₁ ∈ opBRays L := opBNxt_mem L hdist hzz hx₀ hxmax
    have hb2cases : b₂ ∈ opBRays L ∨ b₂ = (opBRays L).min' (opBRays_nonempty L) + 2 * Real.pi := by
      by_cases hb1max : b₁ = (opBRays L).max' (opBRays_nonempty L)
      · exact Or.inr (by rw [hb₂, hb1max, opBNxt_max L hdist hzz])
      · exact Or.inl (opBNxt_mem L hdist hzz hb1R hb1max)
    have hb2corr : ∃ d : Fin n, lineKey (uVec b₂) = lineKey (e d) := by
      rcases hb2cases with hb2R | hb2eq
      · exact hbase b₂ hb2R
      · have hmn : (opBRays L).min' (opBRays_nonempty L) = L.Θ 0 := opBRays_min' L hdist hzz
        refine ⟨0, ?_⟩
        rw [hb2eq, hmn]
        have h1 : lineKey (uVec (L.Θ 0 + 2 * Real.pi)) = lineKey (uVec (L.Θ 0)) := by
          have h2 := lineKey_uVec_sub_mul_pi (L.Θ 0 + 2 * Real.pi) 2
          rw [show L.Θ 0 + 2 * Real.pi - ((2 : ℤ) : ℝ) * Real.pi = L.Θ 0 from by
            push_cast; ring] at h2
          exact h2.symm
        rw [h1]
        exact lineKey_uVec_theta L hzz 0
    have hb1corr : ∃ c : Fin n, lineKey (uVec x₀) = lineKey (e c) := hbase x₀ hx₀
    unfold opBRays at hb1R
    rw [Finset.mem_union, Finset.mem_image, Finset.mem_image] at hb1R
    rcases hb1R with ⟨a, _, ha⟩ | ⟨a, _, ha⟩
    · -- case A: `b₁ = L.Θ a`
      have ha2 : L.Θ a.val = b₁ := ha
      have ha : L.Θ a.val = b₁ - ((0 : ℤ) : ℝ) * Real.pi := by
        rw [ha2]
        push_cast
        ring
      obtain ⟨hE1, hE2, hE3, hE4, hE5⟩ := hEx 0 ha
      exact ⟨a, x₀, b₂, 0, by push_cast; ring, Or.inl rfl, by linarith [ha2, hb01],
        by linarith [ha2, hb12], by ring,
        hE1, hE2, hE3, hE4, hE5,
        hb1corr.elim (fun c hc => ⟨c, hb2corr.elim (fun d hd => ⟨d, hc, hd⟩)⟩), by
        push_cast
        rcases hb2cases with hb2R | hb2eq
        · have h1 := (opBRays_mem_bounds L hdist hzz _ hb2R).2
          linarith [h1]
        · have hmn : (opBRays L).min' (opBRays_nonempty L) = L.Θ 0 := opBRays_min' L hdist hzz
          linarith [hmn, hb2eq]⟩
    · -- case B: antipode
      have ha' : (if L.Θ a.val + Real.pi < L.Θ 0 + 2 * Real.pi then
          L.Θ a.val + Real.pi else L.Θ a.val - Real.pi) = b₁ := ha
      by_cases hw : L.Θ a.val + Real.pi < L.Θ 0 + 2 * Real.pi
      · -- case B-then: `b₁ = L.Θ a + π`
        rw [if_pos hw] at ha'
        have ha2 : L.Θ a.val = b₁ - Real.pi := by linarith [ha']
        have ha : L.Θ a.val = b₁ - ((1 : ℤ) : ℝ) * Real.pi := by
          rw [ha2]
          push_cast
          ring
        obtain ⟨hE1, hE2, hE3, hE4, hE5⟩ := hEx 1 ha
        exact ⟨a, x₀ - Real.pi, b₂ - Real.pi, 1, by push_cast; ring,
          Or.inr (Or.inl rfl),
          by linarith [ha2, hb01], by linarith [ha2, hb12], by ring, hE1, hE2, hE3, hE4, hE5,
          (hcorr1 x₀ hb1corr 1).elim (fun c hc =>
            ⟨c, (hcorr1 b₂ hb2corr 1).elim (fun d hd => ⟨d, by
              rw [show x₀ - Real.pi = x₀ - ((1 : ℤ) : ℝ) * Real.pi from by push_cast; ring]
              exact hc, by
              rw [show b₂ - Real.pi = b₂ - ((1 : ℤ) : ℝ) * Real.pi from by push_cast; ring]
              exact hd⟩)⟩), by
          push_cast
          rcases hb2cases with hb2R | hb2eq
          · have h1 := (opBRays_mem_bounds L hdist hzz _ hb2R).2
            linarith [h1, Real.pi_pos]
          · have hmn : (opBRays L).min' (opBRays_nonempty L) = L.Θ 0 := opBRays_min' L hdist hzz
            linarith [hmn, hb2eq, Real.pi_pos]⟩
      · -- case B-else: `b₁ = L.Θ a − π`
        rw [if_neg hw] at ha'
        have ha2 : L.Θ a.val = b₁ + Real.pi := by linarith [ha']
        have ha : L.Θ a.val = b₁ - ((-1 : ℤ) : ℝ) * Real.pi := by
          rw [ha2]
          push_cast
          ring
        obtain ⟨hE1, hE2, hE3, hE4, hE5⟩ := hEx (-1) ha
        exact ⟨a, x₀ + Real.pi, b₂ + Real.pi, -1, by push_cast; ring,
          Or.inr (Or.inr (Or.inl rfl)),
          by linarith [ha2, hb01], by linarith [ha2, hb12], by ring, hE1, hE2, hE3, hE4, hE5,
          (hcorr1 x₀ hb1corr (-1)).elim (fun c hc =>
            ⟨c, (hcorr1 b₂ hb2corr (-1)).elim (fun d hd => ⟨d, by
              rw [show x₀ + Real.pi = x₀ - ((-1 : ℤ) : ℝ) * Real.pi from by push_cast; ring]
              exact hc, by
              rw [show b₂ + Real.pi = b₂ - ((-1 : ℤ) : ℝ) * Real.pi from by push_cast; ring]
              exact hd⟩)⟩), by
          push_cast
          have hb1max : b₁ ≠ (opBRays L).max' (opBRays_nonempty L) := by
            intro hcon
            have h1 : L.Θ a.val ∈ opBRays L :=
              Finset.mem_union_left _ (Finset.mem_image.mpr ⟨a, Finset.mem_univ a, rfl⟩)
            have h2 : L.Θ a.val ≤ (opBRays L).max' (opBRays_nonempty L) :=
              Finset.le_max' _ _ h1
            linarith [h2, ha', hcon, Real.pi_pos]
          have hanti : L.Θ 0 + Real.pi ∈ opBRays L :=
            Finset.mem_union_right _ (Finset.mem_image.mpr ⟨0, Finset.mem_univ 0, by
              simp only [Fin.val_zero]
              rw [if_pos (by linarith [Real.pi_pos] :
                L.Θ 0 + Real.pi < L.Θ 0 + 2 * Real.pi)]⟩)
          have hb1lt : b₁ < L.Θ 0 + Real.pi := by
            have h1 := (opBRays_mem_bounds L hdist hzz _ (Finset.mem_union_left _
              (Finset.mem_image.mpr ⟨a, Finset.mem_univ a, rfl⟩))).2
            linarith [h1, ha', Real.pi_pos]
          have hb2le : b₂ ≤ L.Θ 0 + Real.pi :=
            opBNxt_le L (L.Θ 0 + Real.pi) (Finset.mem_union_left _ hanti) hb1lt
          linarith [hb2le, Real.pi_pos]⟩

/-!
### Operation B: the algebra of splitting one edge

Splitting the edge `e a` into `f1 + f2 = e a` (inserting `f2` right after
position `a`) lowers the defect `F` by exactly `det2 f1 f2`, preserves
closure, adds one nonzero edge, and removes one direction line (the line of
`e a`, replaced by two pre-existing lines).
-/

/-- `Fin.sum_succAbove` for an arbitrary additive commutative monoid. -/
theorem Fin.sum_succAbove' {n : ℕ} {M : Type*} [AddCommMonoid M] (p : Fin (n + 1))
    (f : Fin (n + 1) → M) : (∑ k : Fin n, f (p.succAbove k)) = ∑ j ∈ univ.erase p, f j := by
  apply Finset.sum_bij (fun k _ => p.succAbove k)
  · intro k _
    exact Finset.mem_erase.mpr ⟨Fin.succAbove_ne p k, Finset.mem_univ _⟩
  · intro k1 _ k2 _ h
    exact Fin.succAbove_right_injective h
  · intro j hj
    have hj' : j ≠ p := Finset.ne_of_mem_erase hj
    obtain ⟨z, hz⟩ := Fin.exists_succAbove_eq hj'
    exact ⟨z, Finset.mem_univ _, hz⟩
  · intro k _
    rfl

/-- The defect after splitting edge `a` into `f1 + f2` drops by `det2 f1 f2`. -/
theorem FES_opB_split {n : ℕ} [NeZero n] (e : Fin n → ℝ × ℝ) (a : Fin n)
    (f1 f2 : ℝ × ℝ) (hsum : f1 + f2 = e a) (hdet : 0 < det2 f1 f2)
    (hsign : ∀ k : Fin n, k ≠ a → 0 ≤ det2 f1 (e k) * det2 f2 (e k)) :
    FES (Fin.insertNth (α := fun _ => ℝ × ℝ) ⟨a.val + 1, by omega⟩ f2
      (Function.update e a f1)) = FES e - det2 f1 f2 := by
  set p : Fin (n + 1) := ⟨a.val + 1, by omega⟩ with hp
  have hG1 : GES (Function.update e a f1) - GES e =
      ∑ k ∈ univ.erase a, (|det2 f1 (e k)| - |det2 (e a) (e k)|) :=
    GES_update_sub e a f1
  have hG2 : GES (Fin.insertNth (α := fun _ => ℝ × ℝ) p f2 (Function.update e a f1)) -
      GES (Function.update e a f1) = ∑ k : Fin n, |det2 f2 (Function.update e a f1 k)| :=
    GES_insertNth_sub (Function.update e a f1) p f2
  have hG3 : (∑ k : Fin n, |det2 f2 (Function.update e a f1 k)|) =
      |det2 f2 f1| + ∑ k ∈ univ.erase a, |det2 f2 (e k)| := by
    rw [← Finset.add_sum_erase univ (fun k => |det2 f2 (Function.update e a f1 k)|)
      (Finset.mem_univ a)]
    congr 1
    · rw [Function.update_self]
    · apply Finset.sum_congr rfl
      intro k hk
      rw [Function.update_of_ne (Finset.ne_of_mem_erase hk)]
  have habs : ∀ k ∈ univ.erase a,
      |det2 f1 (e k)| + |det2 f2 (e k)| = |det2 (e a) (e k)| := by
    intro k hk
    have hka : k ≠ a := Finset.ne_of_mem_erase hk
    have h1 : det2 f1 (e k) + det2 f2 (e k) = det2 (e a) (e k) := by
      rw [← det2_add_left, hsum]
    have h2 : 0 ≤ det2 f1 (e k) * det2 f2 (e k) := hsign k hka
    rw [← h1]
    rcases eq_or_ne (det2 f1 (e k)) 0 with hz | hz
    · simp [hz]
    · have hs : (0 ≤ det2 f1 (e k) ∧ 0 ≤ det2 f2 (e k)) ∨
          (det2 f1 (e k) ≤ 0 ∧ det2 f2 (e k) ≤ 0) := by
        rcases le_or_gt 0 (det2 f1 (e k)) with h5 | h5
        · exact Or.inl ⟨h5, nonneg_of_mul_nonneg_right h2 (lt_of_le_of_ne h5 (Ne.symm hz))⟩
        · exact Or.inr ⟨le_of_lt h5, nonpos_of_mul_nonneg_right h2 h5⟩
      rcases hs with ⟨h3, h4⟩ | ⟨h3, h4⟩
      · rw [abs_of_nonneg h3, abs_of_nonneg h4, abs_of_nonneg (add_nonneg h3 h4)]
      · rw [abs_of_nonpos h3, abs_of_nonpos h4, abs_of_nonpos (add_nonpos h3 h4)]
        ring
  have hG : GES (Fin.insertNth (α := fun _ => ℝ × ℝ) p f2 (Function.update e a f1)) =
      GES e + det2 f1 f2 := by
    have hcancel : ∑ k ∈ univ.erase a,
        (|det2 f1 (e k)| - |det2 (e a) (e k)| + |det2 f2 (e k)|) = 0 := by
      apply Finset.sum_eq_zero
      intro k hk
      have h5 := habs k hk
      linarith [h5]
    have hdet2 : |det2 f2 f1| = det2 f1 f2 := by
      have h6 : det2 f2 f1 = -det2 f1 f2 := by
        show f2.1 * f1.2 - f2.2 * f1.1 = -(f1.1 * f2.2 - f1.2 * f2.1)
        ring
      rw [h6, abs_neg, abs_of_pos hdet]
    have hsum_id : (∑ k ∈ univ.erase a, (|det2 f1 (e k)| - |det2 (e a) (e k)|)) +
        (|det2 f2 f1| + ∑ k ∈ univ.erase a, |det2 f2 (e k)|) = det2 f1 f2 := by
      have h1 : (∑ k ∈ univ.erase a, (|det2 f1 (e k)| - |det2 (e a) (e k)|)) +
          (|det2 f2 f1| + ∑ k ∈ univ.erase a, |det2 f2 (e k)|) =
          ((∑ k ∈ univ.erase a, (|det2 f1 (e k)| - |det2 (e a) (e k)|)) +
            ∑ k ∈ univ.erase a, |det2 f2 (e k)|) + |det2 f2 f1| := by ring
      rw [h1, ← Finset.sum_add_distrib, hcancel, zero_add, hdet2]
    linarith [hG1, hG2, hG3, hsum_id]
  have hS1 : SES (Function.update e a f1) - SES e =
      (∑ k ∈ univ.filter fun k => k.val < a.val, det2 (e k) (f1 - e a)) +
        (∑ k ∈ univ.filter fun k => a.val < k.val, det2 (f1 - e a) (e k)) :=
    SES_update_sub e a f1
  have hS2 : SES (Fin.insertNth (α := fun _ => ℝ × ℝ) p f2 (Function.update e a f1)) -
      SES (Function.update e a f1) =
      ∑ k : Fin n, if k.val < p.val then det2 (Function.update e a f1 k) f2
        else det2 f2 (Function.update e a f1 k) :=
    SES_insertNth_sub (Function.update e a f1) p f2
  have hpval : p.val = a.val + 1 := rfl
  have hS3 : (∑ k : Fin n, if k.val < p.val then det2 (Function.update e a f1 k) f2
        else det2 f2 (Function.update e a f1 k)) =
      det2 f1 f2 + (∑ k ∈ univ.filter fun k => k.val < a.val, det2 (e k) f2) +
        (∑ k ∈ univ.filter fun k => a.val < k.val, det2 f2 (e k)) := by
    have hp1 : (∑ k : Fin n, if k.val < p.val then det2 (Function.update e a f1 k) f2
          else det2 f2 (Function.update e a f1 k)) =
        (∑ k ∈ univ.filter fun k => k.val < p.val, det2 (Function.update e a f1 k) f2) +
          (∑ k ∈ univ.filter fun k => ¬ k.val < p.val,
            det2 f2 (Function.update e a f1 k)) := by
      rw [← Finset.sum_filter_add_sum_filter_not univ (fun k => k.val < p.val)
        (fun k => if k.val < p.val then det2 (Function.update e a f1 k) f2
          else det2 f2 (Function.update e a f1 k))]
      congr 1
      · apply Finset.sum_congr rfl
        intro k hk
        rw [if_pos (Finset.mem_filter.mp hk).2]
      · apply Finset.sum_congr rfl
        intro k hk
        rw [if_neg (Finset.mem_filter.mp hk).2]
    have hp2 : (univ.filter fun k : Fin n => k.val < p.val) =
        insert a (univ.filter fun k : Fin n => k.val < a.val) := by
      ext k
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_insert]
      rw [hpval]
      constructor
      · intro h
        by_cases hka : k = a
        · exact Or.inl hka
        · exact Or.inr (by
            have h2 : k.val ≠ a.val := fun h3 => hka (Fin.ext h3)
            omega)
      · intro h
        rcases h with rfl | h
        · exact Nat.lt_succ_self _
        · exact Nat.lt_succ_of_lt h
    have hp3 : (univ.filter fun k : Fin n => ¬ k.val < p.val) =
        univ.filter fun k : Fin n => a.val < k.val := by
      ext k
      simp only [Finset.mem_filter, Finset.mem_univ, true_and]
      rw [hpval]
      constructor <;> intro h <;> omega
    have hSa : (∑ k ∈ univ.filter fun k : Fin n => k.val < a.val,
        det2 (Function.update e a f1 k) f2) =
        ∑ k ∈ univ.filter fun k : Fin n => k.val < a.val, det2 (e k) f2 := by
      apply Finset.sum_congr rfl
      intro k hk
      rw [Function.update_of_ne (by
        intro hcon
        subst hcon
        simp at hk)]
    have hSb : (∑ k ∈ univ.filter fun k : Fin n => a.val < k.val,
        det2 f2 (Function.update e a f1 k)) =
        ∑ k ∈ univ.filter fun k : Fin n => a.val < k.val, det2 f2 (e k) := by
      apply Finset.sum_congr rfl
      intro k hk
      rw [Function.update_of_ne (by
        intro hcon
        subst hcon
        simp at hk)]
    rw [hp1, hp2, hp3, Finset.sum_insert (by simp), Function.update_self, hSa, hSb]
  have hS : SES (Fin.insertNth (α := fun _ => ℝ × ℝ) p f2 (Function.update e a f1)) =
      SES e + det2 f1 f2 := by
    have hz : f1 - e a + f2 = 0 := by
      have h1 : f1 + f2 - e a = 0 := sub_eq_zero.mpr hsum
      have h2 : f1 - e a + f2 = f1 + f2 - e a := by ext <;> simp <;> ring
      rw [h2]
      exact h1
    have hzero1 : (∑ k ∈ univ.filter fun k : Fin n => k.val < a.val,
        det2 (e k) (f1 - e a)) +
        (∑ k ∈ univ.filter fun k : Fin n => k.val < a.val, det2 (e k) f2) = 0 := by
      rw [← Finset.sum_add_distrib]
      apply Finset.sum_eq_zero
      intro k hk
      rw [← det2_add_right, hz, det2_zero_right]
    have hzero2 : (∑ k ∈ univ.filter fun k : Fin n => a.val < k.val,
        det2 (f1 - e a) (e k)) +
        (∑ k ∈ univ.filter fun k : Fin n => a.val < k.val, det2 f2 (e k)) = 0 := by
      rw [← Finset.sum_add_distrib]
      apply Finset.sum_eq_zero
      intro k hk
      rw [← det2_add_left, hz, det2_zero_left]
    linarith [hS1, hS2, hS3, hzero1, hzero2]
  simp only [FES]
  rw [hG, hS]
  ring

/-- The split preserves the edge-sum invariant. -/
theorem ESClosed_opB_split {n : ℕ} [NeZero n] (e : Fin n → ℝ × ℝ) (a : Fin n)
    (f1 f2 : ℝ × ℝ) (hsum : f1 + f2 = e a) (hclosed : ESClosed e) :
    ESClosed (Fin.insertNth (α := fun _ => ℝ × ℝ) ⟨a.val + 1, by omega⟩ f2
      (Function.update e a f1)) := by
  set p : Fin (n + 1) := ⟨a.val + 1, by omega⟩ with hp
  have hsumk : (∑ k : Fin n, Function.update e a f1 k) = - e a + f1 := by
    rw [← Finset.add_sum_erase univ (fun k => Function.update e a f1 k) (Finset.mem_univ a),
      Function.update_self]
    have h4 : (∑ x ∈ univ.erase a, Function.update e a f1 x) = ∑ x ∈ univ.erase a, e x := by
      apply Finset.sum_congr rfl
      intro k hk
      rw [Function.update_of_ne (Finset.ne_of_mem_erase hk)]
    rw [h4]
    have h5 : (∑ x ∈ univ.erase a, e x) = - e a := by
      have h6 := Finset.add_sum_erase univ e (Finset.mem_univ a)
      have h0 : (∑ i, e i) = 0 := hclosed
      rw [h0] at h6
      have h7 : (∑ x ∈ univ.erase a, e x) + e a = 0 := by
        rw [add_comm]
        exact h6
      exact eq_neg_of_add_eq_zero_left h7
    rw [h5]
    ext <;> simp <;> ring
  have h8 : (∑ j : Fin (n + 1), Fin.insertNth (α := fun _ => ℝ × ℝ) p f2
      (Function.update e a f1) j) = 0 := by
    have h2 := Fin.sum_succAbove_prod p
      (Fin.insertNth (α := fun _ => ℝ × ℝ) p f2 (Function.update e a f1))
    simp only [Fin.insertNth_apply_succAbove] at h2
    have h9 := Finset.add_sum_erase univ
      (Fin.insertNth (α := fun _ => ℝ × ℝ) p f2 (Function.update e a f1))
      (Finset.mem_univ p)
    simp only [Fin.insertNth_apply_same] at h9
    rw [← h2, hsumk] at h9
    rw [← h9]
    have h10 : f2 + (-e a + f1) = f1 + f2 - e a := by ext <;> simp <;> ring
    rw [h10, sub_eq_zero]
    exact hsum
  exact h8

/-- The split adds exactly one nonzero edge. -/
theorem esNu_opB_split {n : ℕ} [NeZero n] (e : Fin n → ℝ × ℝ) (a : Fin n)
    (f1 f2 : ℝ × ℝ) (hf1 : f1 ≠ 0) (hf2 : f2 ≠ 0) (hea : e a ≠ 0) :
    esNu (Fin.insertNth (α := fun _ => ℝ × ℝ) ⟨a.val + 1, by omega⟩ f2
      (Function.update e a f1)) = esNu e + 1 := by
  set p : Fin (n + 1) := ⟨a.val + 1, by omega⟩ with hp
  simp only [esNu, Finset.card_filter]
  have hsucc := Fin.sum_succAbove' p (fun j : Fin (n + 1) =>
    if Fin.insertNth (α := fun _ => ℝ × ℝ) p f2 (Function.update e a f1) j ≠ 0
    then (1 : ℕ) else 0)
  simp only [Fin.insertNth_apply_succAbove] at hsucc
  have hsum : (∑ j : Fin (n + 1), if Fin.insertNth (α := fun _ => ℝ × ℝ) p f2
        (Function.update e a f1) j ≠ 0 then (1 : ℕ) else 0) =
      (if f2 ≠ 0 then (1 : ℕ) else 0) +
        ∑ k : Fin n, (if Function.update e a f1 k ≠ 0 then 1 else 0) := by
    rw [← Finset.add_sum_erase univ (fun j : Fin (n + 1) =>
      if Fin.insertNth (α := fun _ => ℝ × ℝ) p f2 (Function.update e a f1) j ≠ 0
      then (1 : ℕ) else 0) (Finset.mem_univ p), ← hsucc]
    simp only [Fin.insertNth_apply_same]
  have hpt : ∀ k : Fin n, (if Function.update e a f1 k ≠ 0 then (1 : ℕ) else 0) =
      (if e k ≠ 0 then 1 else 0) := by
    intro k
    by_cases hka : k = a
    · subst hka
      rw [Function.update_self, if_pos hf1, if_pos hea]
    · rw [Function.update_of_ne hka]
  rw [hsum, if_pos hf2, Finset.sum_congr rfl (fun k _ => hpt k)]
  ring

/-- The split removes exactly one direction line. -/
theorem esEll_opB_split {n : ℕ} [NeZero n] (e : Fin n → ℝ × ℝ)
    (hdist : ∀ i j : Fin n, e i ≠ 0 → e j ≠ 0 → det2 (e i) (e j) = 0 → i = j)
    (a c d : Fin n) (f1 f2 : ℝ × ℝ)
    (hf1 : f1 ≠ 0) (hf2 : f2 ≠ 0) (hea : e a ≠ 0) (hzz : ∀ i : Fin n, e i ≠ 0)
    (hdet1 : det2 f1 (e a) ≠ 0) (hdet2 : det2 f2 (e a) ≠ 0)
    (hline1 : lineKey f1 = lineKey (e c)) (hline2 : lineKey f2 = lineKey (e d)) :
    esEll (Fin.insertNth (α := fun _ => ℝ × ℝ) ⟨a.val + 1, by omega⟩ f2
      (Function.update e a f1)) + 1 = esEll e := by
  set p : Fin (n + 1) := ⟨a.val + 1, by omega⟩ with hp
  have hca : lineKey (e c) ≠ lineKey (e a) := by
    intro hcon
    have hdet : det2 (e c) (e a) = 0 := (lineKey_eq_iff _ _ (hzz c) hea).mp hcon
    have h1 : c = a := hdist c a (hzz c) hea hdet
    subst h1
    exact hdet1 ((lineKey_eq_iff _ _ hf1 hea).mp hline1)
  have hda : lineKey (e d) ≠ lineKey (e a) := by
    intro hcon
    have hdet : det2 (e d) (e a) = 0 := (lineKey_eq_iff _ _ (hzz d) hea).mp hcon
    have h1 : d = a := hdist d a (hzz d) hea hdet
    subst h1
    exact hdet2 ((lineKey_eq_iff _ _ hf2 hea).mp hline2)
  have himg : (univ.filter fun j : Fin (n + 1) => Fin.insertNth (α := fun _ => ℝ × ℝ) p f2
        (Function.update e a f1) j ≠ 0).image
        (fun j => lineKey (Fin.insertNth (α := fun _ => ℝ × ℝ) p f2
          (Function.update e a f1) j)) =
      ((univ.filter fun i : Fin n => e i ≠ 0).image fun i => lineKey (e i)).erase
        (lineKey (e a)) := by
    ext y
    constructor
    · intro hy
      obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hy
      have hjnz : Fin.insertNth (α := fun _ => ℝ × ℝ) p f2 (Function.update e a f1) j ≠ 0 :=
        (Finset.mem_filter.mp hj).2
      by_cases hjp : j = p
      · subst hjp
        rw [Fin.insertNth_apply_same, hline2]
        exact Finset.mem_erase.mpr ⟨hda, Finset.mem_image.mpr
          ⟨d, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hzz d⟩, rfl⟩⟩
      · obtain ⟨k, rfl⟩ := Fin.exists_succAbove_eq hjp
        rw [Fin.insertNth_apply_succAbove] at hjnz ⊢
        by_cases hka : k = a
        · subst hka
          rw [Function.update_self, hline1]
          exact Finset.mem_erase.mpr ⟨hca, Finset.mem_image.mpr
            ⟨c, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hzz c⟩, rfl⟩⟩
        · rw [Function.update_of_ne hka] at hjnz ⊢
          exact Finset.mem_erase.mpr ⟨by
            intro hcon
            have hdet : det2 (e k) (e a) = 0 := (lineKey_eq_iff _ _ (hzz k) hea).mp hcon
            exact hka (hdist k a (hzz k) hea hdet), Finset.mem_image.mpr
            ⟨k, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hjnz⟩, rfl⟩⟩
    · intro hy
      have hy2 : y ∈ (univ.filter fun i : Fin n => e i ≠ 0).image fun i => lineKey (e i) :=
        Finset.mem_of_mem_erase hy
      have hy3 : y ≠ lineKey (e a) := (Finset.mem_erase.mp hy).1
      obtain ⟨k, hk, rfl⟩ := Finset.mem_image.mp hy2
      have hknz : e k ≠ 0 := (Finset.mem_filter.mp hk).2
      have hka : k ≠ a := by
        intro hcon
        subst hcon
        exact hy3 rfl
      exact Finset.mem_image.mpr ⟨p.succAbove k, Finset.mem_filter.mpr ⟨Finset.mem_univ _, by
        rw [Fin.insertNth_apply_succAbove, Function.update_of_ne hka]
        exact hknz⟩, by
        rw [Fin.insertNth_apply_succAbove, Function.update_of_ne hka]⟩
  have hmem : lineKey (e a) ∈ (univ.filter fun i : Fin n => e i ≠ 0).image
      fun i => lineKey (e i) :=
    Finset.mem_image.mpr ⟨a, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hea⟩, rfl⟩
  simp only [esEll]
  rw [himg, Finset.card_erase_of_mem hmem]
  have hpos : 0 < ((univ.filter fun i : Fin n => e i ≠ 0).image
      fun i => lineKey (e i)).card :=
    Finset.card_pos.mpr ⟨lineKey (e a), hmem⟩
  omega

/-- `Θ` is strictly monotone on the index range. -/
theorem opB_strict {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    (hdist : ∀ i j : Fin n, e i ≠ 0 → e j ≠ 0 → det2 (e i) (e j) = 0 → i = j)
    (hzz : ∀ i : Fin n, e i ≠ 0) {i j : Fin n} (hij : i.val < j.val) :
    L.Θ i.val < L.Θ j.val := by
  have h1 : L.Θ i.val ≤ L.Θ j.val := L.monotone (le_of_lt hij)
  rcases eq_or_lt_of_le h1 with heq | hlt
  · exfalso
    have h2 : i = j := eq_of_theta_eq_add_mul_pi L hdist hzz i j 0 (by
      rw [heq]
      simp)
    rw [h2] at hij
    exact lt_irrefl _ hij
  · exact hlt

/-- The sign condition for the split of operation B: for every other edge,
the determinants with the two new edges have the same sign. -/
theorem opB_sign_cond {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    (hdist : ∀ i j : Fin n, e i ≠ 0 → e j ≠ 0 → det2 (e i) (e j) = 0 → i = j)
    (hzz : ∀ i : Fin n, e i ≠ 0) {x₀ : ℝ} (hx₀ : x₀ ∈ opBRays L)
    (hgap : opBNxt L (opBNxt L x₀) - x₀ < Real.pi)
    {a : Fin n} {β₁ β₂ : ℝ} {σ : ℤ}
    (hσ : β₁ = x₀ - (σ : ℝ) * Real.pi)
    (hσrange : σ = 0 ∨ σ = 1 ∨ σ = -1 ∨ σ = 2)
    (hgap2 : β₂ - β₁ = opBNxt L (opBNxt L x₀) - x₀)
    (hgap0 : 0 < β₂ - β₁)
    (hF0 : ∀ k : Fin n, k ≠ a → L.Θ k.val ∉ Set.Ioo x₀ (opBNxt L (opBNxt L x₀)))
    (hFp : ∀ k : Fin n, k ≠ a → (L.Θ k.val + Real.pi) ∉
      Set.Ioo x₀ (opBNxt L (opBNxt L x₀)))
    (hFm : ∀ k : Fin n, k ≠ a → (L.Θ k.val - Real.pi) ∉
      Set.Ioo x₀ (opBNxt L (opBNxt L x₀)))
    (hF2p : ∀ k : Fin n, k ≠ a → (L.Θ k.val + 2 * Real.pi) ∉
      Set.Ioo x₀ (opBNxt L (opBNxt L x₀)))
    (hF2m : ∀ k : Fin n, k ≠ a → (L.Θ k.val - 2 * Real.pi) ∉
      Set.Ioo x₀ (opBNxt L (opBNxt L x₀)))
    (k : Fin n) (hka : k ≠ a) :
    0 ≤ det2 (uVec β₁) (e k) * det2 (uVec β₂) (e k) := by
  have hβ2σ : β₂ = opBNxt L (opBNxt L x₀) - (σ : ℝ) * Real.pi := by
    linarith [hσ, hgap2]
  have hdet1 : det2 (uVec β₁) (e k) = nrm (e k) * Real.sin (L.Θ k.val - β₁) := by
    rw [det2_eq_sin, nrm_uVec, one_mul]
    obtain ⟨mk, hmk⟩ := L.cons k (hzz k)
    obtain ⟨j1, hj1⟩ := dirAng_uVec β₁
    have h1 : dirAng (e k) - dirAng (uVec β₁) =
        (L.Θ k.val - β₁) + (-(mk + j1) : ℤ) * (2 * Real.pi) := by
      push_cast
      linarith [hmk, hj1]
    rw [h1, Real.sin_add_int_mul_two_pi]
  have hdet2 : det2 (uVec β₂) (e k) = nrm (e k) * Real.sin (L.Θ k.val - β₂) := by
    rw [det2_eq_sin, nrm_uVec, one_mul]
    obtain ⟨mk, hmk⟩ := L.cons k (hzz k)
    obtain ⟨j2, hj2⟩ := dirAng_uVec β₂
    have h1 : dirAng (e k) - dirAng (uVec β₂) =
        (L.Θ k.val - β₂) + (-(mk + j2) : ℤ) * (2 * Real.pi) := by
      push_cast
      linarith [hmk, hj2]
    rw [h1, Real.sin_add_int_mul_two_pi]
  rw [hdet1, hdet2]
  have h3 : 0 ≤ Real.sin (L.Θ k.val - β₁) * Real.sin (L.Θ k.val - β₂) := by
    by_contra hneg
    push_neg at hneg
    have hneg' : Real.sin (L.Θ k.val - β₁) * Real.sin (L.Θ k.val - β₁ - (β₂ - β₁)) < 0 := by
      rw [show L.Θ k.val - β₁ - (β₂ - β₁) = L.Θ k.val - β₂ from by ring]
      exact hneg
    obtain ⟨m, hm1, hm2⟩ := exists_int_mem_Ioo_of_sin_mul_sin_neg (y := L.Θ k.val - β₁)
      (δ := β₂ - β₁) hgap0 (by linarith [hgap, hgap2]) hneg' 
    have hmem : L.Θ k.val + ((σ - m : ℤ) : ℝ) * Real.pi ∈
        Set.Ioo x₀ (opBNxt L (opBNxt L x₀)) := by
      constructor
      · push_cast
        linarith [hm1, hσ]
      · push_cast
        linarith [hm2, hβ2σ]
    have hsmall : (3 : ℤ) ≤ σ - m ∨ σ - m ≤ -3 ∨ σ - m = 0 ∨ σ - m = 1 ∨
        σ - m = -1 ∨ σ - m = 2 ∨ σ - m = -2 := by omega
    have hxmem : L.Θ k.val ∈ opBRays L :=
      Finset.mem_union_left _ (Finset.mem_image.mpr ⟨k, Finset.mem_univ k, rfl⟩)
    rcases hsmall with hbig | hbig | h | h | h | h | h
    · have h1 : (3 : ℝ) ≤ ((σ - m : ℤ) : ℝ) := by exact_mod_cast hbig
      have hb1 := (opBRays_mem_bounds L hdist hzz x₀ hx₀).1
      have hb2 := (opBRays_mem_bounds L hdist hzz _ hxmem).1
      have hb4 := (opBRays_mem_bounds L hdist hzz x₀ hx₀).2
      have h5 : opBNxt L (opBNxt L x₀) < L.Θ 0 + 3 * Real.pi := by
        linarith [hgap, hb4, Real.pi_pos]
      have h6 : L.Θ 0 + 3 * Real.pi ≤ L.Θ k.val + ((σ - m : ℤ) : ℝ) * Real.pi := by
        nlinarith [hb2, h1, Real.pi_pos]
      linarith [hmem.2, h5, h6]
    · have h1 : ((σ - m : ℤ) : ℝ) ≤ (-3 : ℝ) := by exact_mod_cast hbig
      have hb1 := (opBRays_mem_bounds L hdist hzz x₀ hx₀).1
      have hb3 := (opBRays_mem_bounds L hdist hzz _ hxmem).2
      have h2 : L.Θ k.val + ((σ - m : ℤ) : ℝ) * Real.pi ≤ L.Θ k.val - 3 * Real.pi := by
        nlinarith [h1, Real.pi_pos]
      have h4 : L.Θ k.val - 3 * Real.pi < x₀ := by linarith [hb3, hb1, Real.pi_pos]
      linarith [hmem.1, h2, h4]
    · rw [h] at hmem
      exact hF0 k hka (by simpa using hmem)
    · rw [h] at hmem
      exact hFp k hka (by simpa using hmem)
    · rw [h] at hmem
      exact hFm k hka (by
        rw [show L.Θ k.val - Real.pi = L.Θ k.val + ((-1 : ℤ) : ℝ) * Real.pi from by
          push_cast; ring]
        exact hmem)
    · rw [h] at hmem
      exact hF2p k hka (by simpa using hmem)
    · rw [h] at hmem
      exact hF2m k hka (by
        rw [show L.Θ k.val - 2 * Real.pi = L.Θ k.val + ((-2 : ℤ) : ℝ) * Real.pi from by
          push_cast; ring]
        exact hmem)
  have hnn : 0 ≤ nrm (e k) := nrm_nonneg _
  rw [show (nrm (e k) * Real.sin (L.Θ k.val - β₁)) * (nrm (e k) * Real.sin (L.Θ k.val - β₂)) =
      nrm (e k) ^ 2 * (Real.sin (L.Θ k.val - β₁) * Real.sin (L.Θ k.val - β₂)) from by ring]
  exact mul_nonneg (sq_nonneg _) h3

/-- The lift for the split edge sequence of operation B. -/
theorem edgeLift_opB {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ}
    (L : EdgeLift e) (hn3 : 3 ≤ n) (a : Fin n)
    (β₁ β₂ : ℝ) (hβ1a : β₁ < L.Θ a.val) (haβ2 : L.Θ a.val < β₂)
    (hgap : β₂ - β₁ < Real.pi)
    (hbelow : ∀ i : Fin n, i.val < a.val → L.Θ i.val ≤ β₁)
    (habove : ∀ i : Fin n, a.val < i.val → β₂ ≤ L.Θ i.val)
    (hbelow0 : a.val = 0 → L.Θ (n - 1) ≤ β₁ + 2 * Real.pi)
    (haboveN : a.val = n - 1 → β₂ ≤ L.Θ 0 + 2 * Real.pi)
    (f1 f2 : ℝ × ℝ)
    (hf1 : ∃ k : ℤ, dirAng f1 = β₁ + 2 * Real.pi * k)
    (hf2 : ∃ k : ℤ, dirAng f2 = β₂ + 2 * Real.pi * k) :
    Nonempty (EdgeLift (Fin.insertNth (α := fun _ => ℝ × ℝ) ⟨a.val + 1, by omega⟩ f2
      (Function.update e a f1))) := by
  have ha' : a.val < n := a.isLt
  have htop : L.Θ n = L.Θ 0 + 2 * Real.pi := by
    have h := L.period 0
    simp at h
    exact h
  set θb : ℕ → ℝ := fun r =>
    if r < a.val then L.Θ r else if r = a.val then β₁ else if r = a.val + 1 then β₂
    else L.Θ (r - 1) with hθb
  set Θ' : ℕ → ℝ := fun m => θb (m % (n + 1)) + 2 * Real.pi * (m / (n + 1) : ℕ) with hΘ'
  set p : Fin (n + 1) := ⟨a.val + 1, by omega⟩ with hp
  have hblt : ∀ r : ℕ, r < a.val → θb r = L.Θ r := by
    intro r h
    rw [hθb]
    show (if r < a.val then L.Θ r else if r = a.val then β₁ else if r = a.val + 1 then β₂
      else L.Θ (r - 1)) = L.Θ r
    rw [if_pos h]
  have hbeq : θb a.val = β₁ := by
    rw [hθb]
    show (if a.val < a.val then L.Θ a.val else if a.val = a.val then β₁
      else if a.val = a.val + 1 then β₂ else L.Θ (a.val - 1)) = β₁
    rw [if_neg (by omega : ¬ a.val < a.val), if_pos rfl]
  have hbsucc : θb (a.val + 1) = β₂ := by
    rw [hθb]
    show (if a.val + 1 < a.val then L.Θ (a.val + 1) else if a.val + 1 = a.val then β₁
      else if a.val + 1 = a.val + 1 then β₂ else L.Θ (a.val + 1 - 1)) = β₂
    rw [if_neg (by omega : ¬ a.val + 1 < a.val), if_neg (by omega : ¬ a.val + 1 = a.val),
      if_pos rfl]
  have hbgt : ∀ r : ℕ, a.val + 1 < r → θb r = L.Θ (r - 1) := by
    intro r h
    rw [hθb]
    show (if r < a.val then L.Θ r else if r = a.val then β₁ else if r = a.val + 1 then β₂
      else L.Θ (r - 1)) = L.Θ (r - 1)
    rw [if_neg (by omega : ¬ r < a.val), if_neg (by omega : ¬ r = a.val),
      if_neg (by omega : ¬ r = a.val + 1)]
  have hbstep : ∀ r : ℕ, r + 1 ≤ n → 0 ≤ θb (r + 1) - θb r ∧ θb (r + 1) - θb r ≤ Real.pi := by
    intro r hr
    rcases (by omega : r + 1 < a.val ∨ r + 1 = a.val ∨ r + 1 = a.val + 1 ∨
      a.val + 1 < r + 1) with h | h | h | h
    · rw [hblt (r + 1) h, hblt r (by omega)]
      exact ⟨L.step_nonneg r, L.step_le r⟩
    · rw [h, hbeq, hblt r (by omega)]
      have hlb := hbelow ⟨r, by omega⟩ (by show r < a.val; omega)
      have hst := L.step_le r
      have hstn := L.step_nonneg r
      rw [h] at hst hstn
      refine ⟨by linarith [hlb], by linarith [hst, hβ1a]⟩
    · have hr1 : r = a.val := by omega
      rw [h, hbsucc, hr1, hbeq]
      exact ⟨by linarith [hβ1a, haβ2], by linarith [hgap]⟩
    · by_cases h2 : r = a.val + 1
      · rw [hbgt (r + 1) (by omega), h2, hbsucc]
        have h3 : a.val + 1 + 1 - 1 = a.val + 1 := by omega
        rw [h3]
        have hab := habove ⟨a.val + 1, by omega⟩ (by show a.val < a.val + 1; omega)
        have hst := L.step_le a.val
        have hstn := L.step_nonneg a.val
        refine ⟨by linarith [hab], by linarith [hst, haβ2]⟩
      · rw [hbgt (r + 1) (by omega), hbgt r (by omega)]
        have h3 : r + 1 - 1 = r := by omega
        rw [h3]
        have hst := L.step_le (r - 1)
        have hstn := L.step_nonneg (r - 1)
        have h4 : r - 1 + 1 = r := by omega
        rw [h4] at hst hstn
        exact ⟨hstn, hst⟩
  have hbwrap : 0 ≤ θb 0 + 2 * Real.pi - θb n ∧ θb 0 + 2 * Real.pi - θb n ≤ Real.pi := by
    by_cases ha0 : a.val = 0
    · have h1 : θb 0 = β₁ := by
        rw [← ha0]
        exact hbeq
      have h2 : θb n = L.Θ (n - 1) := hbgt n (by rw [ha0]; omega)
      rw [h1, h2]
      have hst := L.step_le (n - 1)
      have hstn := L.step_nonneg (n - 1)
      have h3 : n - 1 + 1 = n := by omega
      rw [h3, htop] at hst hstn
      have hβ1a0 : β₁ < L.Θ 0 := by
        rw [← ha0]
        exact hβ1a
      refine ⟨by linarith [hbelow0 ha0], by linarith [hst, hβ1a0]⟩
    · have h1 : θb 0 = L.Θ 0 := hblt 0 (by omega)
      rw [h1]
      by_cases haN : a.val = n - 1
      · have h2 : θb n = β₂ := by
          have h4 : n = a.val + 1 := by omega
          rw [h4]
          exact hbsucc
        rw [h2]
        have hst := L.step_le (n - 1)
        have hstn := L.step_nonneg (n - 1)
        have h3 : n - 1 + 1 = n := by omega
        rw [h3, htop] at hst hstn
        have hβ2N : L.Θ (n - 1) < β₂ := by
          have h5 : n - 1 = a.val := by omega
          rw [h5]
          exact haβ2
        refine ⟨by linarith [haboveN haN], by linarith [hst, hβ2N]⟩
      · have h2 : θb n = L.Θ (n - 1) := hbgt n (by omega)
        rw [h2]
        have hst := L.step_le (n - 1)
        have hstn := L.step_nonneg (n - 1)
        have h3 : n - 1 + 1 = n := by omega
        rw [h3, htop] at hst hstn
        exact ⟨by linarith [hstn], by linarith [hst]⟩
  have hstep : ∀ k : ℕ, Θ' (k + 1) - Θ' k =
      if k % (n + 1) = n then θb 0 + 2 * Real.pi - θb n
      else θb (k % (n + 1) + 1) - θb (k % (n + 1)) := by
    intro k
    have hq : (n + 1) * (k / (n + 1)) + k % (n + 1) = k := Nat.div_add_mod k (n + 1)
    by_cases hr : k % (n + 1) = n
    · rw [if_pos hr]
      have hk1 : k + 1 = (n + 1) * (k / (n + 1)) + k % (n + 1) + 1 := by omega
      have hm : (k + 1) % (n + 1) = 0 := by
        rw [hk1, hr, show (n + 1) * (k / (n + 1)) + n + 1 = (n + 1) * (k / (n + 1) + 1)
          from by ring]
        simp
      have hd : (k + 1) / (n + 1) = k / (n + 1) + 1 := by
        rw [hk1, hr, show (n + 1) * (k / (n + 1)) + n + 1 = (n + 1) * (k / (n + 1) + 1)
          from by ring,
          show (n + 1) * (k / (n + 1) + 1) = (k / (n + 1) + 1) * (n + 1) from by ring,
          Nat.mul_div_cancel _ (by omega : 0 < n + 1)]
      rw [hΘ']
      simp only []
      rw [hm, hd, hr]
      push_cast
      ring
    · rw [if_neg hr]
      have hrlt : k % (n + 1) < n + 1 := Nat.mod_lt k (by omega : 0 < n + 1)
      have hk1 : k + 1 = (n + 1) * (k / (n + 1)) + (k % (n + 1) + 1) := by omega
      have hm : (k + 1) % (n + 1) = k % (n + 1) + 1 := by
        rw [hk1, add_comm ((n + 1) * (k / (n + 1))) (k % (n + 1) + 1),
          Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (by omega : k % (n + 1) + 1 < n + 1)]
      have hd : (k + 1) / (n + 1) = k / (n + 1) := by
        rw [hk1, add_comm ((n + 1) * (k / (n + 1))) (k % (n + 1) + 1),
          Nat.add_mul_div_left _ _ (by omega : 0 < n + 1),
          Nat.div_eq_of_lt (by omega : k % (n + 1) + 1 < n + 1), zero_add]
      rw [hΘ']
      simp only []
      rw [hm, hd]
      ring
  have hperiod : ∀ m : ℕ, Θ' (m + (n + 1)) = Θ' m + 2 * Real.pi := by
    intro m
    have h1 : (m + (n + 1)) % (n + 1) = m % (n + 1) := Nat.add_mod_right m (n + 1)
    have h2 : (m + (n + 1)) / (n + 1) = m / (n + 1) + 1 := by
      rw [Nat.add_div_right m (by omega : 0 < n + 1)]
    rw [hΘ']
    simp only []
    rw [h1, h2]
    push_cast
    ring
  refine ⟨{ Θ := Θ', period := hperiod, step_nonneg := ?_, step_le := ?_, cons := ?_ }⟩
  · intro k
    rw [hstep]
    by_cases hr : k % (n + 1) = n
    · rw [if_pos hr]
      exact hbwrap.1
    · rw [if_neg hr]
      exact (hbstep (k % (n + 1)) (by
        have h1 := Nat.mod_lt k (by omega : 0 < n + 1)
        omega)).1
  · intro k
    rw [hstep]
    by_cases hr : k % (n + 1) = n
    · rw [if_pos hr]
      exact hbwrap.2
    · rw [if_neg hr]
      exact (hbstep (k % (n + 1)) (by
        have h1 := Nat.mod_lt k (by omega : 0 < n + 1)
        omega)).2
  · intro i hi
    have him : i.val % (n + 1) = i.val := Nat.mod_eq_of_lt i.isLt
    have hid : i.val / (n + 1) = 0 := Nat.div_eq_of_lt i.isLt
    have hΘi : Θ' i.val = θb i.val := by
      rw [hΘ']
      simp only []
      rw [him, hid]
      simp
    rcases (by omega : i.val < a.val ∨ i.val = a.val ∨ i.val = a.val + 1 ∨
      a.val + 1 < i.val) with h | h | h | h
    · have hi2 : i = p.succAbove ⟨i.val, by omega⟩ := by
        apply Fin.ext
        rw [Fin.succAbove_val]
        have h1 : (⟨i.val, by omega⟩ : Fin n).val < p.val := by
          show i.val < a.val + 1
          omega
        rw [if_pos h1]
      have he' : Fin.insertNth (α := fun _ => ℝ × ℝ) p f2 (Function.update e a f1) i =
          e ⟨i.val, by omega⟩ := by
        conv_lhs => rw [hi2, Fin.insertNth_apply_succAbove, Function.update_of_ne (by
          intro hcon
          have h2 : i.val = a.val := congrArg Fin.val hcon
          omega)]
      obtain ⟨m, hm⟩ := L.cons ⟨i.val, by omega⟩ (by rw [← he']; exact hi)
      rw [hΘi, hblt i.val h, he']
      exact ⟨m, hm⟩
    · have hi2 : i = p.succAbove a := by
        apply Fin.ext
        rw [Fin.succAbove_val]
        have h1 : a.val < p.val := by
          show a.val < a.val + 1
          omega
        rw [if_pos h1]
        exact h
      have he' : Fin.insertNth (α := fun _ => ℝ × ℝ) p f2 (Function.update e a f1) i = f1 := by
        rw [hi2, Fin.insertNth_apply_succAbove, Function.update_self]
      obtain ⟨m, hm⟩ := hf1
      rw [hΘi, h, hbeq, he']
      exact ⟨-m, by push_cast; linarith [hm]⟩
    · have hi2 : i = p := by
        apply Fin.ext
        rw [h]
      have he' : Fin.insertNth (α := fun _ => ℝ × ℝ) p f2 (Function.update e a f1) i = f2 := by
        rw [hi2, Fin.insertNth_apply_same]
      obtain ⟨m, hm⟩ := hf2
      rw [hΘi, h, hbsucc, he']
      exact ⟨-m, by push_cast; linarith [hm]⟩
    · have hi2 : i = p.succAbove ⟨i.val - 1, by omega⟩ := by
        apply Fin.ext
        rw [Fin.succAbove_val]
        have h1 : ¬ (⟨i.val - 1, by omega⟩ : Fin n).val < p.val := by
          show ¬ i.val - 1 < a.val + 1
          omega
        rw [if_neg h1]
        show i.val = i.val - 1 + 1
        omega
      have he' : Fin.insertNth (α := fun _ => ℝ × ℝ) p f2 (Function.update e a f1) i =
          e ⟨i.val - 1, by omega⟩ := by
        conv_lhs => rw [hi2, Fin.insertNth_apply_succAbove, Function.update_of_ne (by
          intro hcon
          have h2 : i.val - 1 = a.val := congrArg Fin.val hcon
          omega)]
      obtain ⟨m, hm⟩ := L.cons ⟨i.val - 1, by omega⟩ (by rw [← he']; exact hi)
      rw [hΘi, hbgt i.val h, he']
      exact ⟨m, hm⟩

/-- Operation B of the official solution: with no parallel pairs, split a
well-chosen edge, strictly decreasing the defect and the line count. -/
theorem FES_lt_of_opB_split {n : ℕ} [NeZero n] (e : Fin n → ℝ × ℝ)
    (L : EdgeLift e) (hclosed : ESClosed e)
    (hdist : ∀ i j : Fin n, e i ≠ 0 → e j ≠ 0 → det2 (e i) (e j) = 0 → i = j)
    (hzz : ∀ i : Fin n, e i ≠ 0) (hn3 : 3 ≤ n) :
    ∃ e' : Fin (n + 1) → ℝ × ℝ, ESClosed e' ∧ Nonempty (EdgeLift e') ∧
      FES e' < FES e ∧ esEll e' + 1 = esEll e ∧ esNu e' = esNu e + 1 := by
  obtain ⟨x₀, hx₀, hgap⟩ := opB_pigeonhole L hdist hzz hn3
  obtain ⟨a, β₁, β₂, σ, hσ, hσrange, hβ1a, haβ2, hgap2, hF0, hFp, hFm, hF2p, hF2m,
    ⟨c, d, hline1, hline2⟩, hb2top⟩ := opB_middle L hdist hzz hn3 hx₀
  have hgap0 : 0 < β₂ - β₁ := by linarith [hβ1a, haβ2]
  have hδpi : β₂ - β₁ < Real.pi := by linarith [hgap, hgap2]
  have hβ2σ : β₂ = opBNxt L (opBNxt L x₀) - (σ : ℝ) * Real.pi := by linarith [hσ, hgap2]
  have hD : 0 < det2 (uVec β₁) (uVec β₂) := by
    rw [det2_uVec_uVec]
    exact Real.sin_pos_of_pos_of_lt_pi hgap0 hδpi
  have hdet_ea2 : 0 < det2 (e a) (uVec β₂) := by
    rw [det2_eq_sin]
    obtain ⟨ma, hma⟩ := L.cons a (hzz a)
    obtain ⟨j2, hj2⟩ := dirAng_uVec β₂
    have h1 : dirAng (uVec β₂) - dirAng (e a) =
        (β₂ - L.Θ a.val) + (ma + j2 : ℤ) * (2 * Real.pi) := by
      push_cast
      linarith [hma, hj2]
    rw [nrm_uVec, mul_one, h1, Real.sin_add_int_mul_two_pi]
    exact mul_pos (nrm_pos_of_ne_zero _ (hzz a))
      (Real.sin_pos_of_pos_of_lt_pi (by linarith [haβ2]) (by linarith [haβ2, hδpi, hβ1a]))
  have hdet_1ea : 0 < det2 (uVec β₁) (e a) := by
    rw [det2_eq_sin]
    obtain ⟨ma, hma⟩ := L.cons a (hzz a)
    obtain ⟨j1, hj1⟩ := dirAng_uVec β₁
    have h1 : dirAng (e a) - dirAng (uVec β₁) =
        (L.Θ a.val - β₁) + (-(ma + j1) : ℤ) * (2 * Real.pi) := by
      push_cast
      linarith [hma, hj1]
    rw [nrm_uVec, one_mul, h1, Real.sin_add_int_mul_two_pi]
    exact mul_pos (nrm_pos_of_ne_zero _ (hzz a))
      (Real.sin_pos_of_pos_of_lt_pi (by linarith [hβ1a]) (by linarith [hβ1a, hδpi, haβ2]))
  set A := det2 (e a) (uVec β₂) / det2 (uVec β₁) (uVec β₂) with hAdef
  set B := det2 (uVec β₁) (e a) / det2 (uVec β₁) (uVec β₂) with hBdef
  have hA : 0 < A := div_pos hdet_ea2 hD
  have hB : 0 < B := div_pos hdet_1ea hD
  set f1 := A • uVec β₁ with hf1def
  set f2 := B • uVec β₂ with hf2def
  have hf1 : f1 ≠ 0 := by
    rw [hf1def]
    intro hcon
    rw [smul_eq_zero] at hcon
    rcases hcon with h | h
    · exact ne_of_gt hA h
    · exact uVec_ne_zero β₁ h
  have hf2 : f2 ≠ 0 := by
    rw [hf2def]
    intro hcon
    rw [smul_eq_zero] at hcon
    rcases hcon with h | h
    · exact ne_of_gt hB h
    · exact uVec_ne_zero β₂ h
  have hsum12 : f1 + f2 = e a := by
    have hD' : det2 (uVec β₁) (uVec β₂) ≠ 0 := ne_of_gt hD
    have h1 := det2_smul_eq (e a) (uVec β₁) (uVec β₂)
    have h2 : det2 (uVec β₁) (uVec β₂) • (f1 + f2) =
        det2 (e a) (uVec β₂) • uVec β₁ + det2 (uVec β₁) (e a) • uVec β₂ := by
      rw [smul_add, hf1def, smul_smul, hAdef, mul_div_cancel₀ _ hD',
        hf2def, smul_smul, hBdef, mul_div_cancel₀ _ hD']
    rw [← h1] at h2
    have h3 := congr_arg (fun v : ℝ × ℝ => (det2 (uVec β₁) (uVec β₂))⁻¹ • v) h2
    rw [smul_smul, smul_smul, inv_mul_cancel₀ hD', one_smul, one_smul] at h3
    exact h3
  have hsign : ∀ k : Fin n, k ≠ a → 0 ≤ det2 f1 (e k) * det2 f2 (e k) := by
    intro k hka
    have h1 := opB_sign_cond L hdist hzz hx₀ hgap hσ hσrange hgap2 hgap0
      hF0 hFp hFm hF2p hF2m k hka
    rw [hf1def, det2_smul_left, hf2def, det2_smul_left]
    have h2 : (A * det2 (uVec β₁) (e k)) * (B * det2 (uVec β₂) (e k)) =
        (A * B) * (det2 (uVec β₁) (e k) * det2 (uVec β₂) (e k)) := by ring
    rw [h2]
    exact mul_nonneg (le_of_lt (mul_pos hA hB)) h1
  have hdet_f1f2 : 0 < det2 f1 f2 := by
    rw [hf1def, hf2def, det2_smul_left, det2_smul_right]
    have h4 : A * (B * det2 (uVec β₁) (uVec β₂)) = (A * B) * det2 (uVec β₁) (uVec β₂) := by
      ring
    rw [h4]
    exact mul_pos (mul_pos hA hB) hD
  have hstrict : ∀ {i j : Fin n}, i.val < j.val → L.Θ i.val < L.Θ j.val := by
    intro i j hij
    exact opB_strict L hdist hzz hij
  have hbelow : ∀ i : Fin n, i.val < a.val → L.Θ i.val ≤ β₁ := by
    intro i hi
    have h1 : L.Θ i.val < L.Θ a.val := hstrict hi
    have hia : i ≠ a := by
      intro hcon
      rw [hcon] at hi
      exact lt_irrefl _ hi
    have h2 : L.Θ i.val ∉ Set.Ioo β₁ β₂ := by
      intro hmem
      have h3 : L.Θ i.val + (σ : ℝ) * Real.pi ∈ Set.Ioo x₀ (opBNxt L (opBNxt L x₀)) := by
        constructor
        · linarith [hmem.1, hσ]
        · linarith [hmem.2, hβ2σ]
      rcases hσrange with rfl | rfl | rfl | rfl
      · exact hF0 i hia (by simpa using h3)
      · exact hFp i hia (by simpa using h3)
      · exact hFm i hia (by
          rw [show L.Θ i.val - Real.pi = L.Θ i.val + ((-1 : ℤ) : ℝ) * Real.pi from by
            push_cast; ring]
          exact h3)
      · exact hF2p i hia (by simpa using h3)
    by_contra hcon
    push_neg at hcon
    exact h2 ⟨hcon, by linarith [h1, haβ2]⟩
  have habove : ∀ i : Fin n, a.val < i.val → β₂ ≤ L.Θ i.val := by
    intro i hi
    have h1 : L.Θ a.val < L.Θ i.val := hstrict hi
    have hia : i ≠ a := by
      intro hcon
      rw [hcon] at hi
      exact lt_irrefl _ hi
    have h2 : L.Θ i.val ∉ Set.Ioo β₁ β₂ := by
      intro hmem
      have h3 : L.Θ i.val + (σ : ℝ) * Real.pi ∈ Set.Ioo x₀ (opBNxt L (opBNxt L x₀)) := by
        constructor
        · linarith [hmem.1, hσ]
        · linarith [hmem.2, hβ2σ]
      rcases hσrange with rfl | rfl | rfl | rfl
      · exact hF0 i hia (by simpa using h3)
      · exact hFp i hia (by simpa using h3)
      · exact hFm i hia (by
          rw [show L.Θ i.val - Real.pi = L.Θ i.val + ((-1 : ℤ) : ℝ) * Real.pi from by
            push_cast; ring]
          exact h3)
      · exact hF2p i hia (by simpa using h3)
    by_contra hcon
    push_neg at hcon
    exact h2 ⟨by linarith [h1, hβ1a], hcon⟩
  have hbelow0 : a.val = 0 → L.Θ (n - 1) ≤ β₁ + 2 * Real.pi := by
    intro ha0
    have hia : (⟨n - 1, by omega⟩ : Fin n) ≠ a := by
      intro hcon
      have h4 : n - 1 = a.val := congrArg Fin.val hcon
      omega
    have hn1mem : L.Θ (n - 1) ∈ opBRays L := by
      have h5 : L.Θ (⟨n - 1, by omega⟩ : Fin n).val ∈ opBRays L :=
        Finset.mem_union_left _ (Finset.mem_image.mpr ⟨⟨n - 1, by omega⟩,
          Finset.mem_univ _, rfl⟩)
      exact h5
    have hn1b := (opBRays_mem_bounds L hdist hzz _ hn1mem).2
    have hxb := (opBRays_mem_bounds L hdist hzz x₀ hx₀).1
    rcases hσrange with rfl | rfl | rfl | rfl
    · rw [hσ]
      have h6 : x₀ - ((0 : ℤ) : ℝ) * Real.pi = x₀ := by push_cast; ring
      rw [h6]
      linarith [hxb, hn1b, Real.pi_pos]
    · have h4 : L.Θ (n - 1) - Real.pi ∉ Set.Ioo x₀ (opBNxt L (opBNxt L x₀)) :=
        hFm ⟨n - 1, by omega⟩ hia
      by_contra hcon
      push_neg at hcon
      rw [hσ] at hcon
      push_cast at hcon
      have h5 : L.Θ (n - 1) - Real.pi ∈ Set.Ioo x₀ (opBNxt L (opBNxt L x₀)) := by
        constructor
        · linarith [hcon, Real.pi_pos]
        · have h7 : L.Θ 0 + Real.pi < opBNxt L (opBNxt L x₀) := by
            have h8 : L.Θ 0 < β₂ := by
              rw [← ha0]
              exact haβ2
            push_cast at hβ2σ
            linarith [h8, hβ2σ, Real.pi_pos]
          linarith [hn1b, h7, Real.pi_pos]
      exact h4 h5
    · exfalso
      have h8 : β₁ < L.Θ 0 := by
        rw [← ha0]
        exact hβ1a
      rw [hσ] at h8
      push_cast at h8
      linarith [hxb, h8, Real.pi_pos]
    · have h4 : L.Θ (n - 1) ∉ Set.Ioo x₀ (opBNxt L (opBNxt L x₀)) :=
        hF0 ⟨n - 1, by omega⟩ hia
      by_contra hcon
      push_neg at hcon
      rw [hσ] at hcon
      push_cast at hcon
      have h5 : L.Θ (n - 1) ∈ Set.Ioo x₀ (opBNxt L (opBNxt L x₀)) := by
        constructor
        · linarith [hcon, Real.pi_pos]
        · have h7 : L.Θ 0 + 2 * Real.pi < opBNxt L (opBNxt L x₀) := by
            have h8 : L.Θ 0 < β₂ := by
              rw [← ha0]
              exact haβ2
            push_cast at hβ2σ
            linarith [h8, hβ2σ, Real.pi_pos]
          linarith [hn1b, h7, Real.pi_pos]
      exact h4 h5
  have haboveN : a.val = n - 1 → β₂ ≤ L.Θ 0 + 2 * Real.pi := by
    intro haN
    rcases hσrange with rfl | rfl | rfl | rfl
    · push_cast at hb2top hβ2σ
      linarith [hb2top, hβ2σ]
    · push_cast at hb2top hβ2σ
      linarith [hb2top, hβ2σ, Real.pi_pos]
    · push_cast at hb2top hβ2σ
      linarith [hb2top, hβ2σ, Real.pi_pos]
    · push_cast at hb2top hβ2σ
      linarith [hb2top, hβ2σ, Real.pi_pos]
  have hf1ang : ∃ k : ℤ, dirAng f1 = β₁ + 2 * Real.pi * k := by
    obtain ⟨j1, hj1⟩ := dirAng_uVec β₁
    refine ⟨j1, ?_⟩
    rw [hf1def, dirAng_smul_of_pos _ _ hA]
    exact hj1
  have hf2ang : ∃ k : ℤ, dirAng f2 = β₂ + 2 * Real.pi * k := by
    obtain ⟨j2, hj2⟩ := dirAng_uVec β₂
    refine ⟨j2, ?_⟩
    rw [hf2def, dirAng_smul_of_pos _ _ hB]
    exact hj2
  have hdet1_ea : det2 f1 (e a) ≠ 0 := by
    rw [hf1def, det2_smul_left]
    have h1 : det2 (uVec β₁) (e a) = B * det2 (uVec β₁) (uVec β₂) := by
      rw [hBdef, div_mul_cancel₀ _ (ne_of_gt hD)]
    rw [h1, ← mul_assoc]
    exact mul_ne_zero (mul_ne_zero (ne_of_gt hA) (ne_of_gt hB)) (ne_of_gt hD)
  have hdet2_ea : det2 f2 (e a) ≠ 0 := by
    rw [hf2def, det2_smul_left]
    have h1 : det2 (uVec β₂) (e a) = - det2 (e a) (uVec β₂) := by
      show (uVec β₂).1 * (e a).2 - (uVec β₂).2 * (e a).1 =
        -((e a).1 * (uVec β₂).2 - (e a).2 * (uVec β₂).1)
      ring
    have h2 : det2 (e a) (uVec β₂) = A * det2 (uVec β₁) (uVec β₂) := by
      rw [hAdef, div_mul_cancel₀ _ (ne_of_gt hD)]
    rw [h1, h2]
    exact mul_ne_zero (ne_of_gt hB)
      (neg_ne_zero.mpr (mul_ne_zero (ne_of_gt hA) (ne_of_gt hD)))
  have hline1' : lineKey f1 = lineKey (e c) := by
    have h1 : lineKey f1 = lineKey (uVec β₁) := by
      rw [hf1def]
      apply (lineKey_eq_iff_int_pi _ _).mpr
      exact ⟨0, by rw [dirAng_smul_of_pos _ _ hA]; simp⟩
    rw [h1]
    exact hline1
  have hline2' : lineKey f2 = lineKey (e d) := by
    have h1 : lineKey f2 = lineKey (uVec β₂) := by
      rw [hf2def]
      apply (lineKey_eq_iff_int_pi _ _).mpr
      exact ⟨0, by rw [dirAng_smul_of_pos _ _ hB]; simp⟩
    rw [h1]
    exact hline2
  set e' := Fin.insertNth (α := fun _ => ℝ × ℝ) ⟨a.val + 1, by omega⟩ f2
    (Function.update e a f1) with he'
  have hcl : ESClosed e' := ESClosed_opB_split e a f1 f2 hsum12 hclosed
  have hli : Nonempty (EdgeLift e') :=
    edgeLift_opB L hn3 a β₁ β₂ hβ1a haβ2 hδpi hbelow habove hbelow0 haboveN
      f1 f2 hf1ang hf2ang
  have hF : FES e' = FES e - det2 f1 f2 := FES_opB_split e a f1 f2 hsum12 hdet_f1f2 hsign
  have hEl : esEll e' + 1 = esEll e :=
    esEll_opB_split e hdist a c d f1 f2 hf1 hf2 (hzz a) hzz hdet1_ea hdet2_ea hline1' hline2'
  have hNu : esNu e' = esNu e + 1 := esNu_opB_split e a f1 f2 hf1 hf2 (hzz a)
  exact ⟨e', hcl, hli, by linarith [hF, hdet_f1f2], hEl, hNu⟩

/-!
The algebra of the official solution's "operation A" in the degenerate
(same-direction) case: `F` is preserved, the invariant is preserved, and the
number of nonzero edges drops.
-/

theorem FES_eq_of_merge_same {n : ℕ} [NeZero n] (e : Fin n → ℝ × ℝ)
    (L : EdgeLift e) (hclosed : ESClosed e) {i j : Fin n}
    (hij : i ≠ j) (hilt : i.val < j.val) (hei : e i ≠ 0) (hej : e j ≠ 0)
    (hpar : det2 (e i) (e j) = 0) (hdot : 0 < dott (e i) (e j)) :
    ∃ e' : Fin n → ℝ × ℝ, ESClosed e' ∧ Nonempty (EdgeLift e') ∧ FES e' = FES e ∧
      esNu e' < esNu e ∧ esEll e' ≤ esEll e := by
  -- `e j = μ • e i` with `μ > 0`
  have hdii_pos : 0 < dott (e i) (e i) := by
    have h : dott (e i) (e i) = nrm (e i) ^ 2 := by
      unfold dott nrm
      rw [Real.sq_sqrt (by positivity)]
      ring
    rw [h]
    exact sq_pos_of_ne_zero ((nrm_eq_zero_iff (e i)).not.mpr hei)
  have hd0 : (e i).1 * (e j).2 - (e i).2 * (e j).1 = 0 := by
    have h := hpar
    rw [det2] at h
    exact h
  have hC : dott (e i) (e i) • e j = dott (e i) (e j) • e i := by
    apply Prod.ext
    · show dott (e i) (e i) * (e j).1 = dott (e i) (e j) * (e i).1
      simp only [dott]
      have h2 : (e i).2 * ((e i).1 * (e j).2 - (e i).2 * (e j).1) = 0 :=
        mul_eq_zero_of_right _ hd0
      nlinarith [h2]
    · show dott (e i) (e i) * (e j).2 = dott (e i) (e j) * (e i).2
      simp only [dott]
      have h2 : (e i).1 * ((e i).1 * (e j).2 - (e i).2 * (e j).1) = 0 :=
        mul_eq_zero_of_right _ hd0
      nlinarith [h2]
  set μ := dott (e i) (e j) / dott (e i) (e i) with hμ
  have hμ_pos : 0 < μ := div_pos hdot hdii_pos
  have hμeq : dott (e i) (e j) = μ * dott (e i) (e i) := by
    rw [hμ]
    field_simp
  have hej_eq : e j = μ • e i := by
    have hne : dott (e i) (e i) ≠ 0 := ne_of_gt hdii_pos
    have h2 : dott (e i) (e i) • e j = dott (e i) (e i) • (μ • e i) := by
      rw [hC, hμeq, smul_smul, mul_comm μ (dott (e i) (e i))]
    apply Prod.ext
    · have h1 := congrArg Prod.fst h2
      simp only [Prod.smul_fst] at h1
      exact mul_left_cancel₀ hne h1
    · have h1 := congrArg Prod.snd h2
      simp only [Prod.smul_snd] at h1
      exact mul_left_cancel₀ hne h1
  -- the merged sequence
  set w : Fin n → ℝ × ℝ := Function.update e j (e j + e i) with hw
  set e' : Fin n → ℝ × ℝ := Function.update w i 0 with he'
  have hwk : ∀ k : Fin n, k ≠ j → w k = e k := fun k hk =>
    Function.update_of_ne hk _ e
  have hwi : w i = e i := Function.update_of_ne hij _ e
  have hwj : w j = e j + e i := Function.update_self j (e j + e i) e
  have he'k : ∀ k : Fin n, k ≠ i → e' k = w k := fun k hk =>
    Function.update_of_ne hk (0 : ℝ × ℝ) w
  have he'i : e' i = 0 := Function.update_self i (0 : ℝ × ℝ) w
  have hn : L.Θ n = L.Θ 0 + 2 * Real.pi := by
    have h := L.period 0
    simp at h
    exact h
  -- `Θ j = Θ i` or `Θ j = Θ i + 2π`
  have hThetaij : L.Θ j.val = L.Θ i.val ∨ L.Θ j.val = L.Θ i.val + 2 * Real.pi := by
    have hle : L.Θ i.val ≤ L.Θ j.val := L.monotone (show i.val ≤ j.val by omega)
    have hub : L.Θ j.val - L.Θ i.val ≤ 2 * Real.pi := by
      have h1 : L.Θ j.val ≤ L.Θ n := L.monotone (show j.val ≤ n by omega)
      have h2 : L.Θ 0 ≤ L.Θ i.val := L.monotone (Nat.zero_le _)
      linarith [h1, h2, hn]
    have hsin0 : Real.sin (L.Θ j.val - L.Θ i.val) = 0 := by
      have h := L.det2_eq i j
      rw [hpar] at h
      have hpos : 0 < nrm (e i) * nrm (e j) :=
        mul_pos (nrm_pos_of_ne_zero _ hei) (nrm_pos_of_ne_zero _ hej)
      have h2 : nrm (e i) * nrm (e j) * Real.sin (L.Θ j.val - L.Θ i.val) = 0 := h.symm
      rcases mul_eq_zero.mp h2 with h3 | h3
      · linarith [h3, hpos]
      · exact h3
    have hcos : 0 < Real.cos (L.Θ j.val - L.Θ i.val) := by
      obtain ⟨mi, hmi⟩ := L.cons i hei
      obtain ⟨mj, hmj⟩ := L.cons j hej
      have h1 : Real.cos (L.Θ j.val - L.Θ i.val) =
          Real.cos (dirAng (e j) - dirAng (e i)) := by
        rw [hmj, hmi]
        have h2 : dirAng (e j) + 2 * Real.pi * ↑mj - (dirAng (e i) + 2 * Real.pi * ↑mi) =
            dirAng (e j) - dirAng (e i) + ↑(mj - mi) * (2 * Real.pi) := by
          push_cast
          ring
        rw [h2, Real.cos_add_int_mul_two_pi]
      rw [h1]
      have h2 := dott_eq_cos (e i) (e j)
      have hpos : 0 < nrm (e i) * nrm (e j) :=
        mul_pos (nrm_pos_of_ne_zero _ hei) (nrm_pos_of_ne_zero _ hej)
      have h3 : 0 < nrm (e i) * nrm (e j) * Real.cos (dirAng (e j) - dirAng (e i)) := by
        rw [← h2]
        exact hdot
      exact (mul_pos_iff_of_pos_left hpos).mp h3
    obtain ⟨k, hk⟩ : ∃ k : ℤ, (k : ℝ) * Real.pi = L.Θ j.val - L.Θ i.val :=
      Real.sin_eq_zero_iff.mp hsin0
    have hkb : k = 0 ∨ k = 1 ∨ k = 2 := by
      have h1 : (0 : ℝ) ≤ k := by
        by_contra hc
        push Not at hc
        have h2 := mul_neg_of_neg_of_pos hc Real.pi_pos
        linarith [h2, hk, hle]
      have h2 : (k : ℝ) ≤ 2 := by
        by_contra hc
        push Not at hc
        have h3 : (2 : ℝ) < k := by linarith [hc]
        have h4 := mul_lt_mul_of_pos_right h3 Real.pi_pos
        linarith [h4, hk, hub]
      have h1' : (0 : ℤ) ≤ k := by exact_mod_cast h1
      have h2' : k ≤ 2 := by exact_mod_cast h2
      omega
    rcases hkb with rfl | rfl | rfl
    · left
      have hk2 : L.Θ j.val - L.Θ i.val = 0 := by
        have h := hk
        ring_nf at h
        linarith [h]
      linarith [hk2]
    · exfalso
      have h5 : L.Θ j.val - L.Θ i.val = Real.pi := by
        have h := hk
        ring_nf at h
        linarith [h]
      rw [h5] at hcos
      simp at hcos
      linarith [hcos]
    · right
      have hk2 : L.Θ j.val - L.Θ i.val = 2 * Real.pi := by
        have h := hk
        ring_nf at h
        linarith [h]
      linarith [hk2]
  -- between-terms vanish
  have hB : sumIco (i.val + 1) j.val (fun k => det2 (e i) (e k)) = 0 := by
    rcases hThetaij with hΘ | hΘ
    · apply Finset.sum_eq_zero
      intro k hk
      rw [Finset.mem_filter] at hk
      obtain ⟨_, hk1, hk2⟩ := hk
      have hΘk : L.Θ k.val = L.Θ i.val := by
        have h1 : L.Θ i.val ≤ L.Θ k.val := L.monotone (show i.val ≤ k.val by omega)
        have h2 : L.Θ k.val ≤ L.Θ j.val := L.monotone (show k.val ≤ j.val by omega)
        rw [hΘ] at h2
        exact le_antisymm h2 h1
      rw [L.det2_eq, hΘk]
      simp
    · have hΘi0 : L.Θ i.val = L.Θ 0 := by
        have h1 : L.Θ 0 ≤ L.Θ i.val := L.monotone (Nat.zero_le _)
        have h2 : L.Θ j.val ≤ L.Θ n := L.monotone (show j.val ≤ n by omega)
        linarith [h1, h2, hΘ, hn]
      have hΘjn : L.Θ j.val = L.Θ n := by
        have h1 : L.Θ j.val ≤ L.Θ n := L.monotone (show j.val ≤ n by omega)
        linarith [h1, hΘ, hΘi0, hn]
      have hvanish : ∀ k : Fin n, k.val ≤ i.val ∨ j.val ≤ k.val →
          det2 (e i) (e k) = 0 := by
        intro k hk
        have hΘk : Real.sin (L.Θ k.val - L.Θ i.val) = 0 := by
          rcases hk with hk | hk
          · have h1 : L.Θ k.val ≤ L.Θ i.val := L.monotone (show k.val ≤ i.val by omega)
            have h2 : L.Θ 0 ≤ L.Θ k.val := L.monotone (Nat.zero_le _)
            have h3 : L.Θ k.val = L.Θ i.val := by linarith [h1, h2, hΘi0]
            rw [h3]
            simp
          · have h1 : L.Θ j.val ≤ L.Θ k.val := L.monotone (show j.val ≤ k.val by omega)
            have h2 : L.Θ k.val ≤ L.Θ n := L.monotone (show k.val ≤ n by omega)
            have h3 : L.Θ k.val = L.Θ j.val := by linarith [h1, h2, hΘjn]
            rw [h3, hΘ, hΘi0]
            have h4 : L.Θ 0 + 2 * Real.pi - L.Θ 0 = 2 * Real.pi := by ring
            rw [h4]
            simp
        rw [L.det2_eq, hΘk]
        simp
      have hsum0 : (∑ k : Fin n, det2 (e i) (e k)) = 0 := by
        have h1 : (∑ i, e i) = 0 := hclosed
        rw [← det2_sum_right (e i) univ e, h1]
        simp [det2]
      have hsplit : (∑ k : Fin n, det2 (e i) (e k)) =
          sumIco 0 (i.val + 1) (fun k => det2 (e i) (e k)) +
            sumIco (i.val + 1) j.val (fun k => det2 (e i) (e k)) +
              sumIco j.val n (fun k => det2 (e i) (e k)) := by
        rw [← sumIco_univ (fun k => det2 (e i) (e k))]
        rw [sumIco_consecutive 0 (i.val + 1) n _ (Nat.zero_le _) (by omega),
          sumIco_consecutive (i.val + 1) j.val n _ (by omega) (by omega),
          ← add_assoc]
      have hleft : sumIco 0 (i.val + 1) (fun k => det2 (e i) (e k)) = 0 := by
        apply Finset.sum_eq_zero
        intro k hk
        rw [Finset.mem_filter] at hk
        obtain ⟨_, hk1, _⟩ := hk
        exact hvanish k (Or.inl (by omega : k.val ≤ i.val))
      have hright : sumIco j.val n (fun k => det2 (e i) (e k)) = 0 := by
        apply Finset.sum_eq_zero
        intro k hk
        rw [Finset.mem_filter] at hk
        obtain ⟨_, hk1, _⟩ := hk
        exact hvanish k (Or.inr (by omega : j.val ≤ k.val))
      linarith [hsum0, hsplit, hleft, hright]
  -- `GES` is preserved
  have htermG : ∀ k : Fin n, |det2 (e j + e i) (e k)| - |det2 (e j) (e k)| =
      |det2 (e i) (e k)| := by
    intro k
    rw [det2_add_left, hej_eq, det2_smul_left]
    have h1 : μ * det2 (e i) (e k) + det2 (e i) (e k) = (μ + 1) * det2 (e i) (e k) := by
      ring
    rw [h1, abs_mul, abs_of_pos (by linarith : (0:ℝ) < μ + 1), abs_mul, abs_of_pos hμ_pos]
    ring
  have hG1 : GES w - GES e = ∑ k ∈ univ.erase j, |det2 (e i) (e k)| := by
    rw [hw, GES_update_sub e j (e j + e i)]
    exact Finset.sum_congr rfl (fun k _ => htermG k)
  have hG2 : GES e' - GES w = -(∑ k ∈ univ.erase j, |det2 (e i) (e k)|) := by
    rw [he', GES_update_sub w i 0]
    rw [Finset.sum_congr rfl (fun k _ => show
      |det2 (0 : ℝ × ℝ) (w k)| - |det2 (w i) (w k)| = -|det2 (w i) (w k)| from by
      simp [det2_zero_left]), Finset.sum_neg_distrib]
    congr 1
    rw [Finset.sum_congr rfl (fun k _ => show |det2 (w i) (w k)| =
      |det2 (e i) (w k)| from by rw [hwi])]
    rw [← Finset.add_sum_erase _ _ (show j ∈ univ.erase i from
      Finset.mem_erase.mpr ⟨hij.symm, Finset.mem_univ _⟩)]
    have hj0 : |det2 (e i) (w j)| = 0 := by
      rw [hwj, det2_add_right, hej_eq, det2_smul_right, det2_self]
      simp
    rw [hj0, zero_add]
    rw [Finset.sum_congr rfl (fun k hk => show |det2 (e i) (w k)| =
      |det2 (e i) (e k)| from by rw [hwk k (Finset.ne_of_mem_erase hk)])]
    rw [Finset.erase_right_comm]
    rw [← Finset.add_sum_erase _ _ (show i ∈ univ.erase j from
      Finset.mem_erase.mpr ⟨hij, Finset.mem_univ _⟩)]
    simp
  have hGES : GES e' = GES e := by linarith [hG1, hG2]
  -- `SES` is preserved
  have hS1 : SES w - SES e =
      sumIco 0 j.val (fun k => det2 (e k) (e i)) +
        sumIco (j.val + 1) n (fun k => det2 (e i) (e k)) := by
    rw [hw, SES_update_sub e j (e j + e i), add_sub_cancel_left,
      ← sumIco_zero_eq j.val (fun k => det2 (e k) (e i)),
      ← sumIco_succ_eq_univ j.val (fun k => det2 (e i) (e k))]
  have hS2 : SES e' - SES w =
      -(sumIco 0 i.val (fun k => det2 (e k) (e i))) -
        (sumIco (i.val + 1) j.val (fun k => det2 (e i) (e k)) +
          sumIco (j.val + 1) n (fun k => det2 (e i) (e k))) := by
    rw [he', SES_update_sub w i 0]
    have hx : (0 : ℝ × ℝ) - w i = -(e i) := by
      rw [hwi]
      exact zero_sub _
    rw [hx, Finset.sum_congr rfl (fun k hk => show det2 (w k) (-(e i)) =
      -det2 (e k) (e i) from by
      have hk' : k ≠ j := by
        rw [Finset.mem_filter] at hk
        omega
      rw [hwk k hk', det2_neg_right]), Finset.sum_neg_distrib,
      ← sumIco_zero_eq i.val (fun k => det2 (e k) (e i))]
    congr 1
    rw [show (∑ k ∈ univ.filter (fun k => i.val < k.val), det2 (-(e i)) (w k)) =
        ∑ k ∈ univ.filter (fun k => i.val < k.val), (-det2 (e i) (w k)) from
      Finset.sum_congr rfl (fun k _ => det2_neg_left ..), Finset.sum_neg_distrib]
    congr 1
    have hsplit2 : (∑ k ∈ univ.filter (fun k => i.val < k.val), det2 (e i) (w k)) =
        det2 (e i) (w j) + (sumIco (i.val + 1) j.val (fun k => det2 (e i) (e k)) +
          sumIco (j.val + 1) n (fun k => det2 (e i) (e k))) := by
      have hmem : j ∈ univ.filter (fun k => i.val < k.val) :=
        Finset.mem_filter.mpr ⟨Finset.mem_univ _, hilt⟩
      rw [← Finset.add_sum_erase _ _ hmem]
      have hmain : (∑ k ∈ (univ.filter (fun k => i.val < k.val)).erase j,
            det2 (e i) (w k)) =
          sumIco (i.val + 1) j.val (fun k => det2 (e i) (e k)) +
            sumIco (j.val + 1) n (fun k => det2 (e i) (e k)) := by
        rw [Finset.sum_congr rfl (fun k hk => show det2 (e i) (w k) =
          det2 (e i) (e k) from by rw [hwk k (Finset.ne_of_mem_erase hk)])]
        have hsplit3 : sumIco (i.val + 1) n (fun k => det2 (e i) (e k)) =
            sumIco (i.val + 1) j.val (fun k => det2 (e i) (e k)) +
              sumIco j.val n (fun k => det2 (e i) (e k)) :=
          sumIco_consecutive (i.val + 1) j.val n _ (by omega) (by omega)
        have hsplit4 : sumIco j.val n (fun k => det2 (e i) (e k)) =
            sumIco (j.val + 1) n (fun k => det2 (e i) (e k)) := by
          rw [sumIco_consecutive j.val (j.val + 1) n _ (by omega) (by omega),
            sumIco_singleton j.val (by omega) _]
          show det2 (e i) (e j) + sumIco (j.val + 1) n (fun k => det2 (e i) (e k)) =
            sumIco (j.val + 1) n (fun k => det2 (e i) (e k))
          rw [hpar, zero_add]
        rw [← hsplit4, ← hsplit3, sumIco_succ_eq_univ i.val,
          ← Finset.add_sum_erase _ _ hmem, hpar, zero_add]
      rw [hmain]
    rw [hsplit2]
    have hj0 : det2 (e i) (w j) = 0 := by
      rw [hwj, det2_add_right, hej_eq, det2_smul_right, det2_self]
      simp
    rw [hj0, zero_add]
  have hSES : SES e' = SES e := by
    have hBL : sumIco 0 j.val (fun k => det2 (e k) (e i)) =
        sumIco 0 i.val (fun k => det2 (e k) (e i)) + det2 (e i) (e i) +
          sumIco (i.val + 1) j.val (fun k => det2 (e k) (e i)) := by
      rw [sumIco_consecutive 0 i.val j.val _ (Nat.zero_le _) (by omega),
        sumIco_consecutive i.val (i.val + 1) j.val _ (by omega) (by omega),
        sumIco_singleton i.val (by omega) _]
      simp
    have hneg : sumIco (i.val + 1) j.val (fun k => det2 (e k) (e i)) =
        -sumIco (i.val + 1) j.val (fun k => det2 (e i) (e k)) := by
      rw [show sumIco (i.val + 1) j.val (fun k => det2 (e k) (e i)) =
          sumIco (i.val + 1) j.val (fun k => -det2 (e i) (e k)) from by
        unfold sumIco
        apply Finset.sum_congr rfl
        intro k _
        exact det2_neg _ _, sumIco_neg]
    linarith [hS1, hS2, hBL, hneg, hB, det2_self (e i)]
  -- `ESClosed`
  have he'closed : ESClosed e' := by
    show (∑ k : Fin n, e' k) = 0
    have h1 : (∑ k : Fin n, e' k) = (∑ k : Fin n, w k) - w i + 0 := sum_update_sub w i 0
    have h2 : (∑ k : Fin n, w k) = (∑ k : Fin n, e k) - e j + (e j + e i) :=
      sum_update_sub e j _
    have h3 : (∑ k : Fin n, e k) = 0 := hclosed
    rw [h1, h2, h3, hwi]
    abel
  -- `EdgeLift`
  have hwjval : e j + e i = (μ + 1) • e i := by
    rw [hej_eq]
    nth_rewrite 2 [show e i = (1 : ℝ) • e i from (one_smul _ _).symm]
    rw [← add_smul]
  have hlift : EdgeLift e' := by
    refine ⟨L.Θ, L.period, L.step_nonneg, L.step_le, ?_⟩
    intro k hk
    by_cases hki : k = i
    · subst hki
      rw [he'i] at hk
      exact (hk rfl).elim
    · by_cases hkj : k = j
      · rw [hkj]
        obtain ⟨mj, hmj⟩ := L.cons j hej
        refine ⟨mj, ?_⟩
        have h2 : dirAng (e' j) = dirAng (e j) := by
          rw [he'k j hij.symm, hwj, hwjval,
            dirAng_smul_of_pos _ _ (by nlinarith [hμ_pos] : (0:ℝ) < μ + 1),
            show dirAng (e i) = dirAng (e j) from by
              rw [← dirAng_smul_of_pos μ (e i) hμ_pos, ← hej_eq]]
        rw [h2]
        exact hmj
      · rw [he'k k hki, hwk k hkj] at hk ⊢
        exact L.cons k hk
  -- `esNu`
  have hnu : esNu e' < esNu e := by
    have hset : (univ.filter fun k => e' k ≠ 0) =
        (univ.filter fun k => e k ≠ 0).erase i := by
      ext k
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_erase]
      by_cases hki : k = i
      · subst hki
        rw [he'i]
        simp
      · by_cases hkj : k = j
        · rw [hkj]
          have h1 : e' j ≠ 0 := by
            rw [he'k j hij.symm, hwj, hwjval]
            exact smul_ne_zero (by nlinarith [hμ_pos] : μ + 1 ≠ 0) hei
          simp [h1, hej, hij.symm]
        · rw [he'k k hki, hwk k hkj]
          simp [hki]
    unfold esNu
    have him : i ∈ univ.filter (fun k => e k ≠ 0) :=
      Finset.mem_filter.mpr ⟨Finset.mem_univ _, hei⟩
    rw [hset, Finset.card_erase_of_mem him]
    have hpos : 0 < (univ.filter fun k => e k ≠ 0).card := by
      rw [Finset.card_pos]
      exact ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hei⟩⟩
    omega
  -- `esEll`
  have hell : esEll e' ≤ esEll e := by
    have hset : (univ.filter fun k => e' k ≠ 0).image (fun k => lineKey (e' k)) ⊆
        (univ.filter fun k => e k ≠ 0).image (fun k => lineKey (e k)) := by
      intro y hy
      rw [Finset.mem_image] at hy
      obtain ⟨k, hk, rfl⟩ := hy
      rw [Finset.mem_filter] at hk
      obtain ⟨_, hk2⟩ := hk
      rw [Finset.mem_image]
      by_cases hkj : k = j
      · rw [hkj]
        refine ⟨j, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hej⟩, ?_⟩
        have h2 : dirAng (e' j) = dirAng (e j) := by
          rw [he'k j (hij.symm : j ≠ i), hwj, hwjval,
            dirAng_smul_of_pos _ _ (by nlinarith [hμ_pos] : (0:ℝ) < μ + 1),
            show dirAng (e i) = dirAng (e j) from by
              rw [← dirAng_smul_of_pos μ (e i) hμ_pos, ← hej_eq]]
        exact ((lineKey_eq_iff_int_pi (e' j) (e j)).mpr ⟨0, by simp [h2]⟩).symm
      · by_cases hki : k = i
        · subst hki
          rw [he'i] at hk2
          exact (hk2 rfl).elim
        · have h1 : e' k = e k := by rw [he'k k hki, hwk k hkj]
          have h2 : e k ≠ 0 := by
            rw [← h1]
            exact hk2
          exact ⟨k, Finset.mem_filter.mpr ⟨Finset.mem_univ _, h2⟩, by rw [h1]⟩
    unfold esEll
    exact Finset.card_le_card hset
  exact ⟨e', he'closed, ⟨hlift⟩, by unfold FES; rw [hGES, hSES], hnu, hell⟩

/-- For an antiparallel pair with `i < j`, the lift satisfies `Θ j = Θ i + π`. -/
theorem anti_theta_eq {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    {i j : Fin n} (hilt : i.val < j.val) (hei : e i ≠ 0) (hej : e j ≠ 0)
    (hpar : det2 (e i) (e j) = 0) (hdot : dott (e i) (e j) < 0) :
    L.Θ j.val = L.Θ i.val + Real.pi := by
  have hn : L.Θ n = L.Θ 0 + 2 * Real.pi := by
    have h := L.period 0
    simp at h
    exact h
  have hle : L.Θ i.val ≤ L.Θ j.val := L.monotone (show i.val ≤ j.val by omega)
  have hub : L.Θ j.val - L.Θ i.val ≤ 2 * Real.pi := by
    have h1 : L.Θ j.val ≤ L.Θ n := L.monotone (show j.val ≤ n by omega)
    have h2 : L.Θ 0 ≤ L.Θ i.val := L.monotone (Nat.zero_le _)
    linarith [h1, h2, hn]
  have hsin0 : Real.sin (L.Θ j.val - L.Θ i.val) = 0 := by
    have h := L.det2_eq i j
    rw [hpar] at h
    have hpos : 0 < nrm (e i) * nrm (e j) :=
      mul_pos (nrm_pos_of_ne_zero _ hei) (nrm_pos_of_ne_zero _ hej)
    have h2 : nrm (e i) * nrm (e j) * Real.sin (L.Θ j.val - L.Θ i.val) = 0 := h.symm
    rcases mul_eq_zero.mp h2 with h3 | h3
    · linarith [h3, hpos]
    · exact h3
  have hcos : Real.cos (L.Θ j.val - L.Θ i.val) < 0 := by
    obtain ⟨mi, hmi⟩ := L.cons i hei
    obtain ⟨mj, hmj⟩ := L.cons j hej
    have h1 : Real.cos (L.Θ j.val - L.Θ i.val) =
        Real.cos (dirAng (e j) - dirAng (e i)) := by
      rw [hmj, hmi]
      have h2 : dirAng (e j) + 2 * Real.pi * ↑mj - (dirAng (e i) + 2 * Real.pi * ↑mi) =
          dirAng (e j) - dirAng (e i) + ↑(mj - mi) * (2 * Real.pi) := by
        push_cast
        ring
      rw [h2, Real.cos_add_int_mul_two_pi]
    rw [h1]
    have h2 := dott_eq_cos (e i) (e j)
    have hpos : 0 < nrm (e i) * nrm (e j) :=
      mul_pos (nrm_pos_of_ne_zero _ hei) (nrm_pos_of_ne_zero _ hej)
    have h3 : nrm (e i) * nrm (e j) * Real.cos (dirAng (e j) - dirAng (e i)) < 0 := by
      rw [← h2]
      exact hdot
    rcases mul_neg_iff.mp h3 with ⟨h4, h5⟩ | ⟨h4, h5⟩
    · exact h5
    · linarith [h4, hpos]
  obtain ⟨k, hk⟩ : ∃ k : ℤ, (k : ℝ) * Real.pi = L.Θ j.val - L.Θ i.val :=
    Real.sin_eq_zero_iff.mp hsin0
  have hkb : k = 0 ∨ k = 1 ∨ k = 2 := by
    have h1 : (0 : ℝ) ≤ k := by
      by_contra hc
      push Not at hc
      have h2 := mul_lt_mul_of_pos_right hc Real.pi_pos
      linarith [h2, hk, hle]
    have h2 : (k : ℝ) ≤ 2 := by
      by_contra hc
      push Not at hc
      have h3 : (2 : ℝ) < k := by linarith [hc]
      have h4 := mul_lt_mul_of_pos_right h3 Real.pi_pos
      linarith [h4, hk, hub]
    have h3 : (0 : ℤ) ≤ k := by exact_mod_cast h1
    have h4 : k ≤ 2 := by exact_mod_cast h2
    omega
  rcases hkb with rfl | rfl | rfl
  · exfalso
    have h5 : L.Θ j.val - L.Θ i.val = 0 := by
      have h := hk
      ring_nf at h
      linarith [h]
    rw [h5, Real.cos_zero] at hcos
    linarith [hcos]
  · have hk2 : L.Θ j.val - L.Θ i.val = Real.pi := by
      have h := hk
      ring_nf at h
      linarith [h]
    linarith [hk2]
  · exfalso
    have h5 : L.Θ j.val - L.Θ i.val = 2 * Real.pi := by
      have h := hk
      ring_nf at h
      linarith [h]
    rw [h5, Real.cos_two_pi] at hcos
    linarith [hcos]

/-- Inside the antiparallel interval, row `i` is nonnegative. -/
theorem anti_sign_in {n : ℕ} {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    {i j : Fin n} (hΘj : L.Θ j.val = L.Θ i.val + Real.pi) (k : Fin n)
    (hk1 : i.val ≤ k.val) (hk2 : k.val ≤ j.val) : 0 ≤ det2 (e i) (e k) := by
  rw [L.det2_eq]
  apply mul_nonneg (mul_nonneg (nrm_nonneg _) (nrm_nonneg _))
  apply Real.sin_nonneg_of_nonneg_of_le_pi
  · have h1 : L.Θ i.val ≤ L.Θ k.val := L.monotone (show i.val ≤ k.val by omega)
    linarith
  · have h2 : L.Θ k.val ≤ L.Θ j.val := L.monotone (show k.val ≤ j.val by omega)
    linarith [h2, hΘj]

/-- Outside the antiparallel interval, row `i` is nonpositive. -/
theorem anti_sign_out {n : ℕ} {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    {i j : Fin n} (hΘj : L.Θ j.val = L.Θ i.val + Real.pi) (k : Fin n)
    (hk : k.val ≤ i.val ∨ j.val ≤ k.val) : det2 (e i) (e k) ≤ 0 := by
  rw [L.det2_eq]
  apply mul_nonpos_of_nonneg_of_nonpos (mul_nonneg (nrm_nonneg _) (nrm_nonneg _))
  have hn : L.Θ n = L.Θ 0 + 2 * Real.pi := by
    have h := L.period 0
    simp at h
    exact h
  have hi_le : L.Θ i.val ≤ L.Θ 0 + Real.pi := by
    have h1 : L.Θ j.val ≤ L.Θ n := L.monotone (show j.val ≤ n by omega)
    linarith [h1, hΘj, hn]
  rcases hk with hk | hk
  · apply sin_nonpos_of_neg_mem
    · have h1 : L.Θ 0 ≤ L.Θ k.val := L.monotone (Nat.zero_le _)
      have h2 : L.Θ k.val ≤ L.Θ i.val := L.monotone (show k.val ≤ i.val by omega)
      linarith [h1, h2, hi_le]
    · have h3 : L.Θ k.val ≤ L.Θ i.val := L.monotone (show k.val ≤ i.val by omega)
      linarith [h3]
  · apply sin_nonpos_of_mem_Icc
    · have h1 : L.Θ j.val ≤ L.Θ k.val := L.monotone (show j.val ≤ k.val by omega)
      linarith [h1, hΘj]
    · have h2 : L.Θ k.val ≤ L.Θ n := L.monotone (show k.val ≤ n by omega)
      have h3 : L.Θ 0 ≤ L.Θ i.val := L.monotone (Nat.zero_le _)
      linarith [h2, h3, hΘj, hn]

/-- The absolute row sum of an antiparallel edge equals twice the between-sum. -/
theorem anti_row_abs {n : ℕ} [NeZero n] {e : Fin n → ℝ × ℝ} (L : EdgeLift e)
    (hclosed : ESClosed e) {i j : Fin n} (hilt : i.val < j.val)
    (hΘj : L.Θ j.val = L.Θ i.val + Real.pi) (hpar : det2 (e i) (e j) = 0) :
    (∑ k ∈ (univ.erase i).erase j, |det2 (e i) (e k)|) =
      2 * sumIco (i.val + 1) j.val (fun k => det2 (e i) (e k)) := by
  have hsplit : (∑ k ∈ (univ.erase i).erase j, |det2 (e i) (e k)|) =
      sumIco 0 i.val (fun k => |det2 (e i) (e k)|) +
        sumIco (i.val + 1) j.val (fun k => |det2 (e i) (e k)|) +
          sumIco (j.val + 1) n (fun k => |det2 (e i) (e k)|) := by
    have hset : (univ.erase i).erase j =
        (univ.filter (fun k => k.val < i.val)) ∪
          ((univ.filter (fun k => i.val < k.val ∧ k.val < j.val)) ∪
            (univ.filter (fun k => j.val < k.val))) := by
      ext k
      simp only [Finset.mem_erase, Finset.mem_union, Finset.mem_filter, Finset.mem_univ,
        true_and]
      constructor
      · intro ⟨h1, h2⟩
        by_cases h3 : k.val < i.val
        · exact Or.inl h3
        · by_cases h4 : k.val < j.val
          · exact Or.inr (Or.inl ⟨by omega, h4⟩)
          · exact Or.inr (Or.inr (by omega))
      · intro h
        rcases h with h | h | h
        · exact ⟨Fin.ne_of_val_ne (by omega), Fin.ne_of_val_ne (by omega), trivial⟩
        · exact ⟨Fin.ne_of_val_ne (by omega), Fin.ne_of_val_ne (by omega), trivial⟩
        · exact ⟨Fin.ne_of_val_ne (by omega), Fin.ne_of_val_ne (by omega), trivial⟩
    have hdisj1 : Disjoint (univ.filter (fun k : Fin n => k.val < i.val))
        (univ.filter (fun k : Fin n => i.val < k.val ∧ k.val < j.val) ∪
          univ.filter (fun k : Fin n => j.val < k.val)) := by
      rw [Finset.disjoint_union_right]
      constructor <;> rw [Finset.disjoint_filter] <;> intro k _ h1 h2 <;> omega
    have hdisj2 : Disjoint (univ.filter (fun k : Fin n => i.val < k.val ∧ k.val < j.val))
        (univ.filter (fun k : Fin n => j.val < k.val)) := by
      rw [Finset.disjoint_filter]
      intro k _ h1 h2
      omega
    rw [hset, Finset.sum_union hdisj1, Finset.sum_union hdisj2,
      ← sumIco_zero_eq i.val (fun k => |det2 (e i) (e k)|),
      ← sumIco_succ_left i.val j.val (fun k => |det2 (e i) (e k)|),
      ← sumIco_succ_eq_univ j.val (fun k => |det2 (e i) (e k)|), add_assoc]
  have hz1 : sumIco 0 i.val (fun k => |det2 (e i) (e k)|) =
      -sumIco 0 i.val (fun k => det2 (e i) (e k)) := by
    rw [show sumIco 0 i.val (fun k => |det2 (e i) (e k)|) =
        sumIco 0 i.val (fun k => -det2 (e i) (e k)) from by
      unfold sumIco
      apply Finset.sum_congr rfl
      intro k hk
      rw [Finset.mem_filter] at hk
      obtain ⟨_, hk1, hk2⟩ := hk
      exact abs_of_nonpos (anti_sign_out L hΘj k (Or.inl (by omega : k.val ≤ i.val))),
      sumIco_neg 0 i.val (fun k => det2 (e i) (e k))]
  have hz2 : sumIco (i.val + 1) j.val (fun k => |det2 (e i) (e k)|) =
      sumIco (i.val + 1) j.val (fun k => det2 (e i) (e k)) := by
    unfold sumIco
    apply Finset.sum_congr rfl
    intro k hk
    rw [Finset.mem_filter] at hk
    obtain ⟨_, hk1, hk2⟩ := hk
    exact abs_of_nonneg (anti_sign_in L hΘj k (by omega) (by omega))
  have hz3 : sumIco (j.val + 1) n (fun k => |det2 (e i) (e k)|) =
      -sumIco (j.val + 1) n (fun k => det2 (e i) (e k)) := by
    rw [show sumIco (j.val + 1) n (fun k => |det2 (e i) (e k)|) =
        sumIco (j.val + 1) n (fun k => -det2 (e i) (e k)) from by
      unfold sumIco
      apply Finset.sum_congr rfl
      intro k hk
      rw [Finset.mem_filter] at hk
      obtain ⟨_, hk1, hk2⟩ := hk
      exact abs_of_nonpos (anti_sign_out L hΘj k (Or.inr (by omega : j.val ≤ k.val))),
      sumIco_neg (j.val + 1) n (fun k => det2 (e i) (e k))]
  have hsum0 : (∑ k : Fin n, det2 (e i) (e k)) = 0 := by
    have h1 : (∑ i, e i) = 0 := hclosed
    rw [← det2_sum_right (e i) univ e, h1]
    simp [det2]
  have hrowsplit : (∑ k : Fin n, det2 (e i) (e k)) =
      sumIco 0 i.val (fun k => det2 (e i) (e k)) + det2 (e i) (e i) +
        sumIco (i.val + 1) j.val (fun k => det2 (e i) (e k)) + det2 (e i) (e j) +
          sumIco (j.val + 1) n (fun k => det2 (e i) (e k)) := by
    rw [← sumIco_univ (fun k => det2 (e i) (e k))]
    rw [sumIco_consecutive 0 i.val n _ (Nat.zero_le _) (by omega),
      sumIco_consecutive i.val (i.val + 1) n _ (by omega) (by omega),
      sumIco_singleton i.val (by omega) _,
      sumIco_consecutive (i.val + 1) j.val n _ (by omega) (by omega),
      sumIco_consecutive j.val (j.val + 1) n _ (by omega) (by omega),
      sumIco_singleton j.val (by omega) _]
    show sumIco 0 i.val (fun k => det2 (e i) (e k)) + (det2 (e i) (e i) +
        (sumIco (i.val + 1) j.val (fun k => det2 (e i) (e k)) + (det2 (e i) (e j) +
          sumIco (j.val + 1) n (fun k => det2 (e i) (e k))))) =
      sumIco 0 i.val (fun k => det2 (e i) (e k)) + det2 (e i) (e i) +
        sumIco (i.val + 1) j.val (fun k => det2 (e i) (e k)) + det2 (e i) (e j) +
          sumIco (j.val + 1) n (fun k => det2 (e i) (e k))
    ring
  rw [hsplit, hz1, hz2, hz3]
  rw [hpar, det2_self] at hrowsplit
  simp at hrowsplit
  linarith [hrowsplit, hsum0]

/-- Operation A of the official solution (antiparallel pair, remove the earlier
edge): `F` is preserved, the invariant is preserved, the measure drops. -/
theorem FES_eq_of_opA_remove_earlier {n : ℕ} [NeZero n] (e : Fin n → ℝ × ℝ)
    (L : EdgeLift e) (hclosed : ESClosed e) {i j : Fin n}
    (hij : i ≠ j) (hilt : i.val < j.val) (hei : e i ≠ 0) (hej : e j ≠ 0)
    (hpar : det2 (e i) (e j) = 0) (hdot : dott (e i) (e j) < 0)
    (hlen : nrm (e i) ≤ nrm (e j)) :
    ∃ e' : Fin n → ℝ × ℝ, ESClosed e' ∧ Nonempty (EdgeLift e') ∧ FES e' = FES e ∧
      esNu e' < esNu e ∧ esEll e' ≤ esEll e := by
  have hΘj : L.Θ j.val = L.Θ i.val + Real.pi := anti_theta_eq L hilt hei hej hpar hdot
  have hdii_pos : 0 < dott (e i) (e i) := by
    have h : dott (e i) (e i) = nrm (e i) ^ 2 := by
      unfold dott nrm
      rw [Real.sq_sqrt (by positivity)]
      ring
    rw [h]
    exact sq_pos_of_ne_zero ((nrm_eq_zero_iff (e i)).not.mpr hei)
  have hd0 : (e i).1 * (e j).2 - (e i).2 * (e j).1 = 0 := by
    have h := hpar
    rw [det2] at h
    exact h
  have hC : dott (e i) (e i) • e j = dott (e i) (e j) • e i := by
    apply Prod.ext
    · show dott (e i) (e i) * (e j).1 = dott (e i) (e j) * (e i).1
      simp only [dott]
      have h2 : (e i).2 * ((e i).1 * (e j).2 - (e i).2 * (e j).1) = 0 :=
        mul_eq_zero_of_right _ hd0
      nlinarith [h2]
    · show dott (e i) (e i) * (e j).2 = dott (e i) (e j) * (e i).2
      simp only [dott]
      have h2 : (e i).1 * ((e i).1 * (e j).2 - (e i).2 * (e j).1) = 0 :=
        mul_eq_zero_of_right _ hd0
      nlinarith [h2]
  set μ := -dott (e i) (e j) / dott (e i) (e i) with hμ
  have hμ_pos : 0 < μ := div_pos (by linarith [hdot]) hdii_pos
  have hμeq : dott (e i) (e j) = -μ * dott (e i) (e i) := by
    rw [hμ]
    field_simp
  have hej_eq : e j = (-μ) • e i := by
    have hne : dott (e i) (e i) ≠ 0 := ne_of_gt hdii_pos
    have h2 : dott (e i) (e i) • e j = dott (e i) (e i) • ((-μ) • e i) := by
      rw [hC, hμeq, smul_smul]
      congr 1
      ring
    apply Prod.ext
    · have h1 := congrArg Prod.fst h2
      simp only [Prod.smul_fst] at h1
      exact mul_left_cancel₀ hne h1
    · have h1 := congrArg Prod.snd h2
      simp only [Prod.smul_snd] at h1
      exact mul_left_cancel₀ hne h1
  have hμ_ge : 1 ≤ μ := by
    have hcosm1 : Real.cos (dirAng (e j) - dirAng (e i)) = -1 := by
      have hsin0 : Real.sin (dirAng (e j) - dirAng (e i)) = 0 := by
        have h := det2_eq_sin (e i) (e j)
        rw [hpar] at h
        have hpos : 0 < nrm (e i) * nrm (e j) :=
          mul_pos (nrm_pos_of_ne_zero _ hei) (nrm_pos_of_ne_zero _ hej)
        have h2 : nrm (e i) * nrm (e j) * Real.sin (dirAng (e j) - dirAng (e i)) = 0 := h.symm
        rcases mul_eq_zero.mp h2 with h3 | h3
        · linarith [h3, hpos]
        · exact h3
      have h4 := Real.cos_sq_add_sin_sq (dirAng (e j) - dirAng (e i))
      rw [hsin0] at h4
      have h5 : Real.cos (dirAng (e j) - dirAng (e i)) ^ 2 = 1 := by linarith [h4]
      rcases sq_eq_one_iff.mp h5 with h6 | h6
      · exfalso
        have h7 := dott_eq_cos (e i) (e j)
        rw [h6] at h7
        have hpos : 0 < nrm (e i) * nrm (e j) :=
          mul_pos (nrm_pos_of_ne_zero _ hei) (nrm_pos_of_ne_zero _ hej)
        linarith [h7, hdot, hpos]
      · exact h6
    have h1 : dott (e i) (e j) = -(nrm (e i) * nrm (e j)) := by
      have h2 := dott_eq_cos (e i) (e j)
      rw [hcosm1] at h2
      rw [h2]
      ring
    have h3 : dott (e i) (e i) = nrm (e i) ^ 2 := by
      unfold dott nrm
      rw [Real.sq_sqrt (by positivity)]
      ring
    have hμval : μ = nrm (e j) / nrm (e i) := by
      rw [hμ, h1, h3]
      field_simp [nrm_pos_of_ne_zero _ hei]
    rw [hμval, le_div_iff₀ (nrm_pos_of_ne_zero _ hei)]
    ring_nf
    exact hlen
  set w : Fin n → ℝ × ℝ := Function.update e j (e j + e i) with hw
  set e' : Fin n → ℝ × ℝ := Function.update w i 0 with he'
  have hwk : ∀ k : Fin n, k ≠ j → w k = e k := fun k hk =>
    Function.update_of_ne hk _ e
  have hwi : w i = e i := Function.update_of_ne hij _ e
  have hwj : w j = e j + e i := Function.update_self j (e j + e i) e
  have he'k : ∀ k : Fin n, k ≠ i → e' k = w k := fun k hk =>
    Function.update_of_ne hk (0 : ℝ × ℝ) w
  have he'i : e' i = 0 := Function.update_self i (0 : ℝ × ℝ) w
  have hX : (∑ k ∈ (univ.erase i).erase j, |det2 (e i) (e k)|) =
      2 * sumIco (i.val + 1) j.val (fun k => det2 (e i) (e k)) :=
    anti_row_abs L hclosed hilt hΘj hpar
  have htermG : ∀ k : Fin n, |det2 (e j + e i) (e k)| - |det2 (e j) (e k)| =
      -|det2 (e i) (e k)| := by
    intro k
    rw [det2_add_left, hej_eq, det2_smul_left]
    have h1 : -μ * det2 (e i) (e k) + det2 (e i) (e k) = (1 - μ) * det2 (e i) (e k) := by
      ring
    rw [h1, show (1 : ℝ) - μ = -(μ - 1) from by ring, abs_mul, abs_neg,
      abs_of_nonneg (by linarith [hμ_ge] : (0:ℝ) ≤ μ - 1), abs_mul, abs_neg,
      abs_of_pos hμ_pos]
    ring
  have hG1 : GES w - GES e = -∑ k ∈ univ.erase j, |det2 (e i) (e k)| := by
    rw [hw, GES_update_sub e j (e j + e i)]
    rw [Finset.sum_congr rfl (fun k _ => htermG k), Finset.sum_neg_distrib]
  have hG2 : GES e' - GES w = -∑ k ∈ (univ.erase i).erase j, |det2 (e i) (e k)| := by
    rw [he', GES_update_sub w i 0]
    rw [Finset.sum_congr rfl (fun k _ => show
      |det2 (0 : ℝ × ℝ) (w k)| - |det2 (w i) (w k)| = -|det2 (w i) (w k)| from by
      simp [det2_zero_left]), Finset.sum_neg_distrib]
    congr 1
    rw [Finset.sum_congr rfl (fun k _ => show |det2 (w i) (w k)| =
      |det2 (e i) (w k)| from by rw [hwi])]
    rw [← Finset.add_sum_erase _ _ (show j ∈ univ.erase i from
      Finset.mem_erase.mpr ⟨hij.symm, Finset.mem_univ _⟩)]
    have hj0 : |det2 (e i) (w j)| = 0 := by
      rw [hwj, det2_add_right, hej_eq, det2_smul_right, det2_self]
      simp
    rw [hj0, zero_add]
    rw [Finset.sum_congr rfl (fun k hk => show |det2 (e i) (w k)| =
      |det2 (e i) (e k)| from by rw [hwk k (Finset.ne_of_mem_erase hk)])]
  have hGES : GES e' = GES e - 4 * sumIco (i.val + 1) j.val (fun k => det2 (e i) (e k)) := by
    have hX2 : (∑ k ∈ univ.erase j, |det2 (e i) (e k)|) =
        ∑ k ∈ (univ.erase i).erase j, |det2 (e i) (e k)| := by
      rw [Finset.erase_right_comm]
      rw [← Finset.add_sum_erase _ _ (show i ∈ univ.erase j from
        Finset.mem_erase.mpr ⟨hij, Finset.mem_univ _⟩)]
      simp
    rw [hX2] at hG1
    linarith [hG1, hG2, hX]
  have hS1 : SES w - SES e =
      sumIco 0 j.val (fun k => det2 (e k) (e i)) +
        sumIco (j.val + 1) n (fun k => det2 (e i) (e k)) := by
    rw [hw, SES_update_sub e j (e j + e i), add_sub_cancel_left,
      ← sumIco_zero_eq j.val (fun k => det2 (e k) (e i)),
      ← sumIco_succ_eq_univ j.val (fun k => det2 (e i) (e k))]
  have hS2 : SES e' - SES w =
      -(sumIco 0 i.val (fun k => det2 (e k) (e i))) -
        (sumIco (i.val + 1) j.val (fun k => det2 (e i) (e k)) +
          sumIco (j.val + 1) n (fun k => det2 (e i) (e k))) := by
    rw [he', SES_update_sub w i 0]
    have hx : (0 : ℝ × ℝ) - w i = -(e i) := by
      rw [hwi]
      exact zero_sub _
    rw [hx, Finset.sum_congr rfl (fun k hk => show det2 (w k) (-(e i)) =
      -det2 (e k) (e i) from by
      have hk' : k ≠ j := by
        rw [Finset.mem_filter] at hk
        omega
      rw [hwk k hk', det2_neg_right]), Finset.sum_neg_distrib,
      ← sumIco_zero_eq i.val (fun k => det2 (e k) (e i))]
    congr 1
    rw [show (∑ k ∈ univ.filter (fun k => i.val < k.val), det2 (-(e i)) (w k)) =
        ∑ k ∈ univ.filter (fun k => i.val < k.val), (-det2 (e i) (w k)) from
      Finset.sum_congr rfl (fun k _ => det2_neg_left ..), Finset.sum_neg_distrib]
    congr 1
    have hsplit2 : (∑ k ∈ univ.filter (fun k => i.val < k.val), det2 (e i) (w k)) =
        det2 (e i) (w j) + (sumIco (i.val + 1) j.val (fun k => det2 (e i) (e k)) +
          sumIco (j.val + 1) n (fun k => det2 (e i) (e k))) := by
      have hmem : j ∈ univ.filter (fun k => i.val < k.val) :=
        Finset.mem_filter.mpr ⟨Finset.mem_univ _, hilt⟩
      rw [← Finset.add_sum_erase _ _ hmem]
      have hmain : (∑ k ∈ (univ.filter (fun k => i.val < k.val)).erase j,
            det2 (e i) (w k)) =
          sumIco (i.val + 1) j.val (fun k => det2 (e i) (e k)) +
            sumIco (j.val + 1) n (fun k => det2 (e i) (e k)) := by
        rw [Finset.sum_congr rfl (fun k hk => show det2 (e i) (w k) =
          det2 (e i) (e k) from by rw [hwk k (Finset.ne_of_mem_erase hk)])]
        have hsplit3 : sumIco (i.val + 1) n (fun k => det2 (e i) (e k)) =
            sumIco (i.val + 1) j.val (fun k => det2 (e i) (e k)) +
              sumIco j.val n (fun k => det2 (e i) (e k)) :=
          sumIco_consecutive (i.val + 1) j.val n _ (by omega) (by omega)
        have hsplit4 : sumIco j.val n (fun k => det2 (e i) (e k)) =
            sumIco (j.val + 1) n (fun k => det2 (e i) (e k)) := by
          rw [sumIco_consecutive j.val (j.val + 1) n _ (by omega) (by omega),
            sumIco_singleton j.val (by omega) _]
          show det2 (e i) (e j) + sumIco (j.val + 1) n (fun k => det2 (e i) (e k)) =
            sumIco (j.val + 1) n (fun k => det2 (e i) (e k))
          rw [hpar, zero_add]
        rw [← hsplit4, ← hsplit3, sumIco_succ_eq_univ i.val,
          ← Finset.add_sum_erase _ _ hmem, hpar, zero_add]
      rw [hmain]
    rw [hsplit2]
    have hj0 : det2 (e i) (w j) = 0 := by
      rw [hwj, det2_add_right, hpar, det2_self]
      simp
    rw [hj0, zero_add]
  have hSES : SES e' = SES e - 2 * sumIco (i.val + 1) j.val (fun k => det2 (e i) (e k)) := by
    have hBL : sumIco 0 j.val (fun k => det2 (e k) (e i)) =
        sumIco 0 i.val (fun k => det2 (e k) (e i)) + det2 (e i) (e i) +
          sumIco (i.val + 1) j.val (fun k => det2 (e k) (e i)) := by
      rw [sumIco_consecutive 0 i.val j.val _ (Nat.zero_le _) (by omega),
        sumIco_consecutive i.val (i.val + 1) j.val _ (by omega) (by omega),
        sumIco_singleton i.val (by omega) _]
      simp
    have hneg : sumIco (i.val + 1) j.val (fun k => det2 (e k) (e i)) =
        -sumIco (i.val + 1) j.val (fun k => det2 (e i) (e k)) := by
      rw [show sumIco (i.val + 1) j.val (fun k => det2 (e k) (e i)) =
          sumIco (i.val + 1) j.val (fun k => -det2 (e i) (e k)) from by
        unfold sumIco
        apply Finset.sum_congr rfl
        intro k _
        exact det2_neg _ _, sumIco_neg]
    linarith [hS1, hS2, hBL, hneg, det2_self (e i)]
  have he'closed : ESClosed e' := by
    show (∑ k : Fin n, e' k) = 0
    have h1 : (∑ k : Fin n, e' k) = (∑ k : Fin n, w k) - w i + 0 := sum_update_sub w i 0
    have h2 : (∑ k : Fin n, w k) = (∑ k : Fin n, e k) - e j + (e j + e i) :=
      sum_update_sub e j _
    have h3 : (∑ k : Fin n, e k) = 0 := hclosed
    rw [h1, h2, h3, hwi]
    abel
  have h4 : e j + e i = ((μ - 1) / μ) • e j := by
    rw [hej_eq, smul_smul]
    have h5 : ((μ - 1) / μ * -μ) = 1 + -μ := by
      field_simp [ne_of_gt hμ_pos]
      ring
    rw [h5, add_smul, one_smul]
    exact add_comm _ _
  have hlift : EdgeLift e' := by
    refine ⟨L.Θ, L.period, L.step_nonneg, L.step_le, ?_⟩
    intro k hk
    by_cases hki : k = i
    · subst hki
      rw [he'i] at hk
      exact (hk rfl).elim
    · by_cases hkj : k = j
      · rw [hkj] at hk ⊢
        by_cases hμ1 : μ = 1
        · rw [he'k j hij.symm, hwj, hej_eq, hμ1] at hk
          simp at hk
        · have hμ_gt : (1:ℝ) < μ := lt_of_le_of_ne hμ_ge (Ne.symm hμ1)
          obtain ⟨mj, hmj⟩ := L.cons j hej
          refine ⟨mj, ?_⟩
          have h3 : (0:ℝ) < (μ - 1) / μ := div_pos (by linarith [hμ_gt]) hμ_pos
          have h2 : dirAng (e' j) = dirAng (e j) := by
            rw [he'k j hij.symm, hwj, h4, dirAng_smul_of_pos _ _ h3,
              show dirAng (e j) = dirAng (((μ - 1) / μ) • e j) from
                (dirAng_smul_of_pos _ _ h3).symm]
          rw [h2]
          exact hmj
      · rw [he'k k hki, hwk k hkj] at hk ⊢
        exact L.cons k hk
  have hnu : esNu e' < esNu e := by
    have hset : (univ.filter fun k => e' k ≠ 0) ⊆
        (univ.filter fun k => e k ≠ 0).erase i := by
      intro k hk
      rw [Finset.mem_filter] at hk
      obtain ⟨_, hk2⟩ := hk
      rw [Finset.mem_erase, Finset.mem_filter]
      refine ⟨?_, Finset.mem_univ _, ?_⟩
      · intro hki
        subst hki
        rw [he'i] at hk2
        exact hk2 rfl
      · by_cases hkj : k = j
        · subst hkj
          exact hej
        · rw [he'k k (by
            intro hki
            subst hki
            rw [he'i] at hk2
            exact hk2 rfl), hwk k hkj] at hk2
          exact hk2
    unfold esNu
    have hle : ((univ.filter fun k => e' k ≠ 0).card) ≤
        ((univ.filter fun k => e k ≠ 0).erase i).card := Finset.card_le_card hset
    have heq : ((univ.filter fun k => e k ≠ 0).erase i).card =
        (univ.filter fun k => e k ≠ 0).card - 1 :=
      Finset.card_erase_of_mem (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hei⟩)
    have hpos : 0 < (univ.filter fun k => e k ≠ 0).card := by
      rw [Finset.card_pos]
      exact ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hei⟩⟩
    omega
  have hell : esEll e' ≤ esEll e := by
    have hset : (univ.filter fun k => e' k ≠ 0).image (fun k => lineKey (e' k)) ⊆
        (univ.filter fun k => e k ≠ 0).image (fun k => lineKey (e k)) := by
      intro y hy
      rw [Finset.mem_image] at hy
      obtain ⟨k, hk, rfl⟩ := hy
      rw [Finset.mem_filter] at hk
      obtain ⟨_, hk2⟩ := hk
      rw [Finset.mem_image]
      by_cases hkj : k = j
      · rw [hkj] at hk2 ⊢
        have hμ_gt : (1:ℝ) < μ := by
          by_contra hc
          push Not at hc
          have hμ1 : μ = 1 := le_antisymm hc hμ_ge
          rw [he'k j (hij.symm : j ≠ i), hwj, hej_eq, hμ1] at hk2
          simp at hk2
        refine ⟨j, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hej⟩, ?_⟩
        have h3 : (0:ℝ) < (μ - 1) / μ := div_pos (by linarith [hμ_gt]) hμ_pos
        have h2 : dirAng (e' j) = dirAng (e j) := by
          rw [he'k j (hij.symm : j ≠ i), hwj, h4, dirAng_smul_of_pos _ _ h3,
            show dirAng (e j) = dirAng (((μ - 1) / μ) • e j) from
              (dirAng_smul_of_pos _ _ h3).symm]
        exact ((lineKey_eq_iff_int_pi (e' j) (e j)).mpr ⟨0, by simp [h2]⟩).symm
      · by_cases hki : k = i
        · subst hki
          rw [he'i] at hk2
          exact (hk2 rfl).elim
        · have h1 : e' k = e k := by rw [he'k k hki, hwk k hkj]
          have h2 : e k ≠ 0 := by
            rw [← h1]
            exact hk2
          exact ⟨k, Finset.mem_filter.mpr ⟨Finset.mem_univ _, h2⟩, by rw [h1]⟩
    unfold esEll
    exact Finset.card_le_card hset
  exact ⟨e', he'closed, ⟨hlift⟩, by unfold FES; linarith [hGES, hSES], hnu, hell⟩

/-- Operation A of the official solution (antiparallel pair, remove the later
edge): `F` is preserved, the invariant is preserved, the measure drops. -/
theorem FES_eq_of_opA_remove_later {n : ℕ} [NeZero n] (e : Fin n → ℝ × ℝ)
    (L : EdgeLift e) (hclosed : ESClosed e) {i j : Fin n}
    (hij : i ≠ j) (hilt : i.val < j.val) (hei : e i ≠ 0) (hej : e j ≠ 0)
    (hpar : det2 (e i) (e j) = 0) (hdot : dott (e i) (e j) < 0)
    (hlen : nrm (e j) ≤ nrm (e i)) :
    ∃ e' : Fin n → ℝ × ℝ, ESClosed e' ∧ Nonempty (EdgeLift e') ∧ FES e' = FES e ∧
      esNu e' < esNu e ∧ esEll e' ≤ esEll e := by
  have hΘj : L.Θ j.val = L.Θ i.val + Real.pi := anti_theta_eq L hilt hei hej hpar hdot
  have hdii_pos : 0 < dott (e i) (e i) := by
    have h : dott (e i) (e i) = nrm (e i) ^ 2 := by
      unfold dott nrm
      rw [Real.sq_sqrt (by positivity)]
      ring
    rw [h]
    exact sq_pos_of_ne_zero ((nrm_eq_zero_iff (e i)).not.mpr hei)
  have hd0 : (e i).1 * (e j).2 - (e i).2 * (e j).1 = 0 := by
    have h := hpar
    rw [det2] at h
    exact h
  have hC : dott (e i) (e i) • e j = dott (e i) (e j) • e i := by
    apply Prod.ext
    · show dott (e i) (e i) * (e j).1 = dott (e i) (e j) * (e i).1
      simp only [dott]
      have h2 : (e i).2 * ((e i).1 * (e j).2 - (e i).2 * (e j).1) = 0 :=
        mul_eq_zero_of_right _ hd0
      nlinarith [h2]
    · show dott (e i) (e i) * (e j).2 = dott (e i) (e j) * (e i).2
      simp only [dott]
      have h2 : (e i).1 * ((e i).1 * (e j).2 - (e i).2 * (e j).1) = 0 :=
        mul_eq_zero_of_right _ hd0
      nlinarith [h2]
  set μ := -dott (e i) (e j) / dott (e i) (e i) with hμ
  have hμ_pos : 0 < μ := div_pos (by linarith [hdot]) hdii_pos
  have hμeq : dott (e i) (e j) = -μ * dott (e i) (e i) := by
    rw [hμ]
    field_simp
  have hej_eq : e j = (-μ) • e i := by
    have hne : dott (e i) (e i) ≠ 0 := ne_of_gt hdii_pos
    have h2 : dott (e i) (e i) • e j = dott (e i) (e i) • ((-μ) • e i) := by
      rw [hC, hμeq, smul_smul]
      congr 1
      ring
    apply Prod.ext
    · have h1 := congrArg Prod.fst h2
      simp only [Prod.smul_fst] at h1
      exact mul_left_cancel₀ hne h1
    · have h1 := congrArg Prod.snd h2
      simp only [Prod.smul_snd] at h1
      exact mul_left_cancel₀ hne h1
  have hμ_le : μ ≤ 1 := by
    have hcosm1 : Real.cos (dirAng (e j) - dirAng (e i)) = -1 := by
      have hsin0 : Real.sin (dirAng (e j) - dirAng (e i)) = 0 := by
        have h := det2_eq_sin (e i) (e j)
        rw [hpar] at h
        have hpos : 0 < nrm (e i) * nrm (e j) :=
          mul_pos (nrm_pos_of_ne_zero _ hei) (nrm_pos_of_ne_zero _ hej)
        have h2 : nrm (e i) * nrm (e j) * Real.sin (dirAng (e j) - dirAng (e i)) = 0 := h.symm
        rcases mul_eq_zero.mp h2 with h3 | h3
        · linarith [h3, hpos]
        · exact h3
      have h4 := Real.cos_sq_add_sin_sq (dirAng (e j) - dirAng (e i))
      rw [hsin0] at h4
      have h5 : Real.cos (dirAng (e j) - dirAng (e i)) ^ 2 = 1 := by linarith [h4]
      rcases sq_eq_one_iff.mp h5 with h6 | h6
      · exfalso
        have h7 := dott_eq_cos (e i) (e j)
        rw [h6] at h7
        have hpos : 0 < nrm (e i) * nrm (e j) :=
          mul_pos (nrm_pos_of_ne_zero _ hei) (nrm_pos_of_ne_zero _ hej)
        linarith [h7, hdot, hpos]
      · exact h6
    have h1 : dott (e i) (e j) = -(nrm (e i) * nrm (e j)) := by
      have h2 := dott_eq_cos (e i) (e j)
      rw [hcosm1] at h2
      rw [h2]
      ring
    have h3 : dott (e i) (e i) = nrm (e i) ^ 2 := by
      unfold dott nrm
      rw [Real.sq_sqrt (by positivity)]
      ring
    have hμval : μ = nrm (e j) / nrm (e i) := by
      rw [hμ, h1, h3]
      field_simp [nrm_pos_of_ne_zero _ hei]
    rw [hμval, div_le_iff₀ (nrm_pos_of_ne_zero _ hei)]
    ring_nf
    exact hlen
  set w : Fin n → ℝ × ℝ := Function.update e i (e i + e j) with hw
  set e' : Fin n → ℝ × ℝ := Function.update w j 0 with he'
  have hwk : ∀ k : Fin n, k ≠ i → w k = e k := fun k hk =>
    Function.update_of_ne hk _ e
  have hwj : w j = e j := Function.update_of_ne hij.symm _ e
  have hwi : w i = e i + e j := Function.update_self i (e i + e j) e
  have he'k : ∀ k : Fin n, k ≠ j → e' k = w k := fun k hk =>
    Function.update_of_ne hk (0 : ℝ × ℝ) w
  have he'j : e' j = 0 := Function.update_self j (0 : ℝ × ℝ) w
  have hX : (∑ k ∈ (univ.erase i).erase j, |det2 (e i) (e k)|) =
      2 * sumIco (i.val + 1) j.val (fun k => det2 (e i) (e k)) :=
    anti_row_abs L hclosed hilt hΘj hpar
  have htermG : ∀ k : Fin n, |det2 (e i + e j) (e k)| - |det2 (e i) (e k)| =
      -μ * |det2 (e i) (e k)| := by
    intro k
    rw [det2_add_left, hej_eq, det2_smul_left]
    have h1 : det2 (e i) (e k) + -μ * det2 (e i) (e k) = (1 - μ) * det2 (e i) (e k) := by
      ring
    rw [h1, abs_mul, abs_of_nonneg (by linarith [hμ_le] : (0:ℝ) ≤ 1 - μ)]
    ring
  have hG1 : GES w - GES e = -μ * ∑ k ∈ univ.erase i, |det2 (e i) (e k)| := by
    rw [hw, GES_update_sub e i (e i + e j)]
    rw [Finset.sum_congr rfl (fun k _ => htermG k), ← Finset.mul_sum]
  have hG2 : GES e' - GES w = -μ * ∑ k ∈ (univ.erase i).erase j, |det2 (e i) (e k)| := by
    rw [he', GES_update_sub w j 0]
    rw [Finset.sum_congr rfl (fun k _ => show
      |det2 (0 : ℝ × ℝ) (w k)| - |det2 (w j) (w k)| = -|det2 (w j) (w k)| from by
      simp [det2_zero_left]), Finset.sum_neg_distrib]
    congr 1
    rw [Finset.sum_congr rfl (fun k _ => show |det2 (w j) (w k)| =
      |det2 (e j) (w k)| from by rw [hwj])]
    rw [← Finset.add_sum_erase _ _ (show i ∈ univ.erase j from
      Finset.mem_erase.mpr ⟨hij, Finset.mem_univ _⟩)]
    have hi0 : |det2 (e j) (w i)| = 0 := by
      rw [hwi, det2_add_right, hej_eq, det2_smul_right, det2_smul_left, det2_self]
      simp
    rw [hi0, zero_add]
    rw [Finset.sum_congr rfl (fun k hk => show |det2 (e j) (w k)| =
      |det2 (e j) (e k)| from by rw [hwk k (Finset.ne_of_mem_erase hk)])]
    rw [Finset.sum_congr rfl (fun k _ => show |det2 (e j) (e k)| =
      μ * |det2 (e i) (e k)| from by
      rw [hej_eq, det2_smul_left, abs_mul, abs_neg, abs_of_pos hμ_pos]),
      neg_mul, ← Finset.mul_sum, Finset.erase_right_comm]
  have hGES : GES e' = GES e - 4 * μ * sumIco (i.val + 1) j.val (fun k => det2 (e i) (e k)) := by
    have hX2 : (∑ k ∈ univ.erase i, |det2 (e i) (e k)|) =
        ∑ k ∈ (univ.erase i).erase j, |det2 (e i) (e k)| := by
      rw [← Finset.add_sum_erase _ _ (show j ∈ univ.erase i from
        Finset.mem_erase.mpr ⟨hij.symm, Finset.mem_univ _⟩)]
      have hj0 : |det2 (e i) (e j)| = 0 := by
        rw [hpar]
        simp
      rw [hj0, zero_add]
    rw [hX2, hX] at hG1
    rw [hX] at hG2
    linarith [hG1, hG2]
  have hS1 : SES w - SES e =
      sumIco 0 i.val (fun k => det2 (e k) (e j)) +
        sumIco (i.val + 1) n (fun k => det2 (e j) (e k)) := by
    rw [hw, SES_update_sub e i (e i + e j), add_sub_cancel_left,
      ← sumIco_zero_eq i.val (fun k => det2 (e k) (e j)),
      ← sumIco_succ_eq_univ i.val (fun k => det2 (e j) (e k))]
  have hS2 : SES e' - SES w =
      -(sumIco 0 j.val (fun k => det2 (e k) (e j))) -
        sumIco (j.val + 1) n (fun k => det2 (e j) (e k)) := by
    rw [he', SES_update_sub w j 0]
    have hx : (0 : ℝ × ℝ) - w j = -(e j) := by
      rw [hwj]
      exact zero_sub _
    rw [hx, Finset.sum_congr rfl (fun k hk => show det2 (w k) (-(e j)) =
      -det2 (e k) (e j) from by
      rw [det2_neg_right]
      by_cases hki : k = i
      · subst hki
        rw [hwi, det2_add_left, hpar, det2_self]
        simp
      · rw [hwk k hki]), Finset.sum_neg_distrib,
      ← sumIco_zero_eq j.val (fun k => det2 (e k) (e j))]
    congr 1
    rw [show (∑ k ∈ univ.filter (fun k => j.val < k.val), det2 (-(e j)) (w k)) =
        ∑ k ∈ univ.filter (fun k => j.val < k.val), (-det2 (e j) (e k)) from by
      apply Finset.sum_congr rfl
      intro k hk
      rw [Finset.mem_filter] at hk
      obtain ⟨_, hk1⟩ := hk
      rw [show w k = e k from hwk k (Fin.ne_of_val_ne (by omega : k.val ≠ i.val))]
      exact det2_neg_left .., Finset.sum_neg_distrib]
    congr 1
    exact (sumIco_succ_eq_univ j.val _).symm
  have hSES : SES e' = SES e - 2 * μ * sumIco (i.val + 1) j.val (fun k => det2 (e i) (e k)) := by
    have hsplitL : sumIco 0 j.val (fun k => det2 (e k) (e j)) =
        sumIco 0 i.val (fun k => det2 (e k) (e j)) + det2 (e i) (e j) +
          sumIco (i.val + 1) j.val (fun k => det2 (e k) (e j)) := by
      rw [sumIco_consecutive 0 i.val j.val _ (Nat.zero_le _) (by omega),
        sumIco_consecutive i.val (i.val + 1) j.val _ (by omega) (by omega),
        sumIco_singleton i.val (by omega) _]
      show sumIco 0 i.val (fun k => det2 (e k) (e j)) + (det2 (e i) (e j) +
          sumIco (i.val + 1) j.val (fun k => det2 (e k) (e j))) =
        sumIco 0 i.val (fun k => det2 (e k) (e j)) + det2 (e i) (e j) +
          sumIco (i.val + 1) j.val (fun k => det2 (e k) (e j))
      ring
    have hsplitR : sumIco (i.val + 1) n (fun k => det2 (e j) (e k)) =
        sumIco (i.val + 1) j.val (fun k => det2 (e j) (e k)) + det2 (e j) (e j) +
          sumIco (j.val + 1) n (fun k => det2 (e j) (e k)) := by
      rw [sumIco_consecutive (i.val + 1) j.val n _ (by omega) (by omega),
        sumIco_consecutive j.val (j.val + 1) n _ (by omega) (by omega),
        sumIco_singleton j.val (by omega) _]
      show sumIco (i.val + 1) j.val (fun k => det2 (e j) (e k)) + (det2 (e j) (e j) +
          sumIco (j.val + 1) n (fun k => det2 (e j) (e k))) =
        sumIco (i.val + 1) j.val (fun k => det2 (e j) (e k)) + det2 (e j) (e j) +
          sumIco (j.val + 1) n (fun k => det2 (e j) (e k))
      ring
    have hneg2 : sumIco (i.val + 1) j.val (fun k => det2 (e k) (e j)) =
        -sumIco (i.val + 1) j.val (fun k => det2 (e j) (e k)) := by
      rw [show sumIco (i.val + 1) j.val (fun k => det2 (e k) (e j)) =
          sumIco (i.val + 1) j.val (fun k => -det2 (e j) (e k)) from by
        unfold sumIco
        apply Finset.sum_congr rfl
        intro k _
        exact (det2_neg _ _), sumIco_neg (i.val + 1) j.val (fun k => det2 (e j) (e k))]
    have hμrow : sumIco (i.val + 1) j.val (fun k => det2 (e j) (e k)) =
        -μ * sumIco (i.val + 1) j.val (fun k => det2 (e i) (e k)) := by
      rw [show sumIco (i.val + 1) j.val (fun k => det2 (e j) (e k)) =
          sumIco (i.val + 1) j.val (fun k => -μ * det2 (e i) (e k)) from by
        unfold sumIco
        apply Finset.sum_congr rfl
        intro k _
        show det2 (e j) (e k) = -μ * det2 (e i) (e k)
        rw [hej_eq, det2_smul_left]]
      unfold sumIco
      rw [← Finset.mul_sum]
    linarith [hS1, hS2, hsplitL, hsplitR, hneg2, hμrow, hpar, det2_self (e j)]
  have he'closed : ESClosed e' := by
    show (∑ k : Fin n, e' k) = 0
    have h1 : (∑ k : Fin n, e' k) = (∑ k : Fin n, w k) - w j + 0 := sum_update_sub w j 0
    have h2 : (∑ k : Fin n, w k) = (∑ k : Fin n, e k) - e i + (e i + e j) :=
      sum_update_sub e i _
    have h3 : (∑ k : Fin n, e k) = 0 := hclosed
    rw [h1, h2, h3, hwj]
    abel
  have h4 : e i + e j = (1 - μ) • e i := by
    rw [hej_eq, show (1 : ℝ) - μ = 1 + -μ from by ring, add_smul, one_smul]
  have hlift : EdgeLift e' := by
    refine ⟨L.Θ, L.period, L.step_nonneg, L.step_le, ?_⟩
    intro k hk
    by_cases hkj : k = j
    · subst hkj
      rw [he'j] at hk
      exact (hk rfl).elim
    · by_cases hki : k = i
      · rw [hki] at hk ⊢
        by_cases hμ1 : μ = 1
        · rw [he'k i (hij : i ≠ j), hwi, hej_eq, hμ1] at hk
          simp at hk
        · have hμ_lt : μ < 1 := lt_of_le_of_ne hμ_le hμ1
          obtain ⟨mi, hmi⟩ := L.cons i hei
          refine ⟨mi, ?_⟩
          have h3 : (0:ℝ) < 1 - μ := by linarith [hμ_lt]
          have h2 : dirAng (e' i) = dirAng (e i) := by
            rw [he'k i (hij : i ≠ j), hwi, h4, dirAng_smul_of_pos _ _ h3]
          rw [h2]
          exact hmi
      · rw [he'k k hkj, hwk k hki] at hk ⊢
        exact L.cons k hk
  have hnu : esNu e' < esNu e := by
    have hset : (univ.filter fun k => e' k ≠ 0) ⊆
        (univ.filter fun k => e k ≠ 0).erase j := by
      intro k hk
      rw [Finset.mem_filter] at hk
      obtain ⟨_, hk2⟩ := hk
      rw [Finset.mem_erase, Finset.mem_filter]
      have hkj : k ≠ j := by
        intro hkj
        subst hkj
        rw [he'j] at hk2
        exact hk2 rfl
      refine ⟨hkj, Finset.mem_univ _, ?_⟩
      by_cases hki : k = i
      · subst hki
        exact hei
      · rw [he'k k hkj, hwk k hki] at hk2
        exact hk2
    unfold esNu
    have hle : ((univ.filter fun k => e' k ≠ 0).card) ≤
        ((univ.filter fun k => e k ≠ 0).erase j).card := Finset.card_le_card hset
    have heq : ((univ.filter fun k => e k ≠ 0).erase j).card =
        (univ.filter fun k => e k ≠ 0).card - 1 := by
      have him : j ∈ univ.filter (fun k => e k ≠ 0) :=
        Finset.mem_filter.mpr ⟨Finset.mem_univ _, hej⟩
      rw [Finset.card_erase_of_mem him]
    have hpos : 0 < (univ.filter fun k => e k ≠ 0).card := by
      rw [Finset.card_pos]
      exact ⟨j, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hej⟩⟩
    omega
  have hell : esEll e' ≤ esEll e := by
    have hset : (univ.filter fun k => e' k ≠ 0).image (fun k => lineKey (e' k)) ⊆
        (univ.filter fun k => e k ≠ 0).image (fun k => lineKey (e k)) := by
      intro y hy
      rw [Finset.mem_image] at hy
      obtain ⟨k, hk, rfl⟩ := hy
      rw [Finset.mem_filter] at hk
      obtain ⟨_, hk2⟩ := hk
      rw [Finset.mem_image]
      by_cases hki : k = i
      · rw [hki] at hk2 ⊢
        have hμ_lt : μ < 1 := by
          by_contra hc
          push Not at hc
          have hμ1 : μ = 1 := le_antisymm hμ_le hc
          rw [he'k i (hij : i ≠ j), hwi, hej_eq, hμ1] at hk2
          simp at hk2
        refine ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hei⟩, ?_⟩
        have h3 : (0:ℝ) < 1 - μ := by linarith [hμ_lt]
        have h2 : dirAng (e' i) = dirAng (e i) := by
          rw [he'k i (hij : i ≠ j), hwi, h4, dirAng_smul_of_pos _ _ h3]
        exact ((lineKey_eq_iff_int_pi (e' i) (e i)).mpr ⟨0, by simp [h2]⟩).symm
      · by_cases hkj : k = j
        · subst hkj
          rw [he'j] at hk2
          exact (hk2 rfl).elim
        · have h1 : e' k = e k := by rw [he'k k hkj, hwk k hki]
          have h2 : e k ≠ 0 := by
            rw [← h1]
            exact hk2
          exact ⟨k, Finset.mem_filter.mpr ⟨Finset.mem_univ _, h2⟩, by rw [h1]⟩
    unfold esEll
    exact Finset.card_le_card hset
  exact ⟨e', he'closed, ⟨hlift⟩, by unfold FES; linarith [hGES, hSES], hnu, hell⟩

/-- The turn from a vector to itself is zero. -/
theorem turnAng_self (v : ℝ × ℝ) : turnAng v v = 0 := by
  unfold turnAng
  rw [if_pos le_rfl]
  simp

/-- The turn telescopes modulo `2π`, with a `0/1` integer defect. -/
theorem turnAng_mod_eq (u v : ℝ × ℝ) :
    ∃ k : ℤ, turnAng u v = dirAng v - dirAng u + 2 * Real.pi * (k : ℝ) := by
  unfold turnAng
  split_ifs with h
  · exact ⟨0, by simp⟩
  · exact ⟨1, by push_cast; ring⟩

/-- The sum of the three turning angles of a counterclockwise triangle is
`2π`. -/
theorem turn_sum_triangle (f₀ f₁ f₂ : ℝ × ℝ)
    (h01 : 0 < det2 f₀ f₁) (h12 : 0 < det2 f₁ f₂) (h20 : 0 < det2 f₂ f₀) :
    turnAng f₀ f₁ + turnAng f₁ f₂ + turnAng f₂ f₀ = 2 * Real.pi := by
  have hf0 : f₀ ≠ 0 := by
    intro hcon
    rw [hcon, det2_zero_left] at h01
    exact absurd h01 (lt_irrefl _)
  have hf1 : f₁ ≠ 0 := by
    intro hcon
    rw [hcon, det2_zero_left] at h12
    exact absurd h12 (lt_irrefl _)
  have hf2 : f₂ ≠ 0 := by
    intro hcon
    rw [hcon, det2_zero_left] at h20
    exact absurd h20 (lt_irrefl _)
  have hτ0 := (det2_pos_iff_turnAng f₀ f₁ hf0 hf1).mp h01
  have hτ1 := (det2_pos_iff_turnAng f₁ f₂ hf1 hf2).mp h12
  have hτ2 := (det2_pos_iff_turnAng f₂ f₀ hf2 hf0).mp h20
  obtain ⟨k0, hk0⟩ := turnAng_mod_eq f₀ f₁
  obtain ⟨k1, hk1⟩ := turnAng_mod_eq f₁ f₂
  obtain ⟨k2, hk2⟩ := turnAng_mod_eq f₂ f₀
  have hsum : turnAng f₀ f₁ + turnAng f₁ f₂ + turnAng f₂ f₀ =
      2 * Real.pi * ((k0 + k1 + k2 : ℤ) : ℝ) := by
    rw [hk0, hk1, hk2]
    push_cast
    ring
  rw [hsum]
  have hK : k0 + k1 + k2 = 1 := by
    have h2pi : (0:ℝ) < 2 * Real.pi := by linarith [Real.pi_pos]
    have hpos : (0:ℝ) < ((k0 + k1 + k2 : ℤ) : ℝ) := by
      have h1 : 0 < turnAng f₀ f₁ + turnAng f₁ f₂ + turnAng f₂ f₀ := by
        linarith [hτ0.1, hτ1.1, hτ2.1]
      rw [hsum] at h1
      exact (mul_pos_iff_of_pos_left h2pi).mp h1
    have hlt : ((k0 + k1 + k2 : ℤ) : ℝ) < 2 := by
      have h2 : turnAng f₀ f₁ + turnAng f₁ f₂ + turnAng f₂ f₀ < 3 * Real.pi := by
        linarith [hτ0.2, hτ1.2, hτ2.2]
      rw [hsum] at h2
      by_contra hcon
      push_neg at hcon
      have h5 : (2:ℝ) ≤ ((k0 + k1 + k2 : ℤ) : ℝ) := by exact_mod_cast hcon
      nlinarith [h2, h5, Real.pi_pos]
    have hpos' : 0 < k0 + k1 + k2 := by exact_mod_cast hpos
    have hlt' : k0 + k1 + k2 < 2 := by exact_mod_cast hlt
    omega
  rw [hK]
  push_cast
  ring

/-- The direction angle of a negated vector differs by `π`. -/
theorem dirAng_neg {v : ℝ × ℝ} (hv : v ≠ 0) :
    dirAng (-v) = dirAng v + Real.pi ∨ dirAng (-v) = dirAng v - Real.pi := by
  have hcv : toC v ≠ 0 := (toC_eq_zero_iff v).not.mpr hv
  have htc : toC (-v) = - toC v := by
    unfold toC
    rw [Complex.ext_iff]
    constructor <;> simp
  have h1 := Complex.arg_neg_coe_angle hcv
  rw [← htc] at h1
  have h2 : (↑(dirAng (-v)) : Real.Angle) = ↑(dirAng v + Real.pi) := by
    rw [← Real.Angle.coe_add] at h1
    exact h1
  obtain ⟨k, hk⟩ := Real.Angle.angle_eq_iff_two_pi_dvd_sub.mp h2
  obtain ⟨h4, h5⟩ := dirAng_mem_Ioc (-v)
  obtain ⟨h6, h7⟩ := dirAng_mem_Ioc v
  have hk01 : k = 0 ∨ k = -1 := by
    by_contra hcon
    push_neg at hcon
    have h8 : k ≤ -2 ∨ 1 ≤ k := by omega
    rcases h8 with h8 | h8
    · have h9 : ((k : ℤ) : ℝ) ≤ (-2 : ℝ) := by exact_mod_cast h8
      nlinarith [hk, h6, h7, h4, h5, h9, Real.pi_pos]
    · have h9 : (1:ℝ) ≤ ((k : ℤ) : ℝ) := by exact_mod_cast h8
      nlinarith [hk, h6, h7, h4, h5, h9, Real.pi_pos]
  rcases hk01 with rfl | rfl
  · left
    push_cast at hk
    linarith [hk]
  · right
    push_cast at hk
    linarith [hk]

/-- Turn to a negated target differs from the direct turn by `π`. -/
theorem turnAng_neg_right (u v : ℝ × ℝ) (hv : v ≠ 0) :
    turnAng u (-v) = turnAng u v + Real.pi ∨ turnAng u (-v) = turnAng u v - Real.pi := by
  obtain h | h := dirAng_neg hv
  · unfold turnAng
    rw [h]
    split_ifs with h1 h2 h2
    · left
      linarith
    · right
      linarith
    · exfalso
      obtain ⟨h3, h4⟩ := dirAng_mem_Ioc u
      obtain ⟨h5, h6⟩ := dirAng_mem_Ioc v
      linarith [Real.pi_pos]
    · left
      linarith
  · unfold turnAng
    rw [h]
    split_ifs with h1 h2 h2
    · right
      linarith
    · exfalso
      obtain ⟨h3, h4⟩ := dirAng_mem_Ioc u
      obtain ⟨h5, h6⟩ := dirAng_mem_Ioc v
      linarith [Real.pi_pos]
    · left
      linarith
    · right
      linarith

/-- Turn from a negated source differs from the direct turn by `π`. -/
theorem turnAng_neg_left (u v : ℝ × ℝ) (hu : u ≠ 0) :
    turnAng (-u) v = turnAng u v - Real.pi ∨ turnAng (-u) v = turnAng u v + Real.pi := by
  obtain h | h := dirAng_neg hu
  · unfold turnAng
    rw [h]
    split_ifs with h1 h2 h2
    · left
      linarith
    · exfalso
      obtain ⟨h3, h4⟩ := dirAng_mem_Ioc u
      obtain ⟨h5, h6⟩ := dirAng_mem_Ioc v
      linarith [Real.pi_pos]
    · right
      linarith
    · left
      linarith
  · unfold turnAng
    rw [h]
    split_ifs with h1 h2 h2
    · right
      linarith
    · left
      linarith
    · exfalso
      obtain ⟨h3, h4⟩ := dirAng_mem_Ioc u
      obtain ⟨h5, h6⟩ := dirAng_mem_Ioc v
      linarith [Real.pi_pos]
    · right
      linarith

/-- The turns of a directed pair and its reverse sum to `2π` (or both vanish). -/
theorem turnAng_add_reverse (u v : ℝ × ℝ) :
    turnAng u v + turnAng v u = 2 * Real.pi ∨ (turnAng u v = 0 ∧ turnAng v u = 0) := by
  unfold turnAng
  by_cases huv : dirAng u = dirAng v
  · rw [huv, if_pos le_rfl]
    right
    exact ⟨by simp, by simp⟩
  · left
    have h1 : dirAng u ≤ dirAng v ∨ dirAng v ≤ dirAng u := le_total _ _
    rcases h1 with h1 | h1
    · rw [if_pos h1, if_neg (by
        intro hcon
        exact huv (le_antisymm h1 hcon))]
      linarith
    · rw [if_neg (by
        intro hcon
        exact huv (le_antisymm hcon h1)), if_pos h1]
      linarith

/-- The triple of cyclically consecutive indices of a convex polygon. -/
theorem convex_cyc_succ {n : ℕ} [NeZero n] (hn3 : 3 ≤ n) (i : Fin n) :
    (i.val < (i + 1).val ∧ (i + 1).val < ((i + 1) + 1).val) ∨
      ((i + 1).val < ((i + 1) + 1).val ∧ ((i + 1) + 1).val < i.val) ∨
      (((i + 1) + 1).val < i.val ∧ i.val < (i + 1).val) := by
  have hnn : 0 < n := NeZero.pos n
  by_cases h1 : i.val + 2 < n
  · have h2 : (i + 1 : Fin n).val = i.val + 1 := Fin.val_add_one_of_lt' (by omega)
    have h3 : ((i + 1 : Fin n) + 1).val = i.val + 2 := by
      have h4 : ((i + 1 : Fin n) + 1).val = (i + 1 : Fin n).val + 1 :=
        Fin.val_add_one_of_lt' (by rw [h2]; omega)
      rw [h4, h2]
    exact Or.inl ⟨by rw [h2]; exact Nat.lt_succ_self _, by rw [h2, h3]; omega⟩
  · by_cases h4 : i.val + 1 < n
    · have h5 : i.val = n - 2 := by omega
      have h6 : (i + 1 : Fin n).val = i.val + 1 := Fin.val_add_one_of_lt' (by omega)
      have h7 : ((i + 1 : Fin n) + 1).val = 0 := by
        have h8 : ((i + 1 : Fin n) + 1).val = ((i + 1 : Fin n).val + 1 % n) % n := by
          rw [Fin.val_add]
          rfl
        rw [h8, h6, h5]
        have h9 : n - 2 + 1 + 1 % n = n := by
          have h10 : 1 % n = 1 := Nat.mod_eq_of_lt (by omega : 1 < n)
          rw [h10]
          omega
        rw [h9, Nat.mod_self]
      exact Or.inr (Or.inr ⟨by rw [h7]; omega, by rw [h6]; omega⟩)
    · have h8 : i.val = n - 1 := by omega
      have h9 : (i + 1 : Fin n).val = 0 := by
        have h10 : (i + 1 : Fin n).val = (i.val + 1 % n) % n := by
          rw [Fin.val_add]
          rfl
        rw [h10, h8]
        have h11 : n - 1 + 1 % n = n := by
          have h12 : 1 % n = 1 := Nat.mod_eq_of_lt (by omega : 1 < n)
          rw [h12]
          omega
        rw [h11, Nat.mod_self]
      have h13 : ((i + 1 : Fin n) + 1).val = 1 := by
        have h14 : ((i + 1 : Fin n) + 1).val = ((i + 1 : Fin n).val + 1 % n) % n := by
          rw [Fin.val_add]
          rfl
        rw [h14, h9]
        have h15 : 1 % n = 1 := Nat.mod_eq_of_lt (by omega : 1 < n)
        rw [h15]
        have h16 : 0 + 1 = 1 := by ring
        rw [h16, Nat.mod_eq_of_lt (by omega : 1 < n)]
      exact Or.inr (Or.inl ⟨by rw [h9, h13]; omega, by rw [h13, h8]; omega⟩)

/-- The cross product of two consecutive edges of a strictly convex polygon
is positive. -/
theorem det2_edge_succ_pos_of_convex {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ)
    (hv : IsConvexPolygon v) (hn3 : 3 ≤ n) (i : Fin n) :
    0 < det2 (edge v i) (edge v (i + 1)) := by
  have harea : det2 (edge v i) (edge v (i + 1)) = area2 (v i) (v (i + 1)) (v ((i + 1) + 1)) := by
    have h1 : v ((i + 1) + 1) - v i = (v ((i + 1) + 1) - v (i + 1)) + (v (i + 1) - v i) := by
      ext <;> simp <;> ring
    unfold area2 edge
    rw [h1, det2_add_right, det2_self]
    simp
  rw [harea]
  exact hv i (i + 1) ((i + 1) + 1) (convex_cyc_succ hn3 i)

/-- Edges of a strictly convex polygon are nonzero. -/
theorem edge_ne_zero_of_convex {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ)
    (hv : IsConvexPolygon v) (hn3 : 3 ≤ n) (i : Fin n) : edge v i ≠ 0 := by
  have hdet := det2_edge_succ_pos_of_convex v hv hn3 i
  intro hcon
  rw [hcon, det2_zero_left] at hdet
  exact absurd hdet (lt_irrefl _)

/-- Consecutive edges of a strictly convex polygon make a positive turn. -/
theorem turnAng_edge_pos_of_convex {n : ℕ} [NeZero n] (v : Fin n → ℝ × ℝ)
    (hv : IsConvexPolygon v) (hn3 : 3 ≤ n) (i : Fin n) :
    0 < turnAng (edge v i) (edge v (i + 1)) ∧
      turnAng (edge v i) (edge v (i + 1)) < Real.pi := by
  have hdet := det2_edge_succ_pos_of_convex v hv hn3 i
  have he0 : edge v i ≠ 0 := edge_ne_zero_of_convex v hv hn3 i
  have he1 : edge v (i + 1) ≠ 0 := edge_ne_zero_of_convex v hv hn3 (i + 1)
  exact (det2_pos_iff_turnAng _ _ he0 he1).mp hdet

/-- The turn is additive modulo `2π`, with a `0/1` integer defect. -/
theorem turnAng_add_two (u v w : ℝ × ℝ) :
    turnAng u v + turnAng v w = turnAng u w ∨ turnAng u v + turnAng v w = turnAng u w + 2 * Real.pi := by
  obtain ⟨k1, hk1⟩ := turnAng_mod_eq u v
  obtain ⟨k2, hk2⟩ := turnAng_mod_eq v w
  obtain ⟨k3, hk3⟩ := turnAng_mod_eq u w
  have hsum : turnAng u v + turnAng v w = turnAng u w + 2 * Real.pi * ((k1 + k2 - k3 : ℤ) : ℝ) := by
    rw [hk1, hk2, hk3]
    push_cast
    ring
  have hb1 := turnAng_nonneg u v
  have hb2 := turnAng_nonneg v w
  have hb3 := turnAng_nonneg u w
  have hb4 := turnAng_lt_two_pi u w
  have hb5 := turnAng_lt_two_pi u v
  have hb6 := turnAng_lt_two_pi v w
  have hk : k1 + k2 - k3 = 0 ∨ k1 + k2 - k3 = 1 := by
    by_contra hcon
    push_neg at hcon
    have h1 : k1 + k2 - k3 ≤ -1 ∨ 2 ≤ k1 + k2 - k3 := by omega
    rcases h1 with h1 | h1
    · have h2 : ((k1 + k2 - k3 : ℤ) : ℝ) ≤ (-1 : ℝ) := by exact_mod_cast h1
      nlinarith [hsum, hb1, hb2, hb3, hb4, h2, Real.pi_pos]
    · have h2 : (2:ℝ) ≤ ((k1 + k2 - k3 : ℤ) : ℝ) := by exact_mod_cast h1
      nlinarith [hsum, hb1, hb2, hb3, hb4, hb5, hb6, h2, Real.pi_pos]
  rcases hk with h | h
  · left
    rw [h] at hsum
    push_cast at hsum
    linarith [hsum]
  · right
    rw [h] at hsum
    push_cast at hsum
    linarith [hsum]

/-- Clipping off the ear at vertex `v 1` keeps strict convexity. -/
theorem IsConvexPolygon_clip1 {n : ℕ} [NeZero n] (v : Fin (n + 1) → ℝ × ℝ)
    (hv : IsConvexPolygon v) (hn3 : 3 ≤ n) :
    IsConvexPolygon (v ∘ Fin.succAbove (⟨1, by omega⟩ : Fin (n + 1))) := by
  intro i j k h
  have hs : ∀ a b : Fin n, ((⟨1, by omega⟩ : Fin (n + 1)).succAbove a).val <
      ((⟨1, by omega⟩ : Fin (n + 1)).succAbove b).val ↔ a.val < b.val :=
    fun a b => Fin.succAbove_lt_succAbove _ _ _
  apply hv
  rcases h with ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩
  · exact Or.inl ⟨(hs _ _).mpr h1, (hs _ _).mpr h2⟩
  · exact Or.inr (Or.inl ⟨(hs _ _).mpr h1, (hs _ _).mpr h2⟩)
  · exact Or.inr (Or.inr ⟨(hs _ _).mpr h1, (hs _ _).mpr h2⟩)

/-- Clipping off an ear preserves the total turning angle. -/
theorem turn_sum_clip {n : ℕ} [NeZero n] (v : Fin (n + 1) → ℝ × ℝ)
    (hv : IsConvexPolygon v) (hn3 : 3 ≤ n) :
    ∑ j : Fin n, turnAng (edge (v ∘ Fin.succAbove (⟨1, by omega⟩ : Fin (n + 1))) j)
        (edge (v ∘ Fin.succAbove (⟨1, by omega⟩ : Fin (n + 1))) (j + 1)) =
      ∑ j : Fin (n + 1), turnAng (edge v j) (edge v (j + 1)) := by
  have hnn : 0 < n := NeZero.pos n
  haveI : NeZero (n + 1) := ⟨by omega⟩
  set sp : Fin (n + 1) := ⟨1, by omega⟩
  set sA : Fin n → Fin (n + 1) := sp.succAbove
  have hspv : sp.val = 1 := rfl
  have hlt01 : (0 : Fin (n + 1)).val < (1 : Fin (n + 1)).val := by
    rw [Fin.val_zero, show (1 : Fin (n + 1)).val = 1 % (n + 1) from by rfl,
      Nat.mod_eq_of_lt (by omega : 1 < n + 1)]
    decide
  have hlt12 : (1 : Fin (n + 1)).val < (2 : Fin (n + 1)).val := by
    rw [show (1 : Fin (n + 1)).val = 1 % (n + 1) from by rfl, Nat.mod_eq_of_lt (by omega : 1 < n + 1),
      show (2 : Fin (n + 1)).val = 2 % (n + 1) from by rfl, Nat.mod_eq_of_lt (by omega : 2 < n + 1)]
    decide
  have hvw : ∀ j : Fin n,
      edge (v ∘ sA) j = v (sA (j + 1)) - v (sA j) := fun j => rfl
  -- values of the skip map
  have hsA : ∀ j : Fin n, 1 ≤ j.val → sA j = ⟨j.val + 1, by omega⟩ := by
    intro j hj
    apply Fin.ext
    rw [Fin.succAbove_val, hspv, if_neg (by omega : ¬ j.val < 1)]
  have hsA0 : sA 0 = (0 : Fin (n + 1)) := by
    apply Fin.ext
    rw [Fin.succAbove_val, hspv, Fin.val_zero]
    simp
  have hsA1 : sA 1 = (2 : Fin (n + 1)) := by
    apply Fin.ext
    have h1 : (1 : Fin n).val = 1 % n := by rfl
    rw [Fin.succAbove_val, hspv, h1, Nat.mod_eq_of_lt (by omega : 1 < n),
      if_neg (by omega : ¬ (1 : ℕ) < 1)]
    show 1 + 1 = 2 % (n + 1)
    rw [Nat.mod_eq_of_lt (by omega : 2 < n + 1)]
  -- successor-index conversions
  have h01 : (0 : Fin n) + 1 = (1 : Fin n) := by
    apply Fin.ext
    rw [Fin.val_add, Fin.val_zero]
    show (0 + 1 % n) % n = 1 % n
    rw [Nat.zero_add, Nat.mod_mod]
  have h01v : (0 : Fin (n + 1)) + 1 = (1 : Fin (n + 1)) := by
    apply Fin.ext
    rw [Fin.val_add, Fin.val_zero]
    show (0 + 1 % (n + 1)) % (n + 1) = 1 % (n + 1)
    rw [Nat.zero_add, Nat.mod_mod]
  have h12 : (1 : Fin (n + 1)) + 1 = (2 : Fin (n + 1)) := by
    apply Fin.ext
    have h13 : ((1 : Fin (n + 1)) + 1).val = (1 : Fin (n + 1)).val + 1 :=
      Fin.val_add_one_of_lt' (by
        have h14 : (1 : Fin (n + 1)).val = 1 % (n + 1) := by rfl
        rw [h14, Nat.mod_eq_of_lt (by omega : 1 < n + 1)]
        omega)
    rw [h13]
    have h14 : (1 : Fin (n + 1)).val = 1 % (n + 1) := by rfl
    rw [h14, Nat.mod_eq_of_lt (by omega : 1 < n + 1)]
    show 1 + 1 = (2 : Fin (n + 1)).val
    rw [show (2 : Fin (n + 1)).val = 2 % (n + 1) from by rfl,
      Nat.mod_eq_of_lt (by omega : 2 < n + 1)]
  -- special edges of the clipped polygon
  have he'0 : edge (v ∘ sA) 0 = v 2 - v 0 := by
    have h01 : (0 : Fin n) + 1 = (1 : Fin n) := by
      apply Fin.ext
      rw [Fin.val_add, Fin.val_zero]
      show (0 + 1 % n) % n = 1 % n
      rw [Nat.zero_add, Nat.mod_mod]
    rw [hvw, h01, hsA1, hsA0]
  have he'1 : edge (v ∘ sA) 1 = v 3 - v 2 := by
    rw [hvw]
    have h1 : sA (1 + 1) = (3 : Fin (n + 1)) := by
      have h2 : (1 + 1 : Fin n) = (2 : Fin n) := by
        apply Fin.ext
        have h3 : (1 + 1 : Fin n).val = (1 : Fin n).val + 1 :=
          Fin.val_add_one_of_lt' (by
            have h4 : (1 : Fin n).val = 1 % n := by rfl
            rw [h4, Nat.mod_eq_of_lt (by omega : 1 < n)]
            omega)
        rw [h3]
        have h4 : (1 : Fin n).val = 1 % n := by rfl
        rw [h4, Nat.mod_eq_of_lt (by omega : 1 < n)]
        have h5 : (2 : Fin n).val = 2 % n := by rfl
        rw [h5, Nat.mod_eq_of_lt (by omega : 2 < n)]
      rw [h2]
      have h4 : sA (2 : Fin n) = (3 : Fin (n + 1)) := by
        have h5 : sA (2 : Fin n) = ⟨(2 : Fin n).val + 1, by omega⟩ := by
          apply hsA
          have h6 : (2 : Fin n).val = 2 % n := by rfl
          rw [h6, Nat.mod_eq_of_lt (by omega : 2 < n)]
          decide
        rw [h5]
        apply Fin.ext
        show (2 : Fin n).val + 1 = (3 : Fin (n + 1)).val
        rw [show (2 : Fin n).val = 2 % n from by rfl, Nat.mod_eq_of_lt (by omega : 2 < n),
          show (3 : Fin (n + 1)).val = 3 % (n + 1) from by rfl,
